import acc: ^.ft3.account;
import ft3: ^.ft3.core;
import dip: ^.dip.core;
import og: ^.originals.core;

entity evm_account_link {
    network_id: integer;
    state_n: integer;
    evm_beneficiary: text;
    key network_id, state_n, evm_beneficiary;
}

entity ft3_account_link {
    state_n: integer;
    account_id: byte_array;
    key state_n, account_id;
}

entity evm_block {
    network_id: integer;
    evm_block_height: integer;
    evm_block_hash: byte_array;
    key network_id, evm_block_height, evm_block_hash;
}

entity evm_erc20 {
    network_id: integer;
    address: text;
    name: text;
    symbol: text;
    decimals: integer;
    asset: ft3.asset;
    key network_id, address;
}

entity evm_erc721 {
    key network_id: integer, address: text, token_id: integer;
    name: text;
    symbol: text;
    uri: text;
}

entity evm_erc721_link {
    token: evm_erc721;
    original: og.Dip.instance;
    key token, original;
}

entity evm_event {
    index evm_block;
    tnx_hash: byte_array;
    log_index: integer;
    event_signature: byte_array;
    contract_address: byte_array;
    indexed_values: byte_array;
    non_indexed_values: byte_array;
}

entity evm_erc20_balance {
    network_id: integer;
    token: evm_erc20;
    beneficiary: text;
    mutable amount: integer;
    key token, beneficiary;
}

entity evm_erc721_balance {
    network_id: integer;
    token: evm_erc721;
    beneficiary: text;
    key token, beneficiary;
}

entity evm_erc20_withdraw {
    key serial: integer;
    network_id: integer;
    index token: evm_erc20;
    index beneficiary: text;
    amount: integer;
}

entity evm_erc721_withdraw {
    key serial: integer;
    network_id: integer;
    index token: evm_erc721;
    index beneficiary: text;
}

object withdraw_stats {
    mutable withdraw_count: integer = 0;
}

struct event_data {
    tnx_hash: byte_array;
    log_index: integer;
    signature: byte_array;
    contract_address: byte_array;
    name: text;
    indexed_values: list<gtv>;
    non_indexed_values: list<gtv>;
}

struct state_data {
    state_n: integer;
    account: list<gtv>;
}

query get_last_evm_block(network_id: integer) { return evm_block @? {network_id} (@sort_desc .evm_block_height, .evm_block_hash) limit 1;}

query get_erc20_withdrawal(network_id: integer, token_address: text, beneficiary: text) {
    val token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        return null;
    }

    return evm_erc20_withdraw @* { network_id, token , beneficiary } (@sort_desc .serial, .network_id, token = .token.address, .beneficiary, .amount);
}

query get_erc721_withdrawal(network_id: integer, token_address: text, token_id: integer, beneficiary: text) {
    val token = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(token)) {
        return null;
    }

    return evm_erc721_withdraw @* { network_id, token, beneficiary } (@sort_desc .serial, .network_id, token = .token.address, .beneficiary);
}

query evm_balance_of_erc20(network_id: integer, token_address: text, beneficiary: text): integer {
    val t = evm_erc20 @? { network_id, .address == token_address };
    if (empty(t)) {
        return 0;
    }
    val b = evm_erc20_balance @? { network_id, .token == t, beneficiary } (.amount);
    if (empty(b)) {
        return 0;
    }
    return b;
}

query evm_has_erc721(network_id: integer, token_address: text, token_id: integer, beneficiary: text): boolean {
    val t = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(t)) {
        return false;
    }
    val b = evm_erc721_balance @? { network_id, .token == t, beneficiary };
    return not empty(b);
}

operation __evm_block(network_id: integer, evm_block_height: integer, evm_block_hash: byte_array, events: list<event_data>) {
    val evm_block = create evm_block(
        network_id,
        evm_block_height,
        evm_block_hash
    );

    for (event in events) {
        var indexed_values_bytes = x"";
        for (value in event.indexed_values) {
            indexed_values_bytes += value.to_bytes();
        }
        var non_indexed_values_bytes = x"";
        for (value in event.non_indexed_values) {
            non_indexed_values_bytes += value.to_bytes();
        }

        val evm_event = create evm_event(
            evm_block,
            tnx_hash = event.tnx_hash,
            log_index = event.log_index,
            event_signature = event.signature,
            contract_address = event.contract_address,
            indexed_values = indexed_values_bytes,
            non_indexed_values = non_indexed_values_bytes
        );
        
        val beneficiary = to_zero_padded_hex(byte_array.from_gtv(event.indexed_values[0]));
        when (event.name) {
            "DepositedERC20" -> {
                val token_address = to_zero_padded_hex(byte_array.from_gtv(event.indexed_values[1]));
                val net_id = integer.from_gtv(event.non_indexed_values[0]);
                require(net_id == network_id, "incorrect network id");
                val amount = integer.from_gtv(event.non_indexed_values[1]);
                val name = text.from_gtv(event.non_indexed_values[2]);
                val symbol = text.from_gtv(event.non_indexed_values[3]);
                val decimals = integer.from_gtv(event.non_indexed_values[4]);
                deposit_ERC20(network_id, beneficiary, token_address, amount, name, symbol, decimals);
            }
            "DepositedERC721" -> {
                val token_address = to_zero_padded_hex(byte_array.from_gtv(event.indexed_values[1]));
                val net_id = integer.from_gtv(event.non_indexed_values[0]);
                require(net_id == network_id, "incorrect network id");
                val token_id = integer.from_gtv(event.non_indexed_values[1]);
                val name = text.from_gtv(event.non_indexed_values[2]);
                val symbol = text.from_gtv(event.non_indexed_values[3]);
                val uri = text.from_gtv(event.non_indexed_values[4]);
                deposit_ERC721(network_id, beneficiary, token_address, token_id, name, symbol, uri);
            }
        }
        val account_link = get_or_create_evm_account_link(network_id, beneficiary);
        val state = build_account_state(network_id, beneficiary);
        val state_data = state_data(
            account_link.state_n,
            account = state
        );
        op_context.emit_event("eif_state", state_data.to_gtv());
    }
}

// operation deposit_ft3_token(account: acc.account, asset: ft3.asset, amount: integer) {
operation deposit_ft3_token(network_id: integer, token_address: text, beneficiary: text, amount: integer) {
    require(amount > 0, "amount should larger than 0");
    val token = evm_erc20 @? { network_id, .address == token_address };
    require(token, "token is not evm bridge");
    val asset_id = (token.name, chain_context.blockchain_rid).hash();
    val asset = ft3.asset @? { .id == asset_id };
    require(asset, "ft3 asset does not exist");

    val evm_account_link = evm_account_link @? { network_id, beneficiary };
    require(evm_account_link, "evm account link does not exist");

    val ft3_account_link = ft3_account_link @? { .state_n == evm_account_link.state_n };
    require(ft3_account_link, "ft3 account link does not exist");

    val account = acc.account @? { .id == ft3_account_link.account_id };
    require(account, "ft3 account does not exist");

    // burn ft3 token of the account
    destroy_asset(account, asset, amount);

    // update the postchain EIF state for equivalent account
    deposit_ERC20(token.network_id, evm_account_link.evm_beneficiary, token.address, amount, token.name, token.symbol, token.decimals);
}

operation deposit_non_fungible_original(account: acc.account, original: og.Dip.instance) {
    val ft3_burn_account = og.ensure_locked_account("BURN", account);
    og.Ownership.transfer(account, original, ft3_burn_account.id, 1);

    val token_link = evm_erc721_link @? { original }; // TODO: ensure that 1:1 relation here
    require(token_link, "this asset it not evm bridge token");
    val token = token_link.token;

    // update the postchain EIF state for equivalent account
    val ft3_account_link = ft3_account_link @? { .account_id == account.id };
    require(ft3_account_link);
    val evm_account_link = evm_account_link @? { .network_id == token.network_id, .state_n == ft3_account_link.state_n };
    require(evm_account_link);

    deposit_ERC721(token.network_id, evm_account_link.evm_beneficiary, token.address, token.token_id, token.name, token.symbol, token.uri);
}

operation withdraw_ERC20(network_id: integer, token_address: text, beneficiary: text, amount: integer) {
    require(amount > 0, "Must withdraw an amount larger than 0");
    val token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        return;
    }

    val balance = evm_erc20_balance @? { network_id, token, beneficiary };
    require_not_empty(balance, "No balance for this token");
    require(balance.amount >= amount, "Balance is too low");
    update balance(.amount -= amount);

    update withdraw_stats(withdraw_count += 1);
    val next_serial = withdraw_stats.withdraw_count;

    create evm_erc20_withdraw(
        serial = next_serial,
        network_id,
        token,
        beneficiary,
        amount
    );

    val withdraw_info = list<gtv>();
    withdraw_info.add(next_serial.to_gtv());
    withdraw_info.add(network_id.to_gtv());
    withdraw_info.add(byte_array.from_hex("000000000000000000000000" + token_address.sub(2)).to_gtv());
    withdraw_info.add(byte_array.from_hex("000000000000000000000000" + beneficiary.sub(2)).to_gtv());
    withdraw_info.add(amount.to_gtv());
    emit_withdraw(network_id, beneficiary, withdraw_info);
}

operation claim_ERC20(network_id: integer, token_address: text, beneficiary: text, amount: integer, 
                        r: byte_array, s: byte_array, v: integer, pk: text) {
    require(amount > 0, "Must withdraw an amount larger than 0");
    val token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        return;
    }
    val balance = evm_erc20_balance @? { network_id, token, beneficiary };
    require_not_empty(balance, "No balance for this token");
    require(balance.amount >= amount, "Balance is too low");
    update balance(.amount -= amount);

    update withdraw_stats(withdraw_count += 1);
    val next_serial = withdraw_stats.withdraw_count;

    // net_id = 0 means withdraw from postchain snapshot state into FT3
    val net_id = 0;
    create evm_erc20_withdraw(
        serial = next_serial,
        network_id = net_id,
        token,
        beneficiary,
        amount
    );

    val withdraw_info = list<gtv>();
    withdraw_info.add(next_serial.to_gtv());
    withdraw_info.add(net_id.to_gtv());
    withdraw_info.add(byte_array.from_hex("000000000000000000000000" + token_address.sub(2)).to_gtv());
    withdraw_info.add(byte_array.from_hex("000000000000000000000000" + beneficiary.sub(2)).to_gtv());
    withdraw_info.add(amount.to_gtv());
    emit_withdraw(network_id, beneficiary, withdraw_info);

    val account_link = get_or_create_ft3_account_link(network_id, beneficiary, r, s, v, pk);
    val ft3_balance = ft3.ensure_balance( acc.account @ { account_link.account_id }, token.asset );
    ft3_balance.amount += amount;
}

operation claim_ERC721(network_id: integer, token_address: text, beneficiary: text, token_id: integer,
                        r: byte_array, s: byte_array, v: integer, pk: text) {
    val token = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(token)) {
        return;
    }

    val balance = evm_erc721_balance @? { network_id, token, beneficiary };
    require_not_empty(balance, "No balance for this token");
    delete balance;

    update withdraw_stats(withdraw_count += 1);
    val next_serial = withdraw_stats.withdraw_count;

    // net_id = 0 means withdraw from postchain snapshot state into FT3
    val net_id = 0;
    create evm_erc721_withdraw(
        serial = next_serial,
        network_id = net_id,
        token,
        beneficiary
    );

    val withdraw_info = list<gtv>();
    withdraw_info.add(next_serial.to_gtv());
    withdraw_info.add(net_id.to_gtv());
    withdraw_info.add(byte_array.from_hex("000000000000000000000000" + token_address.sub(2)).to_gtv());
    withdraw_info.add(byte_array.from_hex("000000000000000000000000" + beneficiary.sub(2)).to_gtv());
    withdraw_info.add(token_id.to_gtv());
    emit_withdraw(network_id, beneficiary, withdraw_info);

    val account_link = get_or_create_ft3_account_link(network_id, beneficiary, r, s, v, pk);
    val account = acc.account @ { account_link.account_id };
    val dclass = dip.Interface.dclass @? { og.chromia.INonFungibleOriginal.interface };
    if (empty(dclass)) {
        og.initialize_original_interfaces(account);
    }
    val original_type = og.Minter.I(
        interface_name = og.chromia.INonFungibleOriginal.interface,
        [
            og.chromia.IOriginal.name: dip.Text.T(token.name),
            og.chromia.IOriginal.creator_id: dip.ByteArray.T(account_link.account_id),
            og.chromia.IOriginal.creator_name: dip.Text.T("Owner")
        ]
    );
    val original = og.Minter.mint_non_fungible_original(account, original_type, dip.Meta.Engine.access(account));
    create evm_erc721_link(
        token,
        original
    );
}

operation withdraw_ERC721(network_id: integer, token_address: text, beneficiary: text, token_id: integer) {
    val token = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(token)) {
        return;
    }

    val balance = evm_erc721_balance @? { network_id, token, beneficiary };
    require_not_empty(balance, "No balance for this token");
    delete balance;

    update withdraw_stats(withdraw_count += 1);
    val next_serial = withdraw_stats.withdraw_count;

    create evm_erc721_withdraw(
        serial = next_serial,
        network_id,
        token,
        beneficiary
    );

    val withdraw_info = list<gtv>();
    withdraw_info.add(next_serial.to_gtv());
    withdraw_info.add(network_id.to_gtv());
    withdraw_info.add(byte_array.from_hex("000000000000000000000000" + token_address.sub(2)).to_gtv());
    withdraw_info.add(byte_array.from_hex("000000000000000000000000" + beneficiary.sub(2)).to_gtv());
    withdraw_info.add(token_id.to_gtv());
    emit_withdraw(network_id, beneficiary, withdraw_info);
}

function get_or_create_evm_account_link(network_id: integer, beneficiary: text): evm_account_link {
    val account = evm_account_link @? { network_id, beneficiary };
    if (empty(account)) {
        val last_state_n = evm_account_link @? {} (@sort_desc .state_n) limit 1;
        var next_state_n = 0;
        if (empty(last_state_n)) {
            next_state_n = 1;
        } else {
            next_state_n = last_state_n + 1;
        }

        return create evm_account_link(
            network_id,
            state_n = next_state_n,
            beneficiary
        );
    };
    return account;
}

function get_or_create_ft3_account_link(network_id: integer, beneficiary: text, 
                                        r: byte_array, s: byte_array, v: integer, pk: text): ft3_account_link {
    val account = evm_account_link @? { network_id, beneficiary };
    require(account, "evm account link does not exist");
    val ft3_account = ft3_account_link @? { .state_n == account.state_n };
    val recovered_pubkey = crypto.eth_ecrecover(r, s, v, hash_eth_message(pk));
    val eth_address = get_eth_address(recovered_pubkey);
    require(eth_address == beneficiary.sub(2), "beneficiary is not correct, " + "b: " + beneficiary.sub(2) + " e: " + eth_address);
    if (empty(ft3_account)) {
        val args = list<gtv>();
        args.add("A".to_gtv());
        args.add(network_id.to_text().to_gtv());
        args.add(beneficiary.to_gtv());
        val participants = op_context.get_signers();
        require_not_empty(participants, "participants is empty");
        require(participants.size() == 1, "only support single auth");
        require(participants[0].to_hex() == pk, "ft3 participant is not correct, " + participants[0].to_hex() + ", " + pk);
        val auth_desc = acc.auth_descriptor(
            auth_type = "S",
            participants,
            args,
            rules = null.to_gtv()
        );
        val account_id = acc.create_account_with_auth(auth_desc);
        return create ft3_account_link(
            state_n = account.state_n,
            account_id
        );
    };
    return ft3_account;
}

function build_account_state(network_id: integer, beneficiary: text) {
	val state = list<gtv>();
	state.add(byte_array.from_hex("000000000000000000000000" + beneficiary.sub(2)).to_gtv());
	// In order of asset type
	// 0: ERC20
	val erc20_balances = evm_erc20_balance @* { network_id, beneficiary };
	val erc20_byte_offset = erc20_balances.size() * 2 * 32; // 2 values per entry
	state.add(erc20_byte_offset.to_gtv());
	for (balance in erc20_balances) {
		state.add(byte_array.from_hex("000000000000000000000000" + balance.token.address.sub(2)).to_gtv());
		state.add(balance.amount.to_gtv());
	}
	// 1: ERC721
	val erc721_balances = evm_erc721_balance @* { network_id, beneficiary };
	val erc721_byte_offset = erc721_balances.size() * 2 * 32; // 2 values per entry
	state.add(erc721_byte_offset.to_gtv());
	for (balance in erc721_balances) {
		state.add(byte_array.from_hex("000000000000000000000000" + balance.token.address.sub(2)).to_gtv());
		state.add(balance.token.token_id.to_gtv());
	}
	// Add new asset types here
	// ------------------------ //
	return state;
}

function deposit_ERC20(network_id: integer, beneficiary: text, token_address: text, amount: integer, name: text, symbol: text, decimals: integer) {
    var token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        val asset = ft3.register_asset(name, chain_context.blockchain_rid);

        token = create evm_erc20(
            network_id,
            address = token_address,
            name,
            symbol,
            decimals,
            asset
        );
    }

    val balance = evm_erc20_balance @? { network_id, token, beneficiary };
    if (empty(balance)) {
        create evm_erc20_balance(
            network_id,
            token,
            beneficiary,
            amount
        );
    } else {
        update balance (.amount += amount);
    }
}

function deposit_ERC721(network_id: integer, beneficiary: text, token_address: text, token_id: integer, name: text, symbol: text, uri: text) {
    var token = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(token)) {
          token = create evm_erc721(
              network_id,
              address = token_address,
              token_id,
              name,
              symbol,
              uri
          );
    }

    create evm_erc721_balance(
        network_id,
        token,
        beneficiary
    );
}

function emit_withdraw(network_id: integer, beneficiary: text, eth_event_data: list<gtv>) {
    val account_link = get_or_create_evm_account_link(network_id, beneficiary);
    val state = build_account_state(network_id, beneficiary);
    val state_data = state_data(
        account_link.state_n,
        account = state
    );

    op_context.emit_event("eif_state", state_data.to_gtv());
    op_context.emit_event("eif_event", eth_event_data.to_gtv());
}

function to_zero_padded_hex(array: byte_array) = "0x" + array.to_hex();

function get_eth_address(pk: byte_array) = crypto.keccak256(pk).sub(12).to_hex();

function hash_eth_message(msg: text) = crypto.keccak256(("\u0019Ethereum Signed Message:\n" + msg.size().to_text() + msg).to_bytes());

function destroy_asset (from: acc.account, ft3.asset, amount: integer): ft3.payment_history_entry {
	val b = ft3.ensure_balance(from, asset); 
	require(b.amount >= amount);
	b.amount -= amount;
	return create ft3.payment_history_entry (
        from,
        asset,
        .delta = amount,
        .op_index = 0,
        .is_input = true,
        .entry_index = 0
      );
}
