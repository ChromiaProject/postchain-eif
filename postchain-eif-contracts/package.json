{
  "name": "@eif/contracts",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.0",
  "description": "",
  "files": [
    "contracts/**/*.sol",
    "src/artifacts/contracts/**/*.json",
    "src/!artifacts/contracts/**/*.dbg.json"
  ],
  "scripts": {
    "clean": "cross-env TS_NODE_TRANSPILE_ONLY=true npx hardhat clean",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true npx hardhat compile",
    "test": "npx hardhat test",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain",
    "coverage": "cross-env CODE_COVERAGE=true hardhat coverage --solcoverjs ./.solcover.js --temp artifacts --testfiles \"./test/**/*.ts\"",
    "deploy": "npx hardhat deploy:bridge",
    "deploy:native": "npx hardhat deploy:chromiabridge",
    "deploy:chromiabridge": "npx hardhat deploy:chromiabridge",
    "upgrade:chromiabridge-to-v1.1": "npx hardhat upgrade:chromiabridge-to-v1.1",
    "deploy:directoryValidator": "npx hardhat deploy:directoryValidator",
    "deploy:anchoring": "npx hardhat deploy:anchoring",
    "prepare:bridge": "npx hardhat prepare:bridge",
    "upgrade:bridge": "npx hardhat upgrade:bridge",
    "import:bridge": "npx hardhat import:bridge",
    "setBlockchainRid:bridge": "npx hardhat setBlockchainRid:bridge",
    "allowToken:bridge": "npx hardhat allowToken:bridge",
    "prepare:nft": "npx hardhat prepare:nft",
    "upgrade:nft": "npx hardhat upgrade:nft",
    "deploy:alice": "npx hardhat deploy:alice",
    "set-minter:chromia": "npx hardhat set-minter:chromia",
    "transaction:resubmitSignerUpdate": "npx hardhat transaction:resubmitSignerUpdate",
    "transaction:resubmitAnchoring": "npx hardhat transaction:resubmitAnchoring"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.0.2",
    "@nomiclabs/hardhat-etherscan": "^3.0.3",
    "@nomiclabs/hardhat-waffle": "^2.0.1",
    "@openzeppelin/hardhat-upgrades": "^1.18.0",
    "@typechain/ethers-v5": "^7.0.1",
    "@typechain/hardhat": "^2.0.2",
    "@types/chai": "^4.2.18",
    "@types/ethjs-util": "^0.1.1",
    "@types/fs-extra": "^9.0.12",
    "@types/mocha": "^8.2.2",
    "@types/node": "^15.12.2",
    "chai": "^4.3.4",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "ethereum-waffle": "^3.3.0",
    "ethers": "^5.3.1",
    "fs-extra": "^10.0.0",
    "hardhat": "2.22.13",
    "hardhat-abi-exporter": "^2.9.0",
    "hardhat-gas-reporter": "^1.0.4",
    "prettier": "^2.3.1",
    "prettier-plugin-solidity": "^1.0.0-beta.13",
    "solhint": "^3.3.6",
    "solhint-plugin-prettier": "^0.0.5",
    "solidity-coverage": "^0.7.16",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.0.0",
    "typechain": "^5.0.0",
    "typescript": "^4.3.2",
    "yarn-upgrade-all": "^0.5.4"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@openzeppelin/contracts": "5.0.0",
    "@openzeppelin/contracts-upgradeable": "5.0.0"
  }
}
