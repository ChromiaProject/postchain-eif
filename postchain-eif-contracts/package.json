{
  "name": "postchain-eif-contracts",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.10.1",
  "scripts": {
    "preinstall": "npx -y only-allow yarn",
    "clean": "cross-env TS_NODE_TRANSPILE_ONLY=true npx hardhat clean",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true npx hardhat compile",
    "test": "npx hardhat test",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain",
    "coverage": "cross-env CODE_COVERAGE=true hardhat coverage --solcoverjs ./.solcover.js --temp artifacts --testfiles \"./test/**/*.ts\"",
    "deploy:directoryValidator": "npx hardhat deploy:directoryValidator",
    "deploy:anchoring": "npx hardhat deploy:anchoring",
    "deploy:validator": "npx hardhat deploy:validator",
    "inspect:managedValidator": "npx hardhat inspect:managedValidator",
    "inspect:directoryValidator": "npx hardhat inspect:directoryValidator",
    "inspect:validator": "npx hardhat inspect:validator",
    "deploy": "npx hardhat deploy:bridge",
    "deploy:native": "npx hardhat deploy:chromiabridge",
    "deploy:snapshots": "npx hardhat deploy:snapshots",
    "deploy:chromiatokenbsc": "npx hardhat deploy:chromiatokenbsc",
    "prepare:bridge": "npx hardhat prepare:bridge",
    "upgrade:bridge": "npx hardhat upgrade:bridge",
    "import:bridge": "npx hardhat import:bridge",
    "setBlockchainRid:bridge": "npx hardhat setBlockchainRid:bridge",
    "finalizeBlockchainRid:bridge": "npx hardhat finalizeBlockchainRid:bridge",
    "allowToken:bridge": "npx hardhat allowToken:bridge",
    "approveToken:bridge": "npx hardhat approveToken:bridge",
    "inspect:bridge": "npx hardhat inspect:bridge",
    "inspect:chromiabridge": "npx hardhat inspect:chromiabridge",
    "pause:bridge": "npx hardhat pause:bridge",
    "unpause:bridge": "npx hardhat unpause:bridge",
    "deploy:recovery": "npx hardhat deploy:recovery",
    "setBlockchainRid:recovery": "npx hardhat setBlockchainRid:recovery",
    "finalizeBlockchainRid:recovery": "npx hardhat finalizeBlockchainRid:recovery",
    "deploy:alice": "npx hardhat deploy:alice",
    "transaction:resubmitSignerUpdate": "npx hardhat transaction:resubmitSignerUpdate",
    "transaction:resubmitAnchoring": "npx hardhat transaction:resubmitAnchoring"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^0.15.6",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.6",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.11",
    "@nomicfoundation/ignition-core": "^0.15.7",
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.5.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=18.0.0",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "fs-extra": "^11.2.0",
    "hardhat": "^2.22.13",
    "hardhat-abi-exporter": "^2.10.1",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.13",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "cross-env": "^7.0.3"
  },
  "resolutions": {
    "ansi-regex": "5.0.1",
    "color-convert": "2.0.1",
    "color-name": "1.1.4",
    "debug": "4.4.0",
    "strip-ansi": "6.0.1",
    "wrap-ansi": "7.0.0",
    "slice-ansi": "4.0.0",
    "cli-table3/ansi-regex": "3.0.1",
    "command-line-usage/color-convert": "1.9.3",
    "command-line-usage/color-name": "1.1.3",
    "ghost-testrpc/color-convert": "1.9.3",
    "ghost-testrpc/color-name": "1.1.3",
    "solidity-coverage/color-convert": "1.9.3",
    "solidity-coverage/color-name": "1.1.3"
  }
}
