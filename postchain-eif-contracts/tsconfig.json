{
  "compilerOptions": {
    // Target and Language Support
    "target": "es2020",
    "lib": ["es2020"],

    // Module System and Resolution
    "module": "commonjs",
    "moduleResolution": "node",

    // Interoperability and Import/Export
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // Code Quality and Strictness
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,

    // Project Structure and Output
    "outDir": "dist",
    "sourceMap": true,
    "allowJs": true,
    "isolatedModules": true,

    // Compiler Performance
    "skipLibCheck": true
  },
  "files": [
    "./hardhat.config.ts"
  ],
  "include": [
    "tasks/**/*.ts",
    "test/**/*.ts",
    "typechain-types/**/*.d.ts",
    "typechain-types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
