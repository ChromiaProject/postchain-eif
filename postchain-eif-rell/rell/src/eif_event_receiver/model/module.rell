module;

entity evm_block {
    network_id: integer;
    evm_block_height: integer;
    evm_block_hash: byte_array;
    key network_id, evm_block_height, evm_block_hash;
}

entity evm_event {
    index evm_block;
    tnx_hash: byte_array;
    log_index: integer;
    event_signature: byte_array;
    contract_address: byte_array;
    name: text = "";
    indexed_values: byte_array;
    non_indexed_values: byte_array;
}

struct evm_block_data {
    network_id: integer;
    block_height: integer;
    block_hash: byte_array;
    prev_block_height: integer?;
}

struct evm_event_data {
    tnx_hash: byte_array;
    log_index: integer;
    event_signature: byte_array;
    contract_address: byte_array;
    name: text;
    indexed_values: list<gtv>;
    non_indexed_values: list<gtv>;
}
