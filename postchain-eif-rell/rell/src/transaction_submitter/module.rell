import .utils.messaging.*;
import .utils.*;

operation __icmf_message(sender: byte_array, topic: text, body: gtv) {
    create_evm_submit_transaction_entity(evm_submit_transaction_message.from_gtv(body), sender);
}

operation __update_evm_transaction_state(row_id: integer, status: transaction_status) {
    update evm_submit_transaction_entity @ { .rowid == rowid(row_id)} (status = status);
}

operation __update_evm_transaction_receipt(row_id: integer, block_hash: text, effective_gas_price: big_integer, gas_usage: big_integer) {
    update evm_submit_transaction_entity @ { .rowid == rowid(row_id)} (.block_hash = block_hash, .effective_gas_price = effective_gas_price, .gas_usage = gas_usage);
}

entity evm_submit_transaction_entity {
    key id: byte_array;
    contract_address: text;
    function_name: text;
    parameter_types: text;
    parameter_values: byte_array;
    network_id: integer;
    sender: byte_array;
    index mutable status: transaction_status;
    index mutable queued_timestamp: timestamp;
    mutable block_hash: text = "";
    mutable effective_gas_price: big_integer = -1;
    mutable gas_usage: big_integer = -1;
}

struct evm_submit_transaction {
    row_id: integer;
    contract_address: text;
    function_name: text;
    parameter_types: list<text>;
    parameter_values: list<gtv>;
    network_id: integer;
    sender: byte_array;
    status: transaction_status;
    queued_timestamp: timestamp;
}

enum transaction_status {
    QUEUED,
    TAKEN,
    PENDING,
    SUCCESS,
    FAILURE,
}

struct module_args {
    contract_whitelist: text;
    contract_tx_rate_limit: big_integer;
}

function create_evm_submit_transaction_entity(evm_submit_transaction_message: evm_submit_transaction_message, sender: byte_array) {
    val contract_whitelist = get_contract_whitelist();
    val contract_address = evm_submit_transaction_message.contract_address;
    if (not contract_whitelist.contains(contract_address)) {
        log("Contract %s is not included in whitelist. Ignoring tx request.".format(contract_address));
        return;
    }

    val evm_transaction_id = get_evm_transaction_id(
        contract_address,
        evm_submit_transaction_message.function_name,
        evm_submit_transaction_message.parameter_types,
        evm_submit_transaction_message.parameter_values,
        evm_submit_transaction_message.network_id
    );

    create evm_submit_transaction_entity(
        id = evm_transaction_id,
        contract_address = contract_address,
        function_name = evm_submit_transaction_message.function_name,
        parameter_types = join_text_list(evm_submit_transaction_message.parameter_types),
        parameter_values = evm_submit_transaction_message.parameter_values.to_gtv().to_bytes(),
        network_id = evm_submit_transaction_message.network_id,
        sender = sender,
        status = transaction_status.QUEUED,
        queued_timestamp = op_context.last_block_time
    );
}

query fetch_oldest_queued_transactions_per_contract() {
    val result = list<evm_submit_transaction>();
    var oldest_queued_transactions_per_contract = evm_submit_transaction_entity @* { .status == transaction_status.QUEUED }(@group .contract_address, @min .queued_timestamp);
    for(transaction in oldest_queued_transactions_per_contract) {
        val contract_address = transaction[0];
        val queued_timestamp = transaction[1];
        if (get_last_blocktime() - queued_timestamp > chain_context.args.contract_tx_rate_limit) {
            val evm_submit_transaction_entity = evm_submit_transaction_entity @ { .status == transaction_status.QUEUED and .contract_address == contract_address and .queued_timestamp == queued_timestamp} (
                evm_submit_transaction(
                row_id = .rowid.to_integer(),
                contract_address = .contract_address,
                function_name = .function_name,
                parameter_types = .parameter_types.split("."),
                parameter_values = list<gtv>.from_gtv(gtv.from_bytes(.parameter_values)),
                network_id = .network_id,
                sender = .sender,
                status = .status,
                queued_timestamp = .queued_timestamp))
                limit 1;
            result.add(evm_submit_transaction_entity);
        }
    }
    return result;
}


function join_text_list(components: list<text>) {
    if(components.empty()) {
        return "";
    }
    var result = components[0];
    if(components.size() > 1){
        for (i in range(1, components.size() - 1)) {
            result = result + "." + components[i];
        }
    }
    return result;
}

function get_contract_whitelist() = chain_context.args.contract_whitelist.split(",");

function get_last_blocktime(){
    return block @ {} (@max .timestamp) ?: 0;
}