@test module;

import ^^.*;

// Based on test module args
val test_directory_chain_brid = x"00000000000000000000000000000000";
val test_system_anchoring_chain_brid = x"11111111111111111111111111111111";
val test_system_bridge_chain_brid = x"22222222222222222222222222222222";

function test_system_chain_functions() {
    assert_true(is_directory_chain(test_directory_chain_brid));
    assert_false(is_directory_chain(test_system_anchoring_chain_brid));

    assert_true(is_system_anchoring_chain(test_system_anchoring_chain_brid));
    assert_false(is_system_anchoring_chain(test_directory_chain_brid));

    assert_equals(get_system_chain_validator_contract(test_directory_chain_brid, 11155111), "directory_validator");
    assert_equals(get_system_chain_validator_contract(test_system_anchoring_chain_brid, 11155111), "anchoring_validator");

    assert_equals(get_anchoring_contracts(), [(address = "anchoring", network_id = 11155111)]);

    assert_equals(
        get_validator_contracts(x"22222222222222222222222222222222"),
        [
            (validator_contract = "system_bridge_validator", network_id = 1),
            (validator_contract = "system_bridge_validator1", network_id = 11155111),
            (validator_contract = "system_bridge_validator", network_id = 56),
        ]
    );
}

function test_text_without_0x() {

    assert_equals(text_without_0x("AABBCC"), "AABBCC");
    assert_equals(text_without_0x("0xAABBCC"), "AABBCC");
}