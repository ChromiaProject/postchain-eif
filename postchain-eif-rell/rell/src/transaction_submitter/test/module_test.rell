@test module;

import ^^.*;
import ^.helper_operations.*;

function test_create_evm_submit_transaction_entity(){

    rell.test.tx().op(create_evm_submit_transaction_entity_operation(evm_submit_transaction_message(
        contract_address = "address",
        function_name = "myFunction",
        parameter_types = list(),
        parameter_values = list(),
        network_id = 1), x"")).run();

    val evm_submit_transaction_entity = evm_submit_transaction_entity @? {};

    assert_not_null(evm_submit_transaction_entity);
}

function test_not_whitelisted_contracts_are_ignored(){

    rell.test.tx().op(create_evm_submit_transaction_entity_operation(evm_submit_transaction_message(
        contract_address = "invalid_address",
        function_name = "myFunction",
        parameter_types = list(),
        parameter_values = list(),
        network_id = 1), x"")).run();

    val evm_submit_transaction_entity = evm_submit_transaction_entity @? {};

    assert_null(evm_submit_transaction_entity);
}

function test_fetch_oldest_queued_transactions_per_contract(){
    rell.test.tx().op(
        create_evm_submit_transaction_entity_op("address","myFunction1"),
        create_evm_submit_transaction_entity_op("address","myFunction2"),
        create_evm_submit_transaction_entity_op("address","myFunction3"),
        create_evm_submit_transaction_entity_op("address1","myFunction4"),
        create_evm_submit_transaction_entity_op("address1","myFunction5"),
        create_evm_submit_transaction_entity_op("address1","myFunction6")
    ).run();

    rell.test.tx().op(
        update_evm_submit_transaction_entity_queued_timestamp_op("address","myFunction1"),
        update_evm_submit_transaction_entity_queued_timestamp_op("address","myFunction2"),
        update_evm_submit_transaction_entity_queued_timestamp_op("address1","myFunction4"),
        update_evm_submit_transaction_entity_queued_timestamp_op("address1","myFunction5")
    ).run();

    val evm_submit_transaction_entity = fetch_oldest_queued_transactions_per_contract();

    assert_true(evm_submit_transaction_entity.size() == 2);
    assert_true(evm_submit_transaction_entity[0].contract_address == "address");
    assert_true(evm_submit_transaction_entity[1].contract_address == "address1");
}

