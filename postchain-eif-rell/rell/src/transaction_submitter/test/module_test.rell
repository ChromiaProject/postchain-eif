@test module;

import ^^.*;
import ^.helper_operations.*;

function test_create_evm_submit_transaction() {

    rell.test.tx().op(create_evm_submit_transaction_operation(evm_submit_transaction_message(
        contract_address = "address",
        function_name = "myFunction",
        parameter_types = list(),
        parameter_values = list(),
        network_id = 1), x"")).run();

    val evm_submit_transaction = evm_submit_transaction @? {};

    assert_not_null(evm_submit_transaction);
}

function test_not_whitelisted_contracts_are_ignored(){

    rell.test.tx().op(create_evm_submit_transaction_operation(evm_submit_transaction_message(
        contract_address = "invalid_address",
        function_name = "myFunction",
        parameter_types = list(),
        parameter_values = list(),
        network_id = 1), x"")).run();

    val evm_submit_transaction = evm_submit_transaction @? {};

    assert_null(evm_submit_transaction);
}

function test_fetch_oldest_queued_transactions_per_contract(){
    rell.test.tx().op(
        create_evm_submit_transaction_op("address","myFunction1"),
        create_evm_submit_transaction_op("address","myFunction2"),
        create_evm_submit_transaction_op("address","myFunction3"),
        create_evm_submit_transaction_op("address1","myFunction4"),
        create_evm_submit_transaction_op("address1","myFunction5"),
        create_evm_submit_transaction_op("address1","myFunction6")
    ).run();

    rell.test.tx().op(
        update_evm_submit_transaction_queued_timestamp_op("address","myFunction1"),
        update_evm_submit_transaction_queued_timestamp_op("address","myFunction2"),
        update_evm_submit_transaction_queued_timestamp_op("address1","myFunction4"),
        update_evm_submit_transaction_queued_timestamp_op("address1","myFunction5")
    ).run();

    val evm_submit_transaction = fetch_oldest_queued_transactions_per_contract();

    assert_true(evm_submit_transaction.size() == 2);
    assert_true(evm_submit_transaction[0].contract_address == "address");
    assert_true(evm_submit_transaction[1].contract_address == "address1");
}

function test_fetch_oldest_queued_transactions_per_contract_and_taken_by() {

    // Submit 2 transactions
    rell.test.tx().op(
        create_evm_submit_transaction_operation(evm_submit_transaction_message(
            contract_address = "address",
            function_name = "myFunction-1",
            parameter_types = list(),
            parameter_values = list(),
            network_id = 1), x""),
        create_evm_submit_transaction_operation(evm_submit_transaction_message(
            contract_address = "address1",
            function_name = "myFunction-2",
            parameter_types = list(),
            parameter_values = list(),
            network_id = 1), x"")
        ).run();

    assert_equals(fetch_oldest_queued_transactions_per_contract().size(), 2);

    // Take one
    rell.test.tx().op(
        update_evm_transaction_state_op(1, transaction_status.TAKEN)
    ).sign(rell.test.keypairs.alice).run();

    assert_equals(fetch_oldest_queued_transactions_per_contract().size(), 1);

    // Change the status back to QUEUED - it is still taken by alice
    rell.test.tx().op(
        sete_evm_transaction_status(1, transaction_status.QUEUED)
    ).sign(rell.test.keypairs.alice).run();

    // We are back to having 2 queued
    assert_equals(fetch_oldest_queued_transactions_per_contract().size(), 2);

    // But since one is taken we only get 1 back with the exclude_taken_by_key set
    assert_equals(fetch_oldest_queued_transactions_per_contract(exclude_taken_by_key=rell.test.keypairs.alice.pub).size(), 1);

    // Set transaction taken by alice to success - this should cleanup the taken entities for this transaction
    rell.test.tx().op(
        update_evm_transaction_state_op(1, transaction_status.SUCCESS)
    ).sign(rell.test.keypairs.alice).run();

    assert_true(empty(evm_submit_transaction_taken_by @* {}));
}

function test_fail_transactions_with_enough_retries_strategy_all() {

    // Submit 2 transactions - 1 not to be touched, 1 to be failed
    rell.test.tx().op(
        create_test_evm_submit_transaction(x"00", "address", "myFunction-0", transaction_status.QUEUED),
        create_test_evm_submit_transaction(x"01", "address", "myFunction-1", transaction_status.QUEUED),
        add_transaction_taken_by(x"01", rell.test.keypairs.alice.pub),
        fail_transactions_with_enough_retries_op(node_retry_strategy.ALL)
        ).run();

    assert_equals(evm_submit_transaction @ { .id == x"00"} (.status), transaction_status.QUEUED);

    val failed_transaction = evm_submit_transaction @ { .id == x"01"} (.status, .error_message);
    assert_equals(failed_transaction.status, transaction_status.FAILURE);
    assert_equals(failed_transaction.error_message, "All available nodes failed to execute transaction");
}

function test_fail_transactions_with_enough_retries_strategy_supermajority() {

    // Submit 1 transactions - 1 with super majority and 1 without
    rell.test.tx().op(
        create_test_evm_submit_transaction(x"00", "address", "myFunction-0", transaction_status.QUEUED),
        create_test_evm_submit_transaction(x"01", "address", "myFunction-1", transaction_status.QUEUED),
        add_transaction_taken_by(x"01", rell.test.keypairs.alice.pub)
        ).run();

    rell.test.tx().op(
        fail_transactions_with_enough_retries_op(node_retry_strategy.SUPERMAJORITY)
    ).run();

    assert_equals(evm_submit_transaction @ { .id == x"00"} (.status), transaction_status.QUEUED);

    var failed_transaction = evm_submit_transaction @ { .id == x"01"} (.status, .error_message);
    assert_equals(failed_transaction.status, transaction_status.FAILURE);
    assert_equals(failed_transaction.error_message, "A supermajority of nodes failed to execute transaction");
}

function test_is_supermajority() {

    assert_true(is_supermajority(0, 0));
    assert_false(is_supermajority(0, 1));
    assert_false(is_supermajority(0, 3));
    assert_false(is_supermajority(1, 3));
    assert_false(is_supermajority(2, 3));
    assert_true(is_supermajority(3, 3));
    assert_true(is_supermajority(30, 3));
    assert_false(is_supermajority(2, 4));
    assert_true(is_supermajority(3, 4));
    assert_false(is_supermajority(5, 8));
    assert_true(is_supermajority(6, 8));
    assert_false(is_supermajority(40, 60));
    assert_true(is_supermajority(41, 60));
}

function test_add_evm_transaction_errors() {

    rell.test.tx().op(
        create_test_evm_submit_transaction(x"00", "address", "myFunction-0", transaction_status.FAILURE)
    ).run();

    val transaction_row_id = evm_submit_transaction @ { .id == x"00" } (.rowid);

    rell.test.tx().op(
        add_evm_transaction_errors_op(transaction_row_id.to_integer(), [
            transaction_error_data(123, rpc_url = null, message = "Failed to get balance"),
            transaction_error_data(150, rpc_url = "http://evm-1:12345", message = "Connection issue")
        ])
    ).sign(rell.test.keypairs.alice).run();

    val errors = evm_submit_transaction_error @* { .transaction.rowid == transaction_row_id };
    assert_equals(errors.size(), 2);

    // First error
    assert_equals(errors[0].timestamp, 123);
    assert_equals(errors[0].provider, rell.test.keypairs.alice.pub);
    assert_equals(errors[0].rpc_url, "");
    assert_equals(errors[0].message, "Failed to get balance");

    // Second error
    assert_equals(errors[1].timestamp, 150);
    assert_equals(errors[1].provider, rell.test.keypairs.alice.pub);
    assert_equals(errors[1].rpc_url, "http://evm-1:12345");
    assert_equals(errors[1].message, "Connection issue");
}