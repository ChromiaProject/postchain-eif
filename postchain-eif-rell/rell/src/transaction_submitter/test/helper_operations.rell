module;

import ^^.*;

operation create_evm_submit_transaction_entity_operation(evm_submit_transaction_message: evm_submit_transaction_message, sender: byte_array){
    create_evm_submit_transaction_entity(evm_submit_transaction_message, sender);
}

operation update_evm_transaction_status_helper_op(row_id: rowid, status: transaction_status) {
    update evm_submit_transaction_entity @ { .rowid == row_id } (.status = status);
}

operation update_evm_transaction_receipt_helper_op(row_id: rowid, block_hash: text, effective_gas_price: big_integer, gas_usage: big_integer) {
    update evm_submit_transaction_entity @ { .rowid == row_id } (.block_hash = block_hash, .effective_gas_price = effective_gas_price, .gas_usage = gas_usage);
}
