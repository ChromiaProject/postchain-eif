@test module;

import ^^.*;
import ^.helper_operations.*;

function test_bridge_mapping() {
    // Add mapping
    val test_brid = x"01";
    val test_network = 11137;

    rell.test.tx().op(
            bridge_mapping_message_op(
                bridge_mapping_message(
                    blockchain_rid = test_brid,
                    validator_contract = "validator_contract",
                    bridge_contract = "bridge_contract",
                    evm_network_id = test_network,
                    deleted = false
                )
            )
        ).run();

    assert_true(has_bridge_mapping(test_brid));
    assert_equals(get_bridge_contract(test_brid, test_network), "bridge_contract");
    assert_equals(get_validator_contract(test_brid, test_network), "validator_contract");

    // Update mapping
    rell.test.tx().op(
            bridge_mapping_message_op(
                bridge_mapping_message(
                    blockchain_rid = test_brid,
                    validator_contract = "validator_contract2",
                    bridge_contract = "bridge_contract2",
                    evm_network_id = test_network,
                    deleted = false
                )
            )
        ).run();

    assert_true(has_bridge_mapping(test_brid));
    assert_equals(get_bridge_contract(test_brid, test_network), "bridge_contract2");
    assert_equals(get_validator_contract(test_brid, test_network), "validator_contract2");

    // Delete mapping
    rell.test.tx().op(
            bridge_mapping_message_op(
                bridge_mapping_message(
                    blockchain_rid = test_brid,
                    validator_contract = "validator_contract2",
                    bridge_contract = "bridge_contract2",
                    evm_network_id = test_network,
                    deleted = true
                )
            )
        ).run();

    assert_false(has_bridge_mapping(test_brid));
}
