import ^.*;

val signer_list_update_topic = "L_signer_list_update";

struct signer_list_update_message {
    serial: integer;
    blockchain_rid: byte_array;
    signers: byte_array;
    confirmed_in_directory_at_height: integer;
}

enum signer_list_update_status {
    QUEUED,
    PENDING,
    COMPLETED,
    CANCELLED,
    FAILED
}

entity signer_list_update {
    serial: integer;
    index blockchain_rid: byte_array;
    signers: byte_array;
    confirmed_in_directory_at_height: integer;
    index mutable status: signer_list_update_status = signer_list_update_status.QUEUED;
}

entity parked_directory_signer_list_update {
    serial: integer;
    signers: byte_array;
    confirmed_in_directory_at_height: integer;
}

entity signer_list_update_transaction {
    key evm_submit_transaction, signer_list_update;
}

entity latest_signer_update_for_unmapped_chain {
    key blockchain_rid: byte_array;
    mutable signer_list_update_message: byte_array;
}

struct signer_list_update_data {
    rowid: integer;
    serial: integer;
    blockchain_rid: byte_array;
    signers: byte_array;
    confirmed_in_directory_at_height: integer;
}

struct signer_list_update_txs_data {
    status: signer_list_update_status;
    transactions: list<evm_submit_transaction_data>;
}

operation __enqueue_signer_update_transaction(
    update_id: integer,
    update_event: byte_array,
    block_header_data: byte_array,
    signatures: list<byte_array>,
    signers: list<byte_array>,
    extra_header_proof: byte_array,
    proof: byte_array
) {
    enqueue_signer_update_transaction_impl(
        update_id,
        update_event,
        block_header_data,
        signatures,
        signers,
        extra_header_proof,
        proof
    );
}

function enqueue_signer_update_transaction_impl(
    update_id: integer,
    update_event: byte_array,
    block_header_data: byte_array,
    signatures: list<byte_array>,
    signers: list<byte_array>,
    extra_header_proof: byte_array,
    proof: byte_array
) {
    val signer_list_update = signer_list_update @ { .rowid == rowid(update_id) };

    val contracts = get_validator_contracts(signer_list_update.blockchain_rid);

    for (contract in contracts) {
        val transaction = add_transaction_to_queue(
            contract.validator_contract,
            "updateValidators",
            ["bytes", "bytes", "bytes[]", "address[]", "bytes", "bytes"],
            [
                update_event.to_gtv(),
                block_header_data.to_gtv(),
                signatures.to_gtv(),
                signers.to_gtv(),
                extra_header_proof.to_gtv(),
                proof.to_gtv()
            ],
            contract.network_id,
            get_system_max_priority_fee_per_gas(),
            get_system_max_fee_per_gas(),
            sender = chain_context.blockchain_rid,
            payer_chain = signer_list_update.blockchain_rid,
        );

        create signer_list_update_transaction ( transaction, signer_list_update );

        log(
            "Submitting signer update tx for blockchain %s on network %s.".format(
                signer_list_update.blockchain_rid,
                contract.network_id
            )
        );
    }

    signer_list_update.status = signer_list_update_status.PENDING;
}

query get_queued_signer_updates() = signer_list_update @* { .status == signer_list_update_status.QUEUED } ( 
    signer_list_update_data (
        rowid = .rowid.to_integer(),
        serial = .serial,
        blockchain_rid = .blockchain_rid,
        signers = .signers,
        confirmed_in_directory_at_height = .confirmed_in_directory_at_height
    ) 
);

query get_current_evm_signer_list(blockchain_rid: byte_array): list<byte_array> {
    val latest_confirmed_signers = current_evm_signer_list(blockchain_rid);
    return if (latest_confirmed_signers != null)
        list<byte_array>.from_gtv(gtv.from_bytes(latest_confirmed_signers))
    else [];
}

query is_chain_updatable_at_height(blockchain_rid: byte_array, update_height: integer) {
    val directory_chain_rid = get_directory_chain_blockchain_rid();
    if (blockchain_rid == directory_chain_rid) {
        return if (exists(current_evm_signer_list(blockchain_rid)))
            (
                signer_list_update @* {
                    .blockchain_rid != directory_chain_rid and
                    .status in [signer_list_update_status.QUEUED, signer_list_update_status.PENDING] and
                    .confirmed_in_directory_at_height <= update_height
                }
            ).empty() else true;
    } else {
        val latest_update = signer_list_update @? { .blockchain_rid == directory_chain_rid }
            ( @omit @sort_desc .rowid, $ ) limit 1;
        return if (exists(current_evm_signer_list(directory_chain_rid)))
            latest_update == null or
            latest_update.status == signer_list_update_status.COMPLETED or
            latest_update.confirmed_in_directory_at_height >= update_height
        else false;
    }
}

// Query for triggering alarm, monitor any blockchain of interest
query latest_signer_list_update_status(blockchain_rid: byte_array): signer_list_update_status? {
    return signer_list_update @? { blockchain_rid } ( @omit @sort_desc .rowid, .status ) limit 1;
}

// Use for debugging and information for re-submission
query latest_signer_list_update_txs(blockchain_rid: byte_array): signer_list_update_txs_data? {
    val latest_update = signer_list_update @? { blockchain_rid } ( @omit @sort_desc .rowid, $ ) limit 1;
    if (latest_update == null) return null;

    return signer_list_update_txs_data(
        status = latest_update.status,
        transactions = signer_list_update_transaction @* { .signer_list_update == latest_update } (
            evm_submit_transaction_data (
                row_id = .evm_submit_transaction.rowid.to_integer(),
                contract_address = .evm_submit_transaction.contract_address,
                function_name = .evm_submit_transaction.function_name,
                parameter_types = .evm_submit_transaction.parameter_types.split("."),
                parameter_values = list<gtv>.from_gtv(gtv.from_bytes(.evm_submit_transaction.parameter_values)),
                network_id = .evm_submit_transaction.network_id,
                max_priority_fee_per_gas = .evm_submit_transaction.max_priority_fee_per_gas,
                max_fee_per_gas = .evm_submit_transaction.max_fee_per_gas,
                sender = .evm_submit_transaction.sender,
                status = .evm_submit_transaction.status,
                created = .evm_submit_transaction.created,
                tx_hash = .evm_submit_transaction.tx_hash,
                processed_by = .evm_submit_transaction.processed_by
            )
        )
    );
}

function current_evm_signer_list(
    blockchain_rid: byte_array
) = signer_list_update @? { 
    .blockchain_rid == blockchain_rid and .status == signer_list_update_status.COMPLETED 
} ( 
    @omit @sort_desc .rowid,
    .signers 
) limit 1;

@extend(receive_icmf_message)
function handle_signer_update_message(sender: byte_array, topic: text, body: gtv) {
    if (topic == signer_list_update_topic) {
        val update_message = signer_list_update_message.from_gtv(body);

        val is_directory_chain = is_directory_chain(update_message.blockchain_rid);
        if (not is_directory_chain and
        not has_bridge_mapping(update_message.blockchain_rid) and
            not is_system_anchoring_chain(update_message.blockchain_rid)
        ) {
            handle_unmapped_blockchain_signer_update(body.to_bytes(), update_message);
            return;
        }

        // Any queued update is pointless now, we may cancel it. The exception is directory chain updates since those are validated by directory contract itself
        // TODO: If we implement https://chromaway.atlassian.net/browse/POS-1167 we may even be able to cancel txs that have been taken from queue
        if (not is_directory_chain) {
            val queued_update = signer_list_update @? {
                .blockchain_rid == update_message.blockchain_rid,
                .status == signer_list_update_status.QUEUED
            };
            if (queued_update != null) {
                queued_update.status = signer_list_update_status.CANCELLED;
            }
        } else {
            // If latest directory chain update is not completed we need to park this update
            // Unless it was at the same height, then we can just cancel it
            val latest_directory_update = signer_list_update @? { .blockchain_rid == update_message.blockchain_rid } (@omit @sort_desc .rowid, $) limit 1;
            if (latest_directory_update != null) {
                if (latest_directory_update.confirmed_in_directory_at_height == update_message.confirmed_in_directory_at_height) {
                    latest_directory_update.status = signer_list_update_status.CANCELLED;
                } else if (latest_directory_update.status != signer_list_update_status.COMPLETED) {
                    create parked_directory_signer_list_update (
                        serial = update_message.serial,
                        signers = update_message.signers,
                        confirmed_in_directory_at_height = update_message.confirmed_in_directory_at_height
                    );
                    return;
                }
            }
        }

        apply_signer_update(update_message);
    }
}

function handle_unmapped_blockchain_signer_update(raw_message: byte_array, update_message: signer_list_update_message) {
    val latest_update = latest_signer_update_for_unmapped_chain @? { .blockchain_rid == update_message.blockchain_rid };
    if (exists(latest_update)) {
        latest_update.signer_list_update_message = raw_message;
    } else {
        create latest_signer_update_for_unmapped_chain(
            blockchain_rid = update_message.blockchain_rid,
            signer_list_update_message = raw_message
        );
    }
}

@extend(receive_icmf_message)
function handle_bridge_mapping_updates(
    sender: byte_array,
    topic: text,
    body: gtv
) {
    if (topic == bridge_mapping_topic) {
        val bridge_mapping_message = bridge_mapping_message.from_gtv(body);

        if (not bridge_mapping_message.deleted) {
            handle_new_validator_contract(
                bridge_mapping_message.blockchain_rid,
                bridge_mapping_message.evm_network_id,
                bridge_mapping_message.validator_contract
            );
        }
    }
}

@extend(on_configuration_update)
function check_for_new_system_bridges_and_validators() {
    // Directory chain validators
    val directory_chain_brid = get_directory_chain_blockchain_rid();
    val directory_chain_validator_contracts = get_system_chain_validator_contracts(directory_chain_brid)
    ?: list<(validator_contract: text, network_id: integer)>();
    for (validator in directory_chain_validator_contracts) {
        handle_new_validator_contract(directory_chain_brid, validator.network_id, validator.validator_contract);
    }

    // System chain bridges
    for (system_chain in get_system_chains_with_bridges()) {
        for (bridge_contract in system_chain.bridge_contracts) {
            handle_new_validator_contract(
                system_chain.blockchain_rid,
                bridge_contract.network_id,
                bridge_contract.validator_contract
            );
        }
    }
}

function handle_new_validator_contract(blockchain_rid: byte_array, network_id: integer, validator_contract: text) {
    val latest_ignored_signer_update = latest_signer_update_for_unmapped_chain @? {
        .blockchain_rid == blockchain_rid
    }.signer_list_update_message;
    val latest_signer_update = signer_list_update @? {
        .blockchain_rid == blockchain_rid
    } (@omit @sort_desc .serial, $) limit 1;
    if (exists(latest_ignored_signer_update) and exists(latest_signer_update)) {
        // Check if we should submit ignored update
        val latest_ignored_signer_update_message = signer_list_update_message.from_gtv(gtv.from_bytes(latest_ignored_signer_update));
        if (latest_ignored_signer_update_message.serial > latest_signer_update.serial) {
            apply_signer_update(latest_ignored_signer_update_message);
        } else {
            check_and_resubmit_latest_update_if_needed(network_id, validator_contract, latest_signer_update);
        }
    } else if (exists(latest_ignored_signer_update)) {
        val latest_ignored_signer_update_message = signer_list_update_message.from_gtv(gtv.from_bytes(latest_ignored_signer_update));
        apply_signer_update(latest_ignored_signer_update_message);
    } else if (exists(latest_signer_update)) {
        check_and_resubmit_latest_update_if_needed(network_id, validator_contract, latest_signer_update);
    }
}

function check_and_resubmit_latest_update_if_needed(network_id: integer, validator_contract: text, signer_list_update) {
    if (signer_list_update.status != signer_list_update_status.QUEUED) {
        val transactions = signer_list_update_transaction @* { signer_list_update }.evm_submit_transaction;
        for (transaction in transactions) {
            if (transaction.contract_address == validator_contract and transaction.network_id == network_id) {
                return;
            }
        }

        // Resubmission is necessary, just copy any of the old txs
        if (empty(transactions)) {
            // Weird, but ok, let's just queue it again then
            signer_list_update.status = signer_list_update_status.QUEUED;
        } else {
            val old_transaction = transactions[0];

            val new_transaction = add_transaction_to_queue(
                validator_contract,
                old_transaction.function_name,
                old_transaction.parameter_types.split("."),
                list<gtv>.from_gtv(gtv.from_bytes(old_transaction.parameter_values)),
                network_id,
                get_system_max_priority_fee_per_gas(),
                get_system_max_fee_per_gas(),
                chain_context.blockchain_rid
            );

            create signer_list_update_transaction ( new_transaction, signer_list_update );

            log(
                "Submitting signer update tx for blockchain %s on network %s.".format(
                    signer_list_update.blockchain_rid,
                    network_id
                )
            );
        }
    }
}

function apply_signer_update(signer_list_update_message) {
    create signer_list_update (
        serial = signer_list_update_message.serial,
        blockchain_rid = signer_list_update_message.blockchain_rid,
        signers = signer_list_update_message.signers,
        confirmed_in_directory_at_height = signer_list_update_message.confirmed_in_directory_at_height
    );
}

@extend(on_transaction_completed)
function handle_completed_signer_transaction(
    transaction: evm_submit_transaction,
    status: transaction_status
) {
    val signer_list_update_tx = signer_list_update_transaction @? { .evm_submit_transaction == transaction };
    if (signer_list_update_tx == null) return;

    val signer_list_update = signer_list_update_tx.signer_list_update;

    if (status == transaction_status.SUCCESS) {
        log(
            "Signer update for blockchain %s was successful on network %s.".format(
                signer_list_update.blockchain_rid,
                transaction.network_id
            )
        );

        if ((signer_list_update_transaction @* {
            signer_list_update,
            .evm_submit_transaction != transaction,
            .evm_submit_transaction.status != transaction_status.SUCCESS
        }).empty()) {
            // Now completed on all networks
            signer_list_update.status = signer_list_update_status.COMPLETED;

            dequeue_parked_update(signer_list_update.blockchain_rid);
        }
    } else {
        log(
            "Signer update for blockchain %s failed on network %s. Please submit manually.".format(
                signer_list_update.blockchain_rid,
                transaction.network_id
            )
        );
        // This may only be failed on one network, user will have to figure out which one that needs manual intervention
        // with the help of latest_signer_list_update_txs query
        // Steps would be:
        // 1. Update contract(s) on EVM
        // 2. For dApp chains: Confirm that signers have been updated via update_bridge_lease in EC (optional, will silence alarm)
        //    For directory chain: Confirm that signers have been updated via manually_resolve_failed_signer_update (required)
        signer_list_update.status = signer_list_update_status.FAILED;
    }
}

operation manually_resolve_failed_signer_update(blockchain_rid: byte_array) {
    val manual_admins = get_manual_admins();
    val signers = op_context.get_signers();
    require(not signers.empty(), "No signers");
    for (signer in signers) {
        require(signer in manual_admins, "Signer is not a manual admin");
    }

    val latest_update = signer_list_update @? { blockchain_rid } ( @omit @sort_desc .rowid, $ ) limit 1;
    require(latest_update, "Blockchain does not have any updates");
    require(latest_update.status == signer_list_update_status.FAILED, "Latest update for blockchain is not failed");

    dequeue_parked_update(blockchain_rid);

    latest_update.status = signer_list_update_status.COMPLETED;
}

function dequeue_parked_update(blockchain_rid: byte_array) {
    if (is_directory_chain(blockchain_rid)) {
        val next_update = parked_directory_signer_list_update @? {} limit 1;
        if (next_update != null) {
            create signer_list_update (
                serial = next_update.serial,
                blockchain_rid = blockchain_rid,
                signers = next_update.signers,
                confirmed_in_directory_at_height = next_update.confirmed_in_directory_at_height
            );
            delete next_update;
        }
    }
}
