/**
  * A transaction processed by the transaction submitter.
  */
entity evm_submit_transaction {
    key id: byte_array;
    contract_address: text;
    function_name: text;
    parameter_types: text;
    parameter_values: byte_array;
    network_id: integer;
    currency_symbol: text;
    max_priority_fee_per_gas: big_integer;
    max_fee_per_gas: big_integer;
    sender: byte_array;
    index mutable status: transaction_status;
    index created: timestamp;
    index mutable taken_timestamp: timestamp;
    mutable block_hash: text = "";
    mutable effective_gas_price: big_integer = -1;
    mutable gas_usage: big_integer = -1;
    mutable tx_hash: text = "";

    /** Pubkey of node that is currently submitting or has been submitting the transaction to evm */
    mutable processed_by: pubkey = x"";

    /** The chain to be charged and pay for the transaction  */
    payer_chain: pubkey = x"";
}

entity evm_submit_transaction_taken_by {
    key transaction: evm_submit_transaction, provider: pubkey;
}

struct evm_submit_transaction_data {
    row_id: integer;
    contract_address: text;
    function_name: text;
    parameter_types: list<text>;
    parameter_values: list<gtv>;
    network_id: integer;
    max_priority_fee_per_gas: big_integer;
    max_fee_per_gas: big_integer;
    sender: byte_array;
    status: transaction_status;
    created: timestamp;
    tx_hash: text? = null;
    processed_by: pubkey;
}

enum transaction_status {

    /** Transaction available for a node to submit it. The transaction is either a new transaction or a failed transaction which has is retried. */
    QUEUED,

    /** Transaction taken by a node to submit it */
    TAKEN,

    /** A transaction was submitted successfully and now awaits verification */
    PENDING,

    /** The transaction is successfully submitted and confirmed on EVM */
    SUCCESS,

    /** Transaction failed either due to timeout, failing rpc connection or rejected by EVM */
    FAILURE
}

/** Strategies available for submitting transaction retries */
enum node_retry_strategy {
    /** If necessary let all nodes try submitting the transaction before failing it */
    ALL,

    /** Let a super majority retry submitting the transaction before failing it */
    SUPERMAJORITY
}

struct module_args {
    /** List of system chain bridges, se README.md for more details */
    system_chain_bridges: gtv;

    /** Directory chain rid and validator contracts, se README.md for more details */
    directory_chain_config: gtv;

    /** System anchoring blockchain rid and validator contracts, se README.md for more details */
    system_anchoring_chain_config: gtv?;

    /** Rate limit for transaction submission (applied per contract) */
    contract_tx_rate_limit: big_integer;

    /** How much time each node has to submit the transaction */
    tx_node_submit_timeout: big_integer;

    /** How much time to spend on verification before the attempt is aborted. Based on the time a transaction was TAKEN */
    tx_verification_timeout: big_integer;

    /** Time out for a transaction to be submitted and verified by all nodes in milliseconds, if this deadline is passed the transaction is considered to have failed */
    tx_timeout: big_integer;

    /** Strategy for how many nodes that should retry a transaction before considering it to have failed */
    node_retry_strategy;

    /** Mapping of native currency for each network `id` to `currency_symbol` */
    network_configs: gtv = list<network_config>().to_gtv();

    /** Public keys for manual admins used to reset failed signer updates */
    manual_admins: gtv;

    /** Max priority fee to use for system transactions */
    system_max_priority_fee_per_gas: integer;

    /** Max gas to use for system transactions */
    system_max_fee_per_gas: integer;
}

struct network_config {
    id: integer;
    currency_symbol: text;
}



