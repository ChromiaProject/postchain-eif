struct bridge_anomaly_detector_data {
    blockchain_rid: byte_array;
    evm_network_id: integer;
    bridge_contract: text;
}

struct blockchain_bridge_data {
    /** The bridge blockchain */
    blockchain_rid: byte_array;

    /** EVM network id */
    network_id: integer;

    /** EMV bridge contract address */
    bridge_address: text;

    /** EVM validator contract address */
    validator_address: text;
}

query get_transaction_status(evm_transaction_id: byte_array) =
    evm_submit_transaction @? { .id == evm_transaction_id }.status;

query get_transaction_status_by_transaction_data(contract_address: text, function_name: text, parameter_types: list<text>, parameter_values: list<gtv>, network_id: integer): transaction_status? {
    val evm_transaction_id = get_evm_transaction_id(contract_address, function_name, parameter_types, parameter_values, network_id);
    return get_transaction_status(evm_transaction_id);
}

struct transaction_reciept_data {
    block_hash: text;
    effective_gas_price: big_integer;
    gas_usage: big_integer;
}

query get_transaction_receipt_data(evm_transaction_id: byte_array): transaction_reciept_data {
    val evm_transaction = require_transaction(evm_transaction_id);

    require(evm_transaction.status == transaction_status.SUCCESS, "Receipt data is not available for transaction since it has status %s".format(evm_transaction.status));

    return transaction_reciept_data(
        block_hash = evm_transaction.block_hash,
        effective_gas_price = evm_transaction.effective_gas_price,
        gas_usage = evm_transaction.gas_usage
    );
}

query get_transaction_receipt_data_by_transaction_data(contract_address: text, function_name: text, parameter_types: list<text>, parameter_values: list<gtv>, network_id: integer): transaction_reciept_data {
    val evm_transaction_id = get_evm_transaction_id(contract_address, function_name, parameter_types, parameter_values, network_id);
    return get_transaction_receipt_data(evm_transaction_id);
}

function require_transaction(evm_transaction_id: byte_array): evm_submit_transaction {

    return require(evm_submit_transaction @? { .id == evm_transaction_id }, "Unknown transaction");
}

query get_blockchains_with_bridge_and_anomaly_detection() = blockchain_bridge_contract @* { } (
    bridge_anomaly_detector_data(
        blockchain_rid = .blockchain_rid,
        evm_network_id = .network_id,
        bridge_contract = .address
    )
);

/**
 * Return all existing bridges.
 *
 * @param include_system_bridges Include or exclude system bridges.
 */
query get_all_bridges(include_system_bridges: boolean = true) {
    val bridges = blockchain_bridge_contract @* {} (blockchain_bridge_data(
        .blockchain_rid,
        .network_id,
        bridge_address = .address,
        validator_address = .validator_contract,
    ));
    if (include_system_bridges) {
        val system_bridges = get_system_chains_with_bridges();
        for (system_bridge in system_bridges) {
            for (sbc in system_bridge.bridge_contracts) {
                bridges.add(blockchain_bridge_data(
                    system_bridge.blockchain_rid,
                    sbc.network_id,
                    bridge_address = sbc.address,
                    validator_address = sbc.validator_contract
                ));
            }
        }
    }
    return bridges;
}
