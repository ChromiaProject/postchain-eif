@mount("eif.snapshots")
module;

/**
 * A state slot is a leaf in the state snapshot Merkle tree.
 * The state slot's id represents its position in the Merkle tree.
 * Each state slot is associated with a single account and recipient address.
 * One account may use multiple state slots corresponding to different protocols, 
 * bridge contracts, networks, etc.
 * 
 * The state associated with the state slot contains information which facilitates 
 * withdrawal in "mass exit" scenarios. For example, for ERC20 tokens, the state 
 * contains a list of (token address,  balance) pairs. When mass exit is triggered,
 * users will be able to withdraw their tokens according to the state snapshot.
 * 
 * A state record associated with a state slot also include a header which disambiguates
 * different contracts, protocols, networks, etc. It also includes a recipient address.
 */

import lib.iccf;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.accounts.strategies;
    import lib.ft4.assets;
    import lib.ft4.crosschain;
    import lib.ft4.auth;
    import lib.ft4.utils;
    import transfer_strategy: lib.ft4.accounts.strategies.transfer;
}

// Hexadecimal representation of the "hbridge:erc20:v1" string followed by 16x 0x01 bytes, 32 bytes in total.
val ERC20_STATE_TAG = x"686272696467653a65726332303a763101010101010101010101010101010101";

enum state_slot_type {    
    erc20,
    // temporary state which facilitates withdrawals which are pending at the time of mass exit
    erc20_withdrawal,
    erc721
}

entity state_slot {
    key id: integer;
    network_id: integer;
    recipient_address: byte_array;
    type: state_slot_type;
    local: boolean;
    discriminator: big_integer; // binds slot to a specific (v1) network, or (v2) network and bridge contract address
    index network_id, recipient_address, type, local;
}

entity erc20_asset_snapshots_enabled {
    key erc20_asset;
    key ft4.assets.asset; // only one erc20 asset can be linked to ft4 asset when snapshots are enabled
}

function enable_erc20_asset_snapshots(erc20_asset) {
    create erc20_asset_snapshots_enabled(erc20_asset.asset, erc20_asset);
}

/**
 * This entity is used to track the relationship between accounts, ERC20 tokens,
 * and their corresponding state slots in the Merkle tree.
 *
 * The balance for this binding is not stored directly in this entity,
 * but can be retrieved as needed from the FT4 account's balance for the given ERC20 asset.
 */
entity local_erc20_state_slot_binding {
    key ft4.accounts.account, erc20_asset; // only one slot per account per token
    index state_slot; // slot might collect info from multiple assets
}

function get_next_state_slot_id(): integer {
    val last_slot_id = state_slot @? { } (@sort_desc .id) limit 1;
    if (exists(last_slot_id)) {
        return last_slot_id + 1;
    } else {
        return 0;
    }
}

function get_local_erc20_state_slot(ft4.accounts.account, erc20_asset): state_slot? {
    return local_erc20_state_slot_binding @? { account, erc20_asset } .state_slot;
}

function get_or_create_local_erc20_state_slot(ft4.accounts.account, erc20_asset): state_slot? {
    val network_id = erc20_asset.network_id;

    val account_address = find_address_for_ft4_account(account, network_id);
    if (empty(account_address)) return null;

    val bound_slot = local_erc20_state_slot_binding @? { account, erc20_asset } .state_slot;
    if (exists(bound_slot)) return bound_slot;

    var existing_slot = state_slot @? { network_id, account_address, state_slot_type.erc20, .local == true };

    if (empty(existing_slot)) {
        existing_slot = create state_slot (
            id = get_next_state_slot_id(),
            network_id = network_id,
            recipient_address = account_address,
            type = state_slot_type.erc20,
            discriminator = build_discriminator(erc20_asset),
            local = true
        );
    }

    create local_erc20_state_slot_binding (account, erc20_asset, existing_slot);

    return existing_slot;
}

struct state_data {
    state_n: integer;
    account: list<gtv>;
}

struct balance_record {
    token_address: byte_array;
    balance: big_integer;
}

function emit_erc20_state_eif_event(state_slot, balance_records: list<balance_record>) {
    if (empty(balance_records)) {
        // erase state slot when there are no balances
        op_context.emit_event(
            "eif_state",
            state_data(state_slot.id, list<gtv>()).to_gtv()
        );
        return;
    }

    val state_slot_data = state_slot.to_struct();
    val state_parts = list<gtv>();
    state_parts.add(ERC20_STATE_TAG.to_gtv());
    state_parts.add(utils.evm_address_to_32_byte_array(state_slot_data.recipient_address).to_gtv());
    state_parts.add(state_slot_data.discriminator.to_gtv()); // discriminator includes (v1) network_id, or (v2) network_id and bridge_address

    for (balance_record in balance_records) {
        state_parts.add(utils.evm_address_to_32_byte_array(balance_record.token_address).to_gtv());
        state_parts.add(balance_record.balance.to_gtv());
    }
    
    op_context.emit_event(
        "eif_state",
        state_data(state_slot_data.id, state_parts).to_gtv()
    );
}

function emit_local_erc20_state_slot(state_slot) {
    val balance_records = list<balance_record>();

    // Note: there must be at least one record per state_slot, otherwise we don't know that slot is erc20_asset
    // @+ ensures there's at least one
    for (lss in local_erc20_state_slot_binding @+ { state_slot } (.account, erc20_asset = .erc20_asset.to_struct())) {
        val amount = ft4.assets.get_asset_balance(lss.account, lss.erc20_asset.asset);
        balance_records.add(balance_record(lss.erc20_asset.token_address, amount));
    }

    // Note: we must emit it even if there are no records! 
    // It's important to overwrite previous state with empty state to signal that the slot is empty
    emit_erc20_state_eif_event(state_slot, balance_records);
}

@extend(ft4.assets.after_transfer) function (from: ft4.accounts.account, to: ft4.accounts.account, ft4.assets.asset, amount: big_integer) {
    val erc20_asset = erc20_asset_snapshots_enabled @? { asset } .erc20_asset;
    if (exists(erc20_asset)) {
        val from_slot = get_local_erc20_state_slot(from, erc20_asset);
        if (exists(from_slot)) emit_local_erc20_state_slot(from_slot);

        val to_slot = get_or_create_local_erc20_state_slot(to, erc20_asset);
        if (exists(to_slot)) emit_local_erc20_state_slot(to_slot);
    }
}

@extend(ft4.assets.after_mint) function (ft4.accounts.account, ft4.assets.asset, amount: big_integer) {
    val erc20_asset = erc20_asset_snapshots_enabled @? { asset } .erc20_asset;
    if (exists(erc20_asset)) {
        val slot = get_or_create_local_erc20_state_slot(account, erc20_asset);
        if (exists(slot)) emit_local_erc20_state_slot(slot);
    }
}

@extend(ft4.assets.after_burn) function (ft4.accounts.account, ft4.assets.asset, amount: big_integer) {
    val erc20_asset = erc20_asset_snapshots_enabled @? { asset } .erc20_asset;
    if (exists(erc20_asset)) {
        val slot = get_local_erc20_state_slot(account, erc20_asset);
        if (exists(slot)) emit_local_erc20_state_slot(slot);
    }
}

@extend(after_evm_account_linked) function (address: byte_array, account: ft4.accounts.account, network_id: integer, is_contract: boolean) {
    if (address == find_address_for_ft4_account(account, network_id)) {
        val assets = (b: ft4.assets.balance, e: erc20_asset_snapshots_enabled) @* {
            b.account == account,
            b.asset == e.asset,
        } (.erc20_asset);
        for (asset in assets) {
            val slot = get_or_create_local_erc20_state_slot(account, asset);
            if (exists(slot)) emit_local_erc20_state_slot(slot);
        }
    }
}

function build_discriminator(erc20_asset): big_integer {
    if (chain_context.args.version == 1) {
        return network_discriminator(erc20_asset.network_id);
    }

    // Get primary bridge
    val primary_bridge = require(
        bridge_erc20_asset @? { erc20_asset } ( @omit @sort .rowid, .bridge_contract.contract_address ) limit 1,
        "Bridge address for ERC-20 token %s not found on network ID %d".format(erc20_asset.token_address, erc20_asset.network_id)
    );
    return network_contract_discriminator(erc20_asset.network_id, primary_bridge);
}

