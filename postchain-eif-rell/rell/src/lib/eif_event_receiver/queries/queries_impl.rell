function _create_evm_block_data(block: evm_block, prev_block: evm_block?): evm_block_data {
    return evm_block_data(
        network_id = block.network_id,
        block_height = block.evm_block_height,
        block_hash = block.evm_block_hash,
        prev_block_height = prev_block?.evm_block_height,
    );
}

function _get_prev_block(block: evm_block): evm_block? {
    return evm_block @? { .network_id == block.network_id, .evm_block_height < block.evm_block_height }
        (@omit @sort_desc .evm_block_height, $) limit 1;
}

function _get_evm_block_events(evm_block): list<evm_event_data> {
    return evm_event @* { evm_block } (
        @omit @sort .log_index,
        evm_event_data(
            tnx_hash = .tnx_hash,
            log_index = .log_index,
            event_signature = .event_signature,
            contract_address = .contract_address,
            name = .name,
            indexed_values = list<gtv>.from_gtv(gtv.from_bytes(.indexed_values)),
            non_indexed_values = list<gtv>.from_gtv(gtv.from_bytes(.non_indexed_values)),
        )
    );
}
