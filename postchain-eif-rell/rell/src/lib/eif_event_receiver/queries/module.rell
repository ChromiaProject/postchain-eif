module;

import ^.model.*;
import ^.pause.*;

query get_last_evm_block(network_id: integer) {
    return evm_block @? { network_id } ( @sort_desc .evm_block_height, .evm_block_hash ) limit 1;
}

query get_last_evm_event_height(network_id: integer, contract_address: byte_array): integer? =
    evm_event @? { network_id == .evm_block.network_id, contract_address } ( @sort_desc .evm_block.evm_block_height ) limit 1;

query get_last_evm_block_data(network_id: integer): evm_block_data? {
    val last_block = get_last_evm_block(network_id);
    if (empty(last_block)) return null;

    return get_evm_block_data(network_id, last_block[0]);
}

query get_last_evm_block_data_with_events(network_id: integer): (evm_block: evm_block_data, evm_events: list<evm_event_data>)? {
    val last_block = get_last_evm_block(network_id);
    if (empty(last_block)) return null;

    return get_evm_block_data_with_events(network_id, last_block[0]);
}

query get_evm_block_data(network_id: integer, height: integer): evm_block_data? {
    val block = evm_block @? { .network_id == network_id, .evm_block_height == height } limit 1;
    if (empty(block)) return null;

    return _create_evm_block_data(block, _get_prev_block(block));
}

query get_evm_block_data_with_events(network_id: integer, height: integer): (evm_block: evm_block_data, evm_events: list<evm_event_data>)? {
    val block = evm_block @? { .network_id == network_id, .evm_block_height == height } limit 1;
    if (empty(block)) return null;

    return (
        evm_block = _create_evm_block_data(block, _get_prev_block(block)),
        evm_events = _get_evm_block_events(block)
    );
}

query should_process_evm_events() = not eif_event_receiver_state.paused;
