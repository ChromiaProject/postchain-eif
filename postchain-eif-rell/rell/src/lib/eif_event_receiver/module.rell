module;

import lib.icmf;
import lib.eif.messaging;
import lib.eif.version;
import .model.*;
import .pause;
import .queries.*;

struct module_args {
    enable_icmf: boolean = true;
}

operation __evm_block(
    network_id: integer,
    evm_block_height: big_integer,
    evm_block_hash: byte_array,
    events: list<messaging.event_data>
) {
    _evm_block(network_id, evm_block_height.to_integer(), evm_block_hash, events);
}

function _evm_block(
    network_id: integer,
    evm_block_height: integer,
    evm_block_hash: byte_array,
    events: list<messaging.event_data>
) {
    var block = evm_block @? { network_id, evm_block_height, evm_block_hash };
    if (not exists(block)) {
        block = create evm_block (
            network_id,
            evm_block_height,
            evm_block_hash
        );
    } else {
        log("EVM block at height %d with hash %s for network %s already received".format(evm_block_height, evm_block_hash, network_id));
    }

    val relevant_events = list<messaging.event_data>();
    for (event in events) {
        create evm_event (
            evm_block = block,
            tnx_hash = event.tnx_hash,
            log_index = event.log_index.to_integer(),
            event_signature = event.signature,
            contract_address = event.contract_address,
            name = event.name,
            indexed_values = event.indexed_values.to_gtv().to_bytes(),
            non_indexed_values = event.non_indexed_values.to_gtv().to_bytes()
        );

        relevant_events.add(event);
    }

    val message = messaging.evm_block_message(
        network_id,
        evm_block_height,
        evm_block_hash,
        relevant_events
    );

    // local evm_block handler
    messaging.handle_evm_block(message);

    // icmf evm_block handler
    if (chain_context.args.enable_icmf) {
        icmf.send_message(messaging.evm_block_events_topic, message.to_gtv());
    }
}
