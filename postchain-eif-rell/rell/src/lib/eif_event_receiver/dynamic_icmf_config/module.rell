module;

import ^.*;
import ^.dynamic_config.*;
import ^.pause.*;
import lib.icmf.constants.*;
import lib.icmf.receiver.*;

val blockchain_rid_topic = ICMF_TOPIC_LOCAL_PREFIX + "blockchain_rid_topic";

struct blockchain_rid_message {
    rid: byte_array;
    name: text;
}

struct module_args {
    configuration_chain: text;
}

@extend(receive_icmf_message)
function eif_event_reciever_dynamic_config_message(sender: byte_array, topic: text, body: gtv) {

    when (topic) {
        dynamic_config_common.eif_event_receiver_dynamic_config_topic -> handle_dynamic_config_message(body);
        dynamic_config_common.eif_event_receiver_dynamic_config_topic_v2 -> handle_dynamic_config_message_v2(body);
        dynamic_config_common.eif_event_receiver_dynamic_remove_topic -> handle_dynamic_remove_message(body);
        dynamic_config_common.eif_event_receiver_pause_topic -> handle_pause_message(body);
        blockchain_rid_topic -> handle_blockchain_rid_message(body);
    }
}

function handle_dynamic_config_message(body: gtv) {
    val configs = map<integer, dynamic_config_common.eif_event_receiver_dynamic_config_message>.from_gtv(body);

    for ((network_id, config) in configs) {
        for (contract in config.contracts) {
            if (empty(contract_config @? { network_id, contract })) {
                create contract_config(network_id, contract);
            }
        }

        for (event in config.events) {
            val encoded_inputs = encode_inputs(event.inputs);
            if (empty(event_config @? { network_id, .name == event.name, .inputs == encoded_inputs })) {
                create event_config(network_id, name = event.name, inputs = encoded_inputs);
            }
        }
    }
}

function handle_dynamic_config_message_v2(body: gtv) {
    val configs = map<integer, dynamic_config_common.eif_event_receiver_dynamic_config_message_v2>.from_gtv(body);

    for ((network_id, config) in configs) {
        for (contract in config.contracts) {
            if (empty(contract_config @? { network_id, contract.address })) {
                create contract_config(network_id, contract.address, skip_to_height = contract.skip_to_height);
            }
        }

        for (event in config.events) {
            val encoded_inputs = encode_inputs(event.inputs);
            if (empty(event_config @? { network_id, .name == event.name, .inputs == encoded_inputs })) {
                create event_config(network_id, name = event.name, inputs = encoded_inputs);
            }
        }
    }
}

function handle_dynamic_remove_message(body: gtv) {
    val message = dynamic_config_common.eif_event_receiver_dynamic_remove_message.from_gtv(body);
    for (bridge in message.bridges) {
        delete contract_config @* { .network_id == bridge.network_id, .address == bridge.address };
    }
}

function handle_blockchain_rid_message(body: gtv) {

    val message = blockchain_rid_message.from_gtv(body);

    if (message.name == chain_context.args.configuration_chain) {
        receiver_icmf_update_topics(
            [
                icmf_receiver_topic(topic = dynamic_config_common.eif_event_receiver_dynamic_config_topic, bc_rid = message.rid),
                icmf_receiver_topic(topic = dynamic_config_common.eif_event_receiver_dynamic_config_topic_v2, bc_rid = message.rid),
                icmf_receiver_topic(topic = dynamic_config_common.eif_event_receiver_dynamic_remove_topic, bc_rid = message.rid),
                icmf_receiver_topic(topic = dynamic_config_common.eif_event_receiver_pause_topic, bc_rid = message.rid),
            ],
            false);
    }
}

function handle_pause_message(body: gtv) {
    val message = dynamic_config_common.pause_message.from_gtv(body);

    if (message.pause) {
        pause_event_receiver();
    } else {
        unpause_event_receiver();
    }
}
