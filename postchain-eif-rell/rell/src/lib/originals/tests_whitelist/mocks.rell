function define_empty_non_fungible_interface(name = "TestNonFungibleInterface", ft3_helper_tests.auth_data) {
    originals_external
        .def_original_interface(
            auth_data.auth_id,
            name,
            [:],
            [originals_core.chromia.INonFungibleOriginal.interface]
        )
        .sign(auth_data.keypair)
        .run();
        
    return name;
}

function define_empty_fungible_interface(name = "TestFungibleInterface", ft3_helper_tests.auth_data) {
    originals_external
        .def_original_interface(
            auth_data.auth_id,
            name,
            [:],
            [originals_core.chromia.IFungibleOriginal.interface]
        )
        .sign(auth_data.keypair)
        .run();
        
    return name;
}

function mint_non_fungible_original(ft3_helper_tests.auth_data, collection_name: text) {
    val interface_name = define_empty_non_fungible_interface(auth_data = auth_data);
    originals_external
        .mint_non_fungible_original(
            auth_data.auth_id,
            collection_name,
            originals_core.Minter.I(
                interface_name, 
                [
                    originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                    originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                    originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
                ]
            )
        )
        .sign(auth_data.keypair)
        .run();

    return originals_tests_helper.get_last();
}

