function test_account_cannot_define_interface_if_not_whitelisted() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);
    
    originals_external
        .def_original_interface(
            alice.auth_id,
            "TestInterface",
            [:],
            []
        )
        .sign(alice.keypair)
        .run_must_fail();
}

function test_whitelisted_account_can_define_interface() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);
    
    whitelist
        .whitelist_account(alice.auth_id.account_id)
        .sign(admin.keypair)
        .run();
    
    originals_external
        .def_original_interface(
            alice.auth_id,
            "TestInterface",
            [:],
            []
        )
        .sign(alice.keypair)
        .run();
}

function test_locked_account_cannot_define_interface() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);

    wl_helper.whitelist_accounts([alice], admin);
        
    whitelist
        .lock_account(alice.auth_id.account_id)
        .sign(admin.keypair)
        .run();
    
    originals_external
        .def_original_interface(
            alice.auth_id,
            "TestInterface",
            [:],
            []
        )
        .sign(alice.keypair)
        .run_must_fail();    
}

function test_whitelisted_account_can_mint_original_when_interface_owner() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);

    wl_helper.whitelist_accounts([alice], admin);
    val interface_name = define_empty_non_fungible_interface(auth_data = alice);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(alice, alice, admin);
        
    originals_external
        .mint_non_fungible_original(
            alice.auth_id,
            mock_collection.name,
            originals_core.Minter.I(
                interface_name, 
                [
                    originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                    originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(alice.auth_id.account_id),
                    originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
                ]
            )
        )
        .sign(alice.keypair)
        .run();
}

