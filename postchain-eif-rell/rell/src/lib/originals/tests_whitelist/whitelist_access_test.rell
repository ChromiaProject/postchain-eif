    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(alice, alice, admin);
        
    val interface_name_1 = define_empty_non_fungible_interface(
        name = "TestInterface1",
        auth_data = alice
    );
        
    val interface_name_2 = define_empty_non_fungible_interface(
        name = "TestInterface2",
        auth_data = bob
    );
        
    originals_external
        .def_original_prototype(
            alice.auth_id,
            interface_name_1, 
            [:],
            "TestPrototype"
        )
        .sign(alice.keypair)
        .run();    
        
    originals_external
        .mint_non_fungible_original(
            bob.auth_id,
            mock_collection.name,
            originals_core.Minter.I(
                interface_name = interface_name_2, 
                [
                    originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                    originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(bob.auth_id.account_id),
                    originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
                ],
                prototype_name = "TestPrototype"
            )
        )
        .sign(bob.keypair)
        .run_must_fail();        
}

