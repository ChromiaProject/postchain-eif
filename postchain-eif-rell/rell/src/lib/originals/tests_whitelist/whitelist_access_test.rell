                [
                    originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                    originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(alice.auth_id.account_id),
                    originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
                    originals_core.chromia.IFungibleOriginal.max_supply: dip_attributes.Integer.T(100)
                ]
            )
        )
        .sign(alice.keypair)
        .run();    
        
    val id = originals_tests_helper.get_last_id();
    
    originals_external
        .mint_fungible_original(
            bob.auth_id,
            id
        )
        .sign(bob.keypair)
        .run_must_fail();    
}

function test_whitelisted_account_can_mint_fungible_original_to_account_when_interface_owner() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();
    
    originals_tests_helper.init_originals(admin);

    wl_helper.whitelist_accounts([alice], admin);
    val interface_name = define_empty_fungible_interface(auth_data = alice);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(alice, alice, admin);
    
    originals_external
        .create_fungible_original(
            alice.auth_id,
            mock_collection.name,
            originals_core.Minter.I(
                interface_name, 
                [
                    originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                    originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(alice.auth_id.account_id),
                    originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
                    originals_core.chromia.IFungibleOriginal.max_supply: dip_attributes.Integer.T(100)
                ]
            )
        )
        .sign(alice.keypair)
        .run();    
        
    val id = originals_tests_helper.get_last_id();
    
    originals_external
        .mint_fungible_original_to_account(
            alice.auth_id,
            id,
            bob.auth_id.account_id
        )
        .sign(alice.keypair)
        .run();
}

function test_whitelisted_account_cannot_mint_fungible_original_to_account_when_not_interface_owner() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();
    val eve = ft3_helper_tests.register_eve();
    
    originals_tests_helper.init_originals(admin);

    wl_helper.whitelist_accounts([alice, bob], admin);
    val interface_name = define_empty_fungible_interface(auth_data = alice);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(alice, alice, admin);
    
    originals_external
        .create_fungible_original(
            alice.auth_id,
            mock_collection.name,
            originals_core.Minter.I(
                interface_name, 
                [
                    originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                    originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(alice.auth_id.account_id),
                    originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
                    originals_core.chromia.IFungibleOriginal.max_supply: dip_attributes.Integer.T(100)
                ]
            )
        )
        .sign(alice.keypair)
        .run();    
        
    val id = originals_tests_helper.get_last_id();
    
    originals_external
        .mint_fungible_original_to_account(
            bob.auth_id,
            id,
            eve.auth_id.account_id
        )
        .sign(bob.keypair)
        .run_must_fail();
}

function test_account_cannot_create_collection_if_not_whitelisted() {
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();

    val admin = ft3_helper_tests.register_admin();
    val mock_project = originals_tests_helper.create_mock_project(admin);
    collections_external.create_collection(
        alice.auth_id,
        "com.originals.WearablesCollection",
        "WC",
        "Wearables",
        "Empty description",
        originals_tests_mocks.mock_image,
        originals_tests_mocks.mock_image,
        bob.auth_id.account_id,
        mock_project.name
    )
        .sign(alice.keypair)
        .run_must_fail();
}

function test_locked_account_cannot_create_collection() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    whitelist
        .whitelist_account(alice.auth_id.account_id)
        .sign(admin.keypair)
        .run();

    whitelist
        .lock_account(alice.auth_id.account_id)
        .sign(admin.keypair)
        .run();
    
    val mock_project = originals_tests_helper.create_mock_project(admin);
    collections_external.create_collection(
        alice.auth_id,
        "com.originals.WearablesCollection",
        "WC",
        "Wearables",
        "Empty description",
        originals_tests_mocks.mock_image,
        originals_tests_mocks.mock_image,
        admin.auth_id.account_id,
        mock_project.name
    )
        .sign(alice.keypair)
        .run_must_fail();
}

function test_whitelisted_account_can_create_collection() {
    val alice = ft3_helper_tests.register_alice();
    val admin = ft3_helper_tests.register_admin();

    whitelist
        .whitelist_account(alice.auth_id.account_id)
        .sign(admin.keypair)
        .run();

    val mock_project = originals_tests_helper.create_mock_project(admin);

    collections_external.create_collection(
        alice.auth_id,
        "com.originals.WearablesCollection",
        "WC",
        "Wearables",
        "Empty description",
        originals_tests_mocks.mock_image,
        originals_tests_mocks.mock_image,
        admin.auth_id.account_id,
        mock_project.name
    )
        .sign(alice.keypair)
        .run();
}
