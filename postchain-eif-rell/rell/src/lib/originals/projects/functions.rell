function Project(name: text) = require(
    project @? { name },
    "Project with id '%s' not found".format(name)
);

function create_project(
    owner: utils.ft3_helper.ft3.acc.account,
    simple_project_props
) {
    val treasury = create utils.ft3_helper.ft3.acc.account(id = simple_project_props.name.hash());
    return create project(
        name = simple_project_props.name,
        name_lowercased = simple_project_props.name.lower_case(),
        display_name = simple_project_props.display_name,
        owner = owner,
        treasury = treasury,
        avatar = simple_project_props.avatar,
        background_image = simple_project_props.background_image,
        website = simple_project_props.website,
        description = simple_project_props.description
    );
}