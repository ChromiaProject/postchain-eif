entity project {
    key mutable name;
    key mutable name_lowercased: name;
    mutable display_name: text;
    mutable avatar: text;
    mutable background_image: text;
    owner: acc.account;
    key treasury: acc.account;
    mutable website: text;
    mutable description: text;
    created_at: timestamp = utils.now_from_context();
    mutable reports_count: integer = 0;
}

struct simple_project_props {
    name;
    display_name: text;
    avatar: text; 
    background_image: text; 
    website: text;
    description: text;
}

entity report_project {
    key project, account: acc.account;
    index account: acc.account;
    created_at: timestamp = originals_util.now_from_context();
}