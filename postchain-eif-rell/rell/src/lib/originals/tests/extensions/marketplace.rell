object marketplace_hooks_state {
    mutable called_before_create_settlement: boolean = false;
    mutable before_create_settlement_inputs: byte_array = x"";
    mutable called_after_create_settlement: boolean = false;
    mutable after_create_settlement_inputs: byte_array = x"";
    
    mutable called_before_delete_settlement: boolean = false;
    mutable before_delete_settlement_inputs: byte_array = x"";
    mutable called_after_delete_settlement: boolean = false;
    mutable after_delete_settlement_inputs: byte_array = x"";

    mutable called_before_settle: boolean = false;
    mutable before_settle_inputs: byte_array = x"";
    mutable called_after_settle: boolean = false;
    mutable after_settle_inputs: byte_array = x"";

    mutable called_before_bid: boolean = false;
    mutable before_bid_inputs: byte_array = x"";
    mutable called_after_bid: boolean = false;
    mutable after_bid_inputs: byte_array = x"";
 
    mutable called_before_close_auction: boolean = false;
    mutable before_close_auction_inputs: byte_array = x"";
    mutable called_after_close_auction: boolean = false;
    mutable after_close_auction_inputs: byte_array = x"";
}

@extend(marketplace_extensions.before_create_settlement) 
function before_create_settlement(
    maker_account: ft3_account.account,
    maker_descriptor_asset: ft3_core.asset,
    maker_descriptor_asset_type: originals_marketplace.Marketplace.asset_type,
    maker_descriptor_amount: integer,
    taker_descriptor_asset: ft3_core.asset,
    taker_descriptor_asset_type: originals_marketplace.Marketplace.asset_type,
    taker_descriptor_amount: integer,
    expiration: integer,
    salt: integer,
    originals_marketplace.Marketplace.settlement_type,
    maker_evm_signature: byte_array?
) {
    marketplace_hooks_state.called_before_create_settlement = true;
    marketplace_hooks_state.before_create_settlement_inputs = [
        maker_account.to_gtv(),
        maker_descriptor_asset.id.to_gtv(),
        maker_descriptor_asset_type.to_gtv(),
        maker_descriptor_amount.to_gtv(),
        taker_descriptor_asset.id.to_gtv(),
        taker_descriptor_asset_type.to_gtv(),
        taker_descriptor_amount.to_gtv(),
        expiration.to_gtv(),
        salt.to_gtv(),
        settlement_type.to_gtv(),
        maker_evm_signature?.to_gtv()
    ].to_gtv().to_bytes();
}

@extend(marketplace_extensions.after_create_settlement)
function after_create_settlement(
    originals_marketplace.Marketplace.settlement_descriptor
) {
    marketplace_hooks_state.called_after_create_settlement = true;
    marketplace_hooks_state.after_create_settlement_inputs = settlement_descriptor.to_gtv().to_bytes();
}

@extend(marketplace_extensions.before_delete_settlement)
function before_delete_settlement(
    originals_marketplace.Marketplace.settlement_descriptor
) {
    marketplace_hooks_state.called_before_delete_settlement = true;
    marketplace_hooks_state.before_delete_settlement_inputs = settlement_descriptor.to_gtv().to_bytes();
}

@extend(marketplace_extensions.after_delete_settlement)
function after_delete_settlement(
    settlement_id: byte_array
) {
    marketplace_hooks_state.called_after_delete_settlement = true;
    marketplace_hooks_state.after_delete_settlement_inputs = settlement_id.to_gtv().to_bytes();
}

@extend(marketplace_extensions.before_settle) 
function before_settle(
    taker_account: ft3_account.account,
    originals_marketplace.Marketplace.settlement_descriptor
) {
    marketplace_hooks_state.called_before_settle = true;
    marketplace_hooks_state.before_settle_inputs = [
        taker_account.to_gtv(),
        settlement_descriptor.to_gtv()
    ].to_gtv().to_bytes();
}

@extend(marketplace_extensions.after_settle)
function after_settle(
    taker_account: ft3_account.account,
    originals_marketplace.Marketplace.settlement_descriptor
) {
    marketplace_hooks_state.called_after_settle = true;
    marketplace_hooks_state.after_settle_inputs = [
        taker_account.to_gtv(),
        settlement_descriptor.to_gtv()
    ].to_gtv().to_bytes();
}

@extend(marketplace_extensions.before_bid) 
function before_bid(
    bidder_account: ft3_account.account,
    amount: integer,
    originals_marketplace.Marketplace.settlement_descriptor
) {
    marketplace_hooks_state.called_before_bid = true;
    marketplace_hooks_state.before_bid_inputs = [
        bidder_account.to_gtv(),
        amount.to_gtv(),
        settlement_descriptor.to_gtv()
    ].to_gtv().to_bytes();
}

@extend(marketplace_extensions.after_bid)
function after_bid(
    bidder_account: ft3_account.account,
    amount: integer,
    originals_marketplace.Marketplace.settlement_descriptor
) {
    marketplace_hooks_state.called_after_bid = true;
    marketplace_hooks_state.after_bid_inputs = [
        bidder_account.to_gtv(),
        amount.to_gtv(),
        settlement_descriptor.to_gtv()
    ].to_gtv().to_bytes();
}