}

// should mint and link directly at initiation
function test_mint_17() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    var interface = "ITestDapp";
    originals_external.def_original_interface(
        admin.auth_id,
        interface,
        [:],
        [originals_core.chromia.INonFungibleOriginal.interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    
    val prototype_def = "PrototypeName";
    originals_external.def_original_prototype(
        admin.auth_id,
        interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
        ],
        prototype_def
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    var interface_character = "ICharacter";
    val character_sword = dip_core.Attribute.def_I(interface_character, "sword");
    
    originals_external.def_original_interface(
        admin.auth_id,
        interface_character,
        [
            character_sword: dip_core.Type(dip_attributes.Instance.T(), [dip_core.Optional(), originals_core.OwnerMutable()])
        ],
        [interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    var interface_sword = "ISword";    
    originals_external.def_original_interface(
        admin.auth_id,
        interface_sword,
        [:],
        [interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    val sword_type = originals_core.Minter.I(
        interface_name = interface_sword,
        types = [:],
        prototype_name = prototype_def
    );
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        sword_type
    ).sign(admin.keypair).run();
    val sword_instance = get_last_instance();
    val sword_id = originals_core.Id.get_id(sword_instance);
    
    val character_type_fail = originals_core.Minter.I(
        interface_name = interface_character,
        types = [
          character_sword: dip_attributes.Instance.T(sword_instance)
        ],
        prototype_name = prototype_def
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type_fail
    ).sign(admin.keypair).run_must_fail();    
    
    val character_type = originals_core.Minter.I(
        interface_name = interface_character, 
        types = [
          character_sword: originals_core.Id.T(sword_id)
        ],
        prototype_name = prototype_def
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val character_instance = get_last_instance();
    val character_id = originals_core.Id.get_id(character_instance);
    
    assert_true(originals_core.Ownership.is_linked(sword_instance));
    assert_false(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, sword_id));
    assert_equals(originals_core.Ownership.get_base_instance(sword_instance), character_instance);
}

// should fail if interface depends on fungible original and has public/owner mutable attributes
function test_mint_18() {
    val admin = ft3_helper_tests.register_admin();
    originals_tests_helper.init_originals(admin);
    
    val interface = "ITestDapp";
    val id = dip_core.Attribute.I(interface, name = "id");
    val name = dip_core.Attribute.I(interface, name = "name");
    
    originals_external.def_original_interface(
        admin.auth_id,
        interface,
        [
            id: dip_core.Type(dip_attributes.Integer.T(), [dip_attributes.Mutable()]),
            name: dip_core.Type(dip_attributes.Text.T())
        ],
        [originals_core.chromia.IFungibleOriginal.interface]
    ).sign(ft3_helper_tests.admin_keypair()).run_must_fail();
    
    originals_external.def_original_interface(
        admin.auth_id,
        interface,
        [
            id: dip_core.Type(dip_attributes.Integer.T(), [originals_core.OwnerMutable()])
        ],
        [originals_core.chromia.IFungibleOriginal.interface]
    ).sign(ft3_helper_tests.admin_keypair()).run_must_fail();
    
    originals_external.def_original_interface(
        admin.auth_id,
        interface,
        [
            id: dip_core.Type(dip_attributes.Integer.T(), [originals_core.ApprovedMinterMutable()])
        ],
        [originals_core.chromia.IFungibleOriginal.interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();
}

function test_is_should_succeed_to_get_last_minted_original_id() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (mock_id, mock_instance) = originals_tests_helper.mint_mock_non_fungible_original(admin, mock_collection.name);
    val original_id = originals_external.get_last_minted_original_id();
    
    assert_equals(mock_id, mock_id);
}

function test_get_last_minted_original_id_q_should_retun_null_if_no_original_was_minted() {
    val admin = ft3_helper_tests.register_admin();
    originals_tests_helper.init_originals(admin);
        
    val original_id = originals_external.get_last_minted_original_id();

    assert_null(original_id);
}

function test_minted_non_fungible_original_has_asset_name_equal_to_name_attribute_of_prototype() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val prototype_def = "PrototypeName";
    var interface = "ITest";
    var original_name = "Test original name";

    originals_tests_helper.init_originals(admin);

    originals_external.def_original_interface(
        admin.auth_id,
        interface,
        [:],
        [originals_core.chromia.INonFungibleOriginal.interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();

    originals_external.def_original_prototype(
        admin.auth_id,
        interface,
        [
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T(original_name)
        ],
        prototype_def
    ).sign(ft3_helper_tests.admin_keypair()).run();

    val orig_type = originals_core.Minter.I(
        interface_name = interface,
        types = [:],
        prototype_name = prototype_def
    );    

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    originals_external.mint_non_fungible_original(admin.auth_id, mock_collection.name, orig_type).sign(admin.keypair).run();

    val (id, instance) = originals_tests_helper.get_last();
    val asset_name = (originals_util.Ft3Helper.get_asset(id)).name;
    assert_equals(asset_name, original_name);
}

