// should create fungible original unsafe
function test_mint_9() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    originals_external_dev.create_fungible_original_unsafe(
        admin.auth_id,
        mock_collection.name,
        originals_tests_helper.fungible_mockup(admin.auth_id.account_id),
        40
    ).sign(admin.keypair).run();
    
    var original_id = originals_tests_helper.get_last_id();
    assert_true(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, original_id));
    assert_equals(originals_util.Ft3Helper.get_asset_balance(admin.auth_id.account_id, original_id), 40);
}

// should create fungible original unsafe
// should mint further supply unsafe
function test_mint_10() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    originals_external_dev.create_fungible_original_unsafe(
        admin.auth_id,
        mock_collection.name,
        originals_tests_helper.fungible_mockup(admin.auth_id.account_id),
        40
    ).sign(admin.keypair).run();
    var original_id = originals_tests_helper.get_last_id();
    assert_true(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, original_id));
    assert_equals(originals_util.Ft3Helper.get_asset_balance(admin.auth_id.account_id, original_id), 40);
    
    originals_external_dev.mint_fungible_original_unsafe(
        admin.auth_id,
        original_id,
        20
    ).sign(admin.keypair).run();
    
    originals_external_dev.mint_fungible_original_unsafe(
        bob.auth_id,
        original_id,
        20
    ).sign(bob.keypair).run();
    
    assert_equals(originals_util.Ft3Helper.get_asset_balance(admin.auth_id.account_id, original_id), 60);
    assert_equals(originals_util.Ft3Helper.get_asset_balance(bob.auth_id.account_id, original_id), 20);
}

// should mint non fungible original to acccount
function test_mint_11() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    originals_external.mint_non_fungible_original_to_account(
        admin.auth_id,
        mock_collection.name,
        originals_tests_helper.non_fungible_mockup(admin.auth_id.account_id),
        bob.auth_id.account_id
    ).sign(admin.keypair).run();
    val id = originals_tests_helper.get_last_id();
    
    assert_true(originals_util.Ft3Helper.owns_original(bob.auth_id.account_id, id));
    assert_false(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, id));
}

// should mint fungible original to account
function test_mint_12() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    originals_external.create_fungible_original(
        admin.auth_id,
        mock_collection.name,
        originals_tests_helper.fungible_mockup(admin.auth_id.account_id, 150),
        100
    ).sign(admin.keypair).run();
    val id = originals_tests_helper.get_last_id();
    
    assert_equals(originals_core.Ownership.amount_owned_of_original(admin.auth_id.account_id, originals_core.Id.get_instance(id)), 100);
    
    originals_external.mint_fungible_original_to_account(
        admin.auth_id,
        id,
        bob.auth_id.account_id,
        50
    ).sign(admin.keypair).run();

    assert_equals(originals_core.Ownership.amount_owned_of_original(admin.auth_id.account_id, originals_core.Id.get_instance(id)), 100);
    assert_equals(originals_core.Ownership.amount_owned_of_original(bob.auth_id.account_id, originals_core.Id.get_instance(id)), 50);
}

// should mint non fungible original batches
function test_mint_13() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    originals_external.mint_non_fungible_original_batch(
        admin.auth_id,
        mock_collection.name,
        originals_tests_helper.non_fungible_mockup(admin.auth_id.account_id),
        5
    ).sign(admin.keypair).run();

    val result = originals_external.get_unlocked_originals_from_owner(admin.auth_id.account_id, originals_tests_mocks.default_cursor);
    
    assert_equals(result.data.size(), 5);
}

// should mint non fungible original to account in batches
function test_mint_14() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    originals_external.mint_non_fungible_original_to_account_batch(
        admin.auth_id,
        mock_collection.name,
        originals_tests_helper.non_fungible_mockup(admin.auth_id.account_id),
        bob.auth_id.account_id,
        5
    ).sign(admin.keypair).run();

    val admin_instances = originals_external.get_unlocked_originals_from_owner(admin.auth_id.account_id, originals_tests_mocks.default_cursor);
    val bob_instances = originals_external.get_unlocked_originals_from_owner(bob.auth_id.account_id, originals_tests_mocks.default_cursor);
    
    assert_equals(admin_instances.data.size(), 0);
    assert_equals(bob_instances.data.size(), 5);
}

