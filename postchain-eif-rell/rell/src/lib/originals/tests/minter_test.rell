    dip_external.def_prototype(
        admin.auth_id,
        originals_core.chromia.INonFungibleOriginal.interface,
        [
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(alice.auth_id.account_id)
        ],
        "TestPrototype"
    )
    .sign(admin.keypair)
    .run();

    val original = originals_core.Minter.I(
        interface_name = originals_core.chromia.INonFungibleOriginal.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Alice")
        ],
        prototype_name = "TestPrototype"
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        original
    )
    .sign(admin.keypair)
    .run_must_fail();
}

function test_minted_non_fungible_original_has_creator_id_equal_to_minter_id_if_creator_id_is_not_initialized() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val original = originals_core.Minter.I(
        interface_name = originals_core.chromia.INonFungibleOriginal.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Alice")
        ]
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        original
    )
    .sign(admin.keypair)
    .run();

    val instance = get_last_instance();
    assert_equals(
        admin.auth_id.account_id,
        dip_attributes.ByteArray.get_value(instance, originals_core.chromia.IOriginal.creator_id)
    );
}

function test_hooks_are_called_when_minting_non_fungible_original() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);    
    val (mock_id, mock_instance) = originals_tests_helper.mint_mock_non_fungible_original(admin, mock_collection.name);
    
    assert_true(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, mock_id));
        
    assert_equals(extensions.minter_hooks_state.is_after_mint_called, true);
    assert_equals(extensions.minter_hooks_state.after_mint_account_id, admin.auth_id.account_id);
    assert_equals(extensions.minter_hooks_state.after_mint_original_id, mock_id);
    assert_equals(extensions.minter_hooks_state.after_mint_quantity, 1);
}

function test_hooks_are_called_when_minting_fungible_original() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);    
    val (mock_id, mock_instance) = originals_tests_helper.mint_mock_fungible_original(admin, mock_collection.name, 100, 20);
        
    assert_equals(extensions.minter_hooks_state.is_after_mint_called, true);
    assert_equals(extensions.minter_hooks_state.after_mint_account_id, admin.auth_id.account_id);
    assert_equals(extensions.minter_hooks_state.after_mint_original_id, mock_id);
    assert_equals(extensions.minter_hooks_state.after_mint_quantity, 20);
}

