@test module;

import dip_core: ^^^.dip.core;
import originals_core: ^^.core;
import originals_external_dev: ^^.external.dev.dev_op;
import originals_external: ^^.external;
import originals_tests_helper: ^.helper;
import originals_tests_mocks: ^.mocks;
import collections_test_helper: ^.collections.helper;
import extensions: ^.extensions;
import dip_attributes: ^^^.dip.attributes;
import dip_external: ^^^.dip.external;
import ft3_helper_tests: ^^^.ft3_helper.tests;
import originals_util: ^^.util;
import ^^^.dip.tests.{get_last_instance};
import originals_tests_helper: ^.helper;


// should fail if original interface is not implemented
function test_mint_0() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    
    var interface = "ITest";
    dip_external.def_interface(
        admin.auth_id,
        interface, [:]
    ).sign(admin.keypair).run();
    
    val original = originals_core.Minter.I(
        interface_name = interface,
        types = [:]
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        original
    ).sign(admin.keypair).run_must_fail();
    
    originals_external.create_fungible_original(
        admin.auth_id,
        mock_collection.name,
        original, 
        1
    ).sign(admin.keypair).run_must_fail();
}

// should mint non fungible original
function test_mint_1() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (mock_id, mock_instance) = originals_tests_helper.mint_mock_non_fungible_original(admin, mock_collection.name);
    
    assert_true(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, mock_id));
}

// should mint non fungible original unsafe
function test_mint_2() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    originals_external_dev.mint_non_fungible_original_unsafe(
        admin.auth_id,
        mock_collection.name,
        originals_tests_helper.non_fungible_mockup(admin.auth_id.account_id)
    ).sign(admin.keypair).run();
    
    assert_true(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, originals_tests_helper.get_last_id()));
}

