function test_collection_owners_count_is_more_than_one() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_external.mint_non_fungible_original_to_account(
        admin.auth_id,
        mock_collection.name,
        collections_tests_helper.create_mock_original_definition(admin), 
        bob.auth_id.account_id
    )
        .sign(admin.keypair)
        .run();

    val (last_original_id, last_original_instance) = collections_tests_helper.originals_tests_helper.get_last();

    assert_equals(mock_collection.owners_count, 2);
}

function test_collection_nft_owner_more_than_one() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice(); 

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(alice);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(alice, alice, admin);
    val (original_id_one, original_instance_one) = collections_tests_helper.create_cow(alice, mock_collection.name);
    val (original_two_one, original_instance_two) = collections_tests_helper.create_cow(alice, mock_collection.name);

    val collection_nft_owner = collections_tests_helper.find_collection_nft_owner(mock_collection, alice);
    assert_equals(mock_collection.owners_count, 1);
    assert_equals(collection_nft_owner?.nfts_count, 2);
}

function test_find_collection_owners_count_and_nft_owner_count_when_original_is_transfered_without_selling() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    val collection_nft_owner_before_transfer = collections_tests_helper.find_collection_nft_owner(mock_collection, admin);

    assert_equals(collection_nft_owner_before_transfer?.to_struct(), struct<collections.collection_nft_owner>(
        collection = mock_collection,
        account = ft3_account.account @ { .id == admin.auth_id.account_id },
        nfts_count = 1
    ));
    assert_equals(mock_collection.owners_count, 1);

    originals_external.transfer_original(
        admin.auth_id,
        bertha_id,
        alice.auth_id.account_id
    )
        .sign(admin.keypair)
        .run();

    val collection_nft_owner_after_transfer = collections_tests_helper.find_collection_nft_owner(mock_collection, alice);

    assert_equals(collection_nft_owner_after_transfer?.to_struct(), struct<collections.collection_nft_owner>(
        collection = mock_collection,
        account = ft3_account.account @ { .id == alice.auth_id.account_id },
        nfts_count = 1
    ));
    assert_equals(mock_collection.owners_count, 1);
}

function test_collection_owners_count_is_set_to_zero_when_owner_has_no_more_originals() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(alice);
    collections_tests_helper.register_test_asset_and_mint_to_account(bob);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(alice, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(alice, mock_collection.name);

    originals_tests_helper.list_original(alice, bertha_id);

    val from_collection_nft_owner = collections_tests_helper.find_collection_nft_owner(mock_collection, alice);

    assert_equals(from_collection_nft_owner?.nfts_count, 1);

    val settlement_id = marketplace_external.Queries.derive_settlement_id(alice.auth_id.account_id, bertha_id, 123);
 
    marketplace_external.Operations.settle(
        bob.auth_id,
        settlement_id
    ).sign(bob.keypair).run();

    val to_collection_nft_owner = collections_tests_helper.find_collection_nft_owner(mock_collection, bob);

    assert_equals(from_collection_nft_owner?.nfts_count, 0);
    assert_equals(to_collection_nft_owner?.nfts_count, 1);
}

function test_find_highest_price_nft_in_collection_after_auction_completes() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
