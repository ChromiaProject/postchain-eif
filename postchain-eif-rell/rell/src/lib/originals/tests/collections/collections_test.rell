function test_it_should_find_collection_details_by_name() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    
    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    collections_external.add_social_url_to_collection(admin.auth_id, mock_collection.name, "twitter", "http://www.twitter.com")
        .sign(admin.keypair)
        .run();

    val found_collection = collections_external.find_collection_details_by_name(mock_collection.name);

    assert_equals(found_collection, (
        name = mock_collection.name,
        project = (
            id = mock_project.rowid,
            name = mock_project.name,
            avatar = mock_project.avatar
        ),
        author = bob.auth_id.account_id,
        display_name = mock_collection.display_name,
        description = mock_collection.description,
        owner = admin.auth_id.account_id,
        background_image = mock_collection.background_image,
        collection_avatar = mock_collection.collection_avatar,
        socials = [(
            name = "twitter",
            url = "http://www.twitter.com"
        )],
        nfts_count = 1,
        owners_count = mock_collection.owners_count,
        floor_price = 0,
        volume = 0,
        last_four_nfts = [(
            originals_core.Id.get_by_id(bertha_id)
        )]
    ));
}

