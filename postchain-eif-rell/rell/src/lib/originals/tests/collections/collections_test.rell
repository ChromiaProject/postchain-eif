function test_it_should_find_collection_trading_volume() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    collections_tests_helper.register_test_asset_and_mint_to_account(alice);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(admin, bertha_id);

    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);
 
    marketplace_external.Operations.settle(
        alice.auth_id,
        settlement_id
    ).sign(alice.keypair).run();

    val found_collection = collections_external.find_collection_details_by_name(mock_collection.name);

    assert_equals(found_collection?.volume, 100);
}

function test_it_should_find_collection_trading_volume_increased_after_auction_closed() {
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();
    val admin = ft3_helper_tests.register_admin();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(alice);
    collections_tests_helper.register_test_asset_and_mint_to_account(bob);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(alice, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(alice, mock_collection.name);

    marketplace_external.Operations.create_settlement(
        alice.auth_id,
        bertha_id,
           originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(collections_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        99,
        collections_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.auction,
        null
    )
        .sign(alice.keypair)
        .run();

    val collection_before_auction = collections_external.find_collection_details_by_name(mock_collection.name);
    
    assert_equals(collection_before_auction?.volume, 0);

    val settlement_id = marketplace_external.Queries.derive_settlement_id(alice.auth_id.account_id, bertha_id, 123);

    marketplace_external.Operations.bid(bob.auth_id, settlement_id, 100)
        .sign(bob.keypair)
        .run();

    marketplace_external.OperationsDev.close_auction(settlement_id, collections_tests_mocks.VALID_EXPIRATION + 1)
        .sign(alice.keypair)
        .run();

    val collection_after_auction = collections_external.find_collection_details_by_name(mock_collection.name);

    assert_equals(collection_after_auction?.volume, 100);
}

