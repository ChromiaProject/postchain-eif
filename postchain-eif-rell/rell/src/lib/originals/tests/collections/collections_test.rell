function test_collection_owners_count_after_offer_is_accepted() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    marketplace_test_utils.register_test_asset_and_mint_to_account(admin, alice);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    assert_equals(mock_collection.owners_count, 0);

    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    marketplace_test_utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);

    marketplace_external.Operations.accept_offer(admin.auth_id, bertha_id, alice.auth_id.account_id)
        .sign(admin.keypair)
        .run();

    assert_equals(mock_collection.owners_count, 1);
}

function test_collection_nft_owners_count_after_offer_is_accepted() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    marketplace_test_utils.register_test_asset_and_mint_to_account(admin, alice);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    val from_collection_nft_owner = collections_tests_helper.find_collection_nft_owner(mock_collection, admin);

    assert_equals(from_collection_nft_owner?.account?.id, admin.auth_id.account_id);
    assert_equals(from_collection_nft_owner?.nfts_count, 1);

    marketplace_test_utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);

    marketplace_external.Operations.accept_offer(admin.auth_id, bertha_id, alice.auth_id.account_id)
        .sign(admin.keypair)
        .run();

    assert_equals(from_collection_nft_owner?.nfts_count, 0);
    val to_collection_nft_owner = collections_tests_helper.find_collection_nft_owner(mock_collection, alice);

    assert_equals(to_collection_nft_owner?.account?.id, alice.auth_id.account_id);
    assert_equals(to_collection_nft_owner?.nfts_count, 1);
}

