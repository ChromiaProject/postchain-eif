    collections_external.add_approved_minter(admin.auth_id, alice.auth_id.account_id, mock_collection.name).sign(admin.keypair).run();
}

function test_add_approved_minter_fail_if_not_owner() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();
    
    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, admin, admin);
    
    val failure = collections_external.add_approved_minter(alice.auth_id, bob.auth_id.account_id, mock_collection.name).sign(alice.keypair).run_must_fail();
    assert_true(failure.message.contains("This action is reserved for collection owner. Collection '%s' is owned by '%s'".format(mock_collection.display_name, mock_collection.owner.id)));
}

function test_add_approved_minter_fail_if_already_exists() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, admin, admin);
    
    collections_external.add_approved_minter(admin.auth_id, alice.auth_id.account_id, mock_collection.name).sign(admin.keypair).run();
    val failure = NOP().op(collections_external.add_approved_minter(admin.auth_id, alice.auth_id.account_id, mock_collection.name)).sign(admin.keypair).run_must_fail();
    assert_true(failure.message.contains("Account is already an approved minter"));
}

function test_mint_fails_if_not_approved_user_or_collection_owner() {
    val admin = ft3_helper_tests.register_admin();
