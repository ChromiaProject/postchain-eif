function test_find_collection_details_by_name_returns_the_four_most_recent_originals_out_of_five() {
    val admin = ft3_helper_tests.register_admin();
    
    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, admin, admin);

    val (original_id_one, original_instance_one) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val (original_id_two, original_instance_two) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val (original_id_three, original_instance_three) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val (original_id_four, original_instance_four) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val (original_id_five, original_instance_five) = collections_tests_helper.create_cow(admin, mock_collection.name);

    val found_collection = collections_external.find_collection_details_by_name(mock_collection.name);
    assert_equals(found_collection?.last_four_nfts, [
        (
            originals_core.Id.get_by_id(original_id_five)
        ),
        (
            originals_core.Id.get_by_id(original_id_four)
        ),
        (
            originals_core.Id.get_by_id(original_id_three)
        ),
        (
            originals_core.Id.get_by_id(original_id_two)
        )
    ]);
}

