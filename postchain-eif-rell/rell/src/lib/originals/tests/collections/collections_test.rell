function test_appproved_minter_succeeds_mint_fungible_original() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, admin, admin);
    
    collections_external.add_approved_minter(admin.auth_id, alice.auth_id.account_id, mock_collection.name).sign(admin.keypair).run();
    
    val (fungible_id, _) = originals_tests_helper.mint_mock_fungible_original(
        alice,
        mock_collection.name,
        10,
        1
    );

    originals_external.mint_fungible_original(
        alice.auth_id,
        fungible_id
    ).sign(alice.keypair).run();
}

function test_appproved_minter_succeeds_mint_fungible_original_to_account() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, admin, admin);
    
    collections_external.add_approved_minter(admin.auth_id, alice.auth_id.account_id, mock_collection.name).sign(admin.keypair).run();
    
    val (fungible_id, _) = originals_tests_helper.mint_mock_fungible_original(
        alice,
        mock_collection.name,
        10,
        1
    );

    originals_external.mint_fungible_original_to_account(
        alice.auth_id,
        fungible_id,
        admin.auth_id.account_id
    ).sign(alice.keypair).run();
}

function test_update_collection_details() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    collections_external.update_collection_details(admin.auth_id, mock_collection.name, "updated name", "updated description")
        .sign(admin.keypair)
        .run();

    assert_equals(mock_collection.display_name, "updated name");
    assert_equals(mock_collection.description, "updated description");
}

