    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(admin, bertha_id, price = 99, settlement_type = originals_marketplace.Marketplace.settlement_type.auction);

    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);

    marketplace_external.Operations.bid(bob.auth_id, settlement_id, 100)
        .sign(bob.keypair).run();
 
    marketplace_external.OperationsDev.close_auction(
        settlement_id,
        collections_tests_mocks.VALID_EXPIRATION + 1
    )
        .sign(bob.keypair)
        .run();
    
    assert_equals(collections_tests_helper.find_highest_nft_price_in_collection(mock_collection.name), 100);
}

function test_find_highest_price_nft_in_collection_updated_after_fixed_price_purchase() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    collections_tests_helper.register_test_asset_and_mint_to_account(bob);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (original_one_id, original_one_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val (original_two_id, original_two_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(admin, original_one_id);

    val first_settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, original_one_id, 123);
 
    marketplace_external.Operations.settle(
        bob.auth_id,
        first_settlement_id
    ).sign(bob.keypair).run();

    assert_equals(collections_tests_helper.find_highest_nft_price_in_collection(mock_collection.name), 100);

    originals_tests_helper.list_original(admin, original_two_id, price = 120);

    val second_settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, original_two_id, 123);
 
    marketplace_external.Operations.settle(
        bob.auth_id,
        second_settlement_id
    ).sign(bob.keypair).run();

    assert_equals(collections_tests_helper.find_highest_nft_price_in_collection(mock_collection.name), 120);
}

function test_find_highest_price_nft_in_collection_updated_after_auction_completes() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);
    collections_tests_helper.register_test_asset_and_mint_to_account(bob);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (original_one_id, original_one_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val (original_two_id, original_two_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(admin, original_one_id, price = 99, settlement_type = originals_marketplace.Marketplace.settlement_type.auction);

    val first_settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, original_one_id, 123);

    marketplace_external.Operations.bid(bob.auth_id, first_settlement_id, 100)
        .sign(bob.keypair).run();
 
    marketplace_external.OperationsDev.close_auction(
        first_settlement_id,
        collections_tests_mocks.VALID_EXPIRATION + 1
    )
        .sign(bob.keypair)
        .run();
    
    assert_equals(collections_tests_helper.find_highest_nft_price_in_collection(mock_collection.name), 100);
    
    originals_tests_helper.list_original(admin, original_two_id, price = 99, settlement_type = originals_marketplace.Marketplace.settlement_type.auction);

    val second_settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, original_two_id, 123);

    marketplace_external.Operations.bid(bob.auth_id, second_settlement_id, 120)
        .sign(bob.keypair).run();
 
    marketplace_external.OperationsDev.close_auction(
        second_settlement_id,
        collections_tests_mocks.VALID_EXPIRATION + 1
    )
        .sign(bob.keypair)
        .run();
    
    assert_equals(collections_tests_helper.find_highest_nft_price_in_collection(mock_collection.name), 120);
}

