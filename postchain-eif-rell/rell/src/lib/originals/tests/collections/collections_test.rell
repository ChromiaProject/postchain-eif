        description = "Empty description",
        background_image = originals_tests_mocks.mock_image,
        collection_avatar = originals_tests_mocks.mock_image,
        author_account_id = bob.auth_id.account_id,
        project_name = originals_tests_helper.create_mock_project(admin, originals_tests_mocks.mock_simple_project).name,
        symbol = "WC"
    )
        .run_must_fail();
}

