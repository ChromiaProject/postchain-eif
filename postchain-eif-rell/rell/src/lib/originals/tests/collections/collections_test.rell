function test_update_collection_avatar() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    val update_avatar = "filehub://filehub.originals_core.chromia.com/1";
    collections_external.update_collection_avatar(
        admin.auth_id,
        mock_collection.name,
        update_avatar
    )
        .sign(admin.keypair)
        .run();

    assert_equals(mock_collection.collection_avatar, update_avatar);
}

