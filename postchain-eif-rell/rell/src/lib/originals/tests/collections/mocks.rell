@test module;

import ft3_helper_tests: ^^^^.ft3_helper.tests;
import originals_core: ^^^.core;
import dip_attributes: ^^^^.dip.attributes;
import originals_external: ^^^^.originals.external;
import dip_core: ^^^^.dip.core;

val VALID_EXPIRATION = 1652155799 * 1000 * 2;
val ASSET_NAME = "CHR";
val ASSET_ID = (ASSET_NAME).hash();

namespace ITradableBertha {
    val interface = "ITradableBertha";
    
    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_core.chromia.ITradable.interface
    ];
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [:],
            dependencies()
        )
        .sign(auth_data.keypair)
        .run();
    }

    function get() = dip_attributes.Interface.get(interface);
}

namespace IBertha {
    val interface = "IBertha";
    
    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface
    ];
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
           [:],
           dependencies()
        )
        .sign(auth_data.keypair)
        .run();
    }

    function get() = dip_attributes.Interface.get(interface);
}

namespace IRanch {
    val interface = "IRanch";
    
     function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_core.chromia.ITradable.interface
    ];
    
    val cows = dip_attributes.Attribute.I(interface = interface, name = "cows");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                cows: dip_core.Type(
                    dip_attributes.Set.T(dip_attributes.Attribute.type.instance, set<dip_core.instance>().to_gtv()),
                    [originals_core.OwnerMutable(), dip_core.ImplementsInterface(ITradableBertha.interface)]
                )
            ],
            dependencies()
        )
        .sign(auth_data.keypair)
        .run();
    }
    
    function get() = dip_attributes.Interface.get(interface);  
}
