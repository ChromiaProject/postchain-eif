function find_last_reported_collection() {
    val reported_collection = collections.report_collection @ {} (
        @omit @sort_desc .rowid, $
    ) limit 1;

    return struct<collections.report_collection> (
        collection = reported_collection.collection,
        account = reported_collection.account,
        created_at = reported_collection.created_at
    );
}

function find_last_reported_nft() {
    val reported_nft = reports.report_nft @ {} (
        @omit @sort_desc .rowid, $
    ) limit 1;

    return struct<reports.report_nft> (
        nft = reported_nft.nft,
        account = reported_nft.account,
        created_at = reported_nft.created_at
    );
}

function find_last_reported_project() {
    val reported_project = projects.report_project @ {} (
        @omit @sort_desc .rowid, $
    ) limit 1;

    return struct<projects.report_project> (
        project = reported_project.project,
        account = reported_project.account,
        created_at = reported_project.created_at
    );
}

function create_mock_report_collection_object(name) = 
    reports.report_item(
        type = reports.report_object_type.collection.name,
        id = name.to_gtv()
    );

function create_mock_report_nft_object(asset_id: byte_array) = 
    reports.report_item(
        type = reports.report_object_type.nft.name,
        id = asset_id.to_gtv()
    );

function create_mock_report_project_object(name: text) = 
    reports.report_item(
        type = reports.report_object_type.project.name,
        id = name.to_gtv()
    );