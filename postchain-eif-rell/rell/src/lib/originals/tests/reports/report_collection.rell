function test_report_collection_by_single_user() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val report_timestamp = originals_util.now_from_blocks();

    reports_external.report(admin.auth_id, reports_tests.create_mock_report_collection_object(mock_collection.name))
        .sign(admin.keypair)
        .run();

    assert_equals(mock_collection.reports_count, 1);

    assert_equals(reports_tests.find_last_reported_collection(), struct<collections.report_collection>(
        collection = mock_collection,
        account = ft3_account.account @ { .id == admin.auth_id.account_id },
        created_at = report_timestamp
    ));
}

function test_report_collection_by_multiple_users() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val report_collection = reports_tests.create_mock_report_collection_object(mock_collection.name);
  
    reports_external.report(admin.auth_id, reports_tests.create_mock_report_collection_object(mock_collection.name))
        .sign(admin.keypair)
        .run();

    reports_external.report(alice.auth_id, reports_tests.create_mock_report_collection_object(mock_collection.name))
        .sign(alice.keypair)
        .run();

    assert_equals(mock_collection.reports_count, 2);
}

function test_cannot_report_collection_more_than_once_from_the_same_user() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val report_collection = reports_tests.create_mock_report_collection_object(mock_collection.name);
  
    reports_external.report(admin.auth_id, reports_tests.create_mock_report_collection_object(mock_collection.name))
        .sign(admin.keypair)
        .run();

    reports_external.report(admin.auth_id, reports_tests.create_mock_report_collection_object(mock_collection.name))
        .sign(admin.keypair)
        .run_must_fail();
}

function test_single_user_can_report_two_collections() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);

    val (mock_collection_one, mock_project_one) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (mock_collection_two, mock_project_two) = originals_tests_helper.create_mock_collection(admin, alice, admin, name = "com.originals.WearablesCollection_2");

    reports_external.report(admin.auth_id, reports_tests.create_mock_report_collection_object(mock_collection_two.name))
        .sign(admin.keypair)
        .run();
}