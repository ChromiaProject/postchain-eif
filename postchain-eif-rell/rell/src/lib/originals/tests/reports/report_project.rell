function test_report_project_by_single_user() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);

    val report_timestamp = originals_util.now_from_blocks();
    reports_external.report(admin.auth_id, reports_tests.create_mock_report_project_object(mock_project.name))
        .sign(admin.keypair)
        .run();

    assert_equals(mock_project.reports_count, 1);

    assert_equals(reports_tests.find_last_reported_project(), struct<projects.report_project>(
        project = mock_project,
        account = ft3_account.account @ { .id == admin.auth_id.account_id },
        created_at = report_timestamp
    ));
}

function test_report_project_by_multiple_users() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);

    reports_external.report(alice.auth_id, reports_tests.create_mock_report_project_object(mock_project.name))
        .sign(alice.keypair)
        .run();

    reports_external.report(admin.auth_id, reports_tests.create_mock_report_project_object(mock_project.name))
        .sign(admin.keypair)
        .run();

    assert_equals(mock_project.reports_count, 2);
}

function test_cannot_report_project_more_than_once_from_the_same_user() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);

    reports_external.report(admin.auth_id, reports_tests.create_mock_report_project_object(mock_project.name))
        .sign(admin.keypair)
        .run();

    reports_external.report(admin.auth_id, reports_tests.create_mock_report_project_object(mock_project.name))
        .sign(admin.keypair)
        .run_must_fail();
}

function test_single_user_reports_two_projects() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);

    val project_one = originals_tests_helper.create_mock_project(admin);
    val project_two = originals_tests_helper.create_mock_project(admin, projects.simple_project_props(
        name = "com.chromia.projects.project_2",
        display_name = "Project2",
        avatar = originals_tests_mocks.dummy_image,
        background_image = originals_tests_mocks.dummy_image,
        website = "website.com",
        description = "Description of Project2"
    ));

    reports_external.report(admin.auth_id, reports_tests.create_mock_report_project_object(project_one.name))
        .sign(admin.keypair)
        .run();

    reports_external.report(admin.auth_id, reports_tests.create_mock_report_project_object(project_two.name))
        .sign(admin.keypair)
        .run();
}