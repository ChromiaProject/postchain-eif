/********************
 *         HELPER        *
 ********************/

function create_default_nfo(ft3_helper_tests.auth_data, collection_name: text): (byte_array, dip_core.instance) {
    originals_tests_helper.init_originals(auth_data);
    val original = originals_core.Minter.I(
        interface_name = originals_core.chromia.INonFungibleOriginal.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
        ]
    );
    
    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        original
    ).sign(auth_data.keypair).run();
    
    return originals_tests_helper.get_last();
}

function create_default_fo(
    ft3_helper_tests.auth_data,
    collection_name: text,
    initialize_chain: boolean = true
): (byte_array, dip_core.instance) {
    if (initialize_chain) {
        originals_tests_helper.init_originals(auth_data);
    }
    
    val original = originals_core.Minter.I(
        interface_name = originals_core.chromia.IFungibleOriginal.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
                originals_core.chromia.IFungibleOriginal.max_supply: dip_attributes.Integer.T(100)
        ]
    );
    
    originals_external.create_fungible_original(
        auth_data.auth_id,
      collection_name,
        original, 100
    ).sign(auth_data.keypair).run();
    
    return originals_tests_helper.get_last();
}

function create_test_dapp(ft3_helper_tests.auth_data): name {
    originals_tests_helper.init_originals(auth_data);
    
    val dlcass_name = "ITestDapp";
    originals_external.def_original_interface(
        auth_data.auth_id,
        dlcass_name,
        [:],
        [originals_core.chromia.INonFungibleOriginal.interface]
    ).sign(auth_data.keypair).run();
    
    originals_external.def_original_prototype(
        auth_data.auth_id,
        dlcass_name, [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
    ], "TestDapp").sign(auth_data.keypair).run();
    
    return dlcass_name;
}

function create_sword_example(
    ft3_helper_tests.auth_data,
    sword_optional: boolean = true
): (name, name) {
    val test_dapp = create_test_dapp(auth_data);
    
    val meta = if (sword_optional) [dip_core.Optional(), originals_core.OwnerMutable()] else [originals_core.OwnerMutable()];
    originals_external.def_original_interface(
        auth_data.auth_id,
        "ICharacter",
        [
            dip_core.Attribute.def_I("ICharacter", "sword"): dip_core.Type(dip_core.Instance.T(), meta)
        ],
        [test_dapp]
    ).sign(auth_data.keypair).run();

    originals_external.def_original_interface(
        auth_data.auth_id,
        "ISword",
        [dip_core.Attribute.def_I("ISword", "damage"): dip_core.Type(dip_attributes.Integer.T(100))],
        [test_dapp]
    ).sign(auth_data.keypair).run();
    
    return (
        "ICharacter",
        "ISword"
    );
}

function create_gem_example(
    ft3_helper_tests.auth_data,
    interface_constraint: boolean = false
): (name, name, name?) {
    val test_dapp = create_test_dapp(auth_data);

    val type = if (interface_constraint) 
        dip_core.Type(
            dip_attributes.Set.T(dip_core.Attribute.type.instance, set<dip_core.instance>().to_gtv()),
            [originals_core.OwnerMutable(), dip_core.ImplementsInterface("IGem")]
        )
    else 
        dip_core.Type(dip_attributes.Set.T(dip_core.Attribute.type.instance), [originals_core.OwnerMutable()])
    ;
    originals_external.def_original_interface(
       auth_data.auth_id,
       "ICharacter",
       [dip_core.Attribute.def_I("ICharacter", "gems"): type],
       [test_dapp]
    ).sign(auth_data.keypair).run();
    
    originals_external.def_original_interface(
       auth_data.auth_id,
       "IGem",
       [dip_core.Attribute.def_I("IGem", "power"): dip_core.Type(dip_attributes.Integer.T(100))],
       [test_dapp]
    ).sign(auth_data.keypair).run();
    
    if (interface_constraint) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            "IGemFake", 
            [dip_core.Attribute.def_I("IGemFake", "power"): dip_core.Type(dip_attributes.Integer.T(100))], 
            [test_dapp]
        ).sign(auth_data.keypair).run();
        val gem_fake = dip_core.Interface.get("IGemFake");
    }
    
    return (
        "ICharacter",
        "IGem",
        if (interface_constraint) "IGemFake" else null
    );
}

val default_cursor = pagination_mapper.page_cursor(page_size = 20,after_rowid = null).to_bytes().to_base64();

function create_cursor(page_size: integer, after_rowid: rowid? = null) 
    = pagination_mapper.page_cursor(page_size, after_rowid).to_bytes().to_base64();

/********************
 *         LINKING        *
 ********************/

function test_ownership_link() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, sword) = create_sword_example(admin);
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [:],
        prototype_name = "TestDapp"
    );
    val sword_type = originals_core.Minter.I(
        interface_name = sword,
        types = [:],
        prototype_name = "TestDapp"
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        sword_type
    ).sign(admin.keypair).run();
    val (sword_id, sword_instance) = originals_tests_helper.get_last();
    val cursor = create_cursor(2);
    val list_of_unlocked_instances = originals_external.get_unlocked_originals_from_owner(admin.auth_id.account_id, cursor);
    val list_of_locked_instances = originals_external.get_locked_originals_from_owner(admin.auth_id.account_id, cursor);
    
    assert_equals(list_of_locked_instances.data, list<gtv>());
    assert_equals(list_of_unlocked_instances.data, [character_id.to_gtv(), sword_id.to_gtv()]);
    
    originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword_id
    ).sign(admin.keypair).run();

    val locked_instances_page_data = originals_external.get_locked_originals_from_owner(admin.auth_id.account_id, cursor);
    val unlocked_instances_page_data = originals_external.get_unlocked_originals_from_owner(admin.auth_id.account_id, cursor);
    
    assert_true(originals_core.Ownership.is_linked(sword_instance));
    assert_false(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, sword_id));
    assert_equals(originals_core.Ownership.get_base_instance(sword_instance), character_instance);
    
    assert_equals(locked_instances_page_data.data, [sword_id.to_gtv()]);
    assert_equals(unlocked_instances_page_data.data, [character_id.to_gtv()]);
}

function test_ownership_link_pagination_limit() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, sword) = create_sword_example(admin);
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [:],
        prototype_name = "TestDapp"
    );
    val sword_type = originals_core.Minter.I(
        interface_name = sword,
        types = [:],
        prototype_name = "TestDapp"
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    originals_external.mint_non_fungible_original(
