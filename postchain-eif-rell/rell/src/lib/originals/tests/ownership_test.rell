function test_ownership_only_creator_can_mint() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    val test_dapp = create_test_dapp(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    originals_external.def_original_interface(
        admin.auth_id,
        "ITest",
        [
            dip_core.Attribute.def_I("ITest", "name"): dip_core.Type(dip_attributes.Text.T())
        ],
        [test_dapp]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    val test = "ITest";
    
    originals_external.def_original_prototype(
        admin.auth_id,
        test,
        [
            dip_core.Attribute.def_I("ITest", "name"): dip_attributes.Text.T("peter")
        ],
        "TestDappProp"
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    val test_type = originals_core.Minter.I(
        interface_name = test,
        types = [:],
        prototype_name = "TestDappProp"
    );
    originals_external.mint_non_fungible_original(
        bob.auth_id,
        mock_collection.name,
        test_type
    ).sign(bob.keypair).run_must_fail();
}

function test_hooks_are_called_when_transferring_original() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (id, instance) = create_default_nfo(admin, mock_collection.name);
    
    originals_external.transfer_original(
        admin.auth_id,
        id,
        bob.auth_id.account_id
    )
    .sign(admin.keypair)
    .run();
        
    assert_equals(extensions.transfer_hooks_state.is_after_transfer_called, true);
    assert_equals(extensions.transfer_hooks_state.after_transfer_from_account_id, admin.auth_id.account_id);
    assert_equals(extensions.transfer_hooks_state.after_transfer_to_account_id, bob.auth_id.account_id);
    assert_equals(extensions.transfer_hooks_state.after_transfer_original_id, id);
    assert_equals(extensions.transfer_hooks_state.after_transfer_quantity, 1);
}
