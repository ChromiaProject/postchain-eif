function test_ownership_link_fungible_original() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
        
    val (character, sword) = create_sword_example(admin);
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [:],
        prototype_name = "TestDapp"
    );
    
    NOP().op(originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    )).sign(admin.keypair).run();
    val character1_id = originals_tests_helper.get_last_id();
    
    NOP().op(originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    )).sign(admin.keypair).run();
    val character2_id = originals_tests_helper.get_last_id();
    
    val (id, instance) = create_default_fo(admin, mock_collection.name, false);
    NOP().op(originals_external.link_original(
    admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character1_id,
        id
    )).sign(admin.keypair).run();
    
    NOP().op(originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character2_id,
        id
    )).sign(admin.keypair).run();
}

/********************
 *         TRANSFER    *
 ********************/

function test_ownership_transfer_nfo() {
    val admin_account = ft3_helper_tests.register_admin();
    val bob_account = ft3_helper_tests.register_bob();

    val page_data = originals_external.get_all_originals_from_owner(admin_account.auth_id.account_id, default_cursor);
    
    assert_equals(page_data.data, list<gtv>());
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin_account, bob_account, admin_account);
    val (id, instance) = create_default_nfo(admin_account, mock_collection.name);
    assert_true(originals_util.Ft3Helper.owns_original(admin_account.auth_id.account_id, id));

    val page_data_with_default_nfo = originals_external.get_all_originals_from_owner(admin_account.auth_id.account_id, default_cursor);
    
    assert_equals(page_data_with_default_nfo.data, [id.to_gtv()]);
    assert_equals(originals_core.Ownership.find_last_original_with_interface(admin_account.auth_id.account_id, originals_core.chromia.INonFungibleOriginal.get())!!.instance, instance);

    val page_data_bob_account = originals_external.get_all_originals_from_owner(bob_account.auth_id.account_id, default_cursor);
    assert_equals(page_data_bob_account.data, list<gtv>());
    
    originals_external.transfer_original(
        admin_account.auth_id,
        id,
        bob_account.auth_id.account_id
    ).sign(admin_account.keypair).run();
    
    assert_false(originals_util.Ft3Helper.owns_original(admin_account.auth_id.account_id, id));
    assert_true(originals_util.Ft3Helper.owns_original(bob_account.auth_id.account_id, id));

    val page_data_bob_after_transfer = originals_external.get_all_originals_from_owner(bob_account.auth_id.account_id, default_cursor);

    assert_equals(page_data_bob_after_transfer.data, [id.to_gtv()]);
    assert_equals(originals_core.Ownership.find_last_original_with_interface(bob_account.auth_id.account_id, originals_core.chromia.INonFungibleOriginal.get())!!.instance, instance);

    val page_data_admin_after_transfer = originals_external.get_all_originals_from_owner(admin_account.auth_id.account_id, default_cursor);

    assert_equals(page_data_admin_after_transfer.data, list<gtv>());
}

function test_ownership_transfer_nfo_fail_cases() {
    val admin_account = ft3_helper_tests.register_admin();
    val bob_account = ft3_helper_tests.register_bob();
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin_account, bob_account, admin_account);
    val (id, instance) = create_default_nfo(admin_account, mock_collection.name);
    assert_true(originals_util.Ft3Helper.owns_original(admin_account.auth_id.account_id, id));
    
    // wrong quantity for NFO
    originals_external.transfer_original(
        admin_account.auth_id,
        id,
        bob_account.auth_id.account_id, 2
    ).sign(admin_account.keypair).run_must_fail();
    
    // negative quantity
    originals_external.transfer_original(
        admin_account.auth_id,
        id,
        bob_account.auth_id.account_id, -1
    ).sign(admin_account.keypair).run_must_fail();
    
    // not owner
    originals_external.transfer_original(
        bob_account.auth_id,
        id, 
        admin_account.auth_id.account_id
    ).sign(bob_account.keypair).run_must_fail();
    
    // wrong key signer
    originals_external.transfer_original(
        bob_account.auth_id,
        id,
        bob_account.auth_id.account_id
    ).sign(bob_account.keypair).run_must_fail();
}

function test_ownership_fo() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (id, instance) = create_default_fo(admin, mock_collection.name);
    assert_equals(originals_core.Ownership.amount_owned_of_original(admin.auth_id.account_id, instance), 100);
    
    originals_external.transfer_original(
        admin.auth_id,
        id,
        bob.auth_id.account_id,
        50
    ).sign(admin.keypair).run();
    
    assert_equals(originals_core.Ownership.amount_owned_of_original(admin.auth_id.account_id, instance), 50);
    assert_equals(originals_core.Ownership.amount_owned_of_original(bob.auth_id.account_id, instance), 50);
    
    NOP().op(originals_external.transfer_original(
        admin.auth_id,
        id,
        bob.auth_id.account_id,
        50
    )).sign(admin.keypair).run();
    
    assert_equals(originals_core.Ownership.amount_owned_of_original(admin.auth_id.account_id, instance), 0);
    assert_equals(originals_core.Ownership.amount_owned_of_original(bob.auth_id.account_id, instance), 100);
    
    // should fail because admin does not own any anymore
    NOP().op(originals_external.transfer_original(
        admin.auth_id,
        id,
        bob.auth_id.account_id, 1
    )).sign(admin.keypair).run_must_fail();
}

function test_ownership_transfer_linked_originals() {
    val admin_account = ft3_helper_tests.register_admin();
    val bob_account = ft3_helper_tests.register_bob();
    val test_dapp = create_test_dapp(admin_account);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin_account, bob_account, admin_account);
    
    originals_external.def_original_interface(
        admin_account.auth_id,
        "ICharacter",
        [
            dip_core.Attribute.def_I("ICharacter", "sword"): dip_core.Type(dip_core.Instance.T(), [dip_core.Optional(), originals_core.OwnerMutable()])
        ],
        [test_dapp]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    originals_external.def_original_interface(
        admin_account.auth_id,
        "ISword",
        [
            dip_core.Attribute.def_I("ISword", "gem"): dip_core.Type(dip_core.Instance.T(), [dip_core.Optional(), originals_core.OwnerMutable()])
        ],
        [test_dapp]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    originals_external.def_original_interface(
        admin_account.auth_id,
        "IGem",
        [
            dip_core.Attribute.def_I("IGem", "damage"): dip_core.Type(dip_attributes.Integer.T(100))
        ],
        [test_dapp]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    val character = "ICharacter";
    val sword = "ISword";
    val gem = "IGem";
    
    val gem_type = originals_core.Minter.I(
        interface_name = gem,
        types = [:],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin_account.auth_id,
        mock_collection.name,
        gem_type
    ).sign(admin_account.keypair).run();
    val (gem_id, gem_instance) = originals_tests_helper.get_last();
    
    val sword_type = originals_core.Minter.I(
        interface_name = sword,
        types = [
            dip_core.Attribute.def_I("ISword", "gem"): originals_core.Id.T(gem_id)
        ],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin_account.auth_id,
        mock_collection.name,
        sword_type
    ).sign(admin_account.keypair).run();
    val (sword_id, sword_instance) = originals_tests_helper.get_last();
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [
            dip_core.Attribute.def_I("ICharacter", "sword"): originals_core.Id.T(sword_id)
        ],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin_account.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin_account.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    assert_true(originals_util.Ft3Helper.owns_original(admin_account.auth_id.account_id, character_id));
    assert_false(originals_util.Ft3Helper.owns_original(admin_account.auth_id.account_id, sword_id));
    assert_false(originals_util.Ft3Helper.owns_original(admin_account.auth_id.account_id, gem_id));
    assert_true(originals_util.Ft3Helper.is_asset_locked(admin_account.auth_id.account_id, sword_id));
    assert_true(originals_util.Ft3Helper.is_asset_locked(admin_account.auth_id.account_id, gem_id));
    
    // try transfer locked original (should fail)
    originals_external.transfer_original(
        admin_account.auth_id,
        sword_id,
        bob_account.auth_id.account_id
    ).sign(admin_account.keypair).run_must_fail();
    
    originals_external.transfer_original(
        admin_account.auth_id,
        character_id,
        bob_account.auth_id.account_id
    ).sign(admin_account.keypair).run();
    
    assert_false(originals_util.Ft3Helper.owns_original(admin_account.auth_id.account_id, character_id));
    assert_false(originals_util.Ft3Helper.is_asset_locked(admin_account.auth_id.account_id, sword_id));
    assert_false(originals_util.Ft3Helper.is_asset_locked(admin_account.auth_id.account_id, gem_id));
    
    assert_true(originals_util.Ft3Helper.owns_original(bob_account.auth_id.account_id, character_id));
    assert_false(originals_util.Ft3Helper.owns_original(bob_account.auth_id.account_id, sword_id));
    assert_false(originals_util.Ft3Helper.owns_original(bob_account.auth_id.account_id, gem_id));
    assert_true(originals_util.Ft3Helper.is_asset_locked(bob_account.auth_id.account_id, sword_id));
    assert_true(originals_util.Ft3Helper.is_asset_locked(bob_account.auth_id.account_id, gem_id));
}

/********************
 *     FRACTIONLIZE    *
 ********************/

function fractional_type() = originals_core.Minter.I(
    interface_name = originals_core.chromia.IFractionalizedOriginal.interface,
    types = [:]
);

function test_ownership_fractionalize_nfo() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    val (id, instance) = create_default_nfo(admin, mock_collection.name);
    originals_external.fractionalize_non_fungible_original(
        admin.auth_id,
        id,
        fractional_type(),
        100
    ).sign(admin.keypair).run();
    val (fractionalized_id, fractionalized_instance) = originals_tests_helper.get_last();
    
    assert_false(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, id));
    assert_equals(originals_core.Ownership.amount_owned_of_original(admin.auth_id.account_id, fractionalized_instance), 100);
    
    // should fail because no quantity is defined
    originals_external.transfer_original(
        admin.auth_id,
        id,
        alice.auth_id.account_id
    ).sign(admin.keypair).run_must_fail();
    
    originals_external.transfer_original(
        admin.auth_id,
        fractionalized_id,
        bob.auth_id.account_id, 50
    ).sign(admin.keypair).run();
    
    assert_equals(originals_core.Ownership.amount_owned_of_original(admin.auth_id.account_id, fractionalized_instance), 50);
    assert_equals(originals_core.Ownership.amount_owned_of_original(bob.auth_id.account_id, fractionalized_instance), 50);
}

function test_ownership_fractionalize_nfo_fail_cases() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    val (id, instance) = create_default_nfo(admin, mock_collection.name);
    // wrong owner
    originals_external.fractionalize_non_fungible_original(
        bob.auth_id,
        id,
        fractional_type(),
        100
    ).sign(bob.keypair).run_must_fail();
    
    // wrong amount of fractions
    originals_external.fractionalize_non_fungible_original(
        admin.auth_id,
        id,
        fractional_type(),
        0
    ).sign(admin.keypair).run_must_fail();
    originals_external.fractionalize_non_fungible_original(
        admin.auth_id,
        id,
        fractional_type(),
        -1
    ).sign(admin.keypair).run_must_fail();
    
    // wrong/no signer
    originals_external.fractionalize_non_fungible_original(
        admin.auth_id,
        id,
        fractional_type(),
        100
    ).sign(bob.keypair).run_must_fail();
    originals_external.fractionalize_non_fungible_original(
        admin.auth_id,
        id,
        fractional_type(),
        100
    ).run_must_fail();
        
    // fractionalize_non_fungible_original_op with no NFO
    val (fun_id, fun_instance) = create_default_fo(admin, mock_collection.name, initialize_chain = false);
    originals_external.fractionalize_non_fungible_original(
        admin.auth_id,
        fun_id,
        fractional_type(),
        100
    ).sign(admin.keypair).run_must_fail();
}

