function test_ownership_link_fail_cases() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, sword) = create_sword_example(admin);
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [:],
        prototype_name = "TestDapp"
    );
    val sword_type = originals_core.Minter.I(
        interface_name = sword,
        types = [:],
        prototype_name = "TestDapp"
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        sword_type
    ).sign(admin.keypair).run();
    val (sword_id, sword_instance) = originals_tests_helper.get_last();
    
    // no/wrong signer/owner
    originals_external.link_original(
        bob.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword_id
    ).sign(bob.keypair).run_must_fail();
    
    originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword_id
    ).sign(bob.keypair).run_must_fail();
    
    originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword_id
    ).run_must_fail();
    
    originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword_id
    ).sign(admin.keypair).run();
    
    // relinking
    originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword_id
    ).sign(admin.keypair).run_must_fail();
}


function test_ownership_unlink() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, sword) = create_sword_example(admin);
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [:],
        prototype_name = "TestDapp"
    );
    
    val sword_type = originals_core.Minter.I(
        interface_name = sword,
        types = [:],
        prototype_name = "TestDapp"
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        sword_type
    ).sign(admin.keypair).run();
    val (sword_id, sword_instance) = originals_tests_helper.get_last();
    
    originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword_id
    ).sign(admin.keypair).run();
    
    originals_external.unlink_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id
    ).sign(admin.keypair).run();

    val unlocked_instances_page_data = originals_external.get_unlocked_originals_from_owner(admin.auth_id.account_id, default_cursor);
    val locked_instances_page_data = originals_external.get_locked_originals_from_owner(admin.auth_id.account_id, default_cursor);
    
    assert_false(originals_core.Ownership.is_linked(sword_instance));
    assert_true(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, sword_id));
    
    assert_equals(locked_instances_page_data.data, list<gtv>());
    assert_equals(unlocked_instances_page_data.data, [character_id.to_gtv(), sword_id.to_gtv()]);
}

function test_ownership_unlink_fail_cases() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, sword) = create_sword_example(admin);
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [:],
        prototype_name = "TestDapp"
    );
    
    val sword_type = originals_core.Minter.I(
        interface_name = sword,
        types = [:],
        prototype_name = "TestDapp"
    );
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        sword_type
    ).sign(admin.keypair).run();
    val (sword_id, sword_instance) = originals_tests_helper.get_last();
    
    originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword_id
    ).sign(admin.keypair).run();
    
    // wrong/no owner/signer
    originals_external.unlink_original(
        bob.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id
    ).sign(bob.keypair).run_must_fail();
    
    originals_external.unlink_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id
    ).sign(bob.keypair).run_must_fail();
    
    originals_external.unlink_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id
    ).run_must_fail();
    
    originals_external.unlink_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        x"affe"
    ).run_must_fail();
    
    originals_external.unlink_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id
    ).sign(admin.keypair).run();
    
    // already unlinked
    originals_external.unlink_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id
    ).sign(admin.keypair).run_must_fail();
}

function test_ownership_link_at_mint() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, sword) = create_sword_example(admin);
    
    val sword_type = originals_core.Minter.I(
        interface_name = sword,
        types = [:],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        sword_type
    ).sign(admin.keypair).run();
    val (sword_id, sword_instance) = originals_tests_helper.get_last();
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [
            dip_core.Attribute.def_I("ICharacter", "sword"): originals_core.Id.T(sword_id)
        ],
        prototype_name = "TestDapp"
    );    
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    assert_true(originals_core.Ownership.is_linked(sword_instance));
    assert_false(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, sword_id));
    assert_equals(originals_core.Ownership.get_base_instance(sword_instance), character_instance);
}

function test_ownership_link_swap() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    // The sword attribute in character is non optional to test if it updates
    // instead of deleting and adding.
    val (character, sword) = create_sword_example(admin, sword_optional = false);
    
    val sword_type = originals_core.Minter.I(
        interface_name = sword,
        types = [:],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        sword_type
    ).sign(admin.keypair).run();
    val (sword1_id, sword1_instance) = originals_tests_helper.get_last();
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [
            dip_core.Attribute.def_I("ICharacter", "sword"): originals_core.Id.T(sword1_id)
        ],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    NOP().op(originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        sword_type
    )).sign(admin.keypair).run();
    val (sword2_id, sword2_instance) = originals_tests_helper.get_last();
    
    assert_true(originals_core.Ownership.is_linked(sword1_instance));
    assert_false(originals_core.Ownership.is_linked(sword2_instance));
    assert_equals(originals_core.Ownership.get_base_instance(sword1_instance), character_instance);
    
    originals_external.link_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "sword"),
        character_id,
        sword2_id
    ).sign(admin.keypair).run();
    
    assert_false(originals_core.Ownership.is_linked(sword1_instance));
    assert_true(originals_core.Ownership.is_linked(sword2_instance));
    assert_equals(originals_core.Ownership.get_base_instance(sword2_instance), character_instance);
}

function test_ownership_link_and_unlink_to_set() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, gem, _) = create_gem_example(admin);
    
    val gem_type = originals_core.Minter.I(
        interface_name = gem,
        types = [:],
        prototype_name = "TestDapp"
    );    

    originals_external.mint_non_fungible_original_batch(
        admin.auth_id,
        mock_collection.name,
        gem_type, 5
    ).sign(admin.keypair).run();

    val gem_interface = dip_core.Interface.get(gem);
    val gem_page_data = originals_external.get_originals_with_interface(admin.auth_id.account_id, gem, default_cursor);
    
    val gem_ids = gem_page_data.data @* {} ( byte_array.from_gtv($) );
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [
            dip_core.Attribute.def_I("ICharacter", "gems"): dip_attributes.Set.T(dip_core.Attribute.type.id, value=set<byte_array>().to_gtv())
        ],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();
    
    for (gem_id in gem_ids) {
        originals_external.link_original(
            admin.auth_id,
            dip_core.Attribute.def_I("ICharacter", "gems"),
            character_id,
            gem_id
        ).sign(admin.keypair).run();
    }
    val locked_instances_page_data = originals_external.get_locked_originals_from_owner(admin.auth_id.account_id, default_cursor);
    
    assert_equals(locked_instances_page_data.data, gem_page_data.data);
    
    originals_external.unlink_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "gems"),
        character_id,
        gem_ids[1]
    ).sign(admin.keypair).run();

    val unlocked_instances_page_data = originals_external.get_unlocked_originals_from_owner(admin.auth_id.account_id, default_cursor);
    val locked_instances_page_data_after_unlink = originals_external.get_locked_originals_from_owner(admin.auth_id.account_id, default_cursor);
    
    val gems_list_after_update = gem_page_data.data @* { gem_page_data.data.index_of($) != 1 };

    assert_equals(locked_instances_page_data_after_unlink.data, gems_list_after_update);
    assert_equals(unlocked_instances_page_data.data, [gem_ids[1].to_gtv(), character_id.to_gtv()]);
}

function test_ownership_link_and_unlink_to_set_at_mint() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, gem, _) = create_gem_example(admin);
    
    val gem_type = originals_core.Minter.I(
        interface_name = gem,
        types = [:],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original_batch(
        admin.auth_id,
        mock_collection.name,
        gem_type,
        5
    ).sign(admin.keypair).run();
    val gem_interface = dip_core.Interface.get(gem);
    val gem_page_data = originals_external.get_originals_with_interface(admin.auth_id.account_id, gem, default_cursor);

    val gem_ids = gem_page_data.data @* {} (byte_array.from_gtv($));
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [
            dip_core.Attribute.def_I("ICharacter", "gems"): dip_attributes.Set.T(dip_core.Attribute.type.id, value = set(gem_ids).to_gtv())
        ],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val (character_id, character_instance) = originals_tests_helper.get_last();

    val locked_instances_page_data = originals_external.get_locked_originals_from_owner(admin.auth_id.account_id, default_cursor);
    
    assert_equals(locked_instances_page_data, gem_page_data);
    
    originals_external.unlink_original(
        admin.auth_id,
        dip_core.Attribute.def_I("ICharacter", "gems"),
        character_id,
        gem_ids[1]
    ).sign(admin.keypair).run();

    val unlocked_instances_page_data = originals_external.get_unlocked_originals_from_owner(admin.auth_id.account_id, default_cursor);
    val locked_instances_page_data_after_unlink = originals_external.get_locked_originals_from_owner(admin.auth_id.account_id, default_cursor);
    val gems_list_after_update = gem_page_data.data @* { gem_page_data.data.index_of($) != 1 };

    assert_equals(locked_instances_page_data_after_unlink.data, gems_list_after_update);
    assert_equals(unlocked_instances_page_data.data, [gem_ids[1].to_gtv(), character_id.to_gtv()]);
}

function test_ownership_link_and_unlink_to_set_of_wrong_interface() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (character, gem, gem_fake) = create_gem_example(admin, interface_constraint = true);
    
    val gem_type = originals_core.Minter.I(
        interface_name = gem,
        types = [:],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original_batch(
        admin.auth_id,
        mock_collection.name,
        gem_type,
        5
    ).sign(admin.keypair).run();
    val gem_interface = dip_core.Interface.get(gem);
    val gem_page_data = originals_external.get_originals_with_interface(admin.auth_id.account_id, gem, default_cursor);
    val gem_ids = gem_page_data.data @* {} (byte_array.from_gtv($));
    
    val fake_gem_type = originals_core.Minter.I(
        interface_name = gem_fake!!,
        types = [:],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        fake_gem_type
    ).sign(admin.keypair).run();
    val fake_gem_id = originals_tests_helper.get_last_id();
    
    val character_type = originals_core.Minter.I(
        interface_name = character,
        types = [:],
        prototype_name = "TestDapp"
    );    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        character_type
    ).sign(admin.keypair).run();
    val character_id = originals_tests_helper.get_last_id();
    
    val attribute_name = dip_core.Attribute.def_I("ICharacter", "gems");
    originals_external.link_original(
        admin.auth_id,
        attribute_name,
        character_id,
        fake_gem_id
    ).sign(admin.keypair).run_must_fail();
    
    originals_external.link_original(
        admin.auth_id,
        attribute_name,
        character_id,
        gem_ids[0]
    ).sign(admin.keypair).run();
    
    originals_external.unlink_original(
        admin.auth_id,
        attribute_name,
        character_id,
        fake_gem_id
    ).sign(admin.keypair).run_must_fail();
    
    originals_external.unlink_original(
        admin.auth_id,
        attribute_name,
        character_id,
        gem_ids[0]
    ).sign(admin.keypair).run();
}

