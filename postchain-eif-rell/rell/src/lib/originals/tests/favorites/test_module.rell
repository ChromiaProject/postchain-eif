function test_it_should_succeed_to_remove_nft_from_favorites() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val nft = favorite_tests.favorite_nft(bertha_id);

    favorites_external.add_to_favorites(admin.auth_id, nft)
        .sign(admin.keypair)
        .run();

    assert_equals(favorite_tests.get_last_favorite().favorite_object.favorite_count, 1);

    favorites_external.remove_from_favorites(admin.auth_id, nft)
        .sign(admin.keypair)
        .run();

    val find_favorite = (ff: favorites.favorite, fnft: favorites.favorite_nft) @? {
        ff.user.id == admin.auth_id.account_id,
        ff.favorite_object == fnft.favorite_object,
        fnft.nft.asset.id == bertha_id
    };

    assert_equals(find_favorite, null);
    assert_equals(favorites.favorite_nft @? { .nft.asset.id == bertha_id }.favorite_object.favorite_count, 0);
}

function test_it_should_succeed_to_remove_collection_from_favorites() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val favorite_collection = favorite_tests.favorite_collection("com.originals.WearablesCollection");

    favorites_external.add_to_favorites(admin.auth_id, favorite_collection)
        .sign(admin.keypair)
        .run();

    assert_equals(favorite_tests.get_last_favorite().favorite_object.favorite_count, 1);

    favorites_external.remove_from_favorites(admin.auth_id, favorite_collection)
        .sign(admin.keypair)
        .run();

    val find_favorite = (ff: favorites.favorite, fc: favorites.favorite_collection) @? {
        ff.user.id == admin.auth_id.account_id,
        ff.favorite_object == fc.favorite_object,
        fc.collection.name == "com.originals.WearablesCollection"
    };

    assert_equals(find_favorite, null);
}


