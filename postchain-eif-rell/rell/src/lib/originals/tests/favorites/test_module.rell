function test_it_should_find_single_nft_added_to_favorites_for_account() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val favorite_nft = favorite_tests.favorite_nft(bertha_id);

    favorites_external.add_to_favorites(admin.auth_id, favorite_nft)
        .sign(admin.keypair)
        .run();

    val last_favorite_nft = favorite_tests.get_last_favorite_by_type_mapped(favorites.FavoriteItemType(favorite_nft.type));
    val cursor = originals_tests_helper.default_cursor(1);
    val favorites = favorites_external.find_favorites(admin.auth_id.account_id, favorite_nft.type, cursor);

    assert_equals(favorites, mapper.paged_result(
        next_cursor = null,
        data = [( 
            id = last_favorite_nft.id,
            type = "nft",
            item = (
                id = bertha_id,
                image = originals_tests_mocks.mock_image,
                name = "Test Original",
                collection = (
                    id = mock_collection.name,
                    name = mock_collection.display_name
                ),
                favorites_count = 1,
                is_favorite = null
            ).to_gtv_pretty()
        ).to_gtv_pretty()]
    ));
}

function test_it_should_find_multiple_nfts_added_to_favorites_for_account_on_specific_page() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val (original_id, original_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val first_favorite_nft = favorite_tests.favorite_nft(bertha_id);
    val second_favorite_nft = favorite_tests.favorite_nft(original_id);

    favorites_external.add_to_favorites(admin.auth_id, first_favorite_nft)
        .sign(admin.keypair)
        .run();

    favorites_external.add_to_favorites(admin.auth_id, second_favorite_nft)
        .sign(admin.keypair)
        .run();

    val mapped_favorites = favorite_tests.find_mapped_favorites_by_type(favorites.favorite_type.nft);
    val cursor = originals_tests_helper.default_cursor(2);
    val favorites = favorites_external.find_favorites(admin.auth_id.account_id, first_favorite_nft.type, cursor);

    assert_equals(favorites, mapper.paged_result(
        next_cursor = null,
        data = [( 
            id = mapped_favorites[0].id,
            type = "nft",
            item = (
                id = bertha_id,
                collection = (
                    id = mock_collection.name,
                    name = mock_collection.display_name
                ),
                image = originals_tests_mocks.mock_image,
                name = "Test Original",
                favorites_count = 1,
                is_favorite = null
            ).to_gtv_pretty()
        ).to_gtv_pretty(),
        ( 
            id = mapped_favorites[1].id,
            type = "nft",
            item = (
                id = original_id,
                collection = (
                    id = mock_collection.name,
                    name = mock_collection.display_name
                ),
                image = originals_tests_mocks.mock_image,
                name = "Test Original",
                favorites_count = 1,
                is_favorite = null
            ).to_gtv_pretty()
        ).to_gtv_pretty()
        ]
    ));
}

function test_it_should_find_collections_added_to_favorites_for_account() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);

    val (first_mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (second_mock_collection, _) = originals_tests_helper.create_mock_collection(admin, bob, admin, "com.originals.MockWearablesCollection");

    val first_favorite_collection = favorite_tests.favorite_collection("com.originals.WearablesCollection");
    val second_favorite_collection = favorite_tests.favorite_collection("com.originals.MockWearablesCollection");

    favorites_external.add_to_favorites(admin.auth_id, first_favorite_collection)
        .sign(admin.keypair)
        .run();

    favorites_external.add_to_favorites(admin.auth_id, second_favorite_collection)
        .sign(admin.keypair)
        .run();

    val mapped_favorites = favorite_tests.find_mapped_favorites_by_type(favorites.favorite_type.collection);
    val cursor = originals_tests_helper.default_cursor(2);
    val favorites = favorites_external.find_favorites(admin.auth_id.account_id, first_favorite_collection.type, cursor);
    
    assert_equals(favorites, mapper.paged_result(
        next_cursor = null,
        data = [(
            id = mapped_favorites[0].id,
            type = "collection", 
            item = (
                background_image = originals_tests_mocks.mock_image,
                avatar = originals_tests_mocks.mock_image,
                name = first_mock_collection.name,
                author = bob.auth_id.account_id,
                description = first_mock_collection.description
            ).to_gtv_pretty()
        ).to_gtv_pretty(),
        (
            id = mapped_favorites[1].id,
            type = "collection", 
            item = (
                background_image = originals_tests_mocks.mock_image,
                avatar = originals_tests_mocks.mock_image,
                name = second_mock_collection.name,
                author = bob.auth_id.account_id,
                description = second_mock_collection.description
            ).to_gtv_pretty()
        ).to_gtv_pretty()
        ]
    ));
}

