function test_add_project_to_favorites() {
    val admin = ft3_helper_tests.register_admin();

    originals_tests_helper.init_originals(admin);

    val project = originals_tests_helper.create_mock_project(admin);

    favorites_external.add_to_favorites(admin.auth_id, favorite_tests.favorite_project(project))
        .sign(admin.keypair)
        .run();

    val last_favorite_project = favorite_tests.get_last_favorite_by_type_mapped(favorites.favorite_type.project);

    assert_equals(last_favorite_project, (
        id = last_favorite_project.id,
        type = "project", 
        item = (
            id = project.name,
            name = project.display_name,
            background_image = originals_tests_mocks.mock_image,
            avatar = originals_tests_mocks.mock_image,
            creator = project.owner,
            description = project.description
        ).to_gtv_pretty()
    ));
}

function test_remove_project_from_favorites() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);

    val project = originals_tests_helper.create_mock_project(admin);

    favorites_external.add_to_favorites(admin.auth_id, favorite_tests.favorite_project(project))
        .sign(admin.keypair)
        .run();

    val last_favorite_project = favorite_tests.get_last_favorite_by_type_mapped(favorites.favorite_type.project);

    favorites_external.remove_from_favorites(admin.auth_id, favorite_tests.favorite_project(project))
        .sign(admin.keypair)
        .run();

    val find_favorite = (ff: favorites.favorite, fprj: favorites.favorite_project) @? {
        ff.user.id == admin.auth_id.account_id,
        ff.favorite_object == fprj.favorite_object,
        fprj.project == project
    };

    assert_equals(find_favorite, null);
    assert_equals(favorites.favorite_project @? { .project == project }.favorite_object.favorite_count, 0);
}