function test_it_should_succeed_to_add_nft_to_favorites() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    originals_tests_helper.init_originals(admin);
    originals_tests_helper.initialize_mock_interfaces(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val favorite_nft = favorite_tests.favorite_nft(bertha_id);
   
    favorites_external.add_to_favorites(admin.auth_id, favorite_nft)
        .sign(admin.keypair)
        .run();

    val last_favorite_nft = favorite_tests.get_last_favorite();

    assert_equals(last_favorite_nft.user.id, admin.auth_id.account_id);
    val favorite_nft_id = favorites.favorite_nft @ { last_favorite_nft.favorite_object } (.nft.asset.id);
    assert_equals(favorite_nft_id, bertha_id);
}

function test_it_should_succeed_to_add_collection_to_favorites() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    val favorite_collection = favorite_tests.favorite_collection("com.originals.WearablesCollection");

    favorites_external.add_to_favorites(admin.auth_id, favorite_collection)
        .sign(admin.keypair)
        .run();

    val last_favorite_collection = favorite_tests.get_last_favorite_by_type_mapped(favorites.FavoriteItemType(favorite_collection.type));

    assert_equals(last_favorite_collection, (
        id = last_favorite_collection.id,
        type = "collection", 
        item = (
            background_image = originals_tests_mocks.mock_image,
            avatar = originals_tests_mocks.mock_image,
            name = mock_collection.name,
            author = bob.auth_id.account_id,
            description = mock_collection.description
        ).to_gtv_pretty()
    ));
}

