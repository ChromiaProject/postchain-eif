function test_login_fail() {
    val keypair = ft3_helper_tests.admin_keypair();
    val auth_descriptor = ft3_core.acc.auth_descriptor(
        "S",
        [keypair.pub],
        [ ["T"].to_gtv(), keypair.pub.to_hex().to_gtv() ],
        [ "block_time".to_gtv(), "lt".to_gtv(), originals_tests_mocks.VALID_EXPIRATION.to_gtv() ].to_gtv()
    );
    val auth_descriptor_id = auth_descriptor.hash();
    
    // Not an EVM address
    evm_accounts_external.Operations.login("0x012", auth_descriptor, originals_tests_mocks.ADMIN_LOGIN_SIG).run_must_fail();
    
    // Incorrect signature
    evm_accounts_external.Operations.login(originals_tests_mocks.ADMIN_ADDRESS, auth_descriptor, 
        EvmAccounts.signature(
            r = x"ab91f849c021582763283cbad7716c48f9901e2b497d39f155c0630eef14b6b7",
            s = x"334d545c2a559ce215e28b9393e711a34cea0af7a4b1758147d6faf472947169",
            28
        )
    ).run_must_fail();
}

function test_auth_expired_fail() {
    val keypair = ft3_helper_tests.admin_keypair();
    val auth_descriptor = ft3_core.acc.auth_descriptor(
        "S",
        [keypair.pub],
        [ ["T"].to_gtv(), keypair.pub.to_hex().to_gtv() ],
        [ "block_time".to_gtv(), "lt".to_gtv(), integer(0).to_gtv() ].to_gtv()
    );
    val auth_descriptor_id = auth_descriptor.hash();
        
    // Signature of: Request to login with salt 0 using auth descriptor with hash 73e5a23fe95c003238ece05733e23a6e4d0de6a7bfebf5dca6029819b7bd5c9d
    val ADMIN_LOGIN_SIG_EXPIRED = EvmAccounts.signature(
        r = x"7c83ba5646467c416e813f86b65f1941c4374b0109a65868ac4a23f87a39bd3b",
        s = x"6aa34eeace482f4817979e4b1d4f9b75eeee338b5019d2f23322dcb7a01cc827",
        27
    );
    
    evm_accounts_external.Operations.login(originals_tests_mocks.ADMIN_ADDRESS, auth_descriptor, ADMIN_LOGIN_SIG_EXPIRED).run();
    
    val evm_account_id = evm_accounts_external.Queries.derive_evm_account_id(originals_tests_mocks.ADMIN_ADDRESS);
    
    // Expired login descriptor
    evm_accounts_external.OperationsDev.auth_and_log(evm_account_id, auth_descriptor_id).run_must_fail();
}