function test_create_evm_settlement_check_signature() {
    val DOMAIN_SEPARATOR = x"6fafe686aa6344154513a0d6944671fd22d04ec9a9cbe5edc1bbbd7b6dfcc2b0";

    val seller = utils.login_evm(ft3_helper_tests.bob_keypair(), originals_tests_mocks.BOB_ADDRESS, originals_tests_mocks.BOB_LOGIN_SIG);
    
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val oracle = admin;
    
    utils.register(admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    originals_external.transfer_original(admin.auth_id, bertha_id, seller.auth_id.account_id).sign(admin.keypair).run();
    
    marketplace_external.Operations.set_domain_separator(DOMAIN_SEPARATOR).sign(admin.keypair).run();
    
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);
    
    // Settlement signature obtained using ethers
    val signature = x'9a6508f18a7dd63a43bb43299ebfad635fcd00b8f9535673b35f7b182994658125aa5b5c1510d7a3102c1f8046315953ccfb2afed5ad82e3d5d4d9a9d1be803c1b';

    originals_tests_helper.list_original(
        seller,
        bertha_id,
        price = 100,
        expiration = 3304311598000,
        asset_id = evm_native_asset_id,
        type = originals_marketplace.Marketplace.asset_type.evm_asset,
        salt = 0,
        settlement_type = originals_marketplace.Marketplace.settlement_type.evm,
        signature = signature
    );
}

function test_create_settlement_fixed_price() {
    val admin = ft3_helper_tests.register_admin();
        val bob = ft3_helper_tests.register_bob();
        val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    utils.register_test_asset_and_mint_to_account(admin);
    
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    
      originals_tests_helper.list_original(admin, bertha_id, price = 50);
    
    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);
    val settlement_descriptor = marketplace_external.Queries.get_settlement_descriptor(settlement_id);    
    assert_not_null(settlement_descriptor);
    
    assert_equals(settlement_descriptor.takerDescriptor.asset.id, originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id);
    assert_equals(settlement_descriptor.takerDescriptor.amount, 50);
    assert_equals(settlement_descriptor.takerDescriptor.assetType, originals_marketplace.Marketplace.asset_type.regular.value);
    
    assert_equals(settlement_descriptor.makerDescriptor.asset.id, bertha_id);
    assert_equals(settlement_descriptor.makerDescriptor.amount, 1);
    assert_equals(settlement_descriptor.makerDescriptor.assetType, originals_marketplace.Marketplace.asset_type.original.value);
    
    assert_equals(settlement_descriptor.id, settlement_id);
    assert_equals(settlement_descriptor.expiration, originals_tests_mocks.VALID_EXPIRATION);
    assert_equals(settlement_descriptor.salt, 123);
    assert_equals(settlement_descriptor.settlementType, originals_marketplace.Marketplace.settlement_type.fixed_price.value);
}

