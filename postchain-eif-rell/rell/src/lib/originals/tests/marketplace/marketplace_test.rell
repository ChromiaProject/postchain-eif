function test_create_settlement_evm() {
    val admin = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val bob = ft3_helper_tests.register_bob();
    val oracle = admin;

    utils.register_test_asset_and_mint_to_account(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);

    marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
    
    val settlement_descriptor = marketplace_external.Queries.get_settlement_descriptor(utils.DUMMY_SIGNATURE);    
    assert_not_null(settlement_descriptor);
    
    assert_equals(settlement_descriptor.takerDescriptor.asset.id, evm_native_asset_id);
    assert_equals(settlement_descriptor.takerDescriptor.amount, 50);
    assert_equals(settlement_descriptor.takerDescriptor.assetType, originals_marketplace.Marketplace.asset_type.evm_asset.value);
    
    assert_equals(settlement_descriptor.makerDescriptor.asset.id, bertha_id);
    assert_equals(settlement_descriptor.makerDescriptor.amount, 1);
    assert_equals(settlement_descriptor.makerDescriptor.assetType, originals_marketplace.Marketplace.asset_type.original.value);
    
    assert_equals(settlement_descriptor.id, utils.DUMMY_SIGNATURE);
    assert_equals(settlement_descriptor.expiration, originals_tests_mocks.VALID_EXPIRATION);
    assert_equals(settlement_descriptor.salt, 123);
    assert_equals(settlement_descriptor.settlementType, originals_marketplace.Marketplace.settlement_type.evm.value);
}

function test_delete_settlement() {
    val admin = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val bob = ft3_helper_tests.register_bob();
    val oracle = admin;

    utils.register_test_asset_and_mint_to_account(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    // Delete fixed price settlement
    originals_tests_helper.list_original(admin, bertha_id, price = 50);
    
    var settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);
    
    marketplace_external.Operations.delete_settlement(admin.auth_id, settlement_id)
        .sign(admin.keypair).run();
        
    assert_null(marketplace_external.Queries.get_settlement_descriptor(settlement_id));
    
    // Delete expired EVM settlement
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);

    marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
    
    marketplace_external.OperationsDev.delete_settlement(admin.auth_id, utils.DUMMY_SIGNATURE, originals_tests_mocks.VALID_EXPIRATION + originals_marketplace.Marketplace.data.evm_expiration_delete_buffer + 1)
        .sign(admin.keypair).run();
        
    assert_null(marketplace_external.Queries.get_settlement_descriptor(utils.DUMMY_SIGNATURE));
}

function test_register_cancelled_event() {
    val admin = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val oracle = admin;
    val bob = ft3_helper_tests.register_bob();
    utils.register_test_asset_and_mint_to_account(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    
    // Delete cancelled EVM settlement
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);

    marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
    
    marketplace_external.Operations.register_cancelled_event(utils.DUMMY_SIGNATURE).sign(oracle.keypair).run();
        
    assert_null(marketplace_external.Queries.get_settlement_descriptor(utils.DUMMY_SIGNATURE));
}

function test_settle() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register_test_asset_and_mint_to_account(admin, bob);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(admin, bertha_id, price = 100, signature = null);
    
    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);

    marketplace_external.Operations.settle(
        bob.auth_id,
        settlement_id
    ).sign(bob.keypair).run();
        
    assert_equals(originals_core.ft3_core.get_asset_balance(bob.auth_id.account_id, originals_tests_mocks.ASSET_ID)!!.amount, 900);
    assert_equals(originals_core.ft3_core.get_asset_balance(admin.auth_id.account_id, originals_tests_mocks.ASSET_ID)!!.amount, 1100);
    
    assert_true(originals_util.Ft3Helper.owns_original(bob.auth_id.account_id, bertha_id));
}

