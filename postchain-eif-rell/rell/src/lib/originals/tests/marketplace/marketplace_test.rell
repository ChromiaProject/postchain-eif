    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    utils.register_test_asset_and_mint_to_account(admin, alice);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);
}

function test_create_and_update_offer_of_unlisted_nft() {
  val admin = ft3_helper_tests.register_admin();
  val alice = ft3_helper_tests.register_alice();

  utils.register_test_asset_and_mint_to_account(admin, alice);

  val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
  val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

  utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);
  utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id, amount = 2);
}

function test_create_offers_for_unlisted_nft_by_two_accounts() {
  val admin = ft3_helper_tests.register_admin();
  val alice = ft3_helper_tests.register_alice();
  val bob = ft3_helper_tests.register_bob();

  originals_tests_helper.init_originals(admin);
  originals_tests_helper.initialize_mock_interfaces(admin);

  originals_external_dev.create_asset_and_mint_to_accounts(originals_tests_mocks.ASSET_NAME, [alice.auth_id.account_id, bob.auth_id.account_id], 50)
            .sign(admin.keypair)
            .run();

  val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
  val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

  utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);
  utils.create_or_update_offer_of_unlisted_nft(bob, bertha_id, amount = 20);

  val nft_offers = utils.find_offers_by_asset_id(bertha_id);

  assert_equals(nft_offers.size(), 2);
  assert_equals(nft_offers[0].maker_descriptor.amount, 1);
  assert_equals(nft_offers[1].maker_descriptor.amount, 20);
}

function test_update_offer_for_unlisted_by_the_same_account() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    utils.register_test_asset_and_mint_to_account(admin, alice);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);
    utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id, amount = 20);

    val nft_offers = utils.find_offers_by_asset_id(bertha_id);

    assert_equals(nft_offers.size(), 1);
    assert_equals(nft_offers[0].taker_descriptor.amount, 20);
}

function test_nft_owner_accepts_offer_of_unlisted_nft() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    utils.register_test_asset_and_mint_to_account(admin, alice);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    assert_equals(originals_core.Ownership.get_owner_if_one_by_original_id(bertha_id), admin.auth_id.account_id);

    utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);

    marketplace_external.Operations.accept_offer(admin.auth_id, bertha_id, alice.auth_id.account_id)
        .sign(admin.keypair)
        .run();

    assert_equals(originals_core.Ownership.get_owner_if_one_by_original_id(bertha_id), alice.auth_id.account_id);
}

