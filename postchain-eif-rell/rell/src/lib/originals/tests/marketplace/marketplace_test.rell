function test_close_auction() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register_test_asset_and_mint_to_account(admin, bob);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(admin, bertha_id, price = 99, settlement_type = originals_marketplace.Marketplace.settlement_type.auction);
    
    var settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);
    
    marketplace_external.Operations.bid(bob.auth_id, settlement_id, 100)
        .sign(bob.keypair).run();
    
    marketplace_external.OperationsDev.close_auction(
        settlement_id,
        originals_tests_mocks.VALID_EXPIRATION + 1
    ).sign(bob.keypair).run();
        
    assert_equals(originals_core.ft3_core.get_asset_balance(bob.auth_id.account_id, originals_tests_mocks.ASSET_ID)!!.amount, 900);
    assert_equals(originals_core.ft3_core.get_asset_balance(admin.auth_id.account_id, originals_tests_mocks.ASSET_ID)!!.amount, 1100);
    assert_true(originals_util.Ft3Helper.owns_original(bob.auth_id.account_id, bertha_id));
    
    // No bids
    val (bertha2_id, bertha2_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(
    admin,
    bertha2_id,
    price = 99,
    settlement_type = originals_marketplace.Marketplace.settlement_type.auction,
        salt = 999
  );
    
    settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha2_id, 999);
    
    marketplace_external.OperationsDev.close_auction(
        settlement_id,
        originals_tests_mocks.VALID_EXPIRATION + 1
    ).sign(bob.keypair).run();
    
    assert_true(originals_util.Ft3Helper.owns_original(admin.auth_id.account_id, bertha2_id));
}

function test_register_settled_event() {
    val admin = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val bob_evm_account_id = evm_accounts_external.Queries.derive_evm_account_id(originals_tests_mocks.BOB_ADDRESS);
    val alice = ft3_helper_tests.register_alice();
    utils.register(admin);
    val oracle = admin;
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);

    // Original with EVM payment
  marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
        
    marketplace_external.Operations
        .register_settled_event(originals_tests_mocks.BOB_ADDRESS, utils.DUMMY_SIGNATURE)
        .sign(oracle.keypair)
        .run();
    
    assert_true(originals_util.Ft3Helper.owns_original(bob_evm_account_id, bertha_id));
    var settlement_descriptor = marketplace_external.Queries.get_settlement_descriptor(utils.DUMMY_SIGNATURE);    
    assert_equals(settlement_descriptor, null);
    
    // EVM with EVM payment
    val (bertha2_id, bertha2_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    marketplace_external.Operations.register_evm_asset("0x6c0228eB11a3c5866f740Db5baa8e5BCdB15a0b7", originals_marketplace.Marketplace.evm_type.erc721, bertha2_id, 1)
        .sign(oracle.keypair).run();
    marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        bertha2_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
    
    NOP().op(marketplace_external.Operations.register_settled_event(originals_tests_mocks.BOB_ADDRESS, utils.DUMMY_SIGNATURE))
        .sign(oracle.keypair)
        .run();
    
    settlement_descriptor = marketplace_external.Queries.get_settlement_descriptor(utils.DUMMY_SIGNATURE);    
    assert_equals(settlement_descriptor, null);
}


function test_settle_linked() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register_test_asset_and_mint_to_account(admin, bob);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    val cow_ids = list<byte_array>();
    for(i in range(5)) {
        val (id, _) = collections_tests_helper.create_cow(admin, mock_collection.name); 
        cow_ids.add(id);
    }
    
    val (ranch_id, ranch_instance) = utils.create_ranch(admin, mock_collection.name, cow_ids);
    
    originals_tests_helper.list_original(admin, ranch_id);
    
    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, ranch_id, 123);
    
    marketplace_external.Operations.settle(
        bob.auth_id,
        settlement_id
    ).sign(bob.keypair).run();
    
    assert_true(originals_util.Ft3Helper.owns_original(bob.auth_id.account_id, ranch_id));
    
    val instances = originals_core.Ownership.get_linked_originals(ranch_instance);
    val bob_ft3_account = originals_util.Ft3Helper.get_ft3_account(bob.auth_id.account_id);
    while (not instances.empty()) {
        val instance = instances.remove_at(0);

         assert_true(originals_util.Ft3Helper.owns_asset(
             ft3_helper.find_locked_account(originals_util.Ft3Helper.LINKED, bob_ft3_account)!!.id,
             originals_core.Id.get_id(instance)
         ));
    }
}

function test_it_should_find_listed_originals_by_collection() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
  
    utils.register_test_asset_and_mint_to_account(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

        originals_tests_helper.list_original(admin, bertha_id);

        val originals = marketplace_external.Queries.find_listed_originals_by_collection(
        mock_collection.name,
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_tests_helper.default_cursor()
    );

    val settlement_descriptor_id = originals_marketplace.Marketplace.settlement_descriptor @ {
        .maker_descriptor.asset.id == bertha_id
    }.id;

    val expected_response = dip_utils.paged_result(
        next_cursor = null,
        data = [[
            "attributes": [
                "face": "neutral".to_gtv()
            ].to_gtv(),
            "badges": list<map<name, gtv?>>().to_gtv(),
            "children": list<map<name, gtv?>>().to_gtv(),
            "creator_id": admin.auth_id.account_id.to_gtv(),
            "creator_name": "Admin".to_gtv(),
            "description": null,
            "id": bertha_id.to_gtv(),
            "name": "Test Original".to_gtv(),
            "settlement_descriptor": map<name, gtv>([
                "amount": (100).to_gtv(),
                "asset_id": originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id.to_gtv(),
                "asset_type": (0).to_gtv(),
                "expiration": originals_tests_mocks.VALID_EXPIRATION.to_gtv(),
                "id": settlement_descriptor_id.to_gtv(),
                "maker": admin.auth_id.account_id.to_gtv(),
                "settlement_type": (0).to_gtv()
            ]).to_gtv(),
            "tx_history": list<map<name, gtv?>>().to_gtv(),
            "collection_name": mock_collection.name.to_gtv()
        ].to_gtv()]
    );

    assert_equals(originals, expected_response);
}

function test_close_auction_linked() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register_test_asset_and_mint_to_account(admin, bob);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    val cow_ids = list<byte_array>();
    for(i in range(5)) {
        val (id, _) = utils.create_cow(admin, mock_collection.name); 
        cow_ids.add(id);
    }
    
    val (ranch_id, ranch_instance) = utils.create_ranch(admin, mock_collection.name, cow_ids);
    
    originals_tests_helper.list_original(admin, ranch_id, price = 99, settlement_type = originals_marketplace.Marketplace.settlement_type.auction);
    
    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, ranch_id, 123);
    
    marketplace_external.Operations.bid(bob.auth_id, settlement_id, 100)
        .sign(bob.keypair).run();
    
    marketplace_external.OperationsDev.close_auction(
        settlement_id,
        originals_tests_mocks.VALID_EXPIRATION + 1
    ).sign(bob.keypair).run();
    
    assert_true(originals_util.Ft3Helper.owns_original(bob.auth_id.account_id, ranch_id));
    
    val instances = originals_core.Ownership.get_linked_originals(ranch_instance);
    val bob_ft3_account = originals_util.Ft3Helper.get_ft3_account(bob.auth_id.account_id);
    while (not instances.empty()) {
        val instance = instances.remove_at(0);
         assert_true(originals_util.Ft3Helper.owns_asset(
             ft3_helper.find_locked_account(originals_util.Ft3Helper.LINKED, bob_ft3_account)!!.id,
             originals_core.Id.get_id(instance)
         ));
    }
}

function test_it_should_not_find_originals_by_collection_when_original_not_listed() {
    val alice = ft3_helper_tests.register_alice();
    val bob = ft3_helper_tests.register_bob();
    val admin = ft3_helper_tests.register_admin();
 
    utils.register_test_asset_and_mint_to_account(admin);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);  
        
    val originals = marketplace_external.Queries.find_listed_originals_by_collection(
        mock_collection.name,
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_tests_helper.default_cursor()
    );

    val expected_response = dip_utils.paged_result(
        next_cursor = null,
        data = []
    );
   
    assert_equals(originals, expected_response);
}

function test_register_paid_event_linked() {
    val admin = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val oracle = admin;
    val bob_evm_account_id = evm_accounts_external.Queries.derive_evm_account_id(originals_tests_mocks.BOB_ADDRESS);
    val alice = ft3_helper_tests.register_alice();
    utils.register(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    
    val cow_ids = list<byte_array>();
    for(i in range(5)) {
        val (id, _) = collections_tests_helper.create_cow(admin, mock_collection.name); 
        cow_ids.add(id);
    }
    
    val (ranch_id, ranch_instance) = utils.create_ranch(admin, mock_collection.name, cow_ids);
    
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);
    
    marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        ranch_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
    
    val settlement_descriptor = marketplace_external.Queries.get_settlement_descriptor(utils.DUMMY_SIGNATURE);    
    
    marketplace_external.Operations
        .register_settled_event(originals_tests_mocks.BOB_ADDRESS, utils.DUMMY_SIGNATURE)
        .sign(oracle.keypair)
        .run();
    
    assert_true(originals_util.Ft3Helper.owns_original(bob_evm_account_id, ranch_id));
    
    val instances = originals_core.Ownership.get_linked_originals(ranch_instance);
    val bob_ft3_account = originals_util.Ft3Helper.get_ft3_account(bob_evm_account_id);
    while (not instances.empty()) {
        val instance = instances.remove_at(0);
         assert_true(originals_util.Ft3Helper.owns_asset(
             ft3_helper.find_locked_account(originals_util.Ft3Helper.LINKED, bob_ft3_account)!!.id,
             originals_core.Id.get_id(instance)
         ));
    }
}

