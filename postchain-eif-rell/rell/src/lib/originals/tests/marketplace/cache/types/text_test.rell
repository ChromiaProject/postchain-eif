@test module;


import originals_core: ^^^^^.core;
import dip_core: ^^^^^^.dip.core;
import originals_external: ^^^^^.external;
import ft3_helper_tests: ^^^^^^.ft3_helper.tests;
import dip_attributes: ^^^^^^.dip.attributes;
import dip_external: ^^^^^^.dip.external;
import marketplace_cache_types: ^^^^^.marketplace.cache.types;
import ^^^^^^.dip.tests.{get_last_instance};
import ^^^^^^.dip.external.{set_type_attribute_meta};

namespace ITestText {
    val interface = "ITestText";
    
    val foo = dip_core.Attribute.I(interface, name = "foo");
    val color = dip_core.Attribute.I(interface, name = "color");
    
    function register(ft3_helper_tests.auth_data) {
        dip_external.def_interface(auth_data.auth_id, interface, [
            foo: dip_core.Type(dip_attributes.Text.T(),[dip_core.Mutable()]),
            color: dip_core.Type(dip_attributes.Text.T(), [dip_core.Mutable(), dip_core.Optional()])
        ])
        .sign(auth_data.keypair)
        .run();
    }
    
    function get() = dip_core.Interface.get(interface);
    
    function create_instance(user: ft3_helper_tests.auth_data, attributes: map<dip_core.Attribute.I, dip_core.attribute_type>) {
        rell.test.tx()
            .op(dip_external.def_instance(
                user.auth_id, 
                ITestText.interface, 
                attributes
            ))
            .nop()
            .sign(user.keypair)
            .run();

        return get_last_instance();
        
    }
}

function test_attribute_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    ITestText.register(admin);
    
    ITestText.create_instance(
        admin,
        [
            ITestText.foo: dip_attributes.Text.T("bar")
        ]
    );
    
    val values = marketplace_cache_types.Cache.Text.get_values(dip_core.Attribute.get(ITestText.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITestText.foo),
            value = "bar",
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attribute_values_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    ITestText.register(admin);
    
    ITestText.create_instance(
        admin,
        [
            ITestText.foo: dip_attributes.Text.T("bar")
        ]
    );
    
    ITestText.create_instance(
        admin,
        [
            ITestText.foo: dip_attributes.Text.T("foo")
        ]
    );
    
    val values = marketplace_cache_types.Cache.Text.get_values(dip_core.Attribute.get(ITestText.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITestText.foo),
            value = "bar",
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(ITestText.foo),
            value = "foo",
            count = 1
        )
    ];

    assert_equals(values, expected_values);    
}

function test_multiple_attributes_with_different_values_can_be_marketplace_cache_typesd_right() {
    val admin = ft3_helper_tests.register_admin();
    
    ITestText.register(admin);
    
    val color_instance = ITestText.create_instance(
        admin,
        [
            ITestText.foo: dip_attributes.Text.T("bar"),
            ITestText.color: dip_attributes.Text.T("blue")
        ] 
    );

    
    ITestText.create_instance(
        admin,
        [
            ITestText.foo: dip_attributes.Text.T("bar"),
            ITestText.color: dip_attributes.Text.T("blue")
        ]
    );

    set_type_attribute_meta(
        admin.auth_id, 
        color_instance, 
        ITestText.color, 
        "green".to_gtv()
    )
    .sign(admin.keypair)
    .run();
    
    val values = marketplace_cache_types.Cache.Text.get_values(dip_core.Attribute.get(ITestText.color));
    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITestText.color),
            value = "blue",
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(ITestText.color),
            value = "green",
            count = 1
        )
    ];

    assert_equals(values, expected_values);

}

function test_multiple_attributes_with_same_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    ITestText.register(admin);
    
    ITestText.create_instance(
        admin,
        [
            ITestText.foo: dip_attributes.Text.T("bar")
        ] 
    );

    
    ITestText.create_instance(
        admin,
        [
            ITestText.foo: dip_attributes.Text.T("bar")
        ]
    );

    val values = marketplace_cache_types.Cache.Text.get_values(dip_core.Attribute.get(ITestText.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITestText.foo),
            value = "bar",
            count = 2
        )   
    ];

    assert_equals(values, expected_values);
}