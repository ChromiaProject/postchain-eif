@test module;

import originals_core: ^^^^^.core;
import dip_core: ^^^^^^.dip.core;
import originals_external: ^^^^^.external;
import ft3_helper_tests: ^^^^^^.ft3_helper.tests;
import dip_attributes: ^^^^^^.dip.attributes;
import dip_external: ^^^^^^.dip.external;
import marketplace_cache_types: ^^^^^.marketplace.cache.types;
import ^^^^^^.dip.tests.{get_last_instance};

namespace IDecimalTest {
    val interface = "IDecimalTest";
    
    val foo = dip_core.Attribute.I(interface, name = "foo");
    val color_number = dip_core.Attribute.I(interface, name = "color_number");

    function register(ft3_helper_tests.auth_data) {
        dip_external.def_interface(auth_data.auth_id, interface, [
            foo: dip_core.Type(dip_attributes.Decimal.T(), [dip_core.Mutable()]),
            color_number: dip_core.Type(dip_attributes.Decimal.T(), [dip_core.Mutable(), dip_core.Optional()])
        ])
        .sign(auth_data.keypair)
        .run();
    }

    function get() = dip_core.Interface.get(interface);
    
    function create_instance(user: ft3_helper_tests.auth_data, attributes: map<dip_core.Attribute.I, dip_core.attribute_type>) {
        rell.test.tx()
            .op(dip_external.def_instance(
                user.auth_id, 
                IDecimalTest.interface, 
                attributes
            ))
            .nop()
            .sign(user.keypair)
            .run();
        return get_last_instance();
    }
}

function test_attribute_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    IDecimalTest.register(admin);
    
    IDecimalTest.create_instance(
        admin,
        [
            IDecimalTest.foo: dip_attributes.Decimal.T(1.1)
        ]
    );
    
    val values = marketplace_cache_types.Cache.Decimal.get_values(dip_core.Attribute.get(IDecimalTest.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(IDecimalTest.foo),
            value = 1.1,
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attribute_values_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    IDecimalTest.register(admin);
    
    IDecimalTest.create_instance(
        admin,
        [
            IDecimalTest.foo: dip_attributes.Decimal.T(1.1)
        ]
    );
    
    IDecimalTest.create_instance(
        admin,
        [
            IDecimalTest.foo: dip_attributes.Decimal.T(1.2)
        ]
    );
    
    val values = marketplace_cache_types.Cache.Decimal.get_values(dip_core.Attribute.get(IDecimalTest.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(IDecimalTest.foo),
            value = 1.1,
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(IDecimalTest.foo),
            value = 1.2,
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attributes_with_same_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    IDecimalTest.register(admin);
    
    IDecimalTest.create_instance(
        admin,
        [
            IDecimalTest.foo: dip_attributes.Decimal.T(1.1)
        ] 
    );

    
    IDecimalTest.create_instance(
        admin,
        [
            IDecimalTest.foo: dip_attributes.Decimal.T(1.1)
        ]
    );

    val values = marketplace_cache_types.Cache.Decimal.get_values(dip_core.Attribute.get(IDecimalTest.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(IDecimalTest.foo),
            value = 1.1,
            count = 2
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attributes_with_different_values_can_be_marketplace_cache_typesd_right() {
    val admin = ft3_helper_tests.register_admin();
    
    IDecimalTest.register(admin);
    
    val color_instance = IDecimalTest.create_instance(
        admin,
        [
            IDecimalTest.foo: dip_attributes.Decimal.T(1.1),
            IDecimalTest.color_number: dip_attributes.Decimal.T(2.5)
        ]
    );
    
    IDecimalTest.create_instance(
        admin,
        [
            IDecimalTest.foo: dip_attributes.Decimal.T(1.2),
            IDecimalTest.color_number: dip_attributes.Decimal.T(2.5)
        ]
    );
    
    dip_external.set_type_attribute_meta(
        admin.auth_id, 
        color_instance, 
        IDecimalTest.color_number, 
        (10.5).to_gtv()
    )
    .sign(admin.keypair)
    .run();

    val values = marketplace_cache_types.Cache.Decimal.get_values(dip_core.Attribute.get(IDecimalTest.color_number));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(IDecimalTest.color_number),
            value = 2.5,
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(IDecimalTest.color_number),
            value = 10.5,
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}
