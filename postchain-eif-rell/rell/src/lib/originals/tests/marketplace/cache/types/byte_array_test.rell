@test module;

import originals_core: ^^^^^.core;
import dip_core: ^^^^^^.dip.core;
import originals_external: ^^^^^.external;
import ft3_helper_tests: ^^^^^^.ft3_helper.tests;
import dip_attributes: ^^^^^^.dip.attributes;
import dip_external: ^^^^^^.dip.external;
import marketplace_cache_types: ^^^^^.marketplace.cache.types;
import ^^^^^^.dip.tests.{get_last_instance};

namespace IByteArrayTest {
    val interface = "IByteArrayTest";
    
    val byte_arr = dip_core.Attribute.I(interface, name = "byte_arr");
    val color_code = dip_core.Attribute.I(interface, name = "color_code");
    
    function register(ft3_helper_tests.auth_data) {
        dip_external.def_interface(auth_data.auth_id, interface, [
            byte_arr: dip_core.Type(dip_attributes.ByteArray.T(), [dip_core.Mutable()]),
            color_code: dip_core.Type(dip_attributes.ByteArray.T(), [dip_core.Mutable(), dip_core.Optional()])
        ])
        .sign(auth_data.keypair)
        .run();
    }

    function get() = dip_core.Interface.get(interface);
    
    function create_instance(user: ft3_helper_tests.auth_data, attributes: map<dip_core.Attribute.I, dip_core.attribute_type>) {
        rell.test.tx()
            .op(dip_external.def_instance(
                user.auth_id, 
                IByteArrayTest.interface, 
                attributes
            ))
            .nop()
            .sign(user.keypair)
            .run();
        
        return get_last_instance();
    }
}

function test_attribute_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    IByteArrayTest.register(admin);
    
    IByteArrayTest.create_instance(
        admin,
        [
            IByteArrayTest.byte_arr: dip_attributes.ByteArray.T(x"")
        ]
    );
    
    val values = marketplace_cache_types.Cache.ByteArray.get_values(dip_core.Attribute.get(IByteArrayTest.byte_arr));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(IByteArrayTest.byte_arr),
            value = x"",
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attribute_values_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    IByteArrayTest.register(admin);
    
    IByteArrayTest.create_instance(
        admin,
        [
            IByteArrayTest.byte_arr: dip_attributes.ByteArray.T(x"")
        ]
    );
    
    IByteArrayTest.create_instance(
        admin,
        [
            IByteArrayTest.byte_arr: dip_attributes.ByteArray.T(x"deadbeef")
        ]
    );
    
    val values = marketplace_cache_types.Cache.ByteArray.get_values(dip_core.Attribute.get(IByteArrayTest.byte_arr));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(IByteArrayTest.byte_arr),
            value = x"",
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(IByteArrayTest.byte_arr),
            value = x"deadbeef",
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attributes_with_same_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    IByteArrayTest.register(admin);
    
    IByteArrayTest.create_instance(
        admin,
        [
            IByteArrayTest.byte_arr: dip_attributes.ByteArray.T(x"")
        ] 
    );

    
    IByteArrayTest.create_instance(
        admin,
        [
            IByteArrayTest.byte_arr: dip_attributes.ByteArray.T(x"")
        ]
    );

    val values = marketplace_cache_types.Cache.ByteArray.get_values(dip_core.Attribute.get(IByteArrayTest.byte_arr));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(IByteArrayTest.byte_arr),
            value = x"",
            count = 2
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attributes_with_different_values_can_be_marketplace_cache_typesd_right() {
    val admin = ft3_helper_tests.register_admin();
    
    IByteArrayTest.register(admin);
    
    val byte_array_instance = IByteArrayTest.create_instance(
        admin,
        [
            IByteArrayTest.byte_arr: dip_attributes.ByteArray.T(x""),
            IByteArrayTest.color_code: dip_attributes.ByteArray.T(x"012345")
            
        ]
    );
    
    IByteArrayTest.create_instance(
        admin,
        [
            IByteArrayTest.byte_arr: dip_attributes.ByteArray.T(x"deadbeef"),
            IByteArrayTest.color_code: dip_attributes.ByteArray.T(x"012345")
        ]
    );

    dip_external.set_type_attribute_meta(
        admin.auth_id, 
        byte_array_instance, 
        IByteArrayTest.color_code, 
        (x"654321").to_gtv()
    )
    .sign(admin.keypair)
    .run();
    
    val values = marketplace_cache_types.Cache.ByteArray.get_values(dip_core.Attribute.get(IByteArrayTest.color_code));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(IByteArrayTest.color_code),
            value = x"012345",
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(IByteArrayTest.color_code),
            value = x"654321",
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}

