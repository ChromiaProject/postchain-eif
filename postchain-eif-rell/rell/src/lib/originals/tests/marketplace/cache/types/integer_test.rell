@test module;


import originals_core: ^^^^^.core;
import dip_core: ^^^^^^.dip.core;
import originals_external: ^^^^^.external;
import ft3_helper_tests: ^^^^^^.ft3_helper.tests;
import dip_attributes: ^^^^^^.dip.attributes;
import dip_external: ^^^^^^.dip.external;
import marketplace_cache_types: ^^^^^.marketplace.cache.types;
import ^^^^^^.dip.tests.{get_last_instance};

namespace ITest {
    val interface = "ITest";
    
    val foo = dip_core.Attribute.I(interface, name = "foo");
    val color_number = dip_core.Attribute.I(interface, name = "color_number");
    
    function register(ft3_helper_tests.auth_data) {
        dip_external.def_interface(auth_data.auth_id, interface, [
            foo: dip_core.Type(dip_attributes.Integer.T(), [dip_core.Mutable()]),
            color_number: dip_core.Type(dip_attributes.Integer.T(), [dip_core.Mutable(), dip_core.Optional()])
        ])
        .sign(auth_data.keypair)
        .run();
    }
    
    function get() = dip_core.Interface.get(interface);
    
    function create_instance(user: ft3_helper_tests.auth_data, attributes: map<dip_core.Attribute.I, dip_core.attribute_type>) {
        rell.test.tx()
            .op(dip_external.def_instance(
                user.auth_id, 
                ITest.interface, 
                attributes
            ))
            .nop()
            .sign(user.keypair)
            .run();

        return get_last_instance();
    }
}

function test_attribute_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    ITest.register(admin);
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(20)
        ]
    );
    
    val values = marketplace_cache_types.Cache.Integer.get_values(dip_core.Attribute.get(ITest.foo));
    
    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITest.foo),
            value = 20,
            count = 1
        )
    ];
    
    assert_equals(values, expected_values);
}

function test_multiple_attribute_values_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    ITest.register(admin);
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(20)
        ]
    );
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(10)
        ]
    );    
    
    val values = marketplace_cache_types.Cache.Integer.get_values(dip_core.Attribute.get(ITest.foo));
    
    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITest.foo),
            value = 20,
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(ITest.foo),
            value = 10,
            count = 1
        )
    ];
    
    assert_equals(values, expected_values);    
}

function test_updated_attribute_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    ITest.register(admin);
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(20)
        ]
    );
    
    val instance = get_last_instance();
    
    dip_external.set_type_attribute_meta(admin.auth_id, instance, ITest.foo, (10).to_gtv())
        .sign(admin.keypair)
        .run();
    
    val values = marketplace_cache_types.Cache.Integer.get_values(dip_core.Attribute.get(ITest.foo));
    
    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITest.foo),
            value = 10,
            count = 1
        )
    ];
    
    assert_equals(values, expected_values);    
}

function test_multiple_attributes_with_same_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    ITest.register(admin);
    
    ITest.create_instance(
        admin,    
        [
            ITest.foo: dip_attributes.Integer.T(30)
        ]
    );
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(30)
        ]
    );
        
    val values = marketplace_cache_types.Cache.Integer.get_values(dip_core.Attribute.get(ITest.foo));
    
    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITest.foo),
            value = 30,
            count = 2
        )
    ];
    
    assert_equals(values, expected_values);
}

function test_removing_value_before_update_marketplace_cache_types() {
    val admin = ft3_helper_tests.register_admin();
    
    ITest.register(admin);
    
    ITest.create_instance(
        admin,    
        [
            ITest.foo: dip_attributes.Integer.T(30)
        ]
    );
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(30)
        ]
    );
        
    val values = marketplace_cache_types.Cache.Integer.get_values(dip_core.Attribute.get(ITest.foo));
    
    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITest.foo),
            value = 30,
            count = 2
        )
    ];
    
    assert_equals(values, expected_values);
}

function test_multiple_attributes_with_different_values_can_be_marketplace_cache_typesd_right() {
    val admin = ft3_helper_tests.register_admin();
    
    ITest.register(admin);
    
    val color_instance = ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(50),
            ITest.color_number: dip_attributes.Integer.T(30)
        ]
    );
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(30),
            ITest.color_number: dip_attributes.Integer.T(30)
        ]
    );

    dip_external.set_type_attribute_meta(
        admin.auth_id, 
        color_instance, 
        ITest.color_number, 
        (150).to_gtv()
    )
    .sign(admin.keypair)
    .run();
        
    val values = marketplace_cache_types.Cache.Integer.get_values(dip_core.Attribute.get(ITest.color_number));
    
    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(ITest.color_number),
            value = 30,
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(ITest.color_number),
            value = 150,
            count = 1
        )
    ];
    
    assert_equals(values, expected_values);
}

function test_min_value_in_marketplace_cache_types() {
    val admin = ft3_helper_tests.register_admin();
    
    ITest.register(admin);
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(150),
            ITest.color_number: dip_attributes.Integer.T(30)
        ]
    );

    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(150),
            ITest.color_number: dip_attributes.Integer.T(130)
        ]
    );    

    val min_value = marketplace_cache_types.Cache.Integer.get_min_value(dip_core.Attribute.get(ITest.color_number));
    assert_equals(min_value, 30);
}

function test_max_value_in_marketplace_cache_types() {
    val admin = ft3_helper_tests.register_admin();
    
    ITest.register(admin);
    
    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(50),
            ITest.color_number: dip_attributes.Integer.T(150)
        ]
    );

    ITest.create_instance(
        admin,
        [
            ITest.foo: dip_attributes.Integer.T(50),
            ITest.color_number: dip_attributes.Integer.T(50)
        ]
    );

    val max_value = marketplace_cache_types.Cache.Integer.get_max_value(dip_core.Attribute.get(ITest.color_number));
    assert_equals(max_value, 150);
}
