@test module;

import originals_core: ^^^^^.core;
import originals_external: ^^^^^.external;
import ft3_helper_tests: ^^^^^^.ft3_helper.tests;
import dip_attributes: ^^^^^^.dip.attributes;
import dip_external: ^^^^^^.dip.external;
import dip_core: ^^^^^^.dip.core;
import marketplace_cache_types: ^^^^^.marketplace.cache.types;
import ^^^^^^.dip.tests.{get_last_instance};


namespace Idip_core.BooleanTest {
    val interface = "Idip_core.BooleanTest";
    
    val foo = dip_core.Attribute.I(interface, name = "foo");
    val with_color = dip_core.Attribute.I(interface, name = "with_color");
    function register(ft3_helper_tests.auth_data) {
        dip_external.def_interface(auth_data.auth_id, interface, [
            foo: dip_core.Type(dip_attributes.Boolean.T(), [dip_core.Mutable()]),
            with_color: dip_core.Type(dip_attributes.Boolean.T(), [dip_core.Mutable(), dip_core.Optional()])
        ])
        .sign(auth_data.keypair)
        .run();
    }

    function get() = dip_core.Interface.get(interface);
    
    function create_instance(user: ft3_helper_tests.auth_data, attributes: map<dip_core.Attribute.I, dip_core.attribute_type>) {
        rell.test.tx()
            .op(dip_external.def_instance(
                user.auth_id, 
                Idip_core.BooleanTest.interface, 
                attributes
            ))
            .nop()
            .sign(user.keypair)
            .run();
        
        return get_last_instance();
    }
}

function test_attribute_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    Idip_core.BooleanTest.register(admin);
    
    Idip_core.BooleanTest.create_instance(
        admin,
        [
            Idip_core.BooleanTest.foo: dip_attributes.Boolean.T(true)
        ]
    );
    
    val values = marketplace_cache_types.Cache.Boolean.get_values(dip_core.Attribute.get(Idip_core.BooleanTest.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(Idip_core.BooleanTest.foo),
            value = true,
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attribute_values_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    Idip_core.BooleanTest.register(admin);
    
    Idip_core.BooleanTest.create_instance(
        admin,
        [
            Idip_core.BooleanTest.foo: dip_attributes.Boolean.T(true)
        ]
    );
    
    Idip_core.BooleanTest.create_instance(
        admin,
        [
            Idip_core.BooleanTest.foo: dip_attributes.Boolean.T(false)
        ]
    );
    
    val values = marketplace_cache_types.Cache.Boolean.get_values(dip_core.Attribute.get(Idip_core.BooleanTest.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(Idip_core.BooleanTest.foo),
            value = true,
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(Idip_core.BooleanTest.foo),
            value = false,
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attributes_with_same_value_can_be_marketplace_cache_typesd() {
    val admin = ft3_helper_tests.register_admin();
    
    Idip_core.BooleanTest.register(admin);
    
    Idip_core.BooleanTest.create_instance(
        admin,
        [
            Idip_core.BooleanTest.foo: dip_attributes.Boolean.T(true)
        ] 
    );

    
    Idip_core.BooleanTest.create_instance(
        admin,
        [
            Idip_core.BooleanTest.foo: dip_attributes.Boolean.T(true)
        ]
    );

    val values = marketplace_cache_types.Cache.Boolean.get_values(dip_core.Attribute.get(Idip_core.BooleanTest.foo));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(Idip_core.BooleanTest.foo),
            value = true,
            count = 2
        )
    ];

    assert_equals(values, expected_values);
}

function test_multiple_attributes_with_different_values_can_be_marketplace_cache_typesd_right() {
    val admin = ft3_helper_tests.register_admin();
    
    Idip_core.BooleanTest.register(admin);
    
    val boolean_instance = Idip_core.BooleanTest.create_instance(
        admin,
        [
            Idip_core.BooleanTest.foo: dip_attributes.Boolean.T(true),
            Idip_core.BooleanTest.with_color: dip_attributes.Boolean.T(false)
        ] 
    );

    
    Idip_core.BooleanTest.create_instance(
        admin,
        [
            Idip_core.BooleanTest.foo: dip_attributes.Boolean.T(true),
            Idip_core.BooleanTest.with_color: dip_attributes.Boolean.T(false)
        ]
    );

    dip_external.set_type_attribute_meta(
        admin.auth_id, 
        boolean_instance, 
        Idip_core.BooleanTest.with_color, 
        (true).to_gtv()
    )
    .sign(admin.keypair)
    .run();

    val values = marketplace_cache_types.Cache.Boolean.get_values(dip_core.Attribute.get(Idip_core.BooleanTest.with_color));

    val expected_values = [
        (
            attribute = dip_core.Attribute.get_name(Idip_core.BooleanTest.with_color),
            value = false,
            count = 1
        ),
        (
            attribute = dip_core.Attribute.get_name(Idip_core.BooleanTest.with_color),
            value = true,
            count = 1
        )
    ];

    assert_equals(values, expected_values);
}
