function test_marketplace_can_define_categories() {
    val admin_acc = ft3_helper_tests.register_admin();
    utils.register_categories(admin_acc);
    
    val categories = originals_marketplace_category.Category.get_all();
    assert_equals(categories, [
        originals_marketplace_category.Category.node(name="Category 1", interfaces=[utils.CategoryInterface1.interface], list<originals_marketplace_category.Category.node>()),
        originals_marketplace_category.Category.node(name="Category 2", interfaces=[utils.CategoryInterface2.interface], list<originals_marketplace_category.Category.node>()),
        originals_marketplace_category.Category.node(name="Category 3", interfaces=[utils.CategoryInterface3.interface], [
        originals_marketplace_category.Category.node(name="Category 5", interfaces=[utils.CategoryInterface5.interface], list<originals_marketplace_category.Category.node>())
        ])
    ]);
}

