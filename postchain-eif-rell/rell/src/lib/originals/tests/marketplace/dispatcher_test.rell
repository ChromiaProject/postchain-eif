function test_it_should_succeed_to_get_instance_attribute_value_of_text_type() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    utils.register_test_asset_and_mint_to_account(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (_, bertha) = collections_tests_helper.create_cow(admin, mock_collection.name);

    val value = marketplace_cache.get_instance_attribute_value(
        bertha, 
        dip_core.Attribute.get(originals_tests_marketplace_mocks.ITradableBertha.face)
    );

    assert_equals(value, (
        name = "face",
        value = "neutral".to_gtv(),
        count = 1
    )); 
}

function test_get_instance_attribute_value_returns_null_for_non_primitive_types() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    originals_tests_marketplace_mocks.IMockOriginalWithFileAttribute.register(admin);
    val (_, instance) = utils.create_mock_original_with_file_attribute(admin, mock_collection.name);

    val value = marketplace_cache.get_instance_attribute_value(
        instance, 
        dip_core.Attribute.get(originals_tests_marketplace_mocks.IMockOriginalWithFileAttribute.file)
    );

    assert_null(value);
}

function test_it_should_succeed_to_get_value_count_of_boolean_type() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    originals_tests_marketplace_mocks.IMockOriginalWithBooleanAttribute.register(admin);
    utils.create_mock_original_with_boolean_attribute(admin, mock_collection.name);
    
    val count = marketplace_cache.types.Cache.Boolean.get_value_count(
        dip_core.Attribute.get(originals_tests_marketplace_mocks.IMockOriginalWithBooleanAttribute.is_boolean), 
        true
    );

    assert_equals(count, 1);
}

