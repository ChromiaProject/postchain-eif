@test module;

import originals_marketplace: ^^^.marketplace;
import marketplace_cache: ^^^.marketplace.cache;
import originals_tests_marketplace_mocks: ^^.marketplace.mocks;
import dip_core: ^^^^.dip.core;
import originals_external: ^^^.external;
import ft3_helper_tests: ^^^^.ft3_helper.tests;
import originals_tests_helper: ^^.helper;
import collections_tests_helper: ^^.collections.helper;
import utils: ^.utils;
import originals_tests_mocks: ^.mocks;


function test_it_should_succeed_to_get_instance_attribute_value_of_boolean_type() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);

    originals_tests_marketplace_mocks.IMockOriginalWithBooleanAttribute.register(admin);
    val (_, instance) = utils.create_mock_original_with_boolean_attribute(admin, mock_collection.name);

    val value = marketplace_cache.get_instance_attribute_value(
        instance, 
        dip_core.Attribute.get(originals_tests_marketplace_mocks.IMockOriginalWithBooleanAttribute.is_boolean)
    );

    assert_equals(value, (
        name = "is_boolean",
        value = true.to_gtv(),
        count = 1
    ));
}

