@test module;

import originals_external: ^^^.external;
import ft3_helper_tests: ^^^^.ft3_helper.tests;
import originals_core: ^^^.core;
import dip_core: ^^^^.dip.core;
import dip_attributes: ^^^^.dip.attributes;
import originals_tests_helper: ^^.helper;
import originals_tests_mocks: ^^.mocks;
import originals_marketplace_filter: ^^^.marketplace.filter;
import originals_marketplace: ^^^.marketplace;

namespace IFilter1 {
    val interface = "IFilter1";
    
    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_core.chromia.ITradable.interface
    ];
    
    val bar = dip_attributes.Attribute.I(interface, name = "bar");
    
    function register(ft3_helper_tests.auth_data) {
       originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                bar: dip_core.Type(dip_attributes.Text.T(), meta_list = [ originals_marketplace.Marketplace.Meta.Filter("Bar") ])
            ],
            dependencies()
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_attributes.Interface.get(interface);

    function mint(ft3_helper_tests.auth_data, collection_name: text, name, bar: text) {
        val minter_def = originals_core.Minter.I(
            interface_name = interface,
            [
                originals_core.chromia.IOriginal.name: dip_attributes.Text.T(name),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Tester"),
                originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image),
                IFilter1.bar: dip_attributes.Text.T(bar)
            ]
        );

        originals_external.mint_non_fungible_original(
            auth_data.auth_id,
            collection_name,
            minter_def
        ).sign(auth_data.keypair).run();
    }
}

namespace IFilter2 {
    val interface = "IFilter2";
    
    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_core.chromia.ITradable.interface
    ];
    
    val foo = dip_attributes.Attribute.I(interface, name = "foo");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                foo: dip_core.Type(dip_attributes.Integer.T(), meta_list = [ originals_marketplace.Marketplace.Meta.Filter("Foo") ])
            ],
            dependencies()
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_attributes.Interface.get(interface);

    function mint(ft3_helper_tests.auth_data, collection_name: text, name, foo: integer) {
        val minter_def = originals_core.Minter.I(
            interface_name = interface,
            [
                originals_core.chromia.IOriginal.name: dip_attributes.Text.T(name),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Tester"),
                originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image),
                IFilter2.foo: dip_attributes.Integer.T(foo)
            ]
        );

        originals_external.mint_non_fungible_original(
            auth_data.auth_id,
            collection_name,
            minter_def
        ).sign(auth_data.keypair).run();
    }
}

namespace IFilter3 {
    val interface = "IFilter3";
    
    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_core.chromia.ITradable.interface
    ];
    
    val bar = dip_attributes.Attribute.I(interface, name = "bar");
    val foo = dip_attributes.Attribute.I(interface, name = "foo");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [ 
                bar: dip_core.Type(dip_attributes.Text.T(), meta_list = [ originals_marketplace.Marketplace.Meta.Filter("Bar") ]),
                foo: dip_core.Type(dip_attributes.Integer.T(), meta_list = [ originals_marketplace.Marketplace.Meta.Filter("Foo") ])
                
            ],
            dependencies()
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_attributes.Interface.get(interface);

    function mint(ft3_helper_tests.auth_data, collection_name: text, name, foo: integer, bar: text) {
        val minter_def = originals_core.Minter.I(
            interface_name = interface,
            [
                originals_core.chromia.IOriginal.name: dip_attributes.Text.T(name),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Tester"),
                originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image),
                IFilter3.foo: dip_attributes.Integer.T(foo),
                IFilter3.bar: dip_attributes.Text.T(bar)
            ]
        );

        originals_external.mint_non_fungible_original(
            auth_data.auth_id,
            collection_name,
            minter_def
        ).sign(auth_data.keypair).run();
    }
}

function create_mock_instances_filter1(ft3_helper_tests.auth_data, collection_name: text) {
    IFilter1.register(auth_data);
    
    IFilter1.mint(auth_data, collection_name, "Superplastic GG", "superplastic");
    IFilter1.mint(auth_data, collection_name, "Ape First", "ape");
    IFilter1.mint(auth_data, collection_name, "Ape Second", "ape");
}

function create_mock_instances_filter2(ft3_helper_tests.auth_data, collection_name: text) {
    IFilter2.register(auth_data);
    
    IFilter2.mint(auth_data, collection_name, "Test Original", 10);
    IFilter2.mint(auth_data, collection_name, "Test Original", 13);
    IFilter2.mint(auth_data, collection_name, "Test Original", 35);
}

function create_mock_instances_filter3(ft3_helper_tests.auth_data, collection_name: text) {
    IFilter3.register(auth_data);
    
    IFilter3.mint(auth_data, collection_name, "Test Original", 5, "bar1");
    IFilter3.mint(auth_data, collection_name,"Test Original", 50, "bar2");
}

function create_mock_instances_filter4(ft3_helper_tests.auth_data, collection_name: text) {
    IFilter2.register(auth_data);
    
    IFilter2.mint(auth_data, collection_name, "Test Original", 5);
}

function test_marketplace_returns_options_filter() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    originals_tests_helper.init_originals(admin);
    create_mock_instances_filter1(admin, mock_collection.name);
    
    val filters = originals_marketplace_filter.Filter.get_by_interface(IFilter1.interface);
    
    assert_equals(filters, [
        "Bar": [
            "name": "bar".to_gtv(),
            "type": "options".to_gtv(),
            "values": [
                "ape": (2).to_gtv(),
                "superplastic": (1).to_gtv()
            ].to_gtv()
        ].to_gtv()
    ]);
    
    IFilter1.mint(admin, mock_collection.name, "Ape Third", "ape");
    IFilter1.mint(admin, mock_collection.name, "Superplastic LV", "superplastic");

    val updated_filters = originals_marketplace_filter.Filter.get_by_interface(IFilter1.interface);

    assert_equals(updated_filters, [
        "Bar": [
            "name": "bar".to_gtv(),
            "type": "options".to_gtv(),
            "values": [
                "ape": (3).to_gtv(),
                "superplastic": (2).to_gtv()
            ].to_gtv()
        ].to_gtv()
    ]);


}

function test_marketplace_returns_range_filter() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    create_mock_instances_filter2(admin, mock_collection.name);
    
    val filters = originals_marketplace_filter.Filter.get_by_interface(IFilter2.interface);

   assert_equals(filters, [
        "Foo": [
            "name": "foo".to_gtv(),
            "type": "range".to_gtv(),
            "values": [
                "min": (10).to_gtv(),
                "max": (35).to_gtv()
            ].to_gtv()
        ].to_gtv()
    ]);
}

function test_marketplace_returns_multiple_filter() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    create_mock_instances_filter3(admin, mock_collection.name);
    
    val filters = originals_marketplace_filter.Filter.get_by_interface(IFilter3.interface);

    assert_equals(filters, [
        "Foo": [
            "name": "foo".to_gtv(),
            "type": "range".to_gtv(),
            "values": [
                "min": (5).to_gtv(),
                "max": (50).to_gtv()
            ].to_gtv()
        ].to_gtv(),
        "Bar": [
            "name": "bar".to_gtv(),
            "type": "options".to_gtv(),
            "values": ["bar1": 1, "bar2": 1].to_gtv()
        ].to_gtv()
    ]);
}

function test_marketplace_returns_range_filter_without_minted_tokens() {
    val admin = ft3_helper_tests.register_admin();
    originals_tests_helper.init_originals(admin);
    IFilter2.register(admin);
    
    val filters = originals_marketplace_filter.Filter.get_by_interface(IFilter2.interface);

   assert_equals(filters, [
        "Foo": [
            "name": "foo".to_gtv(),
            "type": "range".to_gtv(),
            "values": [
                "min": (0).to_gtv(),
                "max": (100).to_gtv()
            ].to_gtv()
        ].to_gtv()
    ]);
}

function test_marketplace_returns_range_filter_with_same_min_max() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    originals_tests_helper.init_originals(admin);
    create_mock_instances_filter4(admin, mock_collection.name);
    
    val filters = originals_marketplace_filter.Filter.get_by_interface(IFilter2.interface);

   assert_equals(filters, [
        "Foo": [
            "name": "foo".to_gtv(),
            "type": "range".to_gtv(),
            "values": [
                "min": (5).to_gtv(),
                "max": (5).to_gtv()
            ].to_gtv()
        ].to_gtv()
    ]);
}
