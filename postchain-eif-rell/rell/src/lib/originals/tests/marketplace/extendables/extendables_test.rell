function test_before_create_settlement() {
    val admin = ft3_helper_tests.register_admin();
    marketplace_test_utils.register(admin);
    
    val (mock_collection, _) = originals_tests_helper.create_mock_collection(admin, admin, admin);  
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(admin, bertha_id);
    
    assert_true(extensions.marketplace_hooks_state.called_before_create_settlement);
    val inputs = [
        (ft3_account.account @ {admin.auth_id.account_id}).to_gtv(),
        bertha_id.to_gtv(),
        originals_marketplace.Marketplace.asset_type.original.to_gtv(),
        integer(1).to_gtv(),
        originals_util.Ft3Helper.get_asset(marketplace_test_utils.ASSET_ID).id.to_gtv(),
        originals_marketplace.Marketplace.asset_type.regular.to_gtv(),
        integer(100).to_gtv(),
        originals_tests_mocks.VALID_EXPIRATION.to_gtv(),
        integer(123).to_gtv(),
        originals_marketplace.Marketplace.settlement_type.fixed_price.to_gtv(),
        null.to_gtv()
    ];
    assert_equals(inputs.to_gtv().to_bytes(), extensions.marketplace_hooks_state.before_create_settlement_inputs);
}

function test_after_create_settlement() {
    val admin = ft3_helper_tests.register_admin();
    marketplace_test_utils.register(admin);
    
    val (mock_collection, _) = originals_tests_helper.create_mock_collection(admin, admin, admin);  
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);
    originals_tests_helper.list_original(admin, bertha_id);
    
    assert_true(extensions.marketplace_hooks_state.called_after_create_settlement);
    val sd = originals_marketplace.Marketplace.settlement_descriptor @ {settlement_id};
    assert_equals(sd.to_gtv().to_bytes(), extensions.marketplace_hooks_state.after_create_settlement_inputs);
}

