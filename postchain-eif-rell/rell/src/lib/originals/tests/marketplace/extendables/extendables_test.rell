function test_before_delete_settlement_register_cancelled_event() {
    val admin = marketplace_test_utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val oracle = admin;
    marketplace_test_utils.register(admin);

    val (mock_collection, _) = originals_tests_helper.create_mock_collection(admin, admin, admin);  
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    
    marketplace_external.Operations.register_evm_asset(marketplace_test_utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(marketplace_test_utils.NULL_ADDRESS);
        
    marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        marketplace_test_utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
        
    val sd = originals_marketplace.Marketplace.settlement_descriptor @ {marketplace_test_utils.DUMMY_SIGNATURE};
    
    marketplace_external.Operations.register_cancelled_event(marketplace_test_utils.DUMMY_SIGNATURE).sign(oracle.keypair).run();
        
    assert_true(extensions.marketplace_hooks_state.called_before_delete_settlement);
    assert_equals(sd.to_gtv().to_bytes(), extensions.marketplace_hooks_state.before_delete_settlement_inputs);
}

