function test_before_settle() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    marketplace_test_utils.register(admin, bob);
    
    val (mock_collection, _) = originals_tests_helper.create_mock_collection(admin, admin, admin);  
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    originals_tests_helper.list_original(admin, bertha_id);
    
    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);
    val sd = originals_marketplace.Marketplace.settlement_descriptor @ {settlement_id};
    
    marketplace_external.Operations.settle(
        bob.auth_id,
        settlement_id
    ).sign(bob.keypair).run();
        
    assert_true(extensions.marketplace_hooks_state.called_before_settle);
    assert_equals([
        (ft3_account.account @ {bob.auth_id.account_id}).to_gtv(),
        sd.to_gtv()
    ].to_gtv().to_bytes(), extensions.marketplace_hooks_state.before_settle_inputs);
}

