function test_settle_fail_on_evm_type_settlement() {   
    val admin_account = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val oracle = admin_account;
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin_account, bob);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin_account, bob, admin_account);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin_account, mock_collection.name);
    
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);
    
    marketplace_external.OperationsDev.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        utils.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin_account.keypair).run();
    
    marketplace_external.Operations.settle(
        bob.auth_id,
        utils.DUMMY_SIGNATURE
    ).sign(bob.keypair).run_must_fail();
}

function test_auction_close_fail_cases() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin, bob);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    marketplace_external.Operations.create_settlement(
        admin.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        99,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.auction,
        null
    ).sign(admin.keypair).run();
    
    val settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);
    
    // cannot close auction before expiration time
    marketplace_external.OperationsDev.close_auction(
        settlement_id,
        originals_tests_mocks.VALID_EXPIRATION - 1
    ).sign(admin.keypair).run_must_fail();
}

function test_evm_listing_buy_fail_cases() {
    val admin_evm_account = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin_evm_account);
    val oracle = ft3_helper_tests.register_admin();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin_evm_account, bob, admin_evm_account);
    val (bertha_id, bertha_instance) = utils.create_cow(admin_evm_account, mock_collection.name);
    
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);
    
    marketplace_external.OperationsDev.create_settlement(
        admin_evm_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin_evm_account.keypair).run();
    
    val settlement_descriptor = marketplace_external.Queries.get_settlement_descriptor(utils.DUMMY_SIGNATURE);
                        
    // Oracle must utils.register events
    marketplace_external.Operations
        .register_settled_event(originals_tests_mocks.BOB_ADDRESS, utils.DUMMY_SIGNATURE)
        .sign(ft3_helper_tests.bob_keypair())
        .run_must_fail();

    // Settlement already settled    
    marketplace_external.Operations
        .register_settled_event(originals_tests_mocks.BOB_ADDRESS, utils.DUMMY_SIGNATURE)
        .sign(oracle.keypair)
        .run();
        
    marketplace_external.Operations
        .register_settled_event(originals_tests_mocks.BOB_ADDRESS, utils.DUMMY_SIGNATURE)
        .sign(oracle.keypair)
        .run_must_fail();
}

