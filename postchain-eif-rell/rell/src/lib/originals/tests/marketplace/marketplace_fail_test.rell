function test_cannot_accept_offer_if_original_owner_account_does_not_exist() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    utils.register_test_asset_and_mint_to_account(admin, alice);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);

    marketplace_external.Operations.accept_offer(
        ft3_helper.auth_id(
            account_id = x"0000",
            auth_descriptor_id = x"0000"
        ),
        bertha_id,
        alice.auth_id.account_id
    ).sign(admin.keypair).run_must_fail();
}

function test_cannot_accept_offer_if_buyers_available_balance_is_not_enough() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    utils.register_test_asset_and_mint_to_account(admin, alice, asset_amount = 10);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_one_id, _) = collections_tests_helper.create_cow(admin, mock_collection.name);
    val (bertha_two_id, _) = collections_tests_helper.create_cow(admin, mock_collection.name);

    utils.create_or_update_offer_of_unlisted_nft(alice, bertha_one_id, amount = 9);
    utils.create_or_update_offer_of_unlisted_nft(alice, bertha_two_id, amount = 9);

	marketplace_external.Operations.accept_offer(
		admin.auth_id,
		bertha_one_id,
		alice.auth_id.account_id
	).sign(admin.keypair).run();

	marketplace_external.Operations.accept_offer(
		admin.auth_id,
		bertha_two_id,
		alice.auth_id.account_id
	).sign(admin.keypair).run_must_fail();
}