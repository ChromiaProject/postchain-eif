function test_create_settlement_fails() {
    val admin_account = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val oracle = admin_account;
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin_account);
    val asset = originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin_account, bob, admin_account);
    
    // does not implement ITradable
    val (untradable_bertha_id, untradable_bertha_instance) = utils.create_non_tradable_cow(admin_account, mock_collection.name);
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        untradable_bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin_account, mock_collection.name);
    
    // no signer
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).run_must_fail();
    
    // wrong signer
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(bob.keypair).run_must_fail();
    
    // not owner
    marketplace_external.Operations.create_settlement(
        bob.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(bob.keypair).run_must_fail();
    
    // negative maker price
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        -1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    // null asset on maker descirptor
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.null_asset,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    // original doesn't exist
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        x'affe',
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    // asset doesn't exist
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        x'affe',
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    // expiration time is in the past
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        0,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);
    
    // evm asset in a non evm descriptor
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    // seller is not evm account
    marketplace_external.OperationsDev.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    // evm listing payment asset not utils.registered as EVM asset by admin
    marketplace_external.OperationsDev.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        null
    ).sign(admin_account.keypair).run_must_fail();
    
    // only maker offers evm asset
    marketplace_external.OperationsDev.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        null
    ).sign(admin_account.keypair).run_must_fail();

    
    // relisting
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run();
        
    marketplace_external.Operations.create_settlement(
        admin_account.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin_account.keypair).run_must_fail();
}

function test_delete_settlement_fails() {
    val admin = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val oracle = admin;
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    
    //not listed
    marketplace_external.Operations.delete_settlement(admin.auth_id, x'affe')
        .sign(admin.keypair).run_must_fail();
    
    marketplace_external.Operations.create_settlement(
        admin.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.fixed_price,
        null
    ).sign(admin.keypair).run();
    
    var settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha_id, 123);
    
    // no signer
    marketplace_external.Operations.delete_settlement(
        admin.auth_id,
        settlement_id
    ).run_must_fail();
    
    // wrong signer
    marketplace_external.Operations.delete_settlement(
        admin.auth_id,
        settlement_id
    )
    .sign(bob.keypair).run_must_fail();
    
    // not owner
    marketplace_external.Operations.delete_settlement(
        bob.auth_id,
        settlement_id
    )
    .sign(bob.keypair).run_must_fail();
    
    // can't delete non expired evm settlements
    val (bertha2_id, bertha2_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);
            
    marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        bertha2_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
    
    marketplace_external.OperationsDev.delete_settlement(
        admin.auth_id,
        utils.DUMMY_SIGNATURE,
        originals_tests_mocks.VALID_EXPIRATION - 1
    ).sign(admin.keypair).run_must_fail();
    
    // can't delete auction settlements
    val (bertha3_id, bertha3_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
        
    marketplace_external.Operations.create_settlement(
        admin.auth_id,
        bertha3_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        originals_util.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id,
        originals_marketplace.Marketplace.asset_type.regular,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.auction,
        null
    ).sign(admin.keypair).run();
    
    settlement_id = marketplace_external.Queries.derive_settlement_id(admin.auth_id.account_id, bertha3_id, 123);
    
    marketplace_external.Operations.delete_settlement(
        admin.auth_id,
        settlement_id
    ).sign(admin.keypair).run_must_fail();
}

function test_register_cancelled_event_fails() {
    val admin = utils.login_evm(ft3_helper_tests.admin_keypair(), originals_tests_mocks.ADMIN_ADDRESS, originals_tests_mocks.ADMIN_LOGIN_SIG);
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin, bob);
    val oracle = admin;

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
    
    // Delete cancelled EVM settlement
    marketplace_external.Operations.register_evm_asset(utils.NULL_ADDRESS, originals_marketplace.Marketplace.evm_type.fungible, null, null)
        .sign(oracle.keypair).run();
    val evm_native_asset_id = marketplace_external.Queries.derive_fungible_evm_asset_id(utils.NULL_ADDRESS);
        
    marketplace_external.OperationsDev.create_settlement(
        admin.auth_id,
        bertha_id,
        originals_marketplace.Marketplace.asset_type.original,
        1,
        evm_native_asset_id,
        originals_marketplace.Marketplace.asset_type.evm_asset,
        50,
        originals_tests_mocks.VALID_EXPIRATION,
        123,
        originals_marketplace.Marketplace.settlement_type.evm,
        utils.DUMMY_SIGNATURE
    ).sign(admin.keypair).run();
    
    // Signer is not oracle
    marketplace_external.Operations.register_cancelled_event(utils.DUMMY_SIGNATURE).sign(bob.keypair).run_must_fail();    
}

function test_bid_settle_fail_on_wrong_signer() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin, bob);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);

    val settlement_id = originals_tests_helper.list_original_and_return_settlement_id(admin, bertha_id, settlement_type = originals_marketplace.Marketplace.settlement_type.auction);
    
    marketplace_external.Operations.bid(bob.auth_id, settlement_id, 100)
        .sign(admin.keypair).run_must_fail();
}

