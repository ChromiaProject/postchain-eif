function test_on_sale_event() {
    val admin = ft3_helper_tests.register_admin();
    utils.register(admin);
    
    val (mock_collection, _) = originals_tests_helper.create_mock_collection(admin, admin, admin);  
    val (bertha_id, bertha_instance) = utils.create_cow(admin, mock_collection.name);
    val (bertha2_id, bertha2_instance) = utils.create_cow(admin, mock_collection.name);
    val (bertha3_id, bertha3_instance) = utils.create_cow(admin, mock_collection.name);
    
    val first_settlement = originals_tests_helper.list_original_and_return_settlement(admin, bertha_id);
    val first_settlement_tx_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;
    val second_settlement = originals_tests_helper.list_original_and_return_settlement(admin, bertha2_id);
    val second_settlement_tx_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;
    
    val response_events = events_external.find_nft_activity([events.event_type.on_sale.name], null, null, null, originals_tests_helper.default_cursor()).data;
    
    val null_maker_id = originals_util.Ft3Helper.get_null_account_id(admin.auth_id.account_id);
    assert_equals(response_events.size(), 2);
    assert_equals(events.event_dto.from_gtv_pretty(response_events[0]), events.event_dto(
        asset = (
            id = bertha_id,
            name = "Test Original"
        ),
        type = events.event_type.on_sale.name,
        to_id = null_maker_id,
        from_id = admin.auth_id.account_id,
        params = marketplace_events.event_settlement_descriptor(
            id = first_settlement.id,
            taker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = first_settlement.taker_descriptor.asset.id,
                    name = first_settlement.taker_descriptor.asset.name
                ),
                asset_type = first_settlement.taker_descriptor.asset_type,
                amount = first_settlement.taker_descriptor.amount,
                account = marketplace_events.event_ft3_account (
                    id = null_maker_id
                )
            ),
            maker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = first_settlement.maker_descriptor.asset.id,
                    name = first_settlement.maker_descriptor.asset.name
                ),
                asset_type = first_settlement.maker_descriptor.asset_type,
                amount = first_settlement.maker_descriptor.amount,
                account = marketplace_events.event_ft3_account (
                    id = admin.auth_id.account_id
                )
            ),
            expiration = utils.VALID_EXPIRATION,
            salt = 123,
            settlement_type = marketplace.Marketplace.settlement_type.fixed_price
        ).to_gtv_pretty().to_gtv(),
        timestamp = first_settlement_tx_info.timestamp,
        tx_rid = first_settlement_tx_info.tx_rid
    ));
    assert_equals(events.event_dto.from_gtv_pretty(response_events[1]), events.event_dto(
        asset = (
            id = bertha2_id,
            name = "Test Original"
        ),
        type = events.event_type.on_sale.name,
        to_id = null_maker_id,
        from_id = admin.auth_id.account_id,
        params = marketplace_events.event_settlement_descriptor(
            id = second_settlement.id,
            taker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = second_settlement.taker_descriptor.asset.id,
                    name = second_settlement.taker_descriptor.asset.name
                ),
                asset_type = second_settlement.taker_descriptor.asset_type,
                amount = second_settlement.taker_descriptor.amount,
                account = marketplace_events.event_ft3_account (
                    id = null_maker_id
                )
            ),
            maker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = second_settlement.maker_descriptor.asset.id,
                    name = second_settlement.maker_descriptor.asset.name
                ),
                asset_type = second_settlement.maker_descriptor.asset_type,
                amount = second_settlement.maker_descriptor.amount,
                account = marketplace_events.event_ft3_account (
                    id = admin.auth_id.account_id
                )
            ),
            expiration = utils.VALID_EXPIRATION,
            salt = 123,
            settlement_type = marketplace.Marketplace.settlement_type.fixed_price
        ).to_gtv_pretty().to_gtv(),
        timestamp = second_settlement_tx_info.timestamp,
        tx_rid = second_settlement_tx_info.tx_rid
    ));
}

function test_sold_event() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin, bob);
    
    val (mock_collection, _) = originals_tests_helper.create_mock_collection(admin, admin, admin);  
    val (bertha_id, bertha_instance) = utils.create_cow(admin, mock_collection.name);
    val (bertha2_id, bertha2_instance) = utils.create_cow(admin, mock_collection.name);
    val (bertha3_id, bertha3_instance) = utils.create_cow(admin, mock_collection.name);
    
    val first_settlement_id = originals_tests_helper.list_original_and_return_settlement_id(admin, bertha_id, price = 100);
    val second_settlement_id = originals_tests_helper.list_original_and_return_settlement_id(admin, bertha2_id, price = 100);
    
    marketplace_external.Operations.settle(bob.auth_id, first_settlement_id).sign(bob.keypair).run();
    val first_settlement_tx_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;
    marketplace_external.Operations.settle(bob.auth_id, second_settlement_id).sign(bob.keypair).run();
    val second_settlement_tx_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;
    
    val response_events = events_external.find_nft_activity([events.event_type.sold.name], null, null, null, originals_tests_helper.default_cursor()).data;
    
    val null_maker_id = originals_util.Ft3Helper.get_null_account_id(admin.auth_id.account_id);
        
    assert_equals(response_events.size(), 2);
    assert_equals(events.event_dto.from_gtv_pretty(response_events[0]), events.event_dto(
        asset = (
            id = bertha_id,
            name = "Test Original"
        ),
        type = events.event_type.sold.name,
        to_id = bob.auth_id.account_id,
        from_id = admin.auth_id.account_id,
        params = marketplace_events.event_settlement_descriptor(
            id = first_settlement_id,
            taker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = utils.ASSET_ID,
                    name = utils.ASSET_NAME
                ),
                asset_type = marketplace.Marketplace.asset_type.regular,
                amount = 100,
                account = marketplace_events.event_ft3_account (
                    id = null_maker_id
                )
            ),
            maker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = bertha_id,
                    name = "Test Original"
                ),
                asset_type = marketplace.Marketplace.asset_type.original,
                amount = 1,
                account = marketplace_events.event_ft3_account (
                    id = admin.auth_id.account_id
                )
            ),
            expiration = utils.VALID_EXPIRATION,
            salt = 123,
            settlement_type = marketplace.Marketplace.settlement_type.fixed_price
        ).to_gtv_pretty().to_gtv(),
        timestamp = first_settlement_tx_info.timestamp,
        tx_rid = first_settlement_tx_info.tx_rid
    ));
    assert_equals(events.event_dto.from_gtv_pretty(response_events[1]), events.event_dto(
        asset = (
            id = bertha2_id,
            name = "Test Original"
        ),
        type = events.event_type.sold.name,
        to_id = bob.auth_id.account_id,
        from_id = admin.auth_id.account_id,
        params = marketplace_events.event_settlement_descriptor(
            id = second_settlement_id,
            taker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = utils.ASSET_ID,
                    name = utils.ASSET_NAME
                ),
                asset_type = marketplace.Marketplace.asset_type.regular,
                amount = 100,
                account = marketplace_events.event_ft3_account (
                    id = null_maker_id
                )
            ),
            maker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = bertha2_id,
                    name = "Test Original"
                ),
                asset_type = marketplace.Marketplace.asset_type.original,
                amount = 1,
                account = marketplace_events.event_ft3_account (
                    id = admin.auth_id.account_id
                )
            ),
            expiration = utils.VALID_EXPIRATION,
            salt = 123,
            settlement_type = marketplace.Marketplace.settlement_type.fixed_price
        ).to_gtv_pretty().to_gtv(),
        timestamp = second_settlement_tx_info.timestamp,
        tx_rid = second_settlement_tx_info.tx_rid
    ));
}

function test_bid_event() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin, bob);
    
    val (mock_collection, _) = originals_tests_helper.create_mock_collection(admin, admin, admin);  
    val (bertha_id, bertha_instance) = utils.create_cow(admin, mock_collection.name);
    
    val sd = originals_tests_helper.list_original_and_return_settlement(admin, bertha_id, settlement_type = marketplace.Marketplace.settlement_type.auction);
    
    marketplace_external.Operations.bid(bob.auth_id, sd.id, 101)
        .sign(bob.keypair).run();
    val first_settlement_tx_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;
    marketplace_external.Operations.bid(bob.auth_id, sd.id, 102)
        .sign(bob.keypair).run();
    val second_settlement_tx_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;
                
    val response_events = events_external.find_nft_activity([events.event_type.bid.name], null, null, null, originals_tests_helper.default_cursor()).data;

