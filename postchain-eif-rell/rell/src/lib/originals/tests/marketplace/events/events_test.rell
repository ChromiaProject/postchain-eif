function test_create_offer_of_unlisted_nft_after_create_offer_event() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    utils.register_test_asset_and_mint_to_account(admin, alice);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = utils.create_cow(admin, mock_collection.name);

    utils.create_or_update_offer_of_unlisted_nft(alice, bertha_id);
    val transaction_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;

    val nft_offers = utils.find_offers_by_asset_id(bertha_id);
    val event = events_external.find_nft_activity([events.event_type.offer_placed.name], null, null, null, originals_tests_helper.default_cursor()).data;

    assert_equals(events.event_dto.from_gtv_pretty(event[0]), events.event_dto(
        asset = (
            id = nft_offers[0].asset_instance.asset.id,
            name = "Test Original"
        ),
        type = events.event_type.offer_placed.name,
        to_id = nft_offers[0].maker_descriptor.account.id,
        from_id = nft_offers[0].taker_descriptor.account.id,
        params = marketplace_events.event_offer(
            nft = nft_offers[0].asset_instance,
            maker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = nft_offers[0].maker_descriptor.asset.id,
                    name = nft_offers[0].maker_descriptor.asset.name
                ),
                asset_type = nft_offers[0].maker_descriptor.asset_type,
                amount = nft_offers[0].maker_descriptor.amount,
                account = marketplace_events.event_ft3_account(
                    id = nft_offers[0].maker_descriptor.account.id
                )
            ),
            taker_descriptor = marketplace_events.event_payment_descriptor(
                asset = marketplace_events.event_ft3_asset(
                    id = nft_offers[0].taker_descriptor.asset.id,
                    name = nft_offers[0].taker_descriptor.asset.name
                ),
                asset_type = nft_offers[0].taker_descriptor.asset_type,
                amount = nft_offers[0].taker_descriptor.amount,
                account = marketplace_events.event_ft3_account(
                    id = nft_offers[0].taker_descriptor.account.id
                )
            ),
            created_at = nft_offers[0].created_at
        ).to_gtv_pretty().to_gtv(),
        tx_rid = transaction_info.tx_rid,
        timestamp = transaction_info.timestamp
    ));
}

