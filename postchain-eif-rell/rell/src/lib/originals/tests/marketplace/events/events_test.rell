function test_transfer_event() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    utils.register(admin, bob);
    
    val (mock_collection, _) = originals_tests_helper.create_mock_collection(admin, admin, admin);
    val (bertha_id, bertha_instance) = utils.create_cow(admin, mock_collection.name);
    
    originals_external.transfer_original(admin.auth_id, bertha_id, bob.auth_id.account_id).sign(admin.keypair).run();
    val first_settlement_tx_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;
    originals_external.transfer_original(bob.auth_id, bertha_id, admin.auth_id.account_id).sign(bob.keypair).run();
    val second_settlement_tx_info = transaction @ {} ( @sort_desc timestamp = .block.timestamp, .tx_rid ) limit 1;

    val response_events = events_external.find_nft_activity([events.event_type.transfer.name], null, null, null, originals_tests_helper.default_cursor()).data;

    assert_equals(response_events.size(), 2);
    assert_equals(events.event_dto.from_gtv_pretty(response_events[0]), events.event_dto(
        asset = (
            id = bertha_id,
            name = "Test Original"
        ),
        type = events.event_type.transfer.name,
        to_id = bob.auth_id.account_id,
        from_id = admin.auth_id.account_id,
        params = (
            quantity = 1
        ).to_gtv_pretty().to_gtv(),
        timestamp = first_settlement_tx_info.timestamp,
        tx_rid = first_settlement_tx_info.tx_rid
    ));
    assert_equals(events.event_dto.from_gtv_pretty(response_events[1]), events.event_dto(
        asset = (
            id = bertha_id,
            name = "Test Original"
        ),
        type = events.event_type.transfer.name,
