        from_id = bob.auth_id.account_id,
        params = (
            quantity = 1
        ).to_gtv_pretty().to_gtv(),
        timestamp = second_settlement_tx_info.timestamp,
        tx_rid = second_settlement_tx_info.tx_rid
    ));
}

