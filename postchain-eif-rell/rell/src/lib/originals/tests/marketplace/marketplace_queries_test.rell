function test_find_original_by_id() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
        
    utils.IFoo.register(admin);
    
    val (foo_id1, foo_instance1) = utils.create_mock_instance(admin, mock_collection.name, "Damocles");
    
    val foo_type = originals_core.Minter.I(
        interface_name = utils.IFoo.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(admin.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Foo"),
            originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image),
            utils.IFoo.foo: dip_attributes.Text.T("Foo")
       ]
    );  
    
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        foo_type
    )
    .sign(admin.keypair)
    .run();
    
    val original = originals_marketplace_external.Queries.find_original_by_id(foo_id1)!!;  
    
    assert_equals(original, map<text, gtv?>([
        "id": foo_id1.to_gtv(),
        "settlement_descriptor": map<name, gtv?>().to_gtv(),
        "tx_history":list<map<name, gtv?>>().to_gtv(),
        "badges": list<map<name, gtv?>>().to_gtv(),
        "attributes": map<name, gtv>().to_gtv(),
        "name": "Test Original".to_gtv(),
        "creator_id": admin.auth_id.account_id.to_gtv(),
        "creator_name": "Tester".to_gtv(),
        "description": null,
        "children": list<map<name, gtv?>>().to_gtv(),
        "collection_name": mock_collection.name.to_gtv()
   ]));
   
   // Should be null if id doesn't exist
   assert_null(originals_marketplace_external.Queries.find_original_by_id(x"0373"));
}

function test_find_listed_originals_by_collection() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();

    utils.register_test_asset_and_mint_to_account(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val (bertha_id, bertha_instance) = collections_tests_helper.create_cow(admin, mock_collection.name);
        
    // Should be null if not listed
    
    var originals = originals_marketplace_external.Queries.find_listed_originals_by_collection(
        mock_collection.name,
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_tests_helper.default_cursor()
    );

    var expected_response = dip_utils.paged_result(
        next_cursor = null,
        data = []
    );
   
    assert_equals(originals, expected_response);
    
    // Should find listed original
    
    originals_tests_helper.list_original(admin, bertha_id);
  
    originals = originals_marketplace_external.Queries.find_listed_originals_by_collection(
        mock_collection.name,
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_tests_helper.default_cursor()
    );

    val settlement_descriptor_id = originals_marketplace.Marketplace.settlement_descriptor @ {
        .maker_descriptor.asset.id == bertha_id
    }.id;

    expected_response = dip_utils.paged_result(
        next_cursor = null,
        data = [[
            "attributes": [
                "face": "neutral".to_gtv()
            ].to_gtv(),
            "badges": list<map<name, gtv?>>().to_gtv(),
            "children": list<map<name, gtv?>>().to_gtv(),
            "creator_id": admin.auth_id.account_id.to_gtv(),
            "creator_name": "Admin".to_gtv(),
            "description": null,
            "name": "Test Original".to_gtv(),
            "id": bertha_id.to_gtv(),
            "settlement_descriptor": map<name, gtv>([
                "settlement_type": originals_marketplace.Marketplace.settlement_type.fixed_price.to_gtv(),
                "asset_type": originals_marketplace.Marketplace.asset_type.regular.to_gtv(),
                "asset_id": originals_utils.Ft3Helper.get_asset(originals_tests_mocks.ASSET_ID).id.to_gtv(),
                "maker": admin.auth_id.account_id.to_gtv(),
                "amount": integer(100).to_gtv(),
                "id": settlement_descriptor_id.to_gtv(),
                "expiration": originals_tests_mocks.VALID_EXPIRATION.to_gtv()
                ]).to_gtv(),
            "tx_history": list<map<name, gtv?>>().to_gtv(),
            "collection_name": mock_collection.name.to_gtv()
        ].to_gtv()]
    );
    
    assert_equals(originals, expected_response);
}