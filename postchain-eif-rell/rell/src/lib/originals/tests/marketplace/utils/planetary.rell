namespace IPlanet {
    val interface = "IPlanet";
    
    function dependencies(): list<text> {
        return [
            originals_core.chromia.INonFungibleOriginal.interface,
            originals_core.chromia.ITradable.interface
        ];
    }
    
    val skin = dip_core.Attribute.I(interface, name = "skin");
    val face = dip_core.Attribute.I(interface, name = "face");
    val tshirt = dip_core.Attribute.I(interface, name = "tshirt");
    val head_accessory = dip_core.Attribute.I(interface, name = "head_accessory");
    val body_accessory = dip_core.Attribute.I(interface, name = "body_accessory");
    val color = dip_core.Attribute.I(interface, name = "color");
    val type = dip_core.Attribute.I(interface, name = "type");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [ 
                skin: dip_core.Type(dip_attributes.ByteArray.T()),
                face: dip_core.Type(dip_core.Instance.T(), [ 
                    originals_core.OwnerMutable(), dip_core.ImplementsInterface(IFace.interface)
                ]),
                tshirt: dip_core.Type(dip_core.Instance.T(), [
                    originals_core.OwnerMutable(), dip_core.ImplementsInterface(ITShirt.interface)
                ]),
                head_accessory: dip_core.Type(dip_core.Instance.T(), [
                    originals_core.OwnerMutable(), dip_core.ImplementsInterface(IHeadAccessory.interface)
                ]),
                body_accessory: dip_core.Type(dip_core.Instance.T(), [
                    originals_core.OwnerMutable(), dip_core.ImplementsInterface(IBodyAccessory.interface)
                ]),              
                color: dip_core.Type(
                    dip_attributes.Text.T(),
                    [
                        originals_marketplace.Marketplace.Meta.Filter("Color"),
                        originals_marketplace.Marketplace.Meta.Description("Celestial body color"),
                        originals_marketplace.Marketplace.Meta.Label("Color")
                    ]
                ),
                type: dip_core.Type(
                    dip_attributes.Text.T(),
                    [
                        originals_marketplace.Marketplace.Meta.Filter("Type"),
                        originals_marketplace.Marketplace.Meta.Description("Celestial body type"),
                        originals_marketplace.Marketplace.Meta.Label("Type")
                    ]
                )
            ],
            dependencies(),
            [
                originals_marketplace.Marketplace.Meta.Category("Celestial Bodies"),
                originals_marketplace.Marketplace.Meta.Name("Celestial Body"),
                originals_marketplace.Marketplace.Meta.Description("This is Celestial Body description")
            ]
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Interface.get(interface);
}

function register_planetary_example(ft3_helper_tests.auth_data) {
    IFace.register(auth_data);
    ITShirt.register(auth_data);
    IHeadAccessory.register(auth_data);
    IBodyAccessory.register(auth_data);
    IPlanet.register(auth_data);
}