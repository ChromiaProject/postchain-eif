namespace IFilter3 {
    val interface = "IFilter3";
    
    function dependencies(): list<text> {
        return [
            originals_core.chromia.INonFungibleOriginal.interface,
            originals_core.chromia.ITradable.interface
        ];
    }
    
    val bar = dip_core.Attribute.I(interface, name = "bar");
    val foo = dip_core.Attribute.I(interface, name = "foo");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [ 
                bar: dip_core.Type(dip_attributes.Text.T(), meta_list = [ originals_marketplace.Marketplace.Meta.Filter("Bar") ]),
                foo: dip_core.Type(dip_attributes.Integer.T(), meta_list = [ originals_marketplace.Marketplace.Meta.Filter("Foo") ])
                
            ],
            dependencies()
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Interface.get(interface);
}

function create_mock_instances_filter1(ft3_helper_tests.auth_data, collection_name: text) {
    IFilter1.register(auth_data);
    
    val bar_type1 = originals_core.Minter.I(
        interface_name = IFilter1.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Tester"),
            originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image),
            IFilter1.bar: dip_attributes.Text.T("bar1")
        ]
    );  
    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        bar_type1
    ).sign(auth_data.keypair).run();
    
    val bar_type2 = originals_core.Minter.I(
        interface_name = IFilter1.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Tester"),
            originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image),
            IFilter1.bar: dip_attributes.Text.T("bar2")
        ]
    );  
    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        bar_type2
    ).sign(auth_data.keypair).run();
    
    val bar_type3 = originals_core.Minter.I(
        interface_name = IFilter1.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Tester"),
            originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image),
            IFilter1.bar: dip_attributes.Text.T("bar3")
        ]
    );  
    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        bar_type3
    ).sign(auth_data.keypair).run();
}

