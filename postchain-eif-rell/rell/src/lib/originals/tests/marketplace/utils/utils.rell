function register_test_asset_and_mint_to_account(acc1: ft3_helper_tests.auth_data, acc2: ft3_helper_tests.auth_data? = null, asset_amount: integer = ASSET_AMOUNT) {
    originals_external.init_originals_interfaces(acc1.auth_id).sign(acc1.keypair).run();
    originals_external_dev.create_asset(ASSET_NAME, acc1.auth_id.account_id, if (acc2??) acc2.auth_id.account_id else acc1.auth_id.account_id, asset_amount).run();
    originals_marketplace_util_tests_mocks.ITradableBertha.register(acc1);
    IBertha.register(acc1);
    IRanch.register(acc1);
}

function create_or_update_offer_of_unlisted_nft(
    ft3_helper_tests.auth_data,
    original_id: byte_array,
    asset_id: byte_array = originals_tests_helper.get_asset_id(),
    amount: integer = 1
) {
    marketplace_external.Operations.create_or_update_offer(
        auth_data.auth_id,
        original_id, 
        asset_id,
        amount
    )
      .sign(auth_data.keypair)
        .run();
}

function find_offers_by_asset_id(original_id: byte_array) = originals_marketplace.Marketplace.offer @* { .asset_instance.asset.id == original_id } ;