val ASSET_NAME = "CHR";
val ASSET_ID = (ASSET_NAME).hash();
val ASSET_AMOUNT = 1000;
val VALID_EXPIRATION = 1652155799 * 1000 * 2;
val NULL_ADDRESS = "0x0000000000000000000000000000000000000000";
val DUMMY_SIGNATURE = byte_array.from_hex("FFFF");

function get_last_id() {
    return originals_core.Id.asset_instance @ {} (.asset.id, @omit @sort_desc .rowid) limit 1;
}

// ORIGINAL UTILS

namespace IBertha {
    val interface = "IBertha";
    
    function dependencies(): list<text> {return [
        originals_core.chromia.INonFungibleOriginal.interface
    ];}
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [:],
            dependencies(),
            [
                originals_marketplace.Marketplace.Meta.Category("Cow")
            ]
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Interface.get(interface);
}

namespace IRanch {
    val interface = "IRanch";
    
    function dependencies(): list<text> {return [
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_core.chromia.ITradable.interface
    ];}
    
    val cows = dip_core.Attribute.I(interface, name = "cows");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                cows: dip_core.Type(
                    dip_attributes.Set.T(dip_core.Attribute.type.instance, set<dip_core.instance>().to_gtv()),
                    [originals_core.OwnerMutable(), dip_core.ImplementsInterface(originals_marketplace_util_tests_mocks.ITradableBertha.interface)]
                )
            ],
            dependencies(),
            [
                originals_marketplace.Marketplace.Meta.Category("Ranch")
            ]
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Interface.get(interface);    
}

function register(acc1: ft3_helper_tests.auth_data, acc2: ft3_helper_tests.auth_data? = null) {
    originals_external.init_originals_interfaces(acc1.auth_id).sign(acc1.keypair).run();
    originals_external_dev.create_asset(ASSET_NAME, acc1.auth_id.account_id, if (acc2??) acc2.auth_id.account_id else acc1.auth_id.account_id, ASSET_AMOUNT).run();
    originals_marketplace_util_tests_mocks.ITradableBertha.register(acc1);
    IBertha.register(acc1);
    IRanch.register(acc1);
}

function create_cow(ft3_helper_tests.auth_data, collection_name: text) {
    val original = originals_core.Minter.I(
        interface_name = originals_marketplace_util_tests_mocks.ITradableBertha.interface, [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
            originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image)
        ]
    );
    
    NOP().op(originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        original
    )).sign(auth_data.keypair).run();
    return originals_tests_helper.get_last();
}

function create_non_tradable_cow(ft3_helper_tests.auth_data, collection_name: text) {
    val original = originals_core.Minter.I(
        interface_name = IBertha.interface, [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
        ]
    );
    
    NOP().op(originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        original
    )).sign(auth_data.keypair).run();
    return originals_tests_helper.get_last();
}

function create_ranch(ft3_helper_tests.auth_data, collection_name: text, cows: list<byte_array>) {
    val original = originals_core.Minter.I(
        interface_name = IRanch.interface, [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
            originals_core.chromia.ITradable.image: dip_attributes.Text.T(originals_tests_mocks.dummy_image),
            IRanch.cows: dip_attributes.Set.T(dip_core.Attribute.type.id, value=cows.to_gtv())
        ]
    );
    
    NOP().op(originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        original
    )).sign(auth_data.keypair).run();
    return originals_tests_helper.get_last();
}

function login_evm(rell.test.keypair, address: text, evm_accounts.EvmAccounts.signature): ft3_helper_tests.auth_data {
    val auth_descriptor = generate_auth_descriptor(keypair.pub, VALID_EXPIRATION);
    evm_accounts_external.Operations.login(address, auth_descriptor, signature).sign(keypair).run();
    
    return ft3_helper_tests.auth_data(
        ft3_helper_tests.auth_id(
            account_id = evm_accounts_external.Queries.derive_evm_account_id(address),
            auth_descriptor_id = auth_descriptor.hash()
        ),
        keypair
    );
}

function generate_auth_descriptor(pubkey: byte_array, expiration_time: integer) {
    return originals_core.ft3_core.acc.auth_descriptor(
        "S",
        [pubkey],
        [ ["T"].to_gtv(), pubkey.to_hex().to_gtv() ],
        [ "block_time".to_gtv(), "lt".to_gtv(), expiration_time.to_gtv() ].to_gtv()
    );
}

