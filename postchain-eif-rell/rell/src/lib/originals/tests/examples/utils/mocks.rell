/*
 * MNA integration test example
 */
 
// Defines an interface IMyNeighbourAlice which extends INonFungibleOriginal.
// All Originals implementing IMyNeighbourAlice will therefore be "NFTs".
namespace mna.IBasic {
    val interface = "mna.IBasic";
    
    function dependencies(): list<text> {
        return [
            originals_core.chromia.INonFungibleOriginal.interface
        ];
    }
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [:],
            dependencies()
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Interface.get(interface);
}
// Interface that defines plot Originals and extends IMyNeighbourAlice.
// Each attribute is accessible by mna.IPlot.<attr_name>.
// Attributes are only declared at this point, but not implemented. This is done with the Type()
// function. Text.T, Set.T and Integer.T are structs which define the attribute type. Default values for
// each attribute are defined in them. So if an Original does not implement the attribute "region",
// its name will default to "Nature's Rest".
// In the type definition, optional meta constraints can be defined in an array. The "content"
// attribute for example can be modified by the owner of the Original and all linked Originals
// to it have to implement the interface "mna.IItem". pos_x and pos_y can only contain integers
// between 0 and 100.   
namespace mna.IPlot {
    val interface = "mna.IPlot";
    
    function dependencies(): list<text> {
        return [ mna.IBasic.interface ];
    }
    
    val region = dip_core.Attribute.I(interface, name = "region");
    val content = dip_core.Attribute.I(interface, name = "content");
    val pos_x = dip_core.Attribute.I(interface, name = "pos_x");
    val pos_y = dip_core.Attribute.I(interface, name = "pos_y");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                region: dip_core.Type(dip_attributes.Text.T("Nature's Rest")),
                content: dip_core.Type(dip_attributes.Set.T(dip_attributes.Attribute.type.instance, set<dip_core.instance>().to_gtv()),
                    [originals_core.OwnerMutable(), dip_core.ImplementsInterface("mna.IItem")]
                ),
                pos_x: dip_core.Type(dip_attributes.Integer.T(), [dip_core.Min(0), dip_core.Max(100)]),
                pos_y: dip_core.Type(dip_attributes.Integer.T(), [dip_core.Min(0), dip_core.Max(100)])
            ],
            dependencies()
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Interface.get(interface);
}

// mna.IItem are Originals that can be placed on a plot. Their positions are optional
// so that not set positions mean they are on no plot.      
namespace mna.IItem {
    val interface = "mna.IItem";
    
    function dependencies(): list<text> {
        return [ mna.IBasic.interface ];
    }
    
    val name = dip_core.Attribute.I(interface, name = "name");
    val type = dip_core.Attribute.I(interface, name = "type");
    val pos_x = dip_core.Attribute.I(interface, name = "pos_x");
    val pos_y = dip_core.Attribute.I(interface, name = "pos_y");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                name: dip_core.Type(dip_attributes.Text.T()),
                type: dip_core.Type(dip_attributes.Text.T()),
                pos_x: dip_core.Type(dip_attributes.Integer.T(), [dip_core.Min(0), dip_core.Max(100), dip_core.Optional(), originals_core.OwnerMutable()]),
                pos_y: dip_core.Type(dip_attributes.Integer.T(), [dip_core.Min(0), dip_core.Max(100), dip_core.Optional(), originals_core.OwnerMutable()])
            ],
            dependencies()
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Interface.get(interface);
}

// Creates a prototype called MNA that is discoverable by mna.PBasic.
// Implements the creator attributes so that all Originals implementing this prototype
// do not have to define them. In this example the creator will be the admin keypair.
namespace mna.PBasic {
    val prototype = "mna.PBasic";
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_prototype(
            auth_data.auth_id,
            mna.IBasic.interface,
            [
                originals_core.chromia.IOriginal.name: dip_attributes.Text.T("mna Original"),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
            ],
            mna.PBasic.prototype
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Prototype.get(prototype);
}

// Creates a prototype for cow "items". Cows can be placed on a plot and are set
// to have the type "cow". It extend implements the interface mna.IItem and extends the
// prototype IMyNeighbourAlice.MNA. It will be discoverable with the name mna.IItem.MNACow.
// In the real MNA it would also include the 3D model of the cow to save space. A prototype
// only implements the attribute once. So if we have 1000 cows the 3D model will only be stored
// once.
namespace mna.PCow {
    val prototype = "mna.PCow";
    
    val dependency = mna.PBasic.prototype;
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_prototype(
            auth_data.auth_id,
            mna.IItem.interface,
            [
                mna.IItem.type: dip_attributes.Text.T("cow")
            ],
            prototype,
            dependency
        ).sign(ft3_helper_tests.admin_keypair()).run();
    }
    
    function get() = dip_core.Prototype.get(prototype);
}

namespace IFace {
    val interface = "IFace";
    
    function dependencies(): list<text> {
        return [
            originals_core.chromia.IFungibleOriginal.interface,
            originals_core.chromia.ITradable.interface
        ];
    }
    
    val skin = dip_attributes.Attribute.I(interface, name = "skin");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [ 
                skin: dip_core.Type(dip_attributes.ByteArray.T())
            ],
            dependencies(),
            [
                originals_marketplace.Marketplace.Meta.Category("Faces"),
                originals_marketplace.Marketplace.Meta.Name("Face"),
                originals_marketplace.Marketplace.Meta.Description("This is Face description")
            ]
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_attributes.Interface.get(interface);
}

