function test_mna_example() {
    val admin = ft3_helper_tests.register_admin();
    utils.init_originals(admin);
    val bob_account = ft3_helper_tests.create_ft3_test_acc(ft3_helper_tests.bob_keypair());
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob_account, admin);
    
    // Create plot, cow, house and some fences
    val plot = utils.assign_plot(bob_account.auth_id.account_id, mock_collection.name, (x=21, y=42));
    val cow = utils.create_cow(bob_account.auth_id.account_id, mock_collection.name, "Bertha");
    val house = utils.create_item(bob_account.auth_id.account_id, mock_collection.name, "torp", "house");
    
    val fence_amount = 20;
    val default_cursor = pagination_mapper.page_cursor_instance_id(page_size = fence_amount, instance_rowid = rowid.from_gtv(integer(0).to_gtv()), prototype_rowid = rowid.from_gtv(integer(0).to_gtv()));
    utils.create_items(bob_account.auth_id.account_id, mock_collection.name, "fence_01", "fence", fence_amount);    

    val fence_instances = dip_core.Attribute.find_instances(utils.mna.IItem.type, "fence".to_gtv(), default_cursor).results;
    val fences = fence_instances @* {} (originals_core.Id.get_id($));
    
    // Place house and cow on plot
    utils.place_item_on_plot(bob_account, plot, house, (x=5,y=5));
    utils.place_item_on_plot(bob_account, plot, cow, (x=4,y=5));
    
    // Put fence around our belongings
    var idx = 0;
    for (i in range(3, 7)) {
        for (j in range(3, 7)) {
            if (i==3 or i==6 or j==3 or j==6) {
                utils.place_item_on_plot(bob_account, plot, fences[idx++], (x=i,y=j));                
            }
        }
    }
}