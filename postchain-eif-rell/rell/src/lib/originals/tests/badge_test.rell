@test module;

import originals_core: ^^.core;
import dip_attributes: ^^^.dip.attributes;
import dip_external: ^^^.dip.external;
import originals_external: ^^.external;
import originals_tests_helper: ^.helper;
import ft3_helper_tests: ^^^.ft3_helper.tests;
import dip_core: ^^^.dip.core;
import originals_external_dev: ^^.external.dev.dev_op;
import originals_util: ^^.util;
import ^^^.dip.tests.{get_last_instance};

namespace INonFungibleBadges {
    val interface = "INonFungibleBadges";
    
    function dependencies(): list<text> {return [
        originals_core.chromia.INonFungibleOriginal.interface,
        originals_core.chromia.IHasBadges.interface
    ];}
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [:],
            dependencies()
        ).sign(auth_data.keypair).run();
    }
    
    function get() = dip_core.Interface.get(interface);
}

function mint_mock_instance(ft3_helper_tests.auth_data, collection_name: text) {
    val original = originals_core.Minter.I(
        interface_name = INonFungibleBadges.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
        ]
    );
    
    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        original
    ).sign(auth_data.keypair).run();
    
    return originals_tests_helper.get_last();
}

function create_mock_badge(ft3_helper_tests.auth_data, badge_name: name) {
    dip_external.def_instance(
        auth_data.auth_id,
        originals_core.chromia.IBadge.interface,
        [
            originals_core.chromia.IBadge.name: dip_attributes.Text.T(badge_name),
            originals_core.chromia.IBadge.display_name: dip_attributes.Text.T(badge_name),
            originals_core.chromia.IBadge.description: dip_attributes.Text.T(badge_name + " description"),
            originals_core.chromia.IBadge.image: dip_attributes.Text.T("")
        ]
    ).sign(auth_data.keypair).run();
    
    return get_last_instance();
}

namespace IFakeBadge {
    val interface = "IFakeBadge";
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [:]
        ).sign(auth_data.keypair).run();
    }
}

function create_mock_fake_badge(ft3_helper_tests.auth_data) {
    dip_external.def_instance(
        auth_data.auth_id,
        IFakeBadge.interface,
        [:]
    ).sign(auth_data.keypair).run();
    
    return get_last_instance();
}

// should add badge to original
function test_badge_1() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    originals_tests_helper.init_originals(admin);
    INonFungibleBadges.register(admin);
    
    val (mock_id, mock_instance) = mint_mock_instance(admin, mock_collection.name);
    val badge_instance = create_mock_badge(admin, "initial tester");
    
    
    originals_external_dev.add_badge_to_original(
        mock_instance,
        badge_instance
    ).sign(admin.keypair).run();
    
    assert_true(originals_core.Badge.Original.get_all(mock_instance).contains_all([badge_instance]));
}

// should fail adding badge to original if badge interface is not implemented
function test_badge_2() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    originals_tests_helper.init_originals(admin);
    INonFungibleBadges.register(admin);
    
    val (mock_id, mock_instance) = mint_mock_instance(admin, mock_collection.name);
    
    IFakeBadge.register(admin);    
    val fake_badge_instance = create_mock_fake_badge(admin);
    
    originals_external_dev.add_badge_to_original(
        originals_core.Id.get_instance(mock_id),
        fake_badge_instance
    ).run_must_fail();
}

// should add badge instance to implementing prototype
// should fail adding badge instance to original if not implementing attribute
function test_badge_3() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    INonFungibleBadges.register(admin);
    
    val prototype_def = "PrototypeName";
    originals_external.def_original_prototype(
        admin.auth_id,
        INonFungibleBadges.interface, [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
            originals_core.chromia.IHasBadges.badges: dip_attributes.Set.T(dip_attributes.Attribute.type.instance, set<dip_core.instance>().to_gtv())
        ], prototype_def
    ).sign(admin.keypair).run();
    val prototype = dip_attributes.Prototype.get(prototype_def);
    
    val original = originals_core.Minter.I(
        interface_name = INonFungibleBadges.interface,
        types = [:],
        prototype_name = prototype_def
    );
    
    originals_external.mint_non_fungible_original(
    admin.auth_id,
    mock_collection.name,
    original
    ).sign(admin.keypair).run();
    val original_id = originals_tests_helper.get_last_id();
    
    val badge_instance = create_mock_badge(admin, "initial tester");
    
    originals_external_dev.add_badge_to_original(
        originals_core.Id.get_instance(original_id),
        badge_instance
    ).run_must_fail();
    
    originals_external_dev.add_badge_to_original(
        prototype,
        badge_instance
    ).sign(admin.keypair).run();
    
    assert_true( originals_core.Badge.Original.get_all(originals_core.Id.get_instance(original_id)).contains_all([badge_instance]) );
    assert_true( originals_core.Badge.Original.get_all(prototype).contains_all([badge_instance]) );
}

// should add badges to original during init and later
function test_badge_4() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    INonFungibleBadges.register(admin);
    
    val badge_instance = create_mock_badge(admin, "initial tester");
    
    val original = originals_core.Minter.I(
        interface_name = INonFungibleBadges.interface,
        types = [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(admin.auth_id.account_id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin"),
            originals_core.chromia.IHasBadges.badges: dip_attributes.Set.T(dip_attributes.Attribute.type.instance, [badge_instance.to_gtv()].to_gtv())
        ]
    );
    originals_external.mint_non_fungible_original(
        admin.auth_id,
        mock_collection.name,
        original
    ).sign(admin.keypair).run();
    val original_id = originals_tests_helper.get_last_id();
        
    originals_external_dev.add_badge_to_original(
        originals_core.Id.get_instance(original_id),
        badge_instance
    ).sign(admin.keypair).run();
    
    assert_true( originals_core.Badge.Original.get_all(originals_core.Id.get_instance(original_id)).contains_all([badge_instance]) );
}

// should add different badges to original
function test_badge_5() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    originals_tests_helper.init_originals(admin);
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    INonFungibleBadges.register(admin);
    val (mock_id, mock_instance) = mint_mock_instance(admin, mock_collection.name);
    
    val badge_instance = create_mock_badge(admin, "initial tester");
    
    originals_external_dev.add_badge_to_original(
        originals_core.Id.get_instance(mock_id),
        badge_instance
    ).sign(admin.keypair).run();
    assert_true( originals_core.Badge.Original.get_all(originals_core.Id.get_instance(mock_id)).contains_all([badge_instance]) );
    
    
    val badge_instance2 = create_mock_badge(admin, "initial tester2");
    originals_external_dev.add_badge_to_original(
        originals_core.Id.get_instance(mock_id),
        badge_instance2
    ).sign(admin.keypair).run();
    assert_true( originals_core.Badge.Original.get_all(originals_core.Id.get_instance(mock_id)).contains_all([badge_instance, badge_instance2]) );
}

// should add badge to account
function test_badge_6() {
    val admin = ft3_helper_tests.register_admin();
    originals_tests_helper.init_originals(admin);
    
    val badge_instance = create_mock_badge(admin, "initial tester");
    
    originals_external_dev.add_badge_to_account(admin.auth_id.account_id, badge_instance).sign(admin.keypair).run();
    originals_external_dev.add_badge_to_account(admin.auth_id.account_id, badge_instance).run_must_fail();
    assert_true( originals_core.Badge.Account.get_all(originals_util.Ft3Helper.get_ft3_account(admin.auth_id.account_id)).contains_all([badge_instance]) );
}

// should add extended badge interface to account
function test_badge_7() {
    val admin = ft3_helper_tests.register_admin();
    originals_tests_helper.init_originals(admin);
    
    val interface = "ITestBadge";
    val rep = dip_core.Attribute.def_I(interface, "reputation");
    originals_external.def_original_interface(
        admin.auth_id,
        interface,
        [rep: dip_core.Type(dip_attributes.Integer.T())],
        [originals_core.chromia.IBadge.interface]
    ).sign(admin.keypair).run();
    
    dip_external.def_instance(
        admin.auth_id,
        interface,
        [
            originals_core.chromia.IBadge.name: dip_attributes.Text.T("Too_Easy"),
            originals_core.chromia.IBadge.display_name: dip_attributes.Text.T("Too Easy"),
            originals_core.chromia.IBadge.description: dip_attributes.Text.T("description"),
            originals_core.chromia.IBadge.image: dip_attributes.Text.T(""),
            rep: dip_attributes.Integer.T(42)
        ]
    ).sign(admin.keypair).run();
    val badge_instance = get_last_instance();
    
    originals_external_dev.add_badge_to_account(admin.auth_id.account_id, badge_instance).sign(admin.keypair).run();
    
    assert_true( originals_core.Badge.Account.get_all(originals_util.Ft3Helper.get_ft3_account(admin.auth_id.account_id)).contains_all([badge_instance]) );
}

// should fail adding badge if wrong interface is implemented
function test_badge_8() {
    val admin = ft3_helper_tests.register_admin();
    originals_tests_helper.init_originals(admin);
    
    IFakeBadge.register(admin);    
    val fake_badge_instance = create_mock_fake_badge(admin);
    
    originals_external_dev.add_badge_to_account(admin.auth_id.account_id, fake_badge_instance).run_must_fail();
}
