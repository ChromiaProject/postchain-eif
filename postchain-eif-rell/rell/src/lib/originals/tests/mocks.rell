namespace IHat {
    val interface = "tests.IHat";
    
    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface
    ];
    
    val type = dip_core.Attribute.I(interface, name = "type");
    val age = dip_core.Attribute.I(interface, name = "age");
    
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                type: dip_core.Type(
                    dip_attributes.Text.T(),
                    [
                        dip_core.Meta.I(
                            category = "test_category",
                            meta_key = "foo_key",
                            meta_value = "foo_value".to_gtv().to_bytes()
                        )
                    ]
                ),
                age: dip_core.Type(
                    dip_attributes.Integer.T(),
                    [
                        dip_core.Meta.I(
                            category = "test_category",
                            meta_key = "foo_key",
                            meta_value = "foo_value".to_gtv().to_bytes()
                        ),
                        dip_core.Meta.I(
                            category = "test_category",
                            meta_key = "bar_key",
                            meta_value = "bar_value".to_gtv().to_bytes()
                        )
                    ]
                )
            ],
            dependencies()
        )
        .sign(auth_data.keypair)
        .run();
    }
}

namespace ITShirt {
    val interface = "tests.ITShirt";
    
    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface
    ];
    
    val color = dip_core.Attribute.I(interface, name = "color");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                color: dip_core.Type(dip_attributes.Text.T())
            ],
            dependencies()
        )
        .sign(auth_data.keypair)
        .run();
    }
}

namespace ICharacter {
    val interface = "tests.ICharacter";
    
    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface
    ];
    
    val hat = dip_core.Attribute.I(interface, name = "hat");
    val tShirt = dip_core.Attribute.I(interface, name = "tShirt");
    
    function register(ft3_helper_tests.auth_data) {
        originals_external.def_original_interface(
            auth_data.auth_id,
            interface,
            [
                hat: dip_core.Type(
                    dip_core.Instance.T(),
                    [
                        dip_core.ImplementsInterface(IHat.interface),
                        dip_core.Meta.I(
                            category = "test_category",
                            meta_key = "foo_key",
                            meta_value = "foo_value".to_gtv().to_bytes()
                        ),
                        dip_core.Meta.I(
                            category = "test_category",
                            meta_key = "bar_key",
                            meta_value = "bar_value".to_gtv().to_bytes()
                        )         
                    ]
                ),
                tShirt: dip_core.Type(
                    dip_core.Instance.T(),
                    [
                        dip_core.Meta.I(
                            category = "test_category",
                            meta_key = "foo_key",
                            meta_value = "foo_value".to_gtv().to_bytes()
                        ),
                        dip_core.Meta.I(
                            category = "test_category",
                            meta_key = "bar_key",
                            meta_value = "bar_value".to_gtv().to_bytes()
                        )          
                    ]
                )
            ],
            dependencies()
        )
        .sign(auth_data.keypair)
        .run();
    }
}



function mint_hat(ft3_helper_tests.auth_data, collection_name: text) {
    IHat.register(auth_data);
    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        originals_core.Minter.I(
            interface_name = IHat.interface,
            types = [
                IHat.type: dip_attributes.Text.T("funny"),
                IHat.age: dip_attributes.Integer.T(10),
                originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Hat"),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("User")    
            ]
        )
    )
    .sign(auth_data.keypair)
    .run();
    
    val id = originals_tests_helper.get_last_id();
    return (id = id, instance = originals_core.Id.get_instance(id));
}

function mint_tshirt(ft3_helper_tests.auth_data, collection_name: text) {
    ITShirt.register(auth_data);
    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        originals_core.Minter.I(
            interface_name = ITShirt.interface,
            types = [
                ITShirt.color: dip_attributes.Text.T("violet"),
                originals_core.chromia.IOriginal.name: dip_attributes.Text.T("TShirt"),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("User")   
            ]
        )
    )
    .sign(auth_data.keypair)
    .run();
    
    val id = originals_tests_helper.get_last_id();
    return (id = id, instance = originals_core.Id.get_instance(id));
}

function mint_character(ft3_helper_tests.auth_data, collection_name: text) {
    val hat_id = mint_hat(auth_data, collection_name).id;
    val tshirt_id = mint_tshirt(auth_data, collection_name).id; 
    
    ICharacter.register(auth_data);
    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        originals_core.Minter.I(
            interface_name = ICharacter.interface,
            types = [
                ICharacter.hat: originals_core.Id.T(hat_id),
                ICharacter.tShirt: originals_core.Id.T(tshirt_id),
                originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Character"),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(auth_data.auth_id.account_id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("User")   
            ]
        )
    )
    .sign(auth_data.keypair)
    .run();
    
    val id = originals_tests_helper.get_last_id();
    return (id = id, instance = originals_core.Id.get_instance(id));
}

