// creates 5 types of events and 4 mocks per type (2 with asset1 and acc1 as from, and 2 with asset2 and acc2 as from)
function mock_events(acc1: ft3_account.account, acc2: ft3_account.account, asset1_id: byte_array? = null, asset2_id: byte_array? = null) {
    val asset1: byte_array = asset1_id ?: "asset1".hash();
    val asset2: byte_array = asset2_id ?: "asset2".hash();
    if (asset1_id == null) {
        originals_external_dev.create_asset("asset1", acc1.id, acc2.id, 10000).run();
    }
    if (asset2_id == null) {
        originals_external_dev.create_asset("asset2", acc1.id, acc2.id, 10000).run();
    }
    
    val create_event_reqs = list<(type: text, asset_id: byte_array, from_id: byte_array, to_id: byte_array, params: byte_array)>();
    var i = 1;
    while (i <= 5) {
        var j = 0;
        while (j < 4) {
            val from = if(j > 1) acc2 else acc1;
            val to = if(j > 1) acc1 else acc2;
            create_event_reqs.add((
                type = events.event_type.values()[i].name,
                asset_id = (if(j>1) asset2 else asset1),
                from_id = from.id,
                to_id = to.id,
                params = i.to_gtv().to_bytes()
            ));
            j++;
        }
        i++;
    }
    originals_external_dev.create_events(create_event_reqs).run();
}

