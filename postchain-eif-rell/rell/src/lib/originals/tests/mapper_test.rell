@test module;

import originals_external: ^^.external;
import ft3_account: ^^^.ft3.account;
import ft3_helper_tests: ^^^.ft3_helper.tests;
import dip_attributes: ^^^.dip.attributes;
import dip_external: ^^^.dip.external;
import originals_tests_helper: ^.helper;
import originals_tests_mocks: ^.mocks;
import originals_core: ^^.core;
import dip_core: ^^^.dip.core;

function mint_mock_original(ft3_helper_tests.auth_data, collection_name: text) {
    originals_external.init_originals_interfaces(auth_data.auth_id).sign(auth_data.keypair).run();
    val account_id = auth_data.auth_id.account_id;
    val ft3_account = ft3_account.account @ { account_id };
    
    dip_external.def_prototype(
        auth_data.auth_id,
        originals_core.chromia.INonFungibleOriginal.interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
        ], 
        "TestPrototype"
    ).sign(auth_data.keypair).run();
    
    val original = originals_core.Minter.I(
        interface_name = originals_core.chromia.INonFungibleOriginal.interface,
        types = [:],
        prototype_name = "TestPrototype"
    );

    originals_external.mint_non_fungible_original(
        auth_data.auth_id,
        collection_name,
        original
    )
    .sign(auth_data.keypair)
    .run(); 
    
    return (originals_tests_helper.get_last_id(), ft3_account);
}

function test_original_id_can_be_mapped() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (original_id, account) = mint_mock_original(admin, mock_collection.name);
    
    val original = originals_core.Id.get_instance(original_id);
    
    val original_map = dip_core.Mapper.map_instance(original, [
        originals_core.OMapper.map_original_meta([originals_core.OMapper.type.id])
    ]);
    
    assert_equals(original_map, map<name, gtv?>([
        "id": original_id.to_gtv()
    ]));
}

function test_original_owner_can_be_mapped() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    val (original_id, account) = mint_mock_original(admin, mock_collection.name);
    
    val original = originals_core.Id.get_instance(original_id);
    
    val original_map = dip_core.Mapper.map_instance(original, [
        originals_core.OMapper.map_original_meta([originals_core.OMapper.type.owner])
    ]);
    
    assert_equals(original_map, map<name, gtv?>([
