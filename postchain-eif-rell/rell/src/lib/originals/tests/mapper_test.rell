function test_original_attributes_can_be_mapped_by_meta_with_attributes_meta() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val hat = originals_tests_mocks.mint_hat(admin, mock_collection.name).instance;
    
    val original_map = dip_core.Mapper.map_instance(hat, 
        [
            dip_core.Mapper.map_attributes_by_meta_tag(
                "foo_key", 
                meta = dip_core.Mapper.with_meta([dip_core.Meta.Category("test_category")])
            )
        ]
    );
    
    assert_equals(original_map, map<name, gtv?>([
        "tests.IHat.type": [
            "value": "funny".to_gtv(),
            "foo_key": "foo_value".to_gtv()
        ].to_gtv(),        
        "tests.IHat.age": [
            "value": (10).to_gtv(),
            "foo_key": "foo_value".to_gtv(),
            "bar_key": "bar_value".to_gtv()
        ].to_gtv()
    ]));
}

function test_linked_originals_can_be_mapped_with_attributes_meta() {
    val admin = ft3_helper_tests.register_admin();
    val alice = ft3_helper_tests.register_alice();
    
    originals_tests_helper.init_originals(admin);
 
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, alice, admin);
    val character = originals_tests_mocks.mint_character(admin, mock_collection.name).instance;
    
    val original_map = dip_core.Mapper.map_instance(character,
        [
            originals_core.OMapper.map_linked(meta = dip_core.Mapper.with_meta([dip_core.Meta.Category("test_category")]))
        ]
    );
    
    assert_equals(original_map, map<name, gtv?>([
        "tests.ICharacter.hat": [
            "value": [
                "tests.IHat.type":  "funny".to_gtv(), 
                "tests.IHat.age": (10).to_gtv(),
                "chromia.IOriginal.name": "Hat".to_gtv(),
                "chromia.IOriginal.creator_id": admin.auth_id.account_id.to_gtv(),
                "chromia.IOriginal.creator_name": "User".to_gtv(),
                "chromia.IOriginal.description": null.to_gtv(),
                "chromia.IOriginal.collection_name": mock_collection.name.to_gtv()
            ].to_gtv(),
            "foo_key": "foo_value".to_gtv(),
            "bar_key": "bar_value".to_gtv()
        ].to_gtv(),
        "tests.ICharacter.tShirt": [
            "value": [
                "tests.ITShirt.color": "violet".to_gtv(),
                "chromia.IOriginal.name": "TShirt".to_gtv(),
                "chromia.IOriginal.creator_id": admin.auth_id.account_id.to_gtv(),
                "chromia.IOriginal.creator_name": "User".to_gtv(),
                "chromia.IOriginal.description": null.to_gtv(),
                "chromia.IOriginal.collection_name": mock_collection.name.to_gtv()
            ].to_gtv(),
            "foo_key": "foo_value".to_gtv(),
            "bar_key": "bar_value".to_gtv()
        ].to_gtv()
    ]));
}
