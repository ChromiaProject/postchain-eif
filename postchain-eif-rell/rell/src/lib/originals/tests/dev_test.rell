@test module;

import ft3_helper_tests: ^^^.ft3_helper.tests;
import originals_external: ^^.external;
import dip_attributes: ^^^.dip.attributes;
import originals_tests_mocks: ^.mocks;
import originals_core: ^^.core;
import originals_tests_helper: ^.helper;
import dip_core: ^^^.dip.core;
import originals_tests_helper: ^.helper;

// should return all values by original
function test_dev_1() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);
    
    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);

    var interface = "ICat";
    val cat_fur = dip_core.Attribute.def_I(interface, "fur_color");
    val cat_age = dip_core.Attribute.def_I(interface, "age");
    val cat_parent = dip_core.Attribute.def_I(interface, "parent");
    originals_external.def_original_interface(
        admin.auth_id,
        interface,
        [
            cat_fur: dip_core.Type(dip_attributes.Text.T("black")),
            cat_age: dip_core.Type(dip_attributes.Integer.T(0)),
            cat_parent: dip_core.Type(dip_attributes.Instance.T(), [dip_core.Optional(), originals_core.OwnerMutable()])
        ],
        [originals_core.chromia.INonFungibleOriginal.interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    val prototype_def = "CatDapp";
    originals_external.def_original_prototype(
        admin.auth_id,
        interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
        ],
        prototype_def
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    val prototype_cat_fur_green = "green_cat_fur";
    originals_external.def_original_prototype(
        admin.auth_id,
        interface,
        [
            cat_fur: dip_attributes.Text.T("green")
        ],
        prototype_cat_fur_green,
        prototype_def
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    val prototype_cat_fur_yellow = "yellow_cat_fur";
    originals_external.def_original_prototype(
        admin.auth_id,
        interface,
        [
            cat_fur: dip_attributes.Text.T("yellow")
        ],
        prototype_cat_fur_yellow,
        prototype_def
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    
    val cat1_type = originals_core.Minter.I(
        interface_name = interface,
        types = [cat_age: dip_attributes.Integer.T(10)],
        prototype_name = prototype_cat_fur_green
    );    
    originals_external.mint_non_fungible_original(admin.auth_id, mock_collection.name, cat1_type).sign(admin.keypair).run();
    val cat1 = originals_tests_helper.get_last_id();
    
    val cat2_type = originals_core.Minter.I(
        interface_name = interface, 
        types = [cat_age: dip_attributes.Integer.T(2)], 
        prototype_name = prototype_cat_fur_yellow
    );    
    originals_external.mint_non_fungible_original(admin.auth_id, mock_collection.name, cat2_type).sign(admin.keypair).run();
    val cat2 = originals_tests_helper.get_last_id();
    
    originals_external.link_original(admin.auth_id,cat_parent, cat2, cat1).sign(admin.keypair).run();
}

// should find all originals by given interface
function test_dev_2() {
    val admin = ft3_helper_tests.register_admin();
    val bob = ft3_helper_tests.register_bob();
    originals_tests_helper.init_originals(admin);

    val (mock_collection, mock_project) = originals_tests_helper.create_mock_collection(admin, bob, admin);
    
    var interface = "ITestDapp";
    originals_external.def_original_interface(
        admin.auth_id,
        interface,
        [:],
        [originals_core.chromia.INonFungibleOriginal.interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    val prototype_def = "TestDapp";
    
    originals_external.def_original_prototype(
        admin.auth_id,
        interface,
        [
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Test Original"),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("Admin")
        ],
        prototype_def
    ).sign(ft3_helper_tests.admin_keypair()).run();
        
    var orig_interface = "IOrig1";
    originals_external.def_original_interface(
        admin.auth_id,
        orig_interface,
        [:],
        [interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    var orig2_interface = "IOrig2";
    originals_external.def_original_interface(
        admin.auth_id,
        orig2_interface,
        [:],
        [interface]
    ).sign(ft3_helper_tests.admin_keypair()).run();
    
    val orig1_type = originals_core.Minter.I(
        interface_name = orig_interface,
        types = [:], 
        prototype_name = prototype_def
    );    
    originals_external.mint_non_fungible_original_batch(admin.auth_id, mock_collection.name, orig1_type, 5).sign(admin.keypair).run();

    val instances_page_data = originals_external.get_originals_with_interface(admin.auth_id.account_id, orig_interface, originals_tests_mocks.default_cursor);

    val orig2_type = originals_core.Minter.I(
        interface_name = orig2_interface, 
        types = [:], 
        prototype_name = prototype_def
    );    

    originals_external.mint_non_fungible_original_batch(admin.auth_id, mock_collection.name, orig2_type, 15).sign(admin.keypair).run();

    val instances_page_data_after_minting = originals_external.get_originals_with_interface(admin.auth_id.account_id, orig2_interface, originals_tests_mocks.default_cursor);
    
    assert_equals(instances_page_data.data.size(), 5);
    assert_equals(instances_page_data_after_minting.data.size(), 15);
    
    val latest = originals_core.Ownership.find_last_original_with_interface(admin.auth_id.account_id, dip_core.Interface.get(orig2_interface))!!;
    assert_equals(instances_page_data_after_minting.data[14], latest.asset.id.to_gtv());
}