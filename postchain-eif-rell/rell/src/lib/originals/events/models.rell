struct event_dto {
    asset: (id: byte_array, name: text);
    type: text;
    to_id: byte_array;
    from_id: byte_array;
    params: gtv;
    tx_rid: byte_array;
    timestamp: integer;
}

enum event_type {
    on_sale,
    offer_placed,
    offer_updated,
    sold,
    bid,
    transfer,
    mint
}