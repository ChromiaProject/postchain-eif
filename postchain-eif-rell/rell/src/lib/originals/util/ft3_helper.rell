namespace Ft3Helper {
    val ORIGINAL = "ORIGINAL";
    val LINKED = "LINKED";
    val ESCROW = "ESCROW";
    val NULL = "NULL";
    
    function get_ft3_account(account_id: byte_array): ft3_acc.account {
        return ft3_acc.account @ { .id == account_id };
    }
    
    function does_account_exist(account_id: byte_array): boolean {
        return ft3_acc.account @? { .id == account_id }??;
    }
    
    function get_asset(asset_id: byte_array) {
        return ft3_core.asset @ {.id == asset_id};
    }
    
    function require_transfer_auth(account_id: byte_array, auth_id: byte_array) {
        ft3_acc.require_auth(get_ft3_account(account_id), auth_id, ["T"]);
    }
    
    function originals_account_id(account_id: byte_array): byte_array {
        return ft3_helper.special_account_id (ft3_helper.LOCKED(ORIGINAL), account_id, list<gtv>().to_gtv());
    }
    
    function create_asset(init_id: byte_array, name: text): ft3_core.asset {
        val issuing_chain_rid = chain_context.blockchain_rid;
        val id = (init_id, issuing_chain_rid).hash();
        return create ft3_core.asset (id, issuing_chain_rid, name);
    }
    
    function create_and_mint_asset(init_id: byte_array, name: text, account_id: byte_array, quantity: integer): ft3_core.asset {
        val asset = create_asset(init_id, name);
        val account = get_ft3_account(account_id);
        val original_account = ft3_helper.ensure_locked_account(ORIGINAL, account);
        
        ft3_core.ensure_balance(account, asset).amount += quantity;
        
        // create transfer history entry
        ft3_helper.transfer_asset(
            account,
            original_account,
            asset, quantity
        );
        
        return asset;
    }
    
    function mint_existing_asset(asset_id: byte_array, account_id: byte_array, quantity: integer) {
        val account = get_ft3_account(account_id);
        val original_account = ft3_helper.ensure_locked_account(ORIGINAL, account);
        ft3_core.ensure_balance(original_account, ft3_core.asset @ {.id == asset_id}).amount += quantity;
    }
    
    function owns_original(account_id: byte_array, asset_id: byte_array): boolean {
        val account = get_ft3_account(account_id);
        val original_account = ft3_helper.find_locked_account(ORIGINAL, account);
        
        if (original_account??) {
            return owns_asset(original_account.id, asset_id);    
        } else {
            return false;
        }
    }
    
    function owns_asset(account_id: byte_array, asset_id: byte_array): boolean {
        return ft3_core.balance @? {.asset.id == asset_id, .account.id == account_id, .amount > 0}??;    
    }
    
    function get_asset_balance(account_id: byte_array, asset_id: byte_array): integer {
        val account = get_ft3_account(account_id);
        val original_account = ft3_helper.find_locked_account(ORIGINAL, account);
        var balance = if (original_account??) ft3_core.get_asset_balance(original_account.id, asset_id) else null;
        
        return if (balance??) balance.amount else 0;
    }
    
    function get_asset_supply(asset_id: byte_array): integer {
        return ft3_core.balance @ {.asset.id == asset_id} (@sum .amount);
    }
    
    function lock_asset(account_id: byte_array, asset_id: byte_array, reason: text) {
        val asset = ft3_core.asset @ {.id == asset_id};
        val account = get_ft3_account(account_id);
        val original_account = ft3_helper.ensure_locked_account(ORIGINAL, account);
        
        ft3_helper.transfer_asset(
            original_account,
            ft3_helper.ensure_locked_account(reason, account),
            asset, 1
        );
    }
    
    function unlock_asset(account_id: byte_array, asset_id: byte_array, reason: text) {
        val asset = ft3_core.asset @ {.id == asset_id};
        val account = get_ft3_account(account_id);
        val original_account = ft3_helper.ensure_locked_account(ORIGINAL, account);
        
        ft3_helper.transfer_asset(
            ft3_helper.ensure_locked_account(reason, account),
            original_account,
            asset, 1
        );
    }
    
    function get_original_account_id(account_id: byte_array): byte_array {
        return ft3_helper.special_account_id(ft3_helper.LOCKED(ORIGINAL), account_id, list<gtv>().to_gtv());
    }
    
    function get_linked_account_id(account_id: byte_array): byte_array {
        return ft3_helper.special_account_id(ft3_helper.LOCKED(LINKED), account_id, list<gtv>().to_gtv());
    }
    
    function get_escrow_account_id(account_id: byte_array): byte_array {
        return ft3_helper.special_account_id(ft3_helper.LOCKED(ESCROW), account_id, list<gtv>().to_gtv());
    }

    function get_null_account_id(account_id: byte_array): byte_array {
        return ft3_helper.special_account_id(ft3_helper.LOCKED(NULL), account_id, list<gtv>().to_gtv());
    }
    
    function is_asset_locked(account_id: byte_array, asset_id: byte_array) {
        val locked_account_id = get_linked_account_id(account_id);
        
        return owns_asset(locked_account_id, asset_id);
    }
    
    
    function transfer_original_asset(
        account: ft3_acc.account,
        asset_id: byte_array,
        to_account_id: byte_array,
        quantity: integer
    ) {
        require(quantity > 0);
        
        val asset = ft3_core.asset @ {.id == asset_id};
        val from = get_ft3_account(account.id);
        val to = get_ft3_account(to_account_id);
        
        ft3_helper.transfer_asset(
            ft3_helper.ensure_locked_account(ORIGINAL, from),
            ft3_helper.ensure_locked_account(ORIGINAL, to),
            asset, quantity
        );
    }
    
    function transfer_linked_asset(
        from_account: ft3_acc.account,
        to_account: ft3_acc.account,
        asset_id: byte_array
    ) {
        val asset = ft3_core.asset @ {.id == asset_id};
        
        ft3_helper.transfer_asset(
            ft3_helper.ensure_locked_account(LINKED, from_account),
            ft3_helper.ensure_locked_account(LINKED, to_account),
            asset, 1
        );
    }

    function Account(account_id: byte_array) = require(
        ft3_acc.account @? { account_id },
        "Account does not exist: '%s'".format(account_id)
    );
}
