
namespace Ownership {
    function transfer(
        account: ft3_account.account,
        original: dip_core.instance,
        to_id: byte_array,
        quantity: integer = 1
    ) {
        originals_utils.Ft3Helper.transfer_original_asset(account, Id.get_id(original), to_id, quantity);
        val linked_ids = transfer_linked_originals(account, originals_utils.Ft3Helper.get_ft3_account(to_id), original);
        Hooks.after_transfer(account, original, to_id, quantity);
        // FIXME: For one use case we need a list of child original ids after calling the transfer function.
        // But returning children ids when calling transfer doesn't feel intuitive. We should either return
        // a struct/tuple where one of attributes/elements are children ids, or fetch the list of ids 
        // in some other way where transfer function is called.
        return linked_ids;
    }
    
    function transfer_linked_originals(
        from_account: ft3_account.account,
        to_account: ft3_account.account,
        original: dip_core.instance
    ): list<byte_array> {
        val instances = get_linked_originals(original);
        val ids = list<byte_array>();
        while (not instances.empty()) {
            val instance = instances.remove_at(0);
            val id = Id.get_id(instance);
            originals_utils.Ft3Helper.transfer_linked_asset(from_account, to_account, id);
            instances.add_all(get_linked_originals(instance));
            ids.add(id);
        }
        
        return ids;
    }
    
    function get_linked_originals(dip_core.instance): list<dip_core.instance> {
        return dip_attributes.Instance.instance_attribute @* {
            .instance == instance,
            exists(Id.asset_instance @* {.instance == instance_attribute.value})
        }.value;
    }
    
    function fractionalize(
        account: ft3_account.account,
        original: dip_core.instance,
        fractional_type: Minter.I,
        fractions: integer,
        dip_core.Meta.Engine.access
    ): dip_core.instance {    
        require(fractions > 0, "Number of fractions has to be positive");
        require(
            dip_core.Interface.get_with_dependencies_by_name(fractional_type.interface_name).contains(chromia.IFractionalizedOriginal.get()),
            "Fractionalized type interface has to implement " + chromia.IFractionalizedOriginal.interface
        );
        
        // Get creator data from original to fractionalize
        val name = dip_attributes.Text.get_value(original, chromia.IOriginal.name);
        val creator_id = dip_attributes.ByteArray.get_value(original, chromia.IOriginal.creator_id);
        val creator_name = dip_attributes.Text.get_value(original, chromia.IOriginal.creator_name);
        val original_id = Id.get_id(original);
        
        fractional_type.types.put(chromia.IOriginal.name, dip_attributes.Text.T(name));
        fractional_type.types.put(chromia.IOriginal.creator_id, dip_attributes.ByteArray.T(creator_id));
        fractional_type.types.put(chromia.IOriginal.creator_name, dip_attributes.Text.T(creator_name));
        fractional_type.types.put(chromia.IFractionalizedOriginal.original, Id.T(original_id));
        fractional_type.types.put(chromia.IFungibleOriginal.max_supply, dip_attributes.Integer.T(fractions));
        
        return Minter.create_fungible_original(
            account,
            collections.find_collection_name_by_original_id(original_id),
            fractional_type,
            fractions,
            access
        );
    }
        
    function link_instance(
        account: ft3_account.account,
        attribute_name: dip_core.Attribute.I,
        base: dip_core.instance,
        child: dip_core.instance,
        dip_core.Meta.Engine.access
    ) {
        require(Id.is_original(base), "Base instance is not an original.");
        require(Id.is_original(child), "Child instance is not an original.");
        require(not is_linked(child), "Child is already linked to something.");
        
        val attribute = dip_core.Attribute.get(attribute_name);
        
        if (attribute.type == dip_core.Attribute.type.instance) {
            val linked_instance = dip_attributes.Instance.instance_attribute @? {attribute, .instance == base}.value;
        
            if (linked_instance??) {
                originals_utils.Ft3Helper.unlock_asset(account.id, Id.get_id(linked_instance), originals_utils.Ft3Helper.LINKED);
            }
            Wrapper.Attribute.set_value(base, attribute_name, child.to_gtv(), access);
        } else if (attribute.type == dip_core.Attribute.type.unordered_container) {
            Wrapper.Attribute.add_container_element(base, attribute_name, child.to_gtv(), access);
        } else {
            require(false, "Wrong attribute type. Expected instance or set.");
        }
        
        originals_utils.Ft3Helper.lock_asset(account.id, Id.get_id(child), originals_utils.Ft3Helper.LINKED);
    }
    
    function is_linked(dip_core.instance): boolean {
        return not chromia.IFungibleOriginal.has(instance) and dip_attributes.Instance.instance_attribute @? {.value == instance}??;
    }
    
    function unlink_instance(
        account: ft3_account.account,
        attribute_name: dip_core.Attribute.I,
        base: dip_core.instance,
        child: dip_core.instance? = null,
        dip_core.Meta.Engine.access
    ) {
        val attribute = dip_core.Attribute.get(attribute_name);
        
        var id: byte_array? = null;
        if (attribute.type == dip_core.Attribute.type.instance) {
            val child_found = dip_core.instance.from_gtv(Wrapper.Attribute.remove_value(base, attribute_name));
            id = Id.get_id(child_found);
            require(child == null or child == child_found, "Given child ID does not match ID from linked original.");
        } else if (attribute.type == dip_core.Attribute.type.unordered_container) {
            require(child, "Child has to be set when unlinking from set.");
            id = Id.get_id(child);
            Wrapper.Attribute.remove_container_element(base, attribute_name, child.to_gtv(), access);
        } else {
            require(false, "Wrong attribute type. Expected instance or set.");
        }
        
        originals_utils.Ft3Helper.unlock_asset(account.id, id!!, originals_utils.Ft3Helper.LINKED);
    }
    
    function get_base_instance(dip_core.instance): dip_core.instance {
        return dip_attributes.Instance.instance_attribute @ {.value == instance}.instance;
    }
    
    function amount_owned_of_original(account_id: byte_array, original: dip_core.instance): integer {
        return originals_utils.Ft3Helper.get_asset_balance(account_id, Id.get_id(original));
    }
    
    /*
     * Get instances
     */
    
    function get_unlocked_originals_from_owner(account_id: byte_array, dip_utils.page_cursor) {
        val original_account_id = originals_utils.Ft3Helper.get_original_account_id(account_id);
        return (a: Id.asset_instance, b: ft3_core.balance) @* {
            if (page_cursor.after_rowid??) (a.rowid > page_cursor.after_rowid!!) else true,
            b.account.id == original_account_id,
            a.asset.id == b.asset.id,
            b.amount > 0
        } (
            @omit @sort a.rowid,
            a
        ) limit dip_utils.fetch_data_size(page_cursor);
    }
    
    function get_locked_originals_from_owner(account_id: byte_array, dip_utils.page_cursor) {
        val locked_account_id = originals_utils.Ft3Helper.get_linked_account_id(account_id);
        return (a: Id.asset_instance, b: ft3_core.balance) @* {
            if (page_cursor.after_rowid??) (a.rowid > page_cursor.after_rowid!!) else true,
            b.account.id == locked_account_id,
            a.asset.id == b.asset.id,
            b.amount > 0
        }  (
            @omit @sort a.rowid,
            a
        ) limit dip_utils.fetch_data_size(page_cursor);
    }
    
    function get_all_originals_from_owner(account_id: byte_array, dip_utils.page_cursor) {
        val original_account_id = originals_utils.Ft3Helper.get_original_account_id(account_id);
        val locked_account_id = originals_utils.Ft3Helper.get_linked_account_id(account_id);
        return (a: Id.asset_instance, b: ft3_core.balance) @* {
            if (page_cursor.after_rowid??) (a.rowid > page_cursor.after_rowid!!) else true,
            b.account.id in [original_account_id, locked_account_id],
            a.asset.id == b.asset.id,
            b.amount > 0
        } (
            @omit @sort a.rowid,
            a
        ) limit dip_utils.fetch_data_size(page_cursor);
    }

    function find_last_original_with_interface(account_id: byte_array, dip_core.Interface.dclass): Id.asset_instance? {
        val original_account_id = originals_utils.Ft3Helper.get_original_account_id(account_id);
        return (a: Id.asset_instance, b: ft3_core.balance, i: dip_core.instance_dclass) @? {
            b.account.id == original_account_id,
            a.asset.id == b.asset.id,
            b.amount > 0,
            a.instance == i.instance,
            i.dclass == dclass
        } (a, @omit @sort_desc a.rowid) limit 1;    
    }

    function find_all_originals_with_interface(account_id: byte_array, dip_core.Interface.dclass, dip_utils.page_cursor) {
        val original_account_id = originals_utils.Ft3Helper.get_original_account_id(account_id);
        return (a: Id.asset_instance, b: ft3_core.balance, i: dip_core.instance_dclass) @* {
            if (page_cursor.after_rowid??) (a.rowid > page_cursor.after_rowid!!) else true,
            b.account.id == original_account_id,
            a.asset.id == b.asset.id,
            b.amount > 0,
            a.instance == i.instance,
            i.dclass == dclass
        } (
            @omit @sort a.rowid,
            a
        ) limit dip_utils.fetch_data_size(page_cursor);
    }

    /*
     * Get original ids
     */

    function map_originals_to_pagination_result(originals: list<Id.asset_instance>) 
        = originals @* {} (
            dip_utils.pagination_result(
                data = $.asset.id.to_gtv(),
                rowid = $.rowid
            )
        );     

    function find_all_original_ids_with_interface(account_id: byte_array, dip_core.Interface.dclass, dip_utils.page_cursor) {
        val originals = find_all_originals_with_interface(account_id, dclass, page_cursor);
        return map_originals_to_pagination_result(originals);
    }
    
    function get_unlocked_original_ids_from_owner(account_id: byte_array, dip_utils.page_cursor) {
        val originals = get_unlocked_originals_from_owner(account_id, page_cursor);
        return map_originals_to_pagination_result(originals);
    }
    
    function get_locked_original_ids_from_owner(account_id: byte_array, dip_utils.page_cursor) {
        val originals = get_locked_originals_from_owner(account_id, page_cursor);
        return map_originals_to_pagination_result(originals);
    }
    
    function get_all_original_ids_from_owner(account_id: byte_array, dip_utils.page_cursor) {
        val originals = get_all_originals_from_owner(account_id, page_cursor);
        return map_originals_to_pagination_result(originals);
    }
    
    function get_owner_if_one_by_original_id(original_id: byte_array): byte_array? {
        val owners = (a: Id.asset_instance, b: ft3_core.balance, ac: ft3_helper.account_link) @* {
            a.asset.id == original_id,
            a.asset.id == b.asset.id,
            b.amount > 0,
            ac.special == b.account,
            ac.reason in [ft3_helper.LOCKED(originals_utils.Ft3Helper.ORIGINAL), ft3_helper.LOCKED(originals_utils.Ft3Helper.LINKED), ft3_helper.LOCKED(originals_utils.Ft3Helper.ESCROW)]
        } (ac.main.id) limit 2;
        
        return if (owners.size() == 1) owners[0] else null;
    }
    
    function get_owner_if_one_by_original_instance(dip_core.instance): byte_array? {
        val owners = (a: Id.asset_instance, b: ft3_core.balance, ac: ft3_helper.account_link) @* {
            a.instance == instance,
            a.asset.id == b.asset.id,
            b.amount > 0,
            ac.special == b.account,
            ac.reason in [ft3_helper.LOCKED(originals_utils.Ft3Helper.ORIGINAL), ft3_helper.LOCKED(originals_utils.Ft3Helper.LINKED), ft3_helper.LOCKED(originals_utils.Ft3Helper.ESCROW)]
        } (ac.main.id) limit 2;
        
        return if (owners.size() == 1) owners[0] else null;
    }
}

namespace Ownership.Hooks {
    @extendable function after_transfer(
        account: ft3_account.account,
        original: dip_core.instance,
        to_id: byte_array,
        quantity: integer
    );
}