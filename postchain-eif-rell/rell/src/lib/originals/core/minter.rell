
namespace Minter {
    struct I {
        interface_name: name;
        mutable types: map<dip_core.Attribute.I, dip_core.attribute_type>;
        prototype_name: text? = null;
    }
    
    function mint_non_fungible_original(
        account: ft3_account.account,
        collection_name: text,
        original_type: I,
        dip_core.Meta.Engine.access
    ): dip_core.instance {
        _require_interface(chromia.INonFungibleOriginal.interface, original_type);
        return Unsafe._mint(account, collection_name, original_type, 1, access);
    }
    
    function mint_non_fungible_original_batch(
        account: ft3_account.account,
        collection_name: text,
        original_type: I,
        quantity: integer,
        dip_core.Meta.Engine.access
    ): list<dip_core.instance> {
        require(quantity > 0, "Quantity has to be greater than 0");
        _require_interface(chromia.INonFungibleOriginal.interface, original_type);
        
        val ids = list<dip_core.instance>();
        for (i in range(quantity)) {
            ids.add(Unsafe._mint(account, collection_name, original_type, 1, access));
        }
        
        return ids;
    }
    
    function mint_non_fungible_original_to_account(
        account: ft3_account.account,
        collection_name: text,
        original_type: I,
        to_account_id: byte_array,
        dip_core.Meta.Engine.access
    ): dip_core.instance {
        val id = mint_non_fungible_original(account, collection_name, original_type, access);
        
        Ownership.transfer(account, id, to_account_id, 1);
        
        return id;
    }
    
    function mint_non_fungible_original_to_account_batch(
        account: ft3_account.account,
        collection_name: text,
        original_type: I,
        to_account_id: byte_array,
        quantity: integer,
        dip_core.Meta.Engine.access
    ): list<dip_core.instance> {
        require(quantity > 0, "Quantity has to be greater than 0");
        _require_interface(chromia.INonFungibleOriginal.interface, original_type);
        
        val ids = list<dip_core.instance>();
        for (i in range(quantity)) {
            val id = mint_non_fungible_original(account, collection_name, original_type, access);
            Ownership.transfer(account, id, to_account_id, 1);
            ids.add(id);
        }
        
        return ids;
    }
    
    function create_fungible_original(
        account: ft3_account.account,
        collection_name: text,
        original_type: I,
        quantity: integer = 1,
        dip_core.Meta.Engine.access
    ): dip_core.instance {
        require(quantity > 0, "Quantity has to be greater than 0");
        _require_interface(chromia.IFungibleOriginal.interface, original_type);
        
        return Unsafe._mint(account, collection_name, original_type, quantity, access);
    }
    
    function create_fungible_original_to_account(
        account: ft3_account.account,
        collection_name: text,
        original_type: I,
        to_account_id: byte_array,
        quantity: integer = 1,
        dip_core.Meta.Engine.access
    ): dip_core.instance {
        val id = create_fungible_original(account, collection_name, original_type, quantity, access);
        Ownership.transfer(account, id,to_account_id, quantity);
        
        return id;
    }
    
    function mint_fungible_original_to_account(
        account: ft3_account.account,
        fungible_id: byte_array,
        to_account_id: byte_array,
        quantity: integer = 1
    ): dip_core.instance {
        val instance = mint_fungible_original(account, fungible_id, quantity);
        Ownership.transfer(account, instance, to_account_id, quantity);
        
        return instance;
    }
    
    function mint_fungible_original(
        account: ft3_account.account,
        fungible_id: byte_array, 
        quantity: integer = 1
    ): dip_core.instance {
        collections_access.require_collection_owner_or_approved_minter(account, collections.Collection_by_original_id(fungible_id));
        return Unsafe.mint_fungible_original(account, fungible_id, quantity);
    }

    function get_last_minted_original_id() {
        val original_ids = (a: Id.asset_instance, b: ft3_core.balance) @* {
            a.asset.id == b.asset.id,
            b.amount > 0
        } (@omit @sort_desc a.instance.rowid, a.asset.id) limit 1;
        
        return if(empty(original_ids)) null else original_ids[0];
    }
    
    function _require_interface(interface: text, original_type: I) {
        val type_interface = dip_core.Interface.get(original_type.interface_name);
        val interfaces = dip_core.Interface.get_with_dependencies(type_interface);
        val has_interface = interface in interfaces @* {} .name;
        
        require(has_interface, "Type not implementing interface " + interface);
    }
    
    function _convert_id_type_to_instance(
        types: map<dip_core.Attribute.I, dip_core.attribute_type>
    ): (v: map<dip_core.Attribute.I, dip_core.attribute_type>, i: list<byte_array>) {
        val instance_ids = list<byte_array>();
        val local_types = map<dip_core.Attribute.I, dip_core.attribute_type>(types);
        
        for ((k, v) in types) {
            when (v.type) {
                dip_core.Attribute.type.id -> {
                    if (v.value??) {
                        instance_ids.add(byte_array.from_gtv(v.value!!));
                        
                        val converted = dip_core.attribute_type(
                            dip_core.Attribute.type.instance,
                            value = Id.get_instance(byte_array.from_gtv(v.value!!)).to_gtv()
                        );
                        local_types[k] = converted;
                    }
                }
                dip_core.Attribute.type.unordered_container -> {
                    if (v.value??) {
                        if (v.inner_type?? and dip_core.Attribute.type.from_gtv(v.inner_type!!) == dip_core.Attribute.type.id) {
                            val ids = set<byte_array>.from_gtv(v.value!!);
                            instance_ids.add_all(ids);
                            
                            val converted = dip_core.attribute_type(
                                dip_core.Attribute.type.instance,
                                value = set(ids @* {} (Id.get_instance($))).to_gtv()
                            );
                            
                            local_types[k] = converted;
                        }
                    }
                }
                dip_core.Attribute.type.instance -> require(false, "Use ID type to link originals after minting.");
            }
        }
        
        return (v = local_types, i = instance_ids);
    }
}

namespace Minter.Unsafe {
    function _mint(ft3_account.account, collection_name: text, original_type: I, quantity: integer, dip_core.Meta.Engine.access): dip_core.instance {
        val prototype = if (original_type.prototype_name != null) dip_core.Prototype.get(original_type.prototype_name!!) else null;
        
        // Collection checks and forced values
        val collection = collections.Collection(collection_name);
        original_type.types[chromia.IOriginal.creator_id] = dip_attributes.ByteArray.T(collection.owner.id);
        require(
            not original_type.types.contains(chromia.IOriginal.collection_name)
            or original_type.types[chromia.IOriginal.collection_name].value == null 
            or original_type.types[chromia.IOriginal.collection_name].value!! == collection_name.to_gtv(),
            "chromia.IOriginal.collection_name attribute doesn't match passed collection_name"
        );
        val prototype_collection_name = if (prototype != null) dip_attributes.Text.get_value(prototype, chromia.IOriginal.collection_name) else null;
        if (prototype_collection_name != null) {
            require(prototype_collection_name == collection_name, "Prototype chromia.IOriginal.collection_name value doesn't match passed collection name");
        } else {
            original_type.types[chromia.IOriginal.collection_name] = dip_attributes.Text.T(collection.name);
        }
        
        val (types, instance_ids) = _convert_id_type_to_instance(original_type.types);
        val interface = dip_core.Interface.get(original_type.interface_name);
        val instance = dip_core.InstanceFactory.new(interface, types, original_type.prototype_name, access);
        val name = if (chromia.IOriginal.name in original_type.types)
                original_type.types[chromia.IOriginal.name].value
            else
                null;

        var original_name = if (name??) text.from_gtv(name) else null;
        if (empty(original_name)) {
            // Original name is not defined, check if name is defined on prototype

            // Original doesn't have prototype, therefore throw an error
            require(prototype, "Original doesn't have name");

            original_name = require(
                dip_attributes.Text.get_value(prototype, chromia.IOriginal.name),
                "Original name not defined on instance or on prototype"
            );
        }

        val asset = originals_utils.Ft3Helper.create_and_mint_asset(Id.generate(), original_name, account.id, quantity);
        Id.new(asset, instance);

        for (id in instance_ids) {
            originals_utils.Ft3Helper.lock_asset(account.id, id, originals_utils.Ft3Helper.LINKED);
        }

        collections.add_original_to_collection(account, Id.get_by_id(asset.id), collection);
        Hooks.after_mint(account, instance, quantity);
        
        return instance;
    }
    
    function mint_fungible_original(
        ft3_account.account,
        fungible_id: byte_array,
        quantity: integer = 1
    ): dip_core.instance {
        require(quantity > 0, "Quantity has to be greater than 0");
        
        val instance = Id.get_instance(fungible_id);        
        val max_supply = dip_attributes.Integer.get_value(instance, chromia.IFungibleOriginal.max_supply);
                
        val total_supply = originals_utils.Ft3Helper.get_asset_supply(fungible_id);
        require(total_supply + quantity <= max_supply!!, "Total supply exceeds max supply");
        
        originals_utils.Ft3Helper.mint_existing_asset(fungible_id, account.id, quantity);
        
        Hooks.after_mint(account, instance, quantity);
        
        return instance;
    }
}

namespace Minter.Hooks {
    @extendable function after_mint(
        account: ft3_account.account,
        original: dip_core.instance,
        quantity: integer
    );
}
