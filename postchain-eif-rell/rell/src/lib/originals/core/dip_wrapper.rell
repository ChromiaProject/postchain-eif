namespace Wrapper.InterfaceFactory {
    function new(
        account: ft3_account.account,
        name,
        attributes: map<dip_core.Attribute.I, dip_core.attribute_def>,
        dependencies: list<dip_core.Interface.dclass> = list(),
        meta: list<dip_core.Meta.I> = list(),
        is_open: boolean = false
    ) {
        
        val all_dependencies = list<dip_core.Interface.dclass>();
        for(dependency in dependencies) {
            all_dependencies.add_all(
                dip_core.Interface.get_with_dependencies(dependency)
            );
        }
        
        /* check interface IFungibleOriginal attributes */
        if(all_dependencies.contains(chromia.IFungibleOriginal.get())) {
            // attributes must be creator mutable or immutable 
            for((k, v) in attributes) {
                val attrs = v.meta @* { .meta_key in [
                    dip_core.AttributeMeta.type.public_mutable.name,
                    Meta.type.owner_mutable.name
                ]};
                
                require(
                    attrs.empty(),
                    "Attributes implementing "+
                    chromia.IFungibleOriginal.interface + 
                    " must be creator mutable or immutable."
                );
            }
        }
        dip_core.InterfaceFactory.new(name, attributes, dependencies, meta, account, is_open);
    }
}

namespace Wrapper.PrototypeFactory {
    function new(
        dip_core.Interface.dclass,
        attributes: map<dip_core.Attribute.I, dip_core.attribute_type>,
        name,
        prototype_name: text? = null,
        dip_core.Meta.Engine.access
    ) {
        dip_core.PrototypeFactory.new(dclass, attributes, name, prototype_name, access);
    }
}

namespace Wrapper.Attribute {
    /* Add */
    function add_values(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv,
        dip_core.Meta.Engine.access
    ) {
        dip_core.Attribute.add_value(instance, attribute_name, value, access);
    }
    
    function add_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv,
        dip_core.Meta.Engine.access
    ) {
        dip_core.Attribute.add_value(instance, attribute_name, value, access);
    }
    
    /* Update */
    function update_values(
        dip_core.instance,
        attributes: map<dip_core.Attribute.I, gtv>,
        dip_core.Meta.Engine.access
    ) {
        for ((name, value) in attributes) {
            update_value(instance, name, value, access);
        }
    }
    
    function update_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv,
        dip_core.Meta.Engine.access
    ) {
        dip_core.Attribute.update_value(instance, attribute_name, value, access);
    }
    
    /* Set */
    function set_values(
        dip_core.instance,
        attributes: map<dip_core.Attribute.I, gtv>,
        dip_core.Meta.Engine.access
    ) {
        for ((name, value) in attributes) {
            set_value(instance, name, value, access);
        }
    }
    
    function set_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv,
        dip_core.Meta.Engine.access
    ) {
        dip_core.Attribute.set_value(instance, attribute_name, value, access);
    }
    
    /* Remove */
    function remove_values(
        dip_core.instance,
        attributes: list<dip_core.Attribute.I>
    ) {
        for (name in attributes) {
            remove_value(instance, name);
        }
    }
    
    function remove_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I
    ): gtv {
        return dip_core.Attribute.remove_value(instance, attribute_name);
    }
    
    /* Add container element*/
    function add_container_element(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv,
        dip_core.Meta.Engine.access
    ) {
        if (dip_utils.util.is_implemented(instance, dip_core.Attribute.get(attribute_name))) {
            dip_core.Attribute.add_container_element(instance, attribute_name, value, access);
        } else {
            dip_core.Attribute.add_value(instance, attribute_name, [value].to_gtv(), access);
        }
    }
    
    /* Remove container element */
    function remove_container_element(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv,
        dip_core.Meta.Engine.access
    ) {
        dip_core.Attribute.remove_container_element(instance, attribute_name, value, access);
    }
    
    /* Get value */
    function get_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I
    ): gtv? {
        return dip_core.Attribute.get_value(instance, attribute_name);
    }
    
    /* Find instances */
    function find_instances(
        attribute_name: dip_core.Attribute.I,
        value: gtv,
        dip_utils.page_cursor_instance_id
    ) {
        return dip_core.Attribute.find_instances(attribute_name, value, page_cursor_instance_id);
    }
    
    function filter_instances(
        filters: list<dip_core.Filter.I>,
        dip_utils.page_cursor_instance_id
    ) {
        return dip_core.Filter.find_instances(filters, page_cursor_instance_id);
    }
}

namespace Wrapper.Attribute.Unsafe {
    /* Add unsafe*/
    function add_values(
        dip_core.instance,
        attributes: map<dip_core.Attribute.I, gtv>
    ) {
        for ((name, value) in attributes) {
            add_value(instance, name, value);
        }
    }
    
    function add_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv
    ) {
        dip_core.Attribute.Unsafe.add_value(instance, attribute_name, value);
    }
    
    /* Update unsafe*/
    function update_values(
        dip_core.instance,
        attributes: map<dip_core.Attribute.I, gtv>
    ) {
        for ((name, value) in attributes) {
            update_value(instance, name, value);
        }
    }
    
    function update_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv
    ) {
        dip_core.Attribute.Unsafe.update_value(instance, attribute_name, value);
    }
    
    /* Set unsafe*/
    function set_values(
        dip_core.instance,
        attributes: map<dip_core.Attribute.I, gtv>
    ) {
        for ((name, value) in attributes) {
            set_value(instance, name, value);
        }
    }

    function set_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv
    ) {
        dip_core.Attribute.Unsafe.set_value(instance, attribute_name, value);
    }
    
    /* Remove unsafe*/
    function remove_values(
        dip_core.instance,
        attributes: list<dip_core.Attribute.I>
    ) {
        for (attribute in attributes) {
            remove_value(instance, attribute);
        }
    }
    
    function remove_value(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I
    ): gtv {
        return dip_core.Attribute.Unsafe.remove_value(instance, attribute_name);
    }
    
    /* Add container element unsafe*/
    function add_container_element(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv
    ) {
        if (dip_utils.util.is_implemented(instance, dip_core.Attribute.get(attribute_name))) {
            dip_core.Attribute.Unsafe.add_container_element(instance, attribute_name, value);
        } else {
            dip_core.Attribute.Unsafe.add_value(instance, attribute_name, [value].to_gtv());
        }
    }
    
    /* Remove container element unsafe*/
    function remove_container_element(
        dip_core.instance,
        attribute_name: dip_core.Attribute.I,
        value: gtv
    ) {
        dip_core.Attribute.Unsafe.remove_container_element(instance, attribute_name, value);
    }
}
