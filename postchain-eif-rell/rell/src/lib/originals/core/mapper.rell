namespace OMapper {
    enum type {
        id,
        owner,
        prototype
    }
    
    function map_original_meta(
        original_meta_list: list<type>, 
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit = dip_core.Mapper.direct()
    ): (dip_core.instance, map<name, gtv?>, list<dip_core.Mapper.option>) -> unit {
        return _map_original_meta(*, *, *, original_meta_list, mapper);
    }
    
    function _map_original_meta( 
        dip_core.instance, 
        instance_map: map<name, gtv?>, 
        options: list<dip_core.Mapper.option>,
        original_meta_list: list<type>, 
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit
    ) {
        val values = map<dip_core.Mapper.key_name, gtv?>();
        
        for (meta in original_meta_list) {
            when (meta) {
                type.id -> 
                    values[dip_core.Mapper.key_name(name=type.id.name)] = Id.get_id(instance).to_gtv();
                 
                // TODO: investigate what to send when original instance has multiple owners
                // - owner count
                // - owners page
                // - list of all owners
                // - special account that represents all owners
                // - special id `0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF`
                // - original id
                type.owner -> 
                    values[dip_core.Mapper.key_name(name=type.owner.name)] = Ownership.get_owner_if_one_by_original_instance(instance)?.to_gtv();
                type.prototype -> 
                    values[dip_core.Mapper.key_name(name=type.prototype.name)] = dip_core.Prototype.get_first_prototype_name(instance)?.to_gtv();
            }
        }
        
        mapper(instance_map, values, options); 
    }
    
    /*
     *  Reads all instance marketplace settlement_descriptor values 
     */
    
    function map_marketplace_settlement_descriptor(
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit = dip_core.Mapper.direct()
    ): (dip_core.instance, map<name, gtv?>, list<dip_core.Mapper.option>) -> unit {
        return _map_marketplace_settlement_descriptor(*, *, *, mapper);
    }
    
    function _map_marketplace_settlement_descriptor( 
        dip_core.instance, 
        instance_map: map<name, gtv?>,
        options: list<dip_core.Mapper.option>,
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit
    ) {
        val values = map<dip_core.Mapper.key_name, gtv?>();
        val settlement_descriptor = originals_marketplace.Marketplace.settlement_descriptor @? {
            .maker_descriptor.asset.id == Id.get_id(instance)
        };
        
        if(settlement_descriptor??) {
            values.put_all([
                dip_core.Mapper.key_name(name="settlement_type"): settlement_descriptor.settlement_type.to_gtv(),
                dip_core.Mapper.key_name(name="maker"): settlement_descriptor.maker_descriptor.account.id.to_gtv(),
                dip_core.Mapper.key_name(name="amount"): settlement_descriptor.taker_descriptor.amount.to_gtv(),
                dip_core.Mapper.key_name(name="asset_type"): settlement_descriptor.taker_descriptor.asset_type.to_gtv(),
                dip_core.Mapper.key_name(name="asset_id"): settlement_descriptor.taker_descriptor.asset.id.to_gtv(),
                dip_core.Mapper.key_name(name="id"): settlement_descriptor.id.to_gtv(),
                dip_core.Mapper.key_name(name="expiration"): settlement_descriptor.expiration.to_gtv()
            ]);
        }
        
        mapper(instance_map, values, options); 
    }
    
    /*
     *  Reads all instance linked originals.
     *  It is also possible to specify mapping rules for children instances.  
     */
    function map_linked(
        children_mappers: list<(dip_core.instance, map<name, gtv?>, list<dip_core.Mapper.option>) -> unit> = [dip_core.Mapper.map_all_attributes()],
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit = dip_core.Mapper.direct(),
        meta: list<dip_core.Meta.meta>? = null
    ): (dip_core.instance, map<name, gtv?>, list<dip_core.Mapper.option>) -> unit {
        return _map_linked(*, *, *, children_mappers, mapper, meta);
    }
    
    function _map_linked(
        dip_core.instance, 
        instance_map: map<name, gtv?>, 
        options: list<dip_core.Mapper.option>,
        children_mappers: list<(dip_core.instance, map<name, gtv?>, list<dip_core.Mapper.option>) -> unit>,
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit,
        meta: list<dip_core.Meta.meta>?
    ) {
        val mapped_instances = (i: dip_attributes.Instance.instance_attribute, ai: Id.asset_instance) @* {
            i.instance == instance, i.value == ai.instance
        } ((
            dip_core.Mapper.key_name(prefix=i.attribute.dclass.name, name=i.attribute.name),
            dip_core.Mapper.decorate_with_meta_if_needed(
                dip_core.Mapper._get_attribute_name_from_attribute(i.attribute),
                dip_core.Mapper.map_instance(i.value, children_mappers, options).to_gtv(),
                meta,
                options
            ) 
        ));
        
        mapper(instance_map, map<dip_core.Mapper.key_name, gtv?>(mapped_instances), options);
    }
    
    /*
     *  Reads all instance badges
     *  can be replaced by map_attributes_implementing_interface when set of instances are supported
     */
    function map_badges(
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit = dip_core.Mapper.direct()
    ): (dip_core.instance, map<name, gtv?>, list<dip_core.Mapper.option>) -> unit {
        return _map_badges(*, *, *, mapper);
    }
    
    function _map_badges( 
        dip_core.instance, 
        instance_map: map<name, gtv?>,
        options: list<dip_core.Mapper.option>,
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit
    ) {
        val values = list<gtv?>();
        val badge_instances = Badge.Original.get_all(instance);
        
        for(badge_instance in badge_instances) {
            values.add(
                dip_core.Mapper.map_instance(
                    badge_instance,
                    [dip_core.Mapper.map_attributes_of_interfaces([chromia.IBadge.get()])]
                ).to_gtv()
            );
        }
        
        mapper(instance_map, [dip_core.Mapper.key_name(name="badges"): values.to_gtv()], options);
    }
    
    function map_tx_history(
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit = dip_core.Mapper.direct()
    ): (dip_core.instance, map<name, gtv?>, list<dip_core.Mapper.option>) -> unit {
        return _map_tx_history(*, *, *, mapper);
    }
    
    function _map_tx_history( 
        dip_core.instance, 
        instance_map: map<name, gtv?>,
        options: list<dip_core.Mapper.option>,
        mapper: (map<name, gtv?>, map<dip_core.Mapper.key_name, gtv?>, list<dip_core.Mapper.option>) -> unit
    ) {
        val trade_logs = originals_marketplace.Marketplace.History.get_trade_logs(Id.get_id(instance));
        val trade_logs_map = map<dip_core.Mapper.key_name, gtv?>();
        
        for(trade_log in trade_logs) {
            trade_logs_map[dip_core.Mapper.key_name(name=trade_log.block_height.to_text())] = trade_log.to_gtv_pretty();
        }
        
        mapper(instance_map, trade_logs_map, options); 
    }
}

