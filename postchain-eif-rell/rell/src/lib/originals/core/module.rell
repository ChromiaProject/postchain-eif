module;

import ^.collections;
import ft3_account: ^^.ft3.account;
import ft3_core: ^^.ft3.core;
import originals_utils: ^.util;
import dip_core: ^^.dip.core;
import dip_attributes: ^^.dip.attributes;
import dip_utils: ^^.dip.util;
import originals_marketplace: ^.marketplace;
import ft3_helper: ^^.ft3_helper;
import collections_access: ^.collections.external.access;

@extend(Ownership.Hooks.after_transfer)
function (
    account: ft3_account.account, 
    original: dip_core.instance, 
    to_id: byte_array, 
    quantity: integer
) {
    val original_id = Id.get_id(original);
    if (originals_utils.Ft3Helper.is_asset_locked(account.id, original_id)) return;
    
    val collection = collections.collection_original @? { .asset_instance.asset.id == original_id } .collection;

    if (empty(collection)) return;

    collections.update_collection_nft_owner_after_transfer(
        collection,
        account,
        ft3_account.account @ { to_id },
        quantity
    );
}

