namespace Meta {
    enum type {
        approved_minter_mutable,
        owner_mutable
    }
    
    @extend(dip_core.Meta.Engine.access_constraint) function(
        dip_core.attribute,
        dip_core.instance,
        meta_key: text,
        meta_value: gtv,
        dip_core.Meta.Engine.access
    ): boolean {
        when (meta_key) {
            type.owner_mutable.name -> {
                check_owner_mutable(instance, attribute, meta_value, access);
                return true;
            }
            type.approved_minter_mutable.name -> {
                check_approved_minter_mutable(instance, attribute, meta_value, access);
                return true;
            }
        }
        
        return false;
    }
    
    function check_owner_mutable(dip_core.instance, dip_core.attribute, meta_value: gtv, dip_core.Meta.Engine.access) {        
        val id = Id.get_id(instance);        
        require(originals_utils.Ft3Helper.owns_original(access.account.id, id), "Attribute " + attribute.name + " can only be changed by owner.");
    }
    
    function check_approved_minter_mutable(dip_core.instance, dip_core.attribute, meta_value: gtv, dip_core.Meta.Engine.access) {
        val collection_name = dip_attributes.Text.get_value(instance, chromia.IOriginal.collection_name);
        require(collection_name, "No collection name found in instance");
        collections_access.require_collection_owner_or_approved_minter(
            originals_utils.Ft3Helper.get_ft3_account(access.account.id),
            collections.Collection(collection_name)
        );
    }
}
    
function OwnerMutable(): dip_core.Meta.I {
    return dip_core.Meta.I(
        meta_key = Meta.type.owner_mutable.name,
        meta_value = true.to_gtv().to_bytes(),
        category = dip_core.AttributeMeta.category.access_constraint.name
    );
}

function ApprovedMinterMutable(): dip_core.Meta.I {
    return dip_core.Meta.I(
        meta_key = Meta.type.approved_minter_mutable.name,
        meta_value = true.to_gtv().to_bytes(),
        category = dip_core.AttributeMeta.category.access_constraint.name
    );
}
