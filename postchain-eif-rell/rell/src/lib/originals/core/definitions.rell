namespace chromia.IHasBadges {
    val interface = "chromia.IHasBadges";
    
    function dependencies(): list<text> {return [];}
    
    val badges = dip_core.Attribute.I(interface, name = "badges");
    
    function register(account: ft3_account.account) {
        dip_core.InterfaceFactory.new(interface,
            [
                badges: dip_core.Type(
                    dip_attributes.Set.T(dip_core.Attribute.type.instance),
                    [dip_core.ImplementsInterface(IBadge.interface), dip_core.Optional()]
                )
            ],
            dependencies() @* {} (dip_core.Interface.get($)),
            account = account,
            is_open = true
        );
    }
    
    function get() = dip_core.Interface.get(interface);
    function has(dip_core.instance) = dip_core.Interface.is_a(instance, get());
}

namespace chromia.IBadge {
    val interface = "chromia.IBadge";
    
    function dependencies(): list<text> {return [];}
    
    val name = dip_core.Attribute.I(interface, name = "name");
    val display_name = dip_core.Attribute.I(interface, name = "display_name");
    val description = dip_core.Attribute.I(interface, name = "description");
    val image = dip_core.Attribute.I(interface, name = "image");
    
    function register(account: ft3_account.account) {
        dip_core.InterfaceFactory.new(interface,
            [
                name: dip_core.Type(dip_attributes.Text.T()),
                display_name: dip_core.Type(dip_attributes.Text.T()),
                description: dip_core.Type(dip_attributes.Text.T()),
                image: dip_core.Type(dip_attributes.Text.T())
            ],
            dependencies() @* {} (dip_core.Interface.get($)),
            account = account,
            is_open = true
        );
    }
    
    function get() = dip_core.Interface.get(interface);
    function has(dip_core.instance) = dip_core.Interface.is_a(instance, get());
}

function initialize_original_interfaces(account: ft3_account.account) {
    chromia.IOriginal.register(account);
    chromia.INonFungibleOriginal.register(account);
    chromia.IFungibleOriginal.register(account);
    chromia.IFractionalizedOriginal.register(account);
    chromia.IHasBadges.register(account);
    chromia.IBadge.register(account);
    chromia.ITradable.register(account);
}
