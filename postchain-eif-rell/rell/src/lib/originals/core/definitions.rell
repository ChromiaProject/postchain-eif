namespace chromia.IOriginal {
    val interface = "chromia.IOriginal";
    
    function dependencies(): list<text> {return [];}
    
    val name = dip_core.Attribute.I(interface, name = "name");
    val description = dip_core.Attribute.I(interface, name = "description");
    // later web of trust identifier
    val creator_id = dip_core.Attribute.I(interface, name = "creator_id");
    val creator_name = dip_core.Attribute.I(interface, name = "creator_name");
    val collection_name = dip_core.Attribute.I(interface, name = "collection_name");
    
    function register(account: ft3_account.account) {
        dip_core.InterfaceFactory.new(interface,
            [
                name: dip_core.Type(dip_attributes.Text.T()),
                creator_id: dip_core.Type(dip_attributes.ByteArray.T()),
                creator_name: dip_core.Type(dip_attributes.Text.T()),
                description: dip_core.Type(dip_attributes.Text.T(), [dip_core.Optional(), ApprovedMinterMutable()]),
                collection_name: dip_core.Type(dip_attributes.Text.T())
            ],
            dependencies() @* {} (dip_core.Interface.get($)),
            account = account,
            is_open = true
        );
    }
    
    function get() = dip_core.Interface.get(interface);
    function has(dip_core.instance) = dip_core.Interface.is_a(instance, get());
}

namespace chromia.INonFungibleOriginal {
    val interface = "chromia.INonFungibleOriginal";
    
    function dependencies(): list<text> {return [IOriginal.interface];}
    
    function register(account: ft3_account.account) {
        dip_core.InterfaceFactory.new(interface,
            [:],
            dependencies() @* {} (dip_core.Interface.get($)),
            account = account,
            is_open = true
        );
    }
    
    function get() = dip_core.Interface.get(interface);
    function has(dip_core.instance) = dip_core.Interface.is_a(instance, get());
}

namespace chromia.IFungibleOriginal {
    val interface = "chromia.IFungibleOriginal";
    
    function dependencies(): list<text> {return [IOriginal.interface];}
    
    val max_supply = dip_core.Attribute.I(interface, name = "max_supply");
    
    function register(account: ft3_account.account) {
        dip_core.InterfaceFactory.new(interface,
            [
                max_supply: dip_core.Type(dip_attributes.Integer.T())
            ],
            dependencies() @* {} (dip_core.Interface.get($)),
            account = account,
            is_open = true
        );
    }
    
    function get() = dip_core.Interface.get(interface);
    function has(dip_core.instance) = dip_core.Interface.is_a(instance, get());
}

namespace chromia.IFractionalizedOriginal {
    val interface = "chromia.IFractionalizedOriginal";
    
    function dependencies(): list<text> {return [IFungibleOriginal.interface];}
    
    val original = dip_core.Attribute.I(interface, name = "original");
    
    function register(account: ft3_account.account) {
        dip_core.InterfaceFactory.new(interface,
            [
                original: dip_core.Type(
                    dip_attributes.Instance.T(),
                    [dip_core.ImplementsInterface(INonFungibleOriginal.interface)]
                )
            ],
            dependencies() @* {} (dip_core.Interface.get($)),
            account = account,
            is_open = true
        );
    }
    
    function get() = dip_core.Interface.get(interface);
    function has(dip_core.instance) = dip_core.Interface.is_a(instance, get());
}

namespace chromia.ITradable {
    val interface = "chromia.ITradable";
    
    function dependencies(): list<text> {return [];}
    
