@mount("marketplace")
namespace Queries {
    struct asset {
        id: byte_array;
        name: text;
    }

    struct payment_descriptor {
        asset; // Asset can refer to an Original, an EVM imported original, or an EVM asset (ERC20 or Eth)
        assetType: integer;
        amount: integer; // Only mutated on auction type settlements
        // Used on the taker side to store the highest bidder, can later be used to reserve a settlement for a particular account
        accountId: byte_array?;
    }

    struct settlement_descriptor_ret {
        id: byte_array;
        makerDescriptor: payment_descriptor;
        takerDescriptor: payment_descriptor;
        expiration: integer;
        salt: integer;
        settlementType: integer;
    }

    query get_evm_settlement_descriptor(
        settlement_id: byte_array
    ) {
        return Marketplace.get_evm_settlement_descriptor(settlement_id);
    }

    query get_settlement_descriptor(
        settlement_id: byte_array
    ): settlement_descriptor_ret? {
        val settlement_descriptor = Marketplace.settlement_descriptor @? {settlement_id};
        if (settlement_descriptor == null) {
            return null;
        }
        
        val maker_descriptor = payment_descriptor(
            asset(settlement_descriptor.maker_descriptor.asset.id, settlement_descriptor.maker_descriptor.asset.name),
            assetType = settlement_descriptor.maker_descriptor.asset_type.value,
            amount = settlement_descriptor.maker_descriptor.amount,
            settlement_descriptor.maker_descriptor.account.id
        );
        
        val taker_descriptor = payment_descriptor(
            asset(settlement_descriptor.taker_descriptor.asset.id, settlement_descriptor.taker_descriptor.asset.name),
            assetType = settlement_descriptor.taker_descriptor.asset_type.value,
            amount = settlement_descriptor.taker_descriptor.amount,
            if (settlement_descriptor.taker_descriptor.account == Marketplace.ensure_null_account(settlement_descriptor.maker_descriptor.account)) 
                settlement_descriptor.taker_descriptor.account.id 
                else null
        );
        
        val settlement_descriptor_ret = settlement_descriptor_ret(
            settlement_descriptor.id,
            makerDescriptor = maker_descriptor,
            takerDescriptor = taker_descriptor,
            expiration = settlement_descriptor.expiration,
            salt = settlement_descriptor.salt,
            settlementType = settlement_descriptor.settlement_type.value
        );
        
        return settlement_descriptor_ret;
    }

    query derive_settlement_id(maker_account_id: byte_array, maker_descriptor_asset_id: byte_array, salt: integer) {
        return Marketplace.derive_settlement_id(maker_account_id, maker_descriptor_asset_id, salt);
    }

    query get_evm_asset(asset_id: byte_array) {
        return Marketplace.evm_asset @? {.asset.id == asset_id} (.address, evm_type = .evm_type.value, .token_id);
    }

    query derive_fungible_evm_asset_id(evm_address: text) {
        return Marketplace.derive_fungible_evm_asset_id(evm_address);
    }

    // History

    query get_trade_logs(asset_id: byte_array) {
        return Marketplace.History.get_trade_logs(asset_id);
    }

    query find_original_instance_trade_history_page(
        asset_id: byte_array, 
        page_cursor: text
    ) {
        val cursor = mapper.decode_cursor(page_cursor);
        val history = Marketplace.History.get_trade_logs_page(asset_id, cursor);

        return mapper.make_page(history, cursor);
    }

    // Category

    query get_category_attributes(name) {
        val dclass = Marketplace.Meta.get_interface_by_category(name);
        require(dclass, "Category with name " + name + " not found.");
        
        return dip_core.Attribute.get_all(dclass) @* {} (dip_core.Attribute.get_name_from_attribute($));
    }

    query get_categories() {
        return Marketplace.Category.get_all().to_gtv_pretty();
    }

    // FIlter

    query find_listed_originals_by_interface(
        interface_name: name,
        page_cursor: text
    ) {
        val cursor = mapper.decode_cursor(page_cursor);
        val result = Marketplace.Filter.find_listed_originals_by_interface(interface_name, cursor);
        return mapper.make_page(result, cursor);
    }

    query find_listed_originals_by_interface_price_range(
        interface_name: name,
        min: integer,
        max: integer,
        page_cursor: text
    ) {
        val cursor = mapper.decode_cursor(page_cursor);
        val result = Marketplace.Filter.find_listed_originals_by_interface_price_range(interface_name, min, max, cursor);
        return mapper.make_page(result, cursor);
    }

    query find_original_instances_by_owner_id_and_status(
        owner_id: byte_array,
        listed_state: boolean,
        page_cursor: text
    ) {
        val cursor = mapper.decode_cursor(page_cursor);
        val originals = Marketplace.Filter.find_original_instances_by_owner_id_and_status(owner_id, listed_state, cursor);
        return mapper.make_page(originals, cursor);
    }

    query get_interface_filters(interface: name) {
        return Marketplace.Filter.get_by_interface(interface);
    }

    query search(
        text
    ): (type: text, hit: gtv)? {
        return Marketplace.Filter.search(text);
    }

    // TODO: These queries are not Marketplace specific, they are general purpose for Originals

    query get_grouped_interfaces(): map<name, list<map<name, gtv>>> {
        return Marketplace.Filter.get_grouped_interfaces();
    }

    query find_originals_by_creator_id(
        creator_id: byte_array,
        page_cursor: text
    ) {
        val cursor = mapper.decode_cursor_with_instance_id(page_cursor);
        return Marketplace.Filter.find_originals_by_creator_id(creator_id, cursor);
    }

    query find_original_by_id(id: byte_array) {
        return Marketplace.Filter.find_original_by_id(id);
    }

    query find_original_instances_by_owner_id(
        owner_id: byte_array, 
        page_cursor: text
    ) {
        val cursor = mapper.decode_cursor(page_cursor);
        val result = Marketplace.Filter.find_original_instances_by_owner_id(owner_id, cursor);
        return mapper.make_page(result, cursor);
    }

    query find_distinct_original_names_by_interface(interface_name: name) {
        return Marketplace.Filter.find_distinct_original_names_by_interface(interface_name);
    }

    query find_originals_by_name(name: text) {
        return Marketplace.Filter.find_originals_by_name(name);
    }

    query find_listed_originals_by_collection(
        collection_name: text, 
        interface_name: name, 
        page_cursor: text  
    ) {
        val collection = collections.Collection(collection_name);

        val cursor = mapper.decode_cursor(page_cursor);
        
        val originals = Marketplace.Filter.find_paginated_listed_originals_by_collection(
            collection,
            interface_name,
            cursor
        );
        
        return mapper.make_page(originals, cursor);
    }
}