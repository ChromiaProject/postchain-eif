@extend(extensions.after_create_settlement)
function after_create_settlement(
    Marketplace.settlement_descriptor
) {
    val type: text;
    when (settlement_descriptor.settlement_type) {
// TODO: Uncomment once marketplace expansion is merged into dev
//        Marketplace.settlement_type.offer -> {
//            create Events.event(
//                OFFER,
//                asset_id = settlement_descriptor.taker_descriptor.asset.id,
//                from = settlement_descriptor.maker_descriptor.account,
//                to = settlement_descriptor.taker_descriptor.account,
//                params = settlement_descriptor.to_gtv_pretty().to_bytes()
//            );
//        }
        else -> {
            create events.event(
                events.event_type.on_sale,
                asset = settlement_descriptor.maker_descriptor.asset,
                from = settlement_descriptor.maker_descriptor.account,
                to = settlement_descriptor.taker_descriptor.account,
                params = settlement_descriptor_to_struct(settlement_descriptor).to_gtv_pretty().to_bytes()
            );
        }
    }
} 

@extend(extensions.after_settle)
function after_settle(
    taker_account: ft3_account.account,
    Marketplace.settlement_descriptor
) {
    create events.event(
        events.event_type.sold,
        asset = settlement_descriptor.maker_descriptor.asset,
        from = settlement_descriptor.maker_descriptor.account,
        to = taker_account,
        params = settlement_descriptor_to_struct(settlement_descriptor).to_gtv_pretty().to_bytes()
    );
}

@extend(extensions.after_bid)
function after_bid(
    bidder_account: ft3_account.account,
    amount: integer,
    Marketplace.settlement_descriptor
) {
    create events.event(
        events.event_type.bid,
        asset = settlement_descriptor.maker_descriptor.asset,
        from = bidder_account,
        to = settlement_descriptor.maker_descriptor.account,
        params = settlement_descriptor_to_struct(settlement_descriptor).to_gtv_pretty().to_bytes()
    );
}

@extend(originals_core.Minter.Hooks.after_mint)
function after_mint(
        account: ft3_account.account,
        original: dip_core.instance,
        quantity: integer
) {
    create events.event(
        events.event_type.mint,
        asset = originals_core.Id.asset_instance @ {original}.asset,
        from = account,
        to = account,
        params = (
            quantity = quantity
        ).to_gtv_pretty().to_bytes()
    );
}

@extend(originals_core.Ownership.Hooks.after_transfer)
function after_transfer(
    account: ft3_account.account,
    original: dip_core.instance,
    to_id: byte_array,
    quantity: integer
) {
    create events.event(
        events.event_type.transfer,
        asset = originals_core.Id.asset_instance @ {original}.asset,
        from = account,
        to = ft3_account.account @ {to_id},
        params = (
            quantity = quantity
        ).to_gtv_pretty().to_bytes()
    );
}

@extend(extensions.before_create_or_update_offer)
function before_create_or_update_offer(
    bidder_account: ft3_account.account,
    offer_amount: integer,
    asset: ft3_core.asset
) {
    val bidders_balance = ft3_core.ensure_balance(bidder_account, asset);
    ensure_bidders_balance(bidders_balance.amount, offer_amount);
}

@extend(extensions.after_create_offer)
function after_create_offer(Marketplace.offer) {
    create_offer_event(offer, events.event_type.offer_placed);
}

@extend(extensions.after_update_offer)
function after_update_offer(Marketplace.offer) {
    create_offer_event(offer, events.event_type.offer_updated);
}

@extend(extensions.before_accept_offer)
function before_accept_offer(
    bidder_account: ft3_account.account,
    Marketplace.offer
) {
    val bidders_balance = ft3_core.ensure_balance(bidder_account, offer.maker_descriptor.asset);

    ensure_bidders_balance(bidders_balance.amount, offer.maker_descriptor.amount);
}

@extend(extensions.after_accept_offer)
function after_accept_offer(Marketplace.offer) {
    create_offer_event(offer, events.event_type.sold);

    history.History.log_trade(
        offer.maker_descriptor.account,
        offer.taker_descriptor.account,
        offer.maker_descriptor.asset,
        offer.maker_descriptor.asset,
        offer.maker_descriptor.amount,
        offer.taker_descriptor.amount
    );

    collections.update_collection_nft_owner_after_transfer(
        collections.Collection_by_original_id(offer.asset_instance.asset.id),
        offer.taker_descriptor.account,
        offer.maker_descriptor.account
    );

    Marketplace.delete_offer(offer.asset_instance);
}

function create_offer_event(Marketplace.offer, events.event_type) {
    create events.event(
        event_type,
        asset = offer.asset_instance.asset,
        from = offer.taker_descriptor.account,
        to = offer.maker_descriptor.account,
        params = event_offer(
            nft = offer.asset_instance,
            maker_descriptor = event_payment_descriptor(
                asset = event_ft3_asset(
                    id = offer.maker_descriptor.asset.id,
                    name = offer.maker_descriptor.asset.name
                ),
                asset_type = offer.maker_descriptor.asset_type,
                amount = offer.maker_descriptor.amount,
                account = event_ft3_account(
                    id = offer.maker_descriptor.account.id
                )
            ),
            taker_descriptor = event_payment_descriptor(
                asset = event_ft3_asset(
                    id =  offer.taker_descriptor.asset.id,
                    name =  offer.taker_descriptor.asset.name
                ),
                asset_type = offer.taker_descriptor.asset_type,
                amount = offer.taker_descriptor.amount,
                account = event_ft3_account(
                    id = offer.taker_descriptor.account.id
                )
            ),
            created_at = offer.created_at
        ).to_gtv_pretty().to_bytes()
    );
}

function ensure_bidders_balance(bidders_balance: integer, offer_amount: integer) =
    require((bidders_balance >=offer_amount), "Insufficient bidders balance");