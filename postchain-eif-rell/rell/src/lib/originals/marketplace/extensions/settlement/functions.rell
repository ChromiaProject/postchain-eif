
@extend(extensions.after_settle)
function (taker_account: ft3_account.account, originals_marketplace.Marketplace.settlement_descriptor) {
    val collection = find_collection_by_asset(settlement_descriptor.maker_descriptor.asset);
    if (empty(collection)) return;

    collection.trading_volume += settlement_descriptor.taker_descriptor.amount;

    update_floor_price_if_price_match(collection, settlement_descriptor);

    collections.update_collection_nft_owner_after_transfer(
        collection,
        settlement_descriptor.maker_descriptor.account,
        taker_account,
        settlement_descriptor.maker_descriptor.amount
    );
}

@extend(extensions.after_make_payment)
function (originals_marketplace.Marketplace.settlement_descriptor) {
    val collection = find_collection_by_asset(settlement_descriptor.maker_descriptor.asset);
    if (empty(collection)) return;

    if (collection.highest_nft_price < settlement_descriptor.taker_descriptor.amount) {
        collection.highest_nft_price = settlement_descriptor.taker_descriptor.amount;
    }
}

function find_collection_by_asset(asset: ft3_core.asset) 
    = collections.collection_original @? { .asset_instance.asset == asset } .collection;

@extend(extensions.before_delete_settlement)
function (originals_marketplace.Marketplace.settlement_descriptor) {
    val collection = find_collection_by_asset(settlement_descriptor.maker_descriptor.asset);
    if (empty(collection)) return;

    update_floor_price_if_price_match(collection, settlement_descriptor);
}

@extend(extensions.after_create_settlement)
function (originals_marketplace.Marketplace.settlement_descriptor) {
    val collection = find_collection_by_asset(settlement_descriptor.maker_descriptor.asset);
    if (empty(collection)) return;

    collections.update_floor_price(collection, null);
}

@extend(extensions.after_bid)
function (
    bidder_account: ft3_account.account,
    amount: integer,
    originals_marketplace.Marketplace.settlement_descriptor
) {
    val collection = find_collection_by_asset(settlement_descriptor.maker_descriptor.asset);
    if (empty(collection)) return;

    collections.update_floor_price(collection, null);
}

function update_floor_price_if_price_match(collections.collection, originals_marketplace.Marketplace.settlement_descriptor) {
    if (collection.floor_price == settlement_descriptor.taker_descriptor.amount) {
        collections.update_floor_price(collection, settlement_descriptor);
    }
}