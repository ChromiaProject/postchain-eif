
function get_instance_attribute_value(instance, attribute) {
    when (attribute.type) {
        Attribute.type.boolean -> return types.Cache.Boolean.get_instance_attribute_value(instance, attribute);
        Attribute.type.byte_array -> return types.Cache.ByteArray.get_instance_attribute_value(instance, attribute);
        Attribute.type.decimal -> return types.Cache.Decimal.get_instance_attribute_value(instance, attribute);
        Attribute.type.integer -> return types.Cache.Integer.get_instance_attribute_value(instance, attribute);
        Attribute.type.text -> return types.Cache.Text.get_instance_attribute_value(instance, attribute);
        else -> return null;
    }
}