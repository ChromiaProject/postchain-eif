import ^.*;
import ^^.access;
import ^^^^^.ft3.account.*;
import ^^^^.collections.*;

@extend(access.has_add_original_to_collection_permission) 
function (account, original: originals_core.Id.asset_instance, collection) {
    require_collection_owner_or_approved_minter(account, collection);
    return true;
}

@extend(access.has_create_collection_permission)
function (account) {
    return true;
}