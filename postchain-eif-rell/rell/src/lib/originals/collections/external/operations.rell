operation create_collection(
    owners_auth_id: ft3_helper.auth_id,
    name: text,
    symbol: text,
    display_name: text,
    description: text,
    background_image: text,
    collection_avatar: text,
    author_account_id: byte_array,
    project_name: text
) {
    val owner_account = ft3_helper.do_auth(owners_auth_id, []);
    val author_account = originals_util.Ft3Helper.Account(author_account_id);

    access.require_create_collection_permission(owner_account);

    collections.create_collection(
        name,
        symbol,
        display_name, 
        description, 
        owner_account, 
        author_account, 
        background_image, 
        collection_avatar, 
        project_name
    );
}

operation update_collection_details(owners_auth_id: ft3_helper.auth_id, name, display_name: text, description: text) {
    val owner_account = ft3_helper.do_auth(owners_auth_id, []);
    val collection = collections.Collection(name);

    access.require_collection_owner(owner_account, collection);
    collections.update_collection_details(collection, display_name, description);
}

operation add_social_url_to_collection(ft3_helper.auth_id, collection_name: text, social_name: text, social_url: text) {
    val account = ft3_helper.do_auth(auth_id, []);
    val collection = collections.Collection(collection_name);

    access.require_collection_owner(account, collection);
    collections.add_social_url_to_collection(account, collection, social_name, social_url);
}

operation update_collection_social_url(owners_auth_id: ft3_helper.auth_id, collection_name: text, social_name: text, url: text) {
    val owner_account = ft3_helper.do_auth(owners_auth_id, []);
    val collection = collections.Collection(collection_name);

    access.require_collection_owner(owner_account, collection);
    collections.update_collection_social_url(collection, social_name, url);
}

operation add_approved_minter(ft3_helper.auth_id, account_id: byte_array, collection_name: text) {
    val collection = collections.Collection(collection_name);

    access.require_collection_owner(
        ft3_helper.do_auth(auth_id, []),
        collection
    );
    
    collections.add_approved_minter(
        originals_util.Ft3Helper.Account(account_id),
        collection
    );
}

operation update_collection_avatar(ft3_helper.auth_id, name, avatar: text) {
    val account = ft3_helper.do_auth(auth_id, []);
    val collection = collections.Collection(name);

    access.require_collection_owner(account, collection);
    collections.update_collection_avatar(collection, avatar);
}