query find_originals_by_collection_for_account(account_id: byte_array, collection_name: text, page_cursor: text): mapper.paged_result {
    val cursor = mapper.decode_cursor(page_cursor);
    val account = originals_util.Ft3Helper.get_ft3_account(account_id);
    val collection = collections.Collection(collection_name);
    val originals = collections.find_paginated_originals_by_collection_for_account(account, collection, cursor);
    
    return mapper.make_page(originals, cursor);
}

query find_originals_by_collection(collection_name: text, page_cursor: text): mapper.paged_result {
    val cursor = mapper.decode_cursor(page_cursor); 
    val collection = collections.Collection(collection_name);
    val originals = collections.find_paginated_originals_by_collection(collection, cursor);
    
    return mapper.make_page(originals, cursor);
}

query find_collection_by_original_id(original_id: byte_array) {
    return collections.find_collection_by_original_id(original_id);
}

query find_collection_details_by_name(name: text) {
    val collection = collections.collection @? { .name == name };
    if (empty(collection)) return null;
    
    val social = collections.collection_social_url @* { collection } ( name = .name, url = .url );

    return collections.map_collection_details(collection, social);
}

query find_collection_nfts_count(name) =
    collections.collection @? { .name == name } .nfts_count;
