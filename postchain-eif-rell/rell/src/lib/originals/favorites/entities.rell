enum favorite_type {
    nft,
    collection,
    project
}

struct favorite_item {
    type: text;
    id: gtv;
}

entity favorite {
    index favorite_object;
    key user: ft3_account.account, favorite_object;
    created_at: timestamp = originals_util.now_from_context();
}

entity favorite_object {
    mutable favorite_count: integer = 0;
}

entity favorite_nft {
    key favorite_object;
    key nft: originals_core.Id.asset_instance;
}

entity favorite_collection {
    key favorite_object;
    key originals_collections.collection;
}

entity favorite_project {
    key favorite_object;
    key projects.project;
}

function FavoriteItemType(name) = require(
    favorite_type.values() @? { name },
    "Cannot have '%s' as favorite".format(name)
);
