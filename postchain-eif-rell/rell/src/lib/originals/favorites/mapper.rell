function map_favorite_by_type(favorite, favorite_type_name: text) {
    when (favorite_type_from_name(favorite_type_name)) {
        nft -> {
            return (
                id = favorite.rowid,
                type = "nft",
                item = map_favorite_nft(favorite).to_gtv_pretty()
            );
        }
        collection -> {
            return (
                id = favorite.rowid,
                type = "collection",
                item = map_favorite_collection(favorite).to_gtv_pretty()
            );
        }
        project -> {
            return (
                id = favorite.rowid,
                type = "project",
                item = map_favorite_project(favorite).to_gtv_pretty()
            );
        }
    }
}

function map_favorite_nft(favorite) {
    val nft = favorite_nft @ {favorite.favorite_object} .nft;
    val collection = originals_collections.collection_original @? { nft } .collection;

    return map_nft_and_collection(nft, collection, null);
}

function map_nft_and_collection(nft: originals_core.Id.asset_instance, originals_collections.collection?, caller_id: byte_array?) {
    val creator_id = dip_attributes.ByteArray.get_value(nft.instance, originals_core.chromia.IOriginal.creator_id);

    return (
        id = nft.asset.id,
        image = dip_attributes.Text.get_value(nft.instance, originals_core.chromia.ITradable.image),
        name = dip_attributes.Text.get_value(nft.instance, originals_core.chromia.IOriginal.name),
        collection = if (empty(collection)) null else (
            id = collection.name,
            name = collection.display_name
        ),
        favorites_count = favorites.favorite_nft @? { nft } .favorite_object.favorite_count ?: 0,
        is_favorite = if (empty(caller_id)) null else favorites.is_favorite_nft(nft, caller_id)
    );
}

function map_favorite_collection(favorite) {
    val collection = favorite_collection @ { favorite.favorite_object } .collection;

    return (
        background_image = collection.background_image,
        avatar = collection.collection_avatar,
        name = collection.name,
        author = collection.author.id,
        description = collection.description
    );
}

function map_favorite_project(favorite) {
    val project = favorite_project @ { favorite.favorite_object } .project;

    return (
        id = project.name,
        name = project.display_name,
        creator = project.owner,
        background_image = project.background_image,
        avatar = project.avatar,
        description = project.description
    );
}

function favorite_type_from_name(name): favorite_type =
    require(
        favorite_type.values() @? {.name == name},
        "Unrecognized favorite object type %s".format(name)
    );