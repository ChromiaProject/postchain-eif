function find_favorites_by_type(account_id: byte_array, favorite_type_name: text, cursor: mapper.page_cursor) {
    return when(favorite_type_from_name(favorite_type_name)) {
        nft -> find_favorite_nfts(account_id, cursor);
        collection -> find_favorite_collections(account_id, cursor);
        project -> find_favorite_projects(account_id, cursor);
    };
}

function find_favorite_nfts(account_id: byte_array, cursor: mapper.page_cursor) {
    return (f: favorite, fn: favorite_nft) @* { 
        if (cursor.after_rowid??) f.rowid > cursor.after_rowid!! else true,
        f.user.id == account_id,
        f.favorite_object == fn.favorite_object
    } (
        @omit @sort f.rowid,
        mapper.pagination_result(
            data = map_favorite_by_type(f, favorite_type.nft.name).to_gtv_pretty(),
            rowid = f.rowid
        )
    ) limit mapper.fetch_data_size(cursor);    
}

function find_favorite_collections(account_id: byte_array, cursor: mapper.page_cursor) {
    return (f: favorite, fc: favorite_collection) @* {
        if (cursor.after_rowid??) f.rowid > cursor.after_rowid!! else true,
        f.user.id == account_id,
        f.favorite_object == fc.favorite_object
    } (
        @omit @sort f.rowid,
        mapper.pagination_result(
            data = map_favorite_by_type(f, favorite_type.collection.name).to_gtv_pretty(),
            rowid = f.rowid
        )
    ) limit mapper.fetch_data_size(cursor);  
}

function find_favorite_projects(account_id: byte_array, cursor: mapper.page_cursor) {
    return (f: favorite, fp: favorite_project) @* {
        if (cursor.after_rowid??) f.rowid > cursor.after_rowid!! else true,
        f.user.id == account_id,
        f.favorite_object == fp.favorite_object
    } (
        @omit @sort f.rowid,
        mapper.pagination_result(
            data = map_favorite_by_type(f, favorite_type.project.name).to_gtv_pretty(),
            rowid = f.rowid
        )
    ) limit mapper.fetch_data_size(cursor);
}