operation add_to_favorites(ft3_helper.auth_id, favorites.favorite_item) {
    val account = ft3_helper.do_auth(auth_id, []);

    favorites.create_favorite(account, favorite_item);
}

operation remove_from_favorites(ft3_helper.auth_id, favorites.favorite_item) {
    val account = ft3_helper.do_auth(auth_id, []);

    favorites.remove_favorite(account.id, favorite_item);
}