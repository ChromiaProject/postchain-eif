
operation init_originals_interfaces(ft3_helper.auth_id) {
    admin.require_admin();
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    originals_core.initialize_original_interfaces(account);
}

operation def_original_interface(
    ft3_helper.auth_id,
    name,
    attributes: map<dip_core.Attribute.I, dip_core.attribute_def>,
    depends: list<text> = list(),
    meta: list<dip_core.Meta.I> = list()
 ) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val dclasses = dip_core.Interface.get_all(depends);
    access.require_interface_definition_permission(account, dclasses);
    originals_core.Wrapper.InterfaceFactory.new(account, name, attributes, dclasses, meta, true);
}
 
operation def_original_prototype(
    ft3_helper.auth_id,
    interface_name: text,
    attributes: map<dip_core.Attribute.I, dip_core.attribute_type>,
    name,
    prototype_name: text? = null
 ) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    
    var prototype = if (prototype_name??) dip_core.Prototype.get(prototype_name) else null;
    val dclass = dip_core.Interface.get(interface_name);
    access.require_prototype_definition_permission(account, dclass, prototype);
    originals_core.Wrapper.PrototypeFactory.new(dclass, attributes, name, prototype_name, dip_core.Meta.Engine.access(account));
}

operation mint_non_fungible_original(
    ft3_helper.auth_id,
    collection_name: text,
    definition: originals_core.Minter.I
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    access.require_minting_permission(account, dip_core.Interface.get(definition.interface_name), collections.Collection(collection_name));
    originals_core.Minter.mint_non_fungible_original(account, collection_name, definition, dip_core.Meta.Engine.access(account));
}

