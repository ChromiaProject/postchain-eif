operation create_fungible_original(
    ft3_helper.auth_id,
    collection_name: text,
    definition: originals_core.Minter.I,
    quantity: integer = 1
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    access.require_minting_permission(account, dip_core.Interface.get(definition.interface_name), collections.Collection(collection_name));
    originals_core.Minter.create_fungible_original(account, collection_name, definition, quantity, dip_core.Meta.Engine.access(account));
}

operation create_fungible_original_to_account(
    ft3_helper.auth_id,
    collection_name: text,
    definition: originals_core.Minter.I,
    to_account_id: byte_array,
    quantity: integer = 1
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    access.require_minting_permission(account, dip_core.Interface.get(definition.interface_name), collections.Collection(collection_name));
    originals_core.Minter.create_fungible_original_to_account(account, collection_name, definition, to_account_id, quantity, dip_core.Meta.Engine.access(account));
}

operation mint_fungible_original(
    ft3_helper.auth_id,
    fungible_id: byte_array,
    quantity: integer = 1
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = originals_core.Id.get_instance(fungible_id);
    
    val dclass = dip_core.instance_dclass @ {instance, .direct == true} .dclass;
    access.require_minting_permission(
        account,
        dip_core.Interface.get(dclass.name),
        collections.Collection_by_original_id(fungible_id)
    );
    originals_core.Minter.mint_fungible_original(account, fungible_id, quantity);
}

operation mint_fungible_original_to_account(
    ft3_helper.auth_id,
    fungible_id: byte_array,
    to_account_id: byte_array,
    quantity: integer = 1
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = originals_core.Id.get_instance(fungible_id);
    
    val dclass = dip_core.instance_dclass @ {instance, .direct == true} .dclass;
    access.require_minting_permission(
        account,
        dip_core.Interface.get(dclass.name),
        collections.Collection_by_original_id(fungible_id)
    );
    originals_core.Minter.mint_fungible_original_to_account(account, fungible_id, to_account_id, quantity);
}

operation link_original(
    ft3_helper.auth_id,
    attribute_name: dip_core.Attribute.I,
    base_id: byte_array,
    child_id: byte_array
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = originals_core.Id.get_instance(base_id);
    
    dip_core.Meta.Engine.execute_access(instance, attribute_name, dip_core.Meta.Engine.access(account));
    originals_core.Ownership.link_instance(
        account, 
        attribute_name,
        originals_core.Id.get_instance(base_id),
        originals_core.Id.get_instance(child_id),
        dip_core.Meta.Engine.access(account)
    );
}

operation unlink_original(
    ft3_helper.auth_id,
    attribute_name: dip_core.Attribute.I,
    base_id: byte_array,
    child_id: byte_array? = null
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = originals_core.Id.get_instance(base_id);
    
    dip_core.Meta.Engine.execute_access(instance, attribute_name, dip_core.Meta.Engine.access(account));
    originals_core.Ownership.unlink_instance(
        account, 
        attribute_name,
        originals_core.Id.get_instance(base_id),
        if (child_id??) originals_core.Id.get_instance(child_id) else null,
        dip_core.Meta.Engine.access(account)
    );
}

operation transfer_original(
    ft3_helper.auth_id,
    original_id: byte_array,
    account_to_id: byte_array,
    quantity: integer = 1
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    originals_core.Ownership.transfer(
        account,
        originals_core.Id.get_instance(original_id),
        account_to_id,
        quantity
    );
}

operation fractionalize_non_fungible_original(
    ft3_helper.auth_id,
    original_id: byte_array,
    fractional_type: originals_core.Minter.I,
    fractions: integer
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    originals_core.Ownership.fractionalize(
        account,
        originals_core.Id.get_instance(original_id),
        fractional_type,
        fractions,
        dip_core.Meta.Engine.access(account)
    );
}

operation set_original_attribute(
    ft3_helper.auth_id,
    original_id: byte_array,
    attribute_name: dip_core.Attribute.I,
    value: gtv
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = originals_core.Id.get_instance(original_id);
    
    dip_core.Meta.Engine.execute_access(instance, attribute_name, dip_core.Meta.Engine.access(account));
    
    originals_core.Wrapper.Attribute.set_value(
        instance,
        attribute_name,
        value,
        dip_core.Meta.Engine.access(account)
    );
}

operation set_original_attributes(
    ft3_helper.auth_id,
    original_id: byte_array,
    attributes: map<dip_core.Attribute.I, gtv>
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);    
    val instance = originals_core.Id.get_instance(original_id);
    
    for ((attribute_name, value) in attributes) {
        dip_core.Meta.Engine.execute_access(instance, attribute_name, dip_core.Meta.Engine.access(account));
        
        originals_core.Wrapper.Attribute.set_value(
            instance,
            attribute_name,
            value,
            dip_core.Meta.Engine.access(account)
        );
    }
}

operation set_prototype_attribute(
    ft3_helper.auth_id,
    prototype_name: text,
    attribute_name: dip_core.Attribute.I,
    value: gtv
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = dip_core.Prototype.get(prototype_name);
    
    dip_core.Meta.Engine.execute_access(instance, attribute_name, dip_core.Meta.Engine.access(account));
    
    originals_core.Wrapper.Attribute.set_value(
        instance,
        attribute_name,
        value,
        dip_core.Meta.Engine.access(account)
    );
}

operation remove_original_attribute(
    ft3_helper.auth_id,
    original_id: byte_array,
    attribute_name: dip_core.Attribute.I
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = originals_core.Id.get_instance(original_id);
    
    dip_core.Meta.Engine.execute_access(instance, attribute_name, dip_core.Meta.Engine.access(account));
    
    originals_core.Wrapper.Attribute.remove_value(
        instance,
        attribute_name
    );
}

operation remove_original_attributes(
    ft3_helper.auth_id,
    original_id: byte_array,
    attribute_names: list<dip_core.Attribute.I>
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = originals_core.Id.get_instance(original_id);
    
    for (attribute_name in attribute_names) {
        dip_core.Meta.Engine.execute_access(instance, attribute_name, dip_core.Meta.Engine.access(account));
        
        originals_core.Wrapper.Attribute.remove_value(
            instance,
            attribute_name
        );
    }
}

operation add_original_container_element(
    ft3_helper.auth_id,
    original_id: byte_array,
    attribute_name: dip_core.Attribute.I,
    value: gtv
) {
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    val instance = originals_core.Id.get_instance(original_id);
    
    dip_core.Meta.Engine.execute_access(instance, attribute_name, dip_core.Meta.Engine.access(account));
    
    originals_core.Wrapper.Attribute.add_container_element(
        instance,
        attribute_name,
        value,
        dip_core.Meta.Engine.access(account)
    );
}
