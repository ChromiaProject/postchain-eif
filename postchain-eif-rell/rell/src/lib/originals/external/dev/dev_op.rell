module;

import ft3_core: ^^^^.ft3.core;
import ft3_account: ^^^^.ft3.account;
import dip_core: ^^^^.dip.core;
import originals_core: ^^^.core;
import originals_utils: ^^^.util;
import ^^^.collections;
import ^.{require_dev};
import ^^^^.ft3_helper;
import ^^^.events;

operation create_asset(name: text, acc1: byte_array, acc2: byte_array, amount: integer) {
    val issuing_chain_rid = chain_context.blockchain_rid;
    val id = (name).hash();
    val asset = create ft3_core.asset (id, issuing_chain_rid, name);
    
    val account1 = originals_utils.Ft3Helper.get_ft3_account(acc1);
    val account2 = originals_utils.Ft3Helper.get_ft3_account(acc2);
    ft3_core.ensure_balance(account1, asset).amount += amount;
    ft3_core.ensure_balance(account2, asset).amount += amount;
}

operation mint_non_fungible_original_unsafe(
    ft3_helper.auth_id,
    collection_name: text,
    original_type: originals_core.Minter.I
) {
    require_dev();
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    originals_core.Minter.mint_non_fungible_original(account, collection_name, original_type, dip_core.Meta.Engine.access(account));
}

operation mint_non_fungible_original_unsafe_batch(
    ft3_helper.auth_id,
    collection_name: text,
    original_type: originals_core.Minter.I,
    quantity: integer
){
    require_dev();
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    originals_core.Minter.mint_non_fungible_original_batch(account, collection_name, original_type, quantity, dip_core.Meta.Engine.access(account));
}

operation create_fungible_original_unsafe(
    ft3_helper.auth_id,
    collection_name: text,
    original_type: originals_core.Minter.I,
    quantity: integer = 1
) {
    require_dev();
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    originals_core.Minter.create_fungible_original(account, collection_name, original_type, quantity, dip_core.Meta.Engine.access(account));
}

operation mint_fungible_original_unsafe(
    ft3_helper.auth_id,
    fungible_id: byte_array, 
    quantity: integer = 1
) {
    require_dev();
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    originals_core.Minter.Unsafe.mint_fungible_original(account, fungible_id, quantity);
}

operation add_badge_to_original(
    original: dip_core.instance,
    badge: dip_core.instance
) {
    require_dev();
    originals_core.Badge.Original.add(original, badge);
}

operation add_badge_to_account(
    account_id: byte_array,
    badge: dip_core.instance
) {
    require_dev();
    originals_core.Badge.Account.add(originals_utils.Ft3Helper.get_ft3_account(account_id), badge);
}

operation set_original_attribute_unsafe(instance: dip_core.instance, attribute_name: dip_core.Attribute.I, value: gtv) {
    require_dev();
    originals_core.Wrapper.Attribute.Unsafe.set_value(instance, attribute_name, value);
}

operation link_original_direct(
    ft3_helper.auth_id,
    attribute_name: dip_core.Attribute.I,
    base: dip_core.instance,
    child: dip_core.instance
) {
    require_dev();
    val account = ft3_helper.do_auth(auth_id, ["T"]);
    
    originals_core.Ownership.link_instance(
        account,
        attribute_name,
        base,
        child,
        dip_core.Meta.Engine.access(account)
    );
}

operation create_asset_and_mint_to_accounts(name, account_ids: list<byte_array>, amount: integer) {
    val issuing_chain_rid = chain_context.blockchain_rid;
    val id = name.hash();
    val asset = create ft3_core.asset (id, issuing_chain_rid, name);

    for (account_id in account_ids) {
        val account = originals_utils.Ft3Helper.get_ft3_account(account_id);
        ft3_core.ensure_balance(account, asset).amount += amount;
    } 
}

operation create_events(create_event_reqs: list<(type: text, asset_id: byte_array, from_id: byte_array, to_id: byte_array, params: byte_array)>) {
    for (create_event_req in create_event_reqs) {
        create events.event(
            type = events.event_type_from_name(create_event_req.type),
            asset = ft3_core.asset @ { .id == create_event_req.asset_id },
            from = ft3_account.account @ { create_event_req.from_id },
            to = ft3_account.account @ { create_event_req.to_id },
            params = create_event_req.params
        );
    }
}