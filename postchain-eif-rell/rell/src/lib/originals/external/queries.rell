
query find_originals(
    attribute_name: dip_core.Attribute.I,
    value: gtv,
    page_cursor: text
): dip_utils.paged_result {
    
    val ids = list<byte_array>();
    val cursor = dip_utils.decode_cursor_with_instance_id(page_cursor);
    val ret = originals_core.Wrapper.Attribute.find_instances(attribute_name, value, cursor);
    for (instance in ret.results) {
        ids.add(originals_core.Id.get_id(instance));
    }

    val result = dip_utils.pagination_result_with_instance_id(
        data = ids.to_gtv(),
        instance_rowid = ret.from.instance_rowid,
        prototype_rowid = ret.from.prototype_rowid
    );

    return dip_utils.make_page_by_instance_id([result], cursor);
}

query filter_originals(
    filters: list<dip_core.Filter.I>,
    page_cursor: text
): dip_utils.paged_result {
    val ids = list<byte_array>();
    val cursor = dip_utils.decode_cursor_with_instance_id(page_cursor);
    val ret = originals_core.Wrapper.Attribute.filter_instances(filters, cursor);
    for (instance in ret.results) {
        ids.add(originals_core.Id.get_id(instance));
    }
    
    val result = dip_utils.pagination_result_with_instance_id(
        data = ids.to_gtv(),
        instance_rowid = ret.from.instance_rowid,
        prototype_rowid = ret.from.prototype_rowid
    );

    return dip_utils.make_page_by_instance_id([result], cursor);
}

query get_originals_with_interface(
    account_id: byte_array,
    interface: text,
    page_cursor: text
): dip_utils.paged_result {
    val cursor = dip_utils.decode_cursor(page_cursor);

    return dip_utils.make_page(originals_core.Ownership.find_all_original_ids_with_interface(
        account_id,
        dip_core.Interface.get(interface),
        cursor
    ), cursor);
}

query get_unlocked_originals_from_owner(
    account_id: byte_array,
    page_cursor: text
): dip_utils.paged_result {
    val cursor = dip_utils.decode_cursor(page_cursor);

    return dip_utils.make_page(originals_core.Ownership.get_unlocked_original_ids_from_owner(
        account_id,
        cursor
    ), cursor);
}

query get_locked_originals_from_owner(
    account_id: byte_array,
    page_cursor: text
) {
    val cursor = dip_utils.decode_cursor(page_cursor);

    return dip_utils.make_page(originals_core.Ownership.get_locked_original_ids_from_owner(
        account_id,
        cursor
    ), cursor);
}

query get_all_originals_from_owner(
    account_id: byte_array,
    page_cursor: text
) {
    val cursor = dip_utils.decode_cursor(page_cursor);
    return dip_utils.make_page(originals_core.Ownership.get_all_original_ids_from_owner(
        account_id,
        cursor
    ), cursor);
}

query get_original_value(
    original_id: byte_array,
    attribute_name: dip_core.Attribute.I
): gtv? {
    return dip_core.Attribute.get_value(
        originals_core.Id.get_instance(original_id),
        attribute_name
    );
}

query get_original_values(
    original_id: byte_array,
    attribute_names: list<dip_core.Attribute.I>
): map<dip_core.Attribute.I, gtv?> {
    val result = map<dip_core.Attribute.I, gtv?>();
    
    val instance = originals_core.Id.get_instance(original_id);
    for (attribute_name in attribute_names) {
        result.put(
            attribute_name,
            dip_core.Attribute.get_value(instance, attribute_name)
        );
    }
    
    return result;
}

query get_last_minted_original_id(): byte_array? {   
    return originals_core.Minter.get_last_minted_original_id();
}

