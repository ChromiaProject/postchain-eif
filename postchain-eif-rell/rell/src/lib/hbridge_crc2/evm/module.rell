@mount("eif.hbridge.crc2")
module;

import messaging: lib.eif.messaging;
import common: lib.eif.common;
import utils: lib.eif.utils;
import version: lib.eif.version;

import lib.hbridge.core;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.auth;
    import lib.ft4.utils;
}

namespace crc2 {
    import lib.crc2.*;
    import lib.crc2.evm;
}

/**
 * Module arguments for `lib.hbridge_crc2.evm` (`moduleArgs.lib.hbridge_crc2.evm` in `chromia.yml`).
 */
struct module_args {
    /**
     * Same semantics as `lib.hbridge.core` `evm_read_offsets`: map of decimal EVM `network_id` (text) to
     * `evm_read_offset` used on the Event Receiver. Keeps NFT bridge queries aligned with EIF ingestion finality.
     */
    evm_read_offsets: gtv = map<text, integer>().to_gtv();
}

enum bridge_mode {
    native,
    foreign,
}

enum evm_token_type {
    erc721,
    erc1155,
}

function get_protocol_id_from_token_type(token_type: evm_token_type): integer {
    when (token_type) {
        evm_token_type.erc721 -> return 721;
        evm_token_type.erc1155 -> return 1155;
    }
}