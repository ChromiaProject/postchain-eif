module;

val eif_event_receiver_dynamic_config_topic = "L_eif_event_receiver_dynamic_config";
val eif_event_receiver_dynamic_config_topic_v2 = "L_eif_event_receiver_dynamic_config_v2";
val eif_event_receiver_dynamic_remove_topic = "L_eif_event_receiver_dynamic_remove";
val eif_event_receiver_pause_topic = "L_eif_event_receiver_pause";

struct event_def {
    name: text;
    inputs: list<event_input>;
}

struct event_input {
    type: text;
    indexed: boolean;
}

struct eif_event_receiver_dynamic_config_message {
    contracts: list<byte_array>;
    events: list<event_def>;
}

struct contract_to_fetch {
    address: byte_array;
    skip_to_height: integer;
}

struct eif_event_receiver_dynamic_config_message_v2 {
    contracts: list<contract_to_fetch>;
    events: list<event_def>;
}

struct network_contract_address {
    network_id: integer;
    address: byte_array;
}

struct eif_event_receiver_dynamic_remove_message {
    bridges: list<network_contract_address>;
}

struct pause_message {
    pause: boolean;
}
