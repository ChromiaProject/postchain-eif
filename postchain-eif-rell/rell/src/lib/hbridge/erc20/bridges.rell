struct bridge_contract_info {
    contract_address: byte_array;
    evm_read_offset: integer;
    skip_to_height: integer = 0;
    erc20_assets: list<erc20_asset_info>;
}

entity bridge_erc20_asset {
    key core.bridge_contract, erc20_asset;
}

/**
 * Creates a bridge contract if it doesn't exist, creates an ERC20 asset, and registers the asset on the bridge.
 *
 * @param network_id The ID of the EVM network.
 * @param token_address The address of the ERC20 token.
 * @param asset The asset to register.
 * @param mode The mode of the bridge.
 * @param use_snapshots Whether to use snapshots.
 * @param bridge_address The address of the bridge contract.
 * @param skip_to_height The height to skip to.
 */
function register_bridge_and_erc20_asset(
    network_id: integer,
    token_address: byte_array,
    ft4.assets.asset,
    mode: bridge_mode,
    use_snapshots: boolean = false,
    bridge_address: byte_array,
    skip_to_height: integer,
) {
    val erc20_asset = register_erc20_asset(network_id, token_address, asset, mode, use_snapshots);
    val bridge_contract = core.get_or_create_bridge(network_id, bridge_address, skip_to_height);
    create bridge_erc20_asset(bridge_contract, erc20_asset);
}

/**
 * Creates a bridge contract if it doesn't exist, and registers multiple ERC20 assets on it.
 *
 * @param network_id The ID of the EVM network.
 * @param bridge_address The address of the bridge contract.
 * @param skip_to_height The height to skip to.
 * @param erc20_assets The list of ERC20 assets to register.
 */
function register_bridge_with_erc20_assets(
    network_id: integer, bridge_address: byte_array, skip_to_height: integer, erc20_assets: list<erc20_asset>
) {
    val bridge_contract = core.get_or_create_bridge(network_id, bridge_address, skip_to_height);

    for (erc20_asset in erc20_assets) {
        require(erc20_asset.network_id == bridge_contract.network_id, "Bridge must be part of the same network as the asset");
        create bridge_erc20_asset(bridge_contract, erc20_asset);
    }
}

@extend(core.before_removing_bridge_contract) function (bridge: core.bridge_contract) {
    delete bridge_erc20_asset @* { bridge };
    log("Removed erc20 assets for bridge with contract address %s on network %s".format(bridge.contract_address, bridge.network_id));
}
