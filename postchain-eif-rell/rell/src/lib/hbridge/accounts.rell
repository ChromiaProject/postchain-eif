@extend(ft4.strategies.after_register_account) function (ft4.accounts.account) {
    val pending_deposits = erc20_deposit @* { .recipient_id == account.id, deposit_state.pending };
    for (deposit in pending_deposits) {
        core._link_evm_account_if_not_linked(deposit.network_id, deposit.sender_address, deposit.from_smart_contract, account);

        // Note: we don't need to call collect_pooled_assets here, because it's already done in the transfer strategy implementation
        update_deposit_state(deposit, deposit_state.completed);
    }
}

@extend(core.after_evm_account_linked) function (address: byte_array, ft4.accounts.account, network_id: integer, is_contract: boolean) {
    val pending_deposits = erc20_deposit @* { .sender_address == address, deposit_state.pending, .from_smart_contract == is_contract };
    for (deposit in pending_deposits) {
        update_deposit_state(deposit, deposit_state.completed);
    }
}

entity dynamic_ras_rule {
    network_id: integer;
    token_address: byte_array;
    key network_id, token_address;

    rule: byte_array; // rule.to_gtv().to_bytes()
}

function enable_account_creation_on_deposit(
    network_id: integer,
    @size(20) token_address: byte_array,
    min_amount: big_integer = 1L,
    timeout_days: integer = 10,
    transfer_strategy: text = "open",
) {

    require(
        empty(dynamic_ras_rule @? { network_id, token_address }),
        "Account creation on deposit is already enabled for token %s on network %d".format(token_address, network_id)
    );

    val erc20 = require(
        erc20.erc20_asset @? { network_id, token_address } ( .virtual_blockchain_rid, asset_id = .asset.id ),
        "ERC-20 asset not found for the specified network %d and token address %s".format(network_id, token_address)
    );

    val rule_arg = ft4.transfer_strategy.module_args_list_element(
        sender_blockchain = erc20.virtual_blockchain_rid.to_gtv(),
        sender = "*".to_gtv(),
        recipient = "*".to_gtv(),
        asset = [["id" : erc20.asset_id.to_gtv(), "min_amount" : min_amount.to_gtv()]].to_gtv_pretty(),
        timeout_days = timeout_days,
        strategy = transfer_strategy.to_gtv()
    );

    val rules = ft4.transfer_strategy.get_config([rule_arg].to_gtv());
    require(not rules.empty(), "No valid rules were created for network %d and token address %s".format(network_id, token_address));

    create dynamic_ras_rule(network_id, token_address, rule = rules[0].to_gtv().to_bytes());
}

function disable_account_creation_on_deposit(network_id: integer, @size(20) token_address: byte_array) {
    delete dynamic_ras_rule @? { network_id, token_address };
}

function find_allowed_ras_rules(
    @size(32) from_chain: byte_array,
    from_id: byte_array,
    to_id: byte_array,
    asset: ft4.assets.asset,
    amount: big_integer
): map<text, ft4.transfer_strategy.rule> {

    val static_rules = ft4.transfer_strategy.find_allowed_rules(
        from_chain, from_id, to_id, asset, amount
    );

    val dynamic_rules = dynamic_ras_rule @* {} (
        ft4.transfer_strategy.rule.from_gtv(gtv.from_bytes(.rule))
    ) @* {
        ft4.transfer_strategy.is_blockchain_allowed($, from_chain),
        ft4.transfer_strategy.is_sender_allowed($, from_id),
        ft4.transfer_strategy.is_recipient_allowed($, to_id, from_id),
        ft4.transfer_strategy.is_asset_amount_allowed($, asset, amount)
    };

    val rule_map = static_rules;
    for (rule in dynamic_rules) {
        for (strategy in rule.strategies) {
            rule_map[strategy] = rule;
        }
    }

    return rule_map;
}
