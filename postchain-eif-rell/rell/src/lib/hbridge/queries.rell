/**
 * Retrieves the current version of the HBridge module.
 *
 * @return An integer representing the version number of the HBridge module as specified in chain context arguments.
 */
query get_hbridge_version() = chain_context.args.version;

/**
 * Retrieves the current pause state of the HBridge module.
 *
 * @return A boolean representing the current pause state of the HBridge module.
 */
query is_paused() = hbridge_state.paused;
