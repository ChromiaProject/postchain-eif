
entity erc20_deposit {
    index sender_address: byte_array;
    network_id: integer;
    from_smart_contract: boolean;
    index recipient_id: byte_array;
    token: erc20.erc20_asset;
    amount: big_integer;
    mutable state: deposit_state;
    mutable last_updated: timestamp;
    index evm_tx_hash: byte_array;
}

struct erc20_deposit_info {
    id: rowid;
    network_id: integer;
    sender_address: byte_array;
    recipient_id: byte_array;
    from_smart_contract: boolean;
    asset_id: byte_array;
    amount: big_integer;
    state: deposit_state;
    last_updated: timestamp;
    evm_tx_hash: byte_array;

    /** Transaction RID of a completed deposit */
    completed_tx_rid: byte_array?;

    /** Operation index in transaction of a completed deposit */
    completed_op_index: integer?;
}

/** Store a reference to when the deposit was completed and where the corresponding FT4 transfer can be found */
@log
entity erc20_completed_deposit_transaction {
    key deposit: erc20_deposit;
    op_index: integer = op_context.op_index;
    index transaction, op_index;
}

entity pending_erc20_deposit {
    key deposit: erc20_deposit, ft4.transfer_strategy.account_creation_transfer;
}

enum deposit_state {
    pending,
    completed,
    recalled,
}

entity erc20_deposit_history {
    index erc20_deposit;
    state: deposit_state;
    timestamp;
}

struct erc20_deposit_history_entry {
    deposit_id: integer;
    state: deposit_state;
    timestamp;
}

/**
 * Tracks deposits that were bounced and returned to sender via withdrawal.
 * Links the original deposit event data to the corresponding bounced withdrawal object.
 */
entity bounced_erc20_deposit {
    key erc20_withdrawal;
    index sender_address: byte_array;
    index recipient_id: byte_array;
    evm_tx_hash: byte_array;
    evm_log_index: big_integer;
    index evm_tx_hash, evm_log_index;
    reason: text;
}

struct bounced_erc20_deposit_info {
    withdrawal: erc20_withdrawal_info;
    sender_address: byte_array;
    recipient_id: byte_array;
    evm_tx_hash: byte_array;
    evm_log_index: big_integer;
    reason: text;
}

/**
 * Filter for get_bounced_erc20_deposits()
 */
struct bounced_deposit_filter {
    /** EVM network ID. If null, all networks are considered. */
    network_id: integer? = null;
    /** EVM token address. If null, all token addresses are considered. */
    token_address: byte_array? = null;
    /** EVM sender address. If null, all sender addresses are considered. */
    sender_address: byte_array? = null;
    /** EVM transaction hash. If null, all transactions are considered. */
    evm_tx_hash: byte_array? = null;
    /** EVM log index. If null, all log indices are considered. */
    evm_log_index: big_integer? = null;
    /** Marks the beginning of a time interval. If not null, bounced deposits before `from` are excluded. */
    from: timestamp? = null;
    /** Marks the end of a time interval. If not null, bounced deposits at `to` and after are excluded. */
    to: timestamp? = null;
}

function map_bounced_deposit(bounced: struct<bounced_erc20_deposit>) = bounced_erc20_deposit_info(
    withdrawal = map_withdrawal(bounced.erc20_withdrawal),
    sender_address = bounced.sender_address,
    recipient_id = bounced.recipient_id,
    evm_tx_hash = bounced.evm_tx_hash,
    evm_log_index = bounced.evm_log_index,
    reason = bounced.reason,
);

/**
 * Deposit filter for get_erc20_deposits()
 */
struct deposit_filter {
    /** EVM network ID. If null, all networks are considered. */
    network_id: integer? = null;
    /** EVM token address. If null, all token addresses are considered. */
    token_address: byte_array? = null;
    /** EVM beneficiary address. If null, all recipient_id values are considered. */
    recipient_id: byte_array? = null;
    /** The state of the deposit. If null, all states are considered. */
    state: deposit_state? = null;
    /** EVM transaction hash */
    evm_tx_hash: byte_array? = null;
    /** EVM sender address. If null, all sender_address values are considered. */
    sender_address: byte_array? = null;
}

function map_deposit(deposit: erc20_deposit, cdt: erc20_completed_deposit_transaction?) = erc20_deposit_info(
    id = deposit.rowid,
    network_id = deposit.network_id,
    sender_address = deposit.sender_address,
    recipient_id = deposit.recipient_id,
    from_smart_contract = deposit.from_smart_contract,
    asset_id = deposit.token.asset.id,
    amount = deposit.amount,
    state = deposit.state,
    last_updated = deposit.last_updated,
    evm_tx_hash = deposit.evm_tx_hash,
    completed_tx_rid = cdt?.transaction?.tx_rid,
    completed_op_index = cdt?.op_index
);

function update_deposit_state(deposit: erc20_deposit, state: deposit_state) {
    create erc20_deposit_history(deposit, deposit.state, deposit.last_updated);

    if (deposit.state == deposit_state.pending and (state in [deposit_state.completed, deposit_state.recalled])) {
        delete pending_erc20_deposit @ { deposit };

        if (state == deposit_state.completed) {
            create erc20_completed_deposit_transaction(deposit);
        }
    }

    deposit.state = state;
    deposit.last_updated = op_context.last_block_time;
}
