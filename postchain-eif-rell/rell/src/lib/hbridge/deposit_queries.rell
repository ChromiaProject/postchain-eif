/**
 * Retrieves ERC20 token deposits based on a given filter, with pagination options.
 *
 * @param filter The filter applied to the deposit search. See [deposit_filter] structure.
 * @param from Marks the beginning of a time interval. If not null, deposits last updated before `from` are excluded.
 * @param to Marks the end of a time interval. If not null, deposits last updated at `to` and after `to` are excluded.
 * @param page_size The number of deposit records to return per page. Limited by the maximum page size defined in the chain configuration. If not specified, a maximum page size defined in the chain configuration is used.
 * @param page_cursor A cursor for pagination, typically pointing to the start of the next page of results. If not specified, the first page will be returned.
 * @param sort_desc Controls the sorting order of results. If true, results are sorted in descending order by `rowid` (newest first). If false, results are sorted in ascending order (oldest first). Defaults to false.
 * @return A `ft4.utils.paged_result` containing the filtered results and pagination data. This result includes data such as the list of deposits (see [erc20_deposit_info]), and the next page cursor (`next_cursor`). If `next_cursor` is null, there are no more pages to fetch.
 */
query get_erc20_deposits(filter: deposit_filter, from: timestamp? = null, to: timestamp? = null,
        page_size: integer? = null, page_cursor: text? = null, sort_desc: boolean = false): ft4.utils.paged_result {
    val before_rowid = ft4.utils.before_rowid(page_cursor);

    val paginated_result = (
        d: erc20_deposit,
        @outer ct: erc20_completed_deposit_transaction @* { ct.deposit == d }
    ) @* {
        filter.network_id == null or .network_id == filter.network_id,
        filter.token_address == null or .token.token_address == filter.token_address,
        filter.sender_address == null or .sender_address == filter.sender_address,
        filter.recipient_id == null or .recipient_id == filter.recipient_id,
        filter.state == null or .state == filter.state,
        filter.evm_tx_hash == null or .evm_tx_hash == filter.evm_tx_hash,
        filter.evm_log_index == null or .evm_log_index == filter.evm_log_index,
        from == null or .last_updated >= from,
        to == null or .last_updated < to,
        if (sort_desc)
            d.rowid < (before_rowid ?: rowid(integer.MAX_VALUE))
        else
            d.rowid > (before_rowid ?: rowid(0))
    } (
        @omit @sort_desc if (sort_desc) d.rowid else rowid(0),
        ft4.utils.pagination_result(
            data = map_deposit(d, ct).to_gtv_pretty(),
            rowid = d.rowid
        )
    ) limit ft4.utils.fetch_data_size(page_size);

   return ft4.utils.make_page(paginated_result, page_size);
}

/**
 * Retrieves the history of an ERC20 deposit based on the specified deposit ID.
 *
 * @param deposit_id A `rowid` type identifier for the deposit.
 *
 * @return A list of `erc20_deposit_history_entry` objects, each representing a record in the
 * history of the specified deposit.
 */
query get_erc20_deposit_history(deposit_id: rowid): list<erc20_deposit_history_entry> {
    val deposit = require(erc20_deposit @? { .rowid == deposit_id }, "Deposit not found: " + deposit_id);

    val history = erc20_deposit_history @* { deposit } (
        @sort @omit .rowid,
        erc20_deposit_history_entry(
            deposit_id = deposit.rowid.to_integer(),
            state = .state,
            timestamp = .timestamp
    ));

    history.add(erc20_deposit_history_entry(
        deposit_id = deposit.rowid.to_integer(),
        state = deposit.state,
        timestamp = deposit.last_updated
    ));

    return history;
}

/**
 * Retrieves ERC20 token deposit based on a transaction RID and operation index in which the deposit was completed.
 *
 * @param tx_rid transaction RID in which the deposit was completed
 * @param op_index index of the operation within the transaction in which the deposit was completed
 * @return An optional erc20_deposit_info containing the deposit details if found, null otherwise
 */
query get_erc20_deposit_by_tx(tx_rid: byte_array, op_index: integer): erc20_deposit_info? =
        erc20_completed_deposit_transaction @? { .transaction.tx_rid == tx_rid, op_index } ( map_deposit($.deposit, $) );

/**
 * Retrieves an ERC20 deposit by EVM transaction hash.
 *
 * @param evm_tx_hash The EVM transaction hash.
 * @param evm_log_index The EVM log index (defaults to 0).
 * @return An optional erc20_deposit_info if found, null otherwise.
 */
query get_erc20_deposit_by_evm_tx_hash(evm_tx_hash: byte_array, evm_log_index: big_integer = 0L): erc20_deposit_info? {
    val deposit = erc20_deposit @? { evm_tx_hash, evm_log_index };
    if (deposit == null) return null;
    val cdt = erc20_completed_deposit_transaction @? { .deposit == deposit };
    return map_deposit(deposit, cdt);
}


// Bounced deposit queries

/**
 * Retrieves bounced ERC20 deposits based on a given filter, with pagination options.
 *
 * API version: 19
 *
 * @param filter The filter applied to the bounced deposit search. See [bounced_deposit_filter] structure.
 * @param page_size The number of records to return per page. Limited by the maximum page size defined in the chain configuration.
 * @param page_cursor A cursor for pagination. If not specified, the first page will be returned.
 * @param sort_desc Controls the sorting order of results. If true, results are sorted in descending order by `rowid` (newest first). Defaults to false.
 * @return A `ft4.utils.paged_result` containing the filtered results and pagination data.
 */
query get_bounced_erc20_deposits(filter: bounced_deposit_filter, page_size: integer? = null, page_cursor: text? = null, sort_desc: boolean = false): ft4.utils.paged_result {
    val before_rowid = ft4.utils.before_rowid(page_cursor);

    val paginated_result = bounced_erc20_deposit @* {
        filter.network_id == null or .erc20_withdrawal.network_id == filter.network_id,
        filter.token_address == null or .erc20_withdrawal.token_address == filter.token_address,
        filter.sender_address == null or .sender_address == filter.sender_address,
        filter.evm_tx_hash == null or .evm_tx_hash == filter.evm_tx_hash,
        filter.evm_log_index == null or .evm_log_index == filter.evm_log_index,
        filter.from == null or .erc20_withdrawal.transaction.block.timestamp >= filter.from,
        filter.to == null or .erc20_withdrawal.transaction.block.timestamp < filter.to,
        if (sort_desc)
            .rowid < (before_rowid ?: rowid(integer.MAX_VALUE))
        else
            .rowid > (before_rowid ?: rowid(0))
    } (
        @omit @sort_desc if (sort_desc) $.rowid else rowid(0),
        ft4.utils.pagination_result(
            data = map_bounced_deposit($.to_struct()).to_gtv_pretty(),
            rowid = $.rowid
        )
    ) limit ft4.utils.fetch_data_size(page_size);

    return ft4.utils.make_page(paginated_result, page_size);
}

/**
 * Retrieves bounced ERC20 deposits by sender address.
 *
 * API version: 19
 *
 * @param sender_address The EVM sender address.
 * @param page_size The number of records to return per page.
 * @param page_cursor A cursor for pagination.
 * @return A `ft4.utils.paged_result` containing the bounced deposits for the given sender.
 */
query get_bounced_erc20_deposits_by_sender(sender_address: byte_array, page_size: integer? = null, page_cursor: text? = null, sort_desc: boolean = false): ft4.utils.paged_result {
    return get_bounced_erc20_deposits(
        bounced_deposit_filter(sender_address = sender_address),
        page_size,
        page_cursor,
        sort_desc
    );
}

/**
 * Retrieves bounced ERC20 deposits by network ID and token address.
 *
 * API version: 19
 *
 * @param network_id The EVM network ID.
 * @param token_address The ERC20 token address.
 * @param page_size The number of records to return per page.
 * @param page_cursor A cursor for pagination.
 * @return A `ft4.utils.paged_result` containing the bounced deposits for the given network and token.
 */
query get_bounced_erc20_deposits_by_token(network_id: integer, token_address: byte_array, page_size: integer? = null, page_cursor: text? = null, sort_desc: boolean = false): ft4.utils.paged_result {
    return get_bounced_erc20_deposits(
        bounced_deposit_filter(network_id = network_id, token_address = token_address),
        page_size,
        page_cursor,
        sort_desc
    );
}

/**
 * Retrieves a bounced ERC20 deposit by EVM transaction hash.
 *
 * API version: 19
 *
 * @param evm_tx_hash The EVM transaction hash.
 * @return An optional bounced_erc20_deposit_info if found, null otherwise.
 */
query get_bounced_erc20_deposit_by_evm_tx_hash(evm_tx_hash: byte_array, evm_log_index: big_integer = 0L): bounced_erc20_deposit_info? =
    bounced_erc20_deposit @? { evm_tx_hash, evm_log_index } ( map_bounced_deposit($.to_struct()) );

// Account creation on deposit queries

/**
 * Checks if account creation on deposit is enabled for a given token on a given network.
 *
 * API version: 18
 *
 * @param network_id The network ID of the network to check.
 * @param token_address The address of the token to check.
 * @return True if account creation on deposit is enabled for the given token on the given network, false otherwise.
 */
query is_account_creation_on_deposit_enabled(network_id: integer, @size(20) token_address: byte_array): boolean {
    return exists(dynamic_ras_rule @? { network_id, token_address });
}

/**
 * Returns a list of rules for account creation on deposit for all networks and ERC-20 assets.
 *
 * API version: 18
 *
 * @return A list of rules for account creation on deposit for all networks and ERC-20 assets.
 */
query get_account_creation_rules(): list<ft4.transfer_strategy.rule> {
    val rules = ft4.transfer_strategy.get_transfer_rules();

    rules.add_all(
        dynamic_ras_rule @* {} ( ft4.transfer_strategy.rule.from_bytes(.rule) )
    );

    return rules;
}

