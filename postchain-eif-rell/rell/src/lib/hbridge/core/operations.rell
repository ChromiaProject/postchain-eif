@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(link_evm_eoa_account).mount_name,
    flags = ["A"],
    message = link_evm_eoa_account_auth_message(*)
);

function link_evm_eoa_account_auth_message(gtv) {
    val args = struct<link_evm_eoa_account>.from_gtv(gtv);
    return "Please sign the message to link Externally Owned Account %s\nto Chromia account {account_id}".format(args.address);
}

operation link_evm_eoa_account(address: byte_array) {
    val account = ft4.auth.authenticate();
    ft4.auth.verify_signers([address]);
    _link_evm_eoa_account(address, account);
}

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(link_evm_sc_account).mount_name,
    flags = ["A"],
    message = link_evm_sc_account_auth_message(*)
);

function link_evm_sc_account_auth_message(gtv) {
    val args = struct<link_evm_sc_account>.from_gtv(gtv);
    return "Please sign the message to link Smart Contract %s on network %d\nto Chromia account {account_id}".format(
        args.address, args.network_id
    );
}

operation link_evm_sc_account(address: byte_array, network_id: integer) {
    val account = ft4.auth.authenticate();
    require(
        proposed_evm_sc_account_link @? { account, address, network_id },
        "Proposed EVM SC account link not found for EVM address %s on chain ID %d".format(address, network_id)
    );
    _link_evm_sc_account(address, network_id, account);
}

/**
 * Registers an EVM recovery contract for a specific blockchain.
 * 
 * This operation requires ICCF proof from the source blockchain and validates that:
 * - The operation name matches "register_recovery_contract"
 * - The operation has exactly 2 arguments: `network_id: integer` and `contract_address: byte_array`
 * 
 * Then,
 * - If a recovery contract is already registered, it will be replaced if `replace_existing` is true.
 * - Before removing the existing recovery contract, the `before_remove_recovery_contract` hook is called.
 * - A new recovery contract record is created, linking the blockchain RID, network ID, and contract address.
 * - The contract address is also linked to the source blockchain FT4 account.
 * 
 * @param tx_to_prove       The transaction containing the registration operation to be proven
 * @param op_index          Index of the registration operation within the transaction
 * 
 * Expected operation signature in tx_to_prove:
 *      operation register_recovery_contract(network_id: integer, contract_address: byte_array)
 */
operation register_recovery_contract(tx_to_prove: gtx_transaction, op_index: integer, replace_existing: boolean = false) {
    val iccf_auth_data = require_iccf_auth(tx_to_prove, op_index, rell.meta(register_recovery_contract).simple_name, 2);
    val blockchain_rid = iccf_auth_data.blockchain_rid;
    val network_id = integer.from_gtv(iccf_auth_data.op_args[0]);
    val contract_address = byte_array.from_gtv(iccf_auth_data.op_args[1]);

    utils.validate_evm_network_and_address(network_id, contract_address);
    validate_and_update_recovery_contract_auth(iccf_auth_data);

    val existing_contract = recovery_contract @? { blockchain_rid, network_id };
    if (exists(existing_contract)) {
        require(replace_existing, "Recovery contract is already registered");
        require(existing_contract.contract_address != contract_address, "This recovery contract is already registered");
        
        val blockchain_account = ft4.crosschain.ensure_blockchain_account(blockchain_rid);
        before_remove_recovery_contract(existing_contract, blockchain_account);

        // Unlink and delete recovery contract
        _unlink_evm_sc_account(existing_contract.contract_address, network_id, blockchain_account);
        delete existing_contract;
    }   

    // (1) Create new recovery contract; (2) link it to the blockchain account; 
    // (3) create and bind state slots; (4) emit eif_state events.
    create recovery_contract(blockchain_rid, network_id, contract_address);
    _link_evm_sc_account(contract_address, network_id, ft4.crosschain.ensure_blockchain_account(blockchain_rid)); 
}

@extendable function before_remove_recovery_contract(recovery_contract, blockchain_account: ft4.accounts.account) {}
