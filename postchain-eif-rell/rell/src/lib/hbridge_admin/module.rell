module;

import .access_list_control;

namespace ft4 {
    import lib.ft4.assets;
    import lib.ft4.accounts;
    import lib.ft4.auth;
    import lib.ft4.utils;
}

struct module_args {
    bridge_admin_account_signers: gtv;
}

operation register_bridge_admin_account() {
    create_bridge_admin_account();
}

function create_bridge_admin_account() {
    require(ft4.accounts.account @? { get_bridge_admin_account_id() } == null, "Bridge admin account already created.");
    val signers = list<byte_array>.from_gtv(chain_context.args.bridge_admin_account_signers);
    if (signers.size() == 1) {
        val auth_descriptor = ft4.accounts.single_sig_auth_descriptor(signers[0], set(["A", "T"]));
        ft4.accounts.create_account_with_auth(auth_descriptor);
    } else {
        val auth_descriptor = ft4.accounts.multi_sig_auth_descriptor(signers, signers.size(), set(["A", "T"]));
        ft4.accounts.create_account_with_auth(auth_descriptor);
    }
}

@extend(access_list_control.require_auth)
function require_auth_bridge_admin_account() {
    val account = ft4.auth.authenticate();
    val bridge_admin_account_id = get_bridge_admin_account_id();
    require(bridge_admin_account_id == account.id, "Authorization failed: The account %s is not authorized. Bridge admin account authorization is required.".format(account.id));
}

@extend(access_list_control.block_transfers_exception)
function bridge_admin_account_exception(from: ft4.accounts.account, to: ft4.accounts.account, ft4.assets.asset, amount: big_integer): boolean = to.id == get_bridge_admin_account_id();

operation seize_funds(account_id: byte_array, amount: big_integer, asset_id: byte_array) {
    access_list_control.require_auth();
    val account = ft4.accounts.Account(account_id);
    val bridge_admin_account = ft4.accounts.Account(get_bridge_admin_account_id());
    ft4.assets.Unsafe.transfer(account, bridge_admin_account, ft4.assets.Asset(asset_id), amount);
    create seize_history(account_id, amount, asset_id);
}

function get_bridge_admin_account_id() {
    return ft4.accounts.get_account_id_from_signers(list<byte_array>.from_gtv(chain_context.args.bridge_admin_account_signers));
}

@log entity seize_history {
    op_index: integer = op_context.op_index;
    index transaction, op_index;

    index account_id: byte_array;
    amount: big_integer;
    asset_id: byte_array;
}

struct seize_history_entry {
    account_id: byte_array;
    amount: big_integer;
    asset_id: byte_array;
    timestamp;
}

query get_seize_history(account_id: byte_array): list<seize_history_entry> {
    return seize_history @* { account_id } (
        @sort @omit .rowid,
            seize_history_entry (
            account_id = .account_id,
            amount = .amount,
            asset_id = .asset_id,
            timestamp = .transaction.block.timestamp
        )
    );
}

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(access_list_control.add_account_id_to_blacklist).mount_name,
    flags = ["A"]
);

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(access_list_control.remove_account_id_from_blacklist).mount_name,
    flags = ["A"]
);

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(access_list_control.add_account_id_to_whitelist).mount_name,
    flags = ["A"]
);

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(access_list_control.remove_account_id_from_whitelist).mount_name,
    flags = ["A"]
);

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(seize_funds).mount_name,
    flags = ["T"]
);
