namespace EvmAccounts {
    // Keeps track of the salt the user will have to sign in order to login, this way a compromised signature can be used only once
    entity account_salt {
        key ft3.acc.account;
        mutable salt: integer;
    }
    
    struct signature {
        r: byte_array;
        s: byte_array;
        v: integer;
    }
    
    function get_login_message(ft3.acc.account?, ft3.acc.auth_descriptor): text {
        var salt = 0;
        if (account != null) {
            val account_salt = account_salt @? {account};
            salt = if(account_salt == null) 0 else account_salt.salt;
        }

        return "Request to login with salt " + salt.to_text() + " using auth descriptor with hash " + auth_descriptor.hash().to_hex();
    }
    
    function get_logout_message(ft3.acc.account, auth_descriptor_ids: list<byte_array>): text {
        require(auth_descriptor_ids.size() >= 1, "");

        var message = "Request to logout for " + get_evm_account_address(account) + ". Auth descriptor hashes: ";
        
        for (id in auth_descriptor_ids) {
            message += id.to_hex() + " ";
        }
        
        return message.sub(0, message.size() - 1);
    }
    
    function logout(
        address: text,
        auth_descriptor_ids: list<byte_array>,
        signature
    ) {
        var evm_account = get_evm_account(address);
        if(evm_account == null) {
            return;
        }
        valid_signature(
            get_logout_message(evm_account, auth_descriptor_ids),
            signature, address
        );
        
        
        for (id in auth_descriptor_ids) {
            val auth_descriptor = ft3.acc.account_auth_descriptor @? {.descriptor_id == id};
            print(auth_descriptor);
            if (auth_descriptor != null) { 
                ft3.acc._delete_auth_descriptor(auth_descriptor);    
            }
        }
    }
    
    function login(
        address: text,
        ft3.acc.auth_descriptor,
        signature
    ) {
        var evm_account = get_evm_account(address);
        valid_signature(
            get_login_message(evm_account, auth_descriptor),
            signature, address
        );
        evm_account = ensure_evm_account(address);
        
        for (evm_account_auth_descriptor in ft3.acc.account_auth_descriptor @* {evm_account}) {
            ft3.acc._delete_auth_descriptor(evm_account_auth_descriptor);
        }
        
        _add_evm_auth_descriptor(evm_account, auth_descriptor);
        
        val account_salt = account_salt @? {evm_account};
        if (account_salt == null) {
            create account_salt(evm_account, 1);
        } else {
            account_salt.salt += 1;
        }
    }
    
    // Skips the signer check for participants
    function _add_evm_auth_descriptor(ft3.acc.account, ft3.acc.auth_descriptor) {
          val descriptor_id = auth_descriptor.hash();
     
         ft3.acc.analyze_auth_descriptor_rules(auth_descriptor.rules, 0);
         
         val account_auth_descriptor = create ft3.acc.account_auth_descriptor (
            account, descriptor_id,
            auth_descriptor.auth_type,
            args = auth_descriptor.args.to_gtv().to_bytes(),
            rules = auth_descriptor.rules.to_gtv().to_bytes()
         );
         
         for (participant in auth_descriptor.participants) {
            create ft3.acc.auth_descriptor_participant(account_auth_descriptor, id = participant);
         }
         
         ft3.acc.setup_auth_descriptor_variables(account_auth_descriptor);
    }
    
    function derive_evm_account_id(address: text): byte_array {
        return address.to_bytes();
    }
    
    function get_evm_account(address: text): ft3.acc.account? {
         val id = derive_evm_account_id(address);
         return ft3.acc.account @? {id};
    }
    
    function ensure_evm_account(address: text): ft3.acc.account {
         val id = derive_evm_account_id(address);
         var acc = ft3.acc.account @? {id};
         if (acc == null) {
             acc = create ft3.acc.account (id);
             val max_points = ft3.my_blockchain_info.rate_limit_max_points;
             val recovery_time = ft3.my_blockchain_info.rate_limit_recovery_time;
             val points_at_start = ft3.my_blockchain_info.rate_limit_points_at_account_creation;
            create ft3.acc.rl_state(acc, .points = points_at_start, .last_update = op_context.last_block_time, max_points, recovery_time);
         }
         return acc;
    }
    
    function is_evm_account(ft3.acc.account): boolean {
        // Check that size is of an evm address and that it starts with x'3078' == '0x'
        if(account.id.size() != 42 or account.id.sub(0,2) != x'3078') {
            return false;
        }
        return true;
    }
    
    function get_evm_account_address(ft3.acc.account): text {
        require(is_evm_account(account), "Not an EVM account");
        return text.from_bytes(account.id);
    }
    
    function require_address(address: text) {
        require(address.size() == 42, "Address must be 42 characters long");
        require(address.starts_with("0x"), "Address must start with 0x");
    }
    
    function valid_signature(msg: text, signature, eth_address: text) {
      val msg_hash = keccak256(("\u0019Ethereum Signed Message:\n" + msg.size().to_text() + msg).to_bytes());
      val pubkey_64bytes = eth_ecrecover(
        signature.r, 
        signature.s, 
        signature.v - 27,
        msg_hash
      );
      val _address: byte_array = keccak256(pubkey_64bytes).sub(12);
      val address = "0x" + _address.to_hex();
      require(address == eth_address.lower_case(), "Eth signature doesn't match");
    }
}