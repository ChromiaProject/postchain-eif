function test_interface_creation_succeeds_when_map_attribute_initial_value_is_map() {
    val admin = register_admin();
    val type_name = Attribute.def_I(IAttributesTest.interface, "supercool");

    def_interface(admin.auth_id, IAttributesTest.interface,
        [type_name: Type(attribute_type(
            type = Attribute.type.addressable_container,
            inner_type = ([Attribute.type.text, Attribute.type.integer]).to_gtv(),
            value = (
                map<gtv, gtv>(["test".to_gtv(): (21).to_gtv()])
            ).to_gtv()
        ))]
    ).sign(admin.keypair).run();
}

function test_interface_creation_fails_when_map_of_text_and_integer_attribute_initial_value_is_map_of_text() {
    val admin = register_admin();
    val type_name = Attribute.def_I(IAttributesTest.interface, "supercool");

    def_interface(admin.auth_id, IAttributesTest.interface,
