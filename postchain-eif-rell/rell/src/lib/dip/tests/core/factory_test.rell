function test_interface_creation_succeeds_when_integer_attribute_initial_value_is_integer() {
    val admin = register_admin();
    val type_name = Attribute.def_I(IAttributesTest.interface, "supercool");
    
    def_interface(admin.auth_id, IAttributesTest.interface,
        [type_name: Type(attribute_type(type = Attribute.type.integer, value = (10).to_gtv()))]
    ).sign(admin.keypair).run();
}

function test_interface_creation_fails_when_integer_attribute_initial_value_is_not_integer() {
    val admin = register_admin();
    val type_name = Attribute.def_I(IAttributesTest.interface, "supercool");
    
    def_interface(admin.auth_id, IAttributesTest.interface,
        [type_name: Type(attribute_type(type = Attribute.type.integer, value = ("awesome text").to_gtv()))]
    ).sign(admin.keypair).run_must_fail();
}

