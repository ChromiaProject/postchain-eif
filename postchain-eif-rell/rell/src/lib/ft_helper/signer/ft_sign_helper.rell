function eth_sign(message: text, privkey: byte_array){
    val hash = keccak256(("\u0019Ethereum Signed Message:\n" + message.size().to_text() + message).to_bytes());
    val (r, s, rec_id) = crypto.eth_sign(hash, privkey);
    return ft_auth.signature(
        r,
        s,
        v = 27 + rec_id
    );
}

function eth_address_from_pubkey(pubkey) = keccak256(pubkey).sub(12);

function eth_address_from_keypair(rell.test.keypair) =
    eth_address_from_pubkey(crypto.privkey_to_pubkey(keypair.priv).sub(1));

function create_auth_descriptor(participant_id: byte_array, permissions: list<text> = ["T"]): ft_accounts.auth_descriptor {
    return ft_accounts.auth_descriptor(
        ft_accounts.auth_type.S,
        [
            set(permissions).to_gtv(),
            participant_id.to_hex().to_gtv()
        ],
    rules = null.to_gtv());
}

function get_default_message_signed(ft_helper_tests.auth_data, op: gtx_operation){
    val account_auth_descriptor = ft_accounts.AuthDescriptor(auth_data.account_id);
    val message_template = ft_auth_external.get_auth_message_template(op.name, op.args.to_gtv());

    val eth_auth = ft_accounts.eth_auth_args(
                        account_auth_descriptor.account,
                        account_auth_descriptor,
                        signatures = []
                    );

    val message = ft_auth.create_message_from_template(
        eth_auth,
        message_template,
        list<gtv>(),
        account_auth_descriptor.ctr
    );

    return eth_sign(message, auth_data.keypair.priv);
}

function get_default_operation_evm_auth(ft_helper_tests.auth_data, op: gtx_operation){
    val signed_msg = get_default_message_signed(auth_data, op);
    return ft_auth_external.evm_auth(auth_data.account_id, auth_data.account_id, list<ft_auth.signature>([signed_msg]));
}

function get_default_operation_ft_auth(ft_helper_tests.auth_data){
    return ft_auth_external.ft_auth(auth_data.account_id, auth_data.account_id);
}

function get_default_operation_auth(ft_helper_tests.auth_data, op: gtx_operation){
    when(auth_data.auth_method) {
        ft_helper_tests.auth_method.ft_auth -> return get_default_operation_ft_auth(auth_data);
        ft_helper_tests.auth_method.evm_auth -> return get_default_operation_evm_auth(auth_data, op);
    }
}

function get_signed_tx(ft_helper_tests.auth_data, op: gtx_operation) {
    val op_auth = get_default_operation_auth(auth_data, op);
    return rell.test.tx()
        .op(op_auth)
        .op(rell.test.op(op.name, op.args))
        .sign(auth_data.keypair);
}

function get_signed_tx_multi_operations(ft_helper_tests.auth_data, operations: list<gtx_operation>) {
    val tx_operations: list<rell.test.op> = [];
    for(op in operations){
        tx_operations.add(get_default_operation_auth(auth_data, op));
        tx_operations.add(rell.test.op(op.name, op.args));
    }
    
    return rell.test.tx(tx_operations).sign(auth_data.keypair);
}

function get_signed_nop_tx_multi_operations(ft_helper_tests.auth_data, operations: list<gtx_operation>) {
    val tx_operations: list<rell.test.op> = [];
    for(op in operations){
        tx_operations.add(get_default_operation_auth(auth_data, op));
        tx_operations.add(rell.test.op(op.name, op.args));
    }
    
    return rell.test.tx(tx_operations).nop().sign(auth_data.keypair);
}

function get_signed_nop_tx(ft_helper_tests.auth_data, op: gtx_operation) {
    val op_auth = get_default_operation_auth(auth_data, op);
    return rell.test.tx()
        .nop()
        .op(op_auth)
        .op(rell.test.op(op.name, op.args))
        .sign(auth_data.keypair);
}

function get_signed_test_tx(ft_helper_tests.auth_data, op: rell.test.op) {
    val op_auth = get_default_operation_auth(auth_data, op.to_gtx_operation());
    return rell.test.tx()
        .op(op_auth)
        .op(op)
        .sign(auth_data.keypair);
}
