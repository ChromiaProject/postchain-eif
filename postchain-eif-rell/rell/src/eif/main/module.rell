import ^.common;
import ^.common.messages. { topic.*, msg };
import lib.icmf.{ send_message };
import lib.icmf.receiver.{ receive_icmf_message };

query get_last_evm_block(network_id: integer) {
    return common.evm_block @? { network_id } ( @sort_desc .evm_block_height, .evm_block_hash ) limit 1;
}

operation __evm_block(
    network_id: integer,
    evm_block_height: integer,
    evm_block_hash: byte_array,
    events: list<msg.event_data>
) {
    _evm_block(network_id, evm_block_height, evm_block_hash, events);
}

function _evm_block(
    network_id: integer,
    evm_block_height: integer,
    evm_block_hash: byte_array,
    events: list<msg.event_data>
) {
    create common.evm_block (
        network_id,
        evm_block_height,
        evm_block_hash
    );

    val evm_block = msg.evm_block(
        network_id,
        evm_block_height,
        evm_block_hash,
        events
    );

    send_message(EVM_BLOCK_EVENTS, evm_block.to_gtv());
}

@extend(receive_icmf_message)
function (sender: byte_array, topic: text, body: gtv) {
    when (topic) {
        EVM_BLOCK_EVENTS -> handle_evm_block(msg.evm_block.from_gtv(body));
        else -> require(false, "Message type %s not handled".format(topic));
    }
}

@extendable
function handle_evm_block(evm_block: msg.evm_block) {}