entity token_mapping {
    key token: evm_erc20;
    key asset: ass.asset;
}

// entity nft_mapping {
//     network_id: integer;
//     address: byte_array;
//     interface: dip.Interface.dclass;
//     key network_id, address;
// }

entity evm_account_link {
    network_id: integer;
    state_n: integer;
    evm_beneficiary: byte_array;
    key network_id, state_n, evm_beneficiary;
}

entity evm_block {
    network_id: integer;
    evm_block_height: integer;
    evm_block_hash: byte_array;
    key network_id, evm_block_height, evm_block_hash;
}

entity evm_erc20 {
    network_id: integer;
    address: byte_array;
    name: text;
    symbol: text;
    decimals: integer;
    key network_id, address;
}

// entity evm_erc721 {
//     key network_id: integer, address: byte_array, token_id: integer;
//     name: text;
//     symbol: text;
//     uri: text;
// }

entity evm_event {
    index evm_block;
    tnx_hash: byte_array;
    log_index: integer;
    event_signature: byte_array;
    contract_address: byte_array;
    indexed_values: byte_array;
    non_indexed_values: byte_array;
}

entity evm_erc20_balance {
    network_id: integer;
    token: evm_erc20;
    beneficiary: byte_array;
    mutable amount: big_integer;
    key token, beneficiary;
}

// entity evm_erc721_balance {
//     network_id: integer;
//     token: evm_erc721;
//     beneficiary: byte_array;
//     key token, beneficiary;
// }

entity evm_erc20_withdraw {
    key serial: integer;
    network_id: integer;
    index token: evm_erc20;
    index beneficiary: byte_array;
    amount: big_integer;
}

// entity evm_erc721_withdraw {
//     key serial: integer;
//     network_id: integer;
//     index token: evm_erc721;
//     index beneficiary: byte_array;
// }

object withdraw_stats {
    mutable withdraw_count: integer = 0;
}

struct event_data {
    tnx_hash: byte_array;
    log_index: integer;
    signature: byte_array;
    contract_address: byte_array;
    name: text;
    indexed_values: list<gtv>;
    non_indexed_values: list<gtv>;
}

struct state_data {
    state_n: integer;
    account: list<gtv>;
}

struct state_address_dto {
    state_n: integer;
    evm_address: byte_array;
}

struct auth_id {
    account_id: byte_array;
    auth_descriptor_id: byte_array;
}

query get_network_accounts(network_id: integer) : list<state_address_dto>{
    var accounts = evm_account_link @* {.network_id == network_id};
    val accounts_dto = list<state_address_dto>();
    for(account in accounts){
        accounts_dto.add(state_address_dto(state_n=account.state_n, evm_address=account.evm_beneficiary));
    }
    return accounts_dto;
}

query get_last_evm_block(network_id: integer) { return evm_block @? {network_id} (@sort_desc .evm_block_height, .evm_block_hash) limit 1;}

query get_erc20_withdrawal(network_id: integer, token_address: byte_array, beneficiary: byte_array) {
    val token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        return null;
    }

    return evm_erc20_withdraw @* { network_id, token , beneficiary } (@sort_desc .serial, .network_id, token = .token.address, .beneficiary, .amount);
}

// query get_erc721_withdrawal(network_id: integer, token_address: byte_array, token_id: integer, beneficiary: byte_array) {
