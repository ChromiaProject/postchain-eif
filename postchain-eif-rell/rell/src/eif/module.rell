operation __evm_block(network_id: integer, evm_block_height: integer, evm_block_hash: byte_array, events: list<event_data>) {
    evm_block_fn(network_id, evm_block_height, evm_block_hash, events);
}

function evm_block_fn(network_id: integer, evm_block_height: integer, evm_block_hash: byte_array, events: list<event_data>) { 
    val evm_block = create evm_block(
        network_id,
        evm_block_height,
        evm_block_hash
    );

    for (event in events) {
        var indexed_values_bytes = x"";
        for (value in event.indexed_values) {
            indexed_values_bytes += value.to_bytes();
        }
        var non_indexed_values_bytes = x"";
        for (value in event.non_indexed_values) {
            non_indexed_values_bytes += value.to_bytes();
        }

        // ignore invalid events' network id
        val net_id = integer.from_gtv(event.non_indexed_values[0]);
        if (net_id != network_id) {
            log("ignore invalid events' network id: " + net_id + " : " + network_id);
            continue;
        }

        val beneficiary = byte_array.from_gtv(event.indexed_values[0]);
        val token_address = byte_array.from_gtv(event.indexed_values[1]);
        val evm_account = evm.evm_account @? { .address == beneficiary };

        when (event.name) {
            "DepositedERC20" -> {
                // ignore the unsupport token, move to process next events if any
                val token = evm_erc20 @? { network_id, .address == token_address };
                if (empty(token)) {
                    log("ignore the unsupport token, move to process next events if any: " + token_address);
                    continue;
                }
                val token_mapping = token_mapping @? { .token == token!! };
                if (empty(token_mapping)) {
                    log("no token_mapping");
                    continue;
                }

                // ignore event if ft asset does not exist
                val ft_asset = ass.asset @? { .id == token_mapping!!.asset.id };
                if (empty(ft_asset)) {
                    log("ignore event if ft asset does not exist: " + token_mapping.asset.id);
                    continue;
                }
                val amount = big_integer.from_gtv(event.non_indexed_values[1]);
                val evm_event = create evm_event(
                    evm_block,
                    tnx_hash = event.tnx_hash,
                    log_index = event.log_index,
                    event_signature = event.signature,
                    contract_address = event.contract_address,
                    indexed_values = indexed_values_bytes,
                    non_indexed_values = non_indexed_values_bytes
                );

                // if user account does not exist, record the state into EIF for withdraw back to EVM chains later.
                // This feature is to avoid losing fund of user  
                if (empty(evm_account)) {
                    val name = text.from_gtv(event.non_indexed_values[2]);
                    val symbol = text.from_gtv(event.non_indexed_values[3]);
                    val decimals = integer.from_gtv(event.non_indexed_values[4]);
                    log("record the state into EIF for withdraw back to EVM chains later for beneficiary: " + beneficiary);
                    deposit_ERC20(network_id, beneficiary, token_address, amount, name, symbol, decimals);
                
                    val account_link = get_or_create_evm_account_link(network_id, beneficiary);
                    val state = build_account_state(network_id, beneficiary, null);
                    val state_data = state_data(
                        account_link.state_n,
                        account = state
                    );
                    op_context.emit_event("eif_state", state_data.to_gtv());
                } else {
                    // mint postchain token for ft account
                    val ft_account = evm_account.account;
                    log("mint postchain token for ft account: " + ft_account.id);
                    val ft_balance = ass.ensure_balance( ft_account, ft_asset!! );
                    ft_balance.amount += amount;
                    val ft_beneficiary = evm.evm_account @ { .account == ft_account } ( .address );
                    val account_link = get_or_create_evm_account_link(token_mapping.token.network_id, ft_beneficiary);
                    val state = build_account_state(network_id, ft_beneficiary, ft_account);
                    val state_data = state_data(
                        account_link.state_n,
                        account = state
                    );
                    op_context.emit_event("eif_state", state_data.to_gtv());
                }
            }
            // "DepositedERC721" -> {
            //     // ignore event if dip instance does not exist
            //     val interface = nft_mapping @? { network_id, .address == token_address }.interface;
            //     if (empty(interface)) {
            //         log("nft token was not mapping yet: " + token_address);
            //         continue;
            //     }
                
            //     val evm_event = create evm_event(
            //         evm_block,
            //         tnx_hash = event.tnx_hash,
            //         log_index = event.log_index,
            //         event_signature = event.signature,
            //         contract_address = event.contract_address,
            //         indexed_values = indexed_values_bytes,
            //         non_indexed_values = non_indexed_values_bytes
            //     );

            //     val token_id = integer.from_gtv(event.non_indexed_values[1]);
            //     val name = text.from_gtv(event.non_indexed_values[2]);
            //     val symbol = text.from_gtv(event.non_indexed_values[3]);
            //     val uri = text.from_gtv(event.non_indexed_values[4]);

            //     if (empty(evm_account)) {
            //         log("deposit nft into EIF: " + name);
            //         deposit_ERC721(network_id, beneficiary, token_address, token_id, name, symbol, uri);

            //         val account_link = get_or_create_evm_account_link(network_id, beneficiary);
            //         val state = build_account_state(network_id, beneficiary, null);
            //         val state_data = state_data(
            //             account_link.state_n,
            //             account = state
            //         );
            //         op_context.emit_event("eif_state", state_data.to_gtv());
            //     } else {
            //         val ft3_account = evm_account.account;
            //         log("mint postchain original for ft3 account: " + ft3_account.id);
            //         require(interface!!.name == eif.INonFungibleOriginal.interface, "interface is not supported: " + interface!!.name);
            //         val original_type = og.Minter.I(
            //             interface_name = interface.name,
            //             [
            //                 eif.INonFungibleOriginal.symbol: dip.Text.T(symbol),
            //                 // eif.INonFungibleOriginal.uri: dip.Text.T(uri),
            //                 eif.INonFungibleOriginal.id: dip.Integer.T(token_id),
            //                 // eif.INonFungibleOriginal.address: dip.Text.T(token_address),
            //                 og.chromia.IOriginal.name: dip.Text.T(name),
            //                 og.chromia.IOriginal.creator_id: dip.ByteArray.T(ft3_account.id),
            //                 og.chromia.IOriginal.creator_name: dip.Text.T("User")
            //             ]
            //         );
            //         og.Minter.mint_non_fungible_original(ft3_account, "eif", original_type, dip.Meta.Engine.access(ft3_account));
            //     }
            // }
        }
    }
}

operation add_new_evm_erc20(network_id: integer, token_address: byte_array, name: text, symbol: text, decimals: integer) {
    admin.require_admin();
    require(empty(evm_erc20 @? { network_id, .address == token_address }), "token already existed");
    create evm_erc20(
        network_id,
        address = token_address,
        name,
        symbol,
        decimals
    );
}

operation add_new_token_mapping(network_id: integer, token_address: byte_array, asset_id: byte_array) {
    admin.require_admin();

    val token = require(
        evm_erc20 @? { network_id, .address == token_address },
        "Token does not exist: " + token_address
    );

    val asset = require(
        ass.asset @? { .id == asset_id },
        "Asset does not exist: " + asset_id
    );

    require(
        empty(token_mapping @? { token, asset }),
        "Token was already mapped: " + token_address
    );

    create token_mapping(token, asset);
}

