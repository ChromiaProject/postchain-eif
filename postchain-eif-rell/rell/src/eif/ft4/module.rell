import root: ^.*;
import c: ^.common;
import ^.evm;

import acc: ^^.lib.ft4.accounts;
import ass: ^^.lib.ft4.assets;
import admin: ^^.lib.ft4.admin;

struct module_args {
    sync_transfers_inside_dapp: boolean;
}

entity token_mapping {
    key token: evm_erc20;
    key asset: ass.asset;
}

entity evm_account_link {
    network_id: integer;
    state_n: integer;
    evm_beneficiary: byte_array;
    key network_id, state_n, evm_beneficiary;
}

entity evm_erc20 {
    network_id: integer;
    address: byte_array;
    name: text;
    symbol: text;
    decimals: integer;
    key network_id, address;
}

entity evm_erc20_balance {
    network_id: integer;
    token: evm_erc20;
    beneficiary: byte_array;
    mutable amount: big_integer;
    key token, beneficiary;
}

entity evm_erc20_withdraw {
    key serial: integer;
    network_id: integer;
    index token: evm_erc20;
    index beneficiary: byte_array;
    amount: big_integer;
}

object withdraw_stats {
    mutable withdraw_count: integer = 0;
}

struct state_data {
    state_n: integer;
    account: list<gtv>;
}

struct state_address_dto {
    state_n: integer;
    evm_address: byte_array;
}

struct auth_id {
    account_id: byte_array;
    auth_descriptor_id: byte_array;
}

query get_network_accounts(network_id: integer) : list<state_address_dto>{
    var accounts = evm_account_link @* {.network_id == network_id};
    val accounts_dto = list<state_address_dto>();
    for(account in accounts){
        accounts_dto.add(state_address_dto(state_n=account.state_n, evm_address=account.evm_beneficiary));
    }
    return accounts_dto;
}

query get_erc20_withdrawal(network_id: integer, token_address: byte_array, beneficiary: byte_array) {
    val token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        return null;
    }

    return evm_erc20_withdraw @* { network_id, token , beneficiary } (@sort_desc .serial, .network_id, token = .token.address, .beneficiary, .amount);
}

query evm_balance_of_erc20(network_id: integer, token_address: byte_array, beneficiary: byte_array): big_integer {
    val t = evm_erc20 @? { network_id, .address == token_address };
    if (empty(t)) {
        return 0;
    }
    val b = evm_erc20_balance @? { network_id, .token == t, beneficiary } (.amount);
    if (empty(b)) {
        return 0;
    }
    return b;
}

@extend(root.evm_block_fn) function(c.evm_block, network_id: integer, token_address: byte_array, event: c.event_data) {
    if (event.name != "DepositedERC20") return;
    // ignore the unsupported token, move to process next events if any
    val token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        log("ignore the unsupported token, move to process next events if any: " + token_address);
        return;
    }
    val token_mapping = token_mapping @? { .token == token };
    if (empty(token_mapping)) {
        log("no token_mapping");
        return;
    }

    // ignore event if ft asset does not exist
    val ft_asset = ass.asset @? { .id == token_mapping.asset.id };
    if (empty(ft_asset)) {
        log("ignore event if ft asset does not exist: " + token_mapping.asset.id);
        return;
    }
    val amount = big_integer.from_gtv(event.non_indexed_values[1]);
    val evm_event = create c.evm_event(
        evm_block,
        tnx_hash = event.tnx_hash,
        log_index = event.log_index,
        event_signature = event.signature,
        contract_address = event.contract_address,
        indexed_values = indexed_values_bytes,
        non_indexed_values = non_indexed_values_bytes
    );

    // if user account does not exist, record the state into EIF for withdraw back to EVM chains later.
    // This feature is to avoid losing fund of user
    if (empty(evm_account)) {
        val name = text.from_gtv(event.non_indexed_values[2]);
        val symbol = text.from_gtv(event.non_indexed_values[3]);
        val decimals = integer.from_gtv(event.non_indexed_values[4]);
        log("record the state into EIF for withdraw back to EVM chains later for beneficiary: " + beneficiary);
        deposit_ERC20(network_id, beneficiary, token_address, amount, name, symbol, decimals);

        val account_link = get_or_create_evm_account_link(network_id, beneficiary);
        val state = build_account_state(network_id, beneficiary, null);
        val state_data = state_data(
            account_link.state_n,
            account = state
        );
        op_context.emit_event("eif_state", state_data.to_gtv());
    } else {
        // mint postchain token for ft account
        val ft_account = evm_account.account;
        log("mint postchain token for ft account: " + ft_account.id);
        val ft_balance = ass.ensure_balance( ft_account, ft_asset!! );
        ft_balance.amount += amount;
        val ft_beneficiary = evm.evm_account @ { .account == ft_account } ( .address );
        val account_link = get_or_create_evm_account_link(token_mapping.token.network_id, ft_beneficiary);
        val state = build_account_state(network_id, ft_beneficiary, ft_account);
        val state_data = state_data(
            account_link.state_n,
            account = state
        );
        op_context.emit_event("eif_state", state_data.to_gtv());
    }
}

operation add_new_evm_erc20(network_id: integer, token_address: byte_array, name: text, symbol: text, decimals: integer) {
    admin.require_admin();
    require(empty(evm_erc20 @? { network_id, .address == token_address }), "token already existed");
    create evm_erc20(
        network_id,
        address = token_address,
        name,
        symbol,
        decimals
    );
}

operation add_new_token_mapping(network_id: integer, token_address: byte_array, asset_id: byte_array) {
    admin.require_admin();

    val token = require(
        evm_erc20 @? { network_id, .address == token_address },
        "Token does not exist: " + token_address
    );

    val asset = require(
        ass.asset @? { .id == asset_id },
        "Asset does not exist: " + asset_id
    );

    require(
        empty(token_mapping @? { token, asset }),
        "Token was already mapped: " + token_address
    );

    create token_mapping(token, asset);
}

operation deposit_ft_token(auth_id, network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer) {
    require(amount > 0, "amount should larger than 0");
    val token = require(evm_erc20 @? { network_id, .address == token_address }, "token is not support");
    val token_mapping = require(token_mapping @? { token }, "token is not support");
    val asset = require(ass.asset @? { .id == token_mapping.asset.id }, "asset does not exist");

    val account = acc.account @ { .id == auth_id.account_id };
    val account_auth_descriptor = acc.auth_descriptor_by_id(account, auth_id.auth_descriptor_id);
    acc._auth(account, account_auth_descriptor, ["T"]);

    // burn ft token of the account
    ass.Unsafe.burn(account, asset, amount);

    // update the postchain EIF state for equivalent account
    deposit_ERC20(network_id, beneficiary, token_address, amount, token_mapping.token.name, token_mapping.token.symbol, token_mapping.token.decimals);

    // update relevant account state
    update_account_state(account.id, asset.id);
}

operation bridge_ft_token_to_evm(auth_id, network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer) {
    require(amount > 0, "amount should larger than 0");
    val token = require(evm_erc20 @? { network_id, .address == token_address }, "token is not support");
    val token_mapping = require(token_mapping @? { token }, "token is not support");
    val asset = require(ass.asset @? { .id == token_mapping.asset.id }, "asset does not exist");

    val account = acc.account @ { .id == auth_id.account_id };
    val account_auth_descriptor = acc.auth_descriptor_by_id(account, auth_id.auth_descriptor_id);
    acc._auth(account, account_auth_descriptor, ["T"]);

    // burn ft token of the account and update relevant account state
    ass.Unsafe.burn(account, asset, amount);
    update_account_state(account.id, asset.id);

    update withdraw_stats(withdraw_count += 1);
    val next_serial = withdraw_stats.withdraw_count;

    create evm_erc20_withdraw(
        serial = next_serial,
        network_id,
        token,
        beneficiary,
        amount
    );

    val withdraw_info = list<gtv>();
    withdraw_info.add(next_serial.to_gtv());
    withdraw_info.add(network_id.to_gtv());
    withdraw_info.add(byte_array.from_hex(to_zero_padded_hex(token_address)).to_gtv());
    withdraw_info.add(byte_array.from_hex(to_zero_padded_hex(beneficiary)).to_gtv());
    withdraw_info.add(amount.to_gtv());

    op_context.emit_event("eif_event", withdraw_info.to_gtv());
}

// user can claim ft asset back to specific account id on postchain after deposit it into EIF
operation claim_ERC20(network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer,
                        r: byte_array, s: byte_array, v: integer, pk: text, account_id: byte_array) {
    require(amount > 0, "Must withdraw an amount larger than 0");
    val recovered_pubkey = crypto.eth_ecrecover(r, s, v, hash_eth_message(pk));
    val eth_address = get_eth_address(recovered_pubkey);
    require(eth_address == beneficiary, "beneficiary is not correct, " + "b: " + beneficiary + " e: " + eth_address);
    val participants = op_context.get_signers();
    require_not_empty(participants, "participants is empty");
    require(participants.size() == 1, "only support single auth");
    require(participants[0].to_hex() == pk, "participant is not correct, " + participants[0].to_hex() + ", " + pk);

    val token = require(
        evm_erc20 @? { network_id, .address == token_address },
        "unsupport token: " + token_address
    );
    val token_mapping = require(
        token_mapping @? { .token == token },
        "no token mapping"
    );
    val ft_asset = require(
        ass.asset @? { .id == token_mapping.asset.id },
        "ft asset does not exist: " + token_mapping.asset.id
    );
    val balance = evm_erc20_balance @? { network_id, token, beneficiary };
    require_not_empty(balance, "No balance for this token");
    require(balance.amount >= amount, "Balance is too low");
    update balance(.amount -= amount);

    update withdraw_stats(withdraw_count += 1);
    val next_serial = withdraw_stats.withdraw_count;

    // net_id = 0 means withdraw from postchain snapshot state into ft account
    val net_id = 0;
    create evm_erc20_withdraw(
        serial = next_serial,
        network_id = net_id,
        token,
        beneficiary,
        amount
    );

    val withdraw_info = list<gtv>();
    withdraw_info.add(next_serial.to_gtv());
    withdraw_info.add(net_id.to_gtv());
    withdraw_info.add(byte_array.from_hex(to_zero_padded_hex(token_address)).to_gtv());
    withdraw_info.add(byte_array.from_hex(to_zero_padded_hex(beneficiary)).to_gtv());
    withdraw_info.add(amount.to_gtv());

    val account = acc.account @ { account_id };
    val ft_balance = ass.ensure_balance(account , ft_asset );
    ft_balance.amount += amount;
    emit_withdraw(network_id, beneficiary, account, withdraw_info);
}

operation withdraw_ERC20(network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer,
                                                    r: byte_array, s: byte_array, v: integer, pk: text) {
    require(amount > 0, "Must withdraw an amount larger than 0");

    // ensure that the signer also control the beneficiary account
    val recovered_pubkey = crypto.eth_ecrecover(r, s, v, hash_eth_message(pk));
    val eth_address = get_eth_address(recovered_pubkey);
    require(eth_address == beneficiary, "beneficiary is not correct, " + "b: " + beneficiary + " e: " + eth_address);
    val participants = op_context.get_signers();
    require_not_empty(participants, "participants is empty");
    require(participants.size() == 1, "only support single auth");
    require(participants[0].to_hex() == pk, "participant is not correct, " + participants[0].to_hex() + ", " + pk);

    val token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        return;
    }
    val balance = evm_erc20_balance @? { network_id, token, beneficiary };
    require_not_empty(balance, "No balance for this token");
    require(balance.amount >= amount, "Balance is too low");
    update balance(.amount -= amount);

    update withdraw_stats(withdraw_count += 1);
    val next_serial = withdraw_stats.withdraw_count;

    create evm_erc20_withdraw(
        serial = next_serial,
        network_id,
        token,
        beneficiary,
        amount
    );

    val withdraw_info = list<gtv>();
    withdraw_info.add(next_serial.to_gtv());
    withdraw_info.add(network_id.to_gtv());
    withdraw_info.add(byte_array.from_hex(to_zero_padded_hex(token_address)).to_gtv());
    withdraw_info.add(byte_array.from_hex(to_zero_padded_hex(beneficiary)).to_gtv());
    withdraw_info.add(amount.to_gtv());

    val account = evm.get_account_by_evm_address(eth_address);
    emit_withdraw(network_id, beneficiary, account, withdraw_info);
}

function get_or_create_evm_account_link(network_id: integer, beneficiary: byte_array): evm_account_link {
    val account = evm_account_link @? { network_id, beneficiary };
    if (empty(account)) {
        val last_state_n = evm_account_link @? {} (@sort_desc .state_n) limit 1;
        var next_state_n = 0;
        if (empty(last_state_n)) {
            next_state_n = 1;
        } else {
            next_state_n = last_state_n + 1;
        }

        return create evm_account_link(
            network_id,
            state_n = next_state_n,
            beneficiary
        );
    };
    return account;
}

function build_account_state(network_id: integer, beneficiary: byte_array, account: acc.account?) {
	val state = list<gtv>();
	state.add(byte_array.from_hex(to_zero_padded_hex(beneficiary)).to_gtv());
	// In order of asset type
	// 0: ERC20
	val erc20_balances = evm_erc20_balance @* { network_id, beneficiary };
    val balances = list<ass.balance>();
    if (account != null) {
        val ft_balances = ass.balance @* { .account == account };
        for (ft_balance in ft_balances) {
            val token_mapping = token_mapping @? {.asset == ft_balance.asset};
            if (token_mapping != null) {
                if (token_mapping.token.network_id != network_id) {
                    continue;
                }
                balances.add(ft_balance);
            }
        }
    }
	val erc20_byte_offset = (erc20_balances.size() + balances.size()) * 2 * 32; // 2 values per entry
	state.add(erc20_byte_offset.to_gtv());

    // update state for eif balance
	for (balance in erc20_balances) {
		state.add(byte_array.from_hex(to_zero_padded_hex(balance.token.address)).to_gtv());
		state.add((balance.amount).to_gtv());
    }

    // update state for ft balance
    for (balance in balances) {
        val token_mapping = token_mapping @ {.asset == balance.asset};
        state.add(byte_array.from_hex(to_zero_padded_hex(token_mapping.token.address)).to_gtv());
        state.add((balance.amount).to_gtv());
    }

	// 1: ERC721
	// val erc721_balances = evm_erc721_balance @* { network_id, beneficiary };
	// val erc721_byte_offset = erc721_balances.size() * 2 * 32; // 2 values per entry
	// state.add(erc721_byte_offset.to_gtv());
	// for (balance in erc721_balances) {
	// 	state.add(byte_array.from_hex("000000000000000000000000" + balance.token.address.sub(2)).to_gtv());
	// 	state.add(balance.token.token_id.to_gtv());
	// }
	// Add new asset types here
	// ------------------------ //
	return state;
}

function deposit_ERC20(network_id: integer, beneficiary: byte_array, token_address: byte_array, amount: big_integer, name: text, symbol: text, decimals: integer) {
    log("deposit_ERC20: " + token_address + " : " + beneficiary + " : " + name);
    var token = evm_erc20 @? { network_id, .address == token_address };
    if (empty(token)) {
        token = create evm_erc20(
            network_id,
            address = token_address,
            name,
            symbol,
            decimals
        );
    }

    val balance = evm_erc20_balance @? { network_id, token, beneficiary };
    if (empty(balance)) {
        create evm_erc20_balance(
            network_id,
            token,
            beneficiary,
            amount
        );
    } else {
        update balance (.amount += amount);
    }
}

function emit_withdraw(network_id: integer, beneficiary: byte_array, account: acc.account?, eth_event_data: list<gtv>) {
    val account_link = get_or_create_evm_account_link(network_id, beneficiary);
    val state = build_account_state(network_id, beneficiary, account);
    val state_data = state_data(
        account_link.state_n,
        account = state
    );

    op_context.emit_event("eif_state", state_data.to_gtv());
    op_context.emit_event("eif_event", eth_event_data.to_gtv());
}

function to_zero_padded_hex(array: byte_array) = "000000000000000000000000" + array.to_hex();

function get_eth_address(pk: byte_array) = crypto.keccak256(pk).sub(12);

function hash_eth_message(msg: text) = crypto.keccak256(("\u0019Ethereum Signed Message:\n" + msg.size().to_text() + msg).to_bytes());

function is_syncing_transfers_inside_dapp() = chain_context.args.sync_transfers_inside_dapp;

@extend(ass.after_transfer) function after_transfer_eif(from: acc.account, to: acc.account, ass.asset, amount: big_integer) {
    if (not is_syncing_transfers_inside_dapp()) return;

    update_account_state(from.id, asset.id);
    update_account_state(to.id, asset.id);
}

function update_account_state(account_id: byte_array, asset_id: byte_array) {
    val account = acc.account @ { .id == account_id };
    val beneficiary = evm.evm_account @ { .account == account } ( .address );
    val asset = ass.asset @ { .id == asset_id };
    val token_mapping = token_mapping @? { .asset == asset };
    if (empty(token_mapping)) {
        return;
    }
    val network_id = token_mapping.token.network_id;
    val account_link = get_or_create_evm_account_link(network_id, beneficiary);
    val state = build_account_state(network_id, beneficiary, account);
    val state_data = state_data(
        account_link.state_n,
        account = state
    );
    op_context.emit_event("eif_state", state_data.to_gtv());
}