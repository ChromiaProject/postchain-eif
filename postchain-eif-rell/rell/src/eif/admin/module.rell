@mount('eif.admin')
module;

import admin: lib.ft4.admin;
import ass: lib.ft4.assets;
import acc: lib.ft4.accounts;
import c: ^.common;
import dip_core: lib.dip.core;
import a: lib.access.admin;
import originals_core: lib.originals.core;

entity token_mapping {
    key token: c.evm_erc20;
    key asset: ass.asset;
}

entity nft_mapping {
    network_id: integer;
    address: byte_array;
    interface: dip_core.Interface.dclass;
    key network_id, address;
}

operation add_new_evm_erc20(network_id: integer, token_address: byte_array, name: text, symbol: text, decimals: integer) {
    admin.require_admin();
    require(empty(c.evm_erc20 @? { network_id, .address == token_address }), "token already existed");
    create c.evm_erc20(
        network_id,
        address = token_address,
        name,
        symbol,
        decimals
    );
}

operation add_new_token_mapping(network_id: integer, token_address: byte_array, asset_id: byte_array) {
    admin.require_admin();

    val token = require(
        c.evm_erc20 @? { network_id, .address == token_address },
        "Token does not exist: " + token_address
    );

    val asset = require(
        ass.asset @? { .id == asset_id },
        "Asset does not exist: " + asset_id
    );

    require(
        empty(token_mapping @? { token, asset }),
        "Token was already mapped: " + token_address
    );

    create token_mapping(token, asset);
}

operation register_chromia_base_originals() {
    admin.require_admin();

    val admin_account = require(
        acc.account @? { .id == a.account_id() }, 
        "admin account was not defined: " + a.account_id()
    );

    val dclass = dip_core.Interface.dclass @? { originals_core.chromia.INonFungibleOriginal.interface };
    if (empty(dclass)) {
        originals_core.initialize_original_interfaces(admin_account);
    }
}

operation init_eif_original_interface() {
    admin.require_admin();

    val admin_account = require(
        acc.account @? { .id == a.account_id() }, 
        "admin account was not defined: " + a.account_id()
    );

    require(
        empty(dip_core.Interface.dclass @? { c.eif.INonFungibleOriginal.interface }),
        "eif non fungible original interface was already defined"
    );
    c.eif.INonFungibleOriginal.register(admin_account);
}

operation add_eif_nft_mapping(network_id: integer, token_address: byte_array) {
    admin.require_admin();

    val dclass = require(
        dip_core.Interface.dclass @? { c.eif.INonFungibleOriginal.interface },
        "dclass does not exist: " + c.eif.INonFungibleOriginal.interface
    );

    require(
        empty(nft_mapping @? {}),
        "eif non fungible token was already mapped: " + token_address
    );

    create nft_mapping(network_id, token_address, interface = dclass);
}


