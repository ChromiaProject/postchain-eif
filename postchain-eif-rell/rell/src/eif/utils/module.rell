@mount('eif.utils')
module;

function evm_address_to_32_byte_array(address: byte_array): byte_array {
    require(address.size() == 20, "Invalid address length %d, must be 20 bytes".format(address.size()));
    return (x"00").repeat(12) + address;
}

function integer_to_32_byte_array(i: integer): byte_array {
    return big_integer_to_32_byte_array(i);
}

function big_integer_to_32_byte_array(i: big_integer): byte_array {
    val hex = i.to_hex();
    require(hex.size() <= 64, "Invalid hex value length %d; it must not be greater than 64".format(hex.size()));
    val pad = 64 - hex.size();
    val padded = "0".repeat(pad) + hex;
    return byte_array(padded);
}
