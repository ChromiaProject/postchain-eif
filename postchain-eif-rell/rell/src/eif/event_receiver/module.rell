module;

import lib.icmf. { send_message };
import .messaging.*;
import .model.*;
import .queries.*;

operation __evm_block(
    network_id: integer,
    evm_block_height: integer,
    evm_block_hash: byte_array,
    events: list<event_data>
) {
    _evm_block(network_id, evm_block_height, evm_block_hash, events);
}

function _evm_block(
    network_id: integer,
    evm_block_height: integer,
    evm_block_hash: byte_array,
    events: list<event_data>
) {

    if (exists(evm_block @? { .network_id == network_id, evm_block_height })) {
        log("Block %d with RID %s for chain %s already received".format(evm_block_height, evm_block_hash, network_id));
    }

    val block = create evm_block (
        network_id,
        evm_block_height,
        evm_block_hash
    );

    val relevant_events = list<event_data>();
    for (event in events) {
        // validate network id
        val event_network_id = integer.from_gtv(event.non_indexed_values[0]);
        if (network_id != event_network_id) {
            log("Ignoring event with invalid network_id: expected: %d, actual: %d".format(network_id, event_network_id));
            continue;
        }

        create evm_event (
            evm_block = block,
            tnx_hash = event.tnx_hash,
            log_index = event.log_index,
            event_signature = event.signature,
            contract_address = event.contract_address,
            indexed_values = event.indexed_values.to_gtv().to_bytes(),
            non_indexed_values = event.non_indexed_values.to_gtv().to_bytes()
        );

        relevant_events.add(event);
    }

    val message = evm_block_message(
        network_id,
        evm_block_height,
        evm_block_hash,
        relevant_events
    );

    send_message(evm_block_events_topic, message.to_gtv());
}
