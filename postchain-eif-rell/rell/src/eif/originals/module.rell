@mount('eif.originals')
module;

import root: ^.main;
import c: ^.common;
import u: ^.utils;
import a: lib.access.admin;
import ^.evm;

import admin: lib.ft4.admin;
import ft_helper: lib.ft_helper;
import acc: lib.ft4.accounts;
import dip_core: lib.dip.core;
import dip_attributes: lib.dip.attributes;
import originals_core: lib.originals.core;
import proj: lib.projects.{simple_project_props, create_project};
import collections: lib.collections.{create_collection, collection};
import access: lib.collections.external.access.{has_create_collection_permission};
import hao: lib.originals.originals_collection.external.access.{has_add_original_to_collection_permission};

@extend(access.has_create_collection_permission) function(acc.account) = true;

@extend(hao.has_add_original_to_collection_permission) function(acc.account, original: originals_core.Id.asset_instance, collections.collection) = true;

entity evm_erc721 {
    key network_id: integer, address: byte_array, token_id: integer;
    name: text;
    symbol: text;
    uri: text;
    asset_id: byte_array;
}

entity evm_erc721_balance {
    network_id: integer;
    token: evm_erc721;
    beneficiary: byte_array;
    key token, beneficiary;
}

entity evm_erc721_withdraw {
    key serial: integer;
    network_id: integer;
    index token_address: byte_array;
    index beneficiary: byte_array;
    asset_id: byte_array;
}

entity nft_mapping {
    network_id: integer;
    address: byte_array;
    interface: dip_core.Interface.dclass;
    key network_id, address;
}

namespace eif.INonFungibleOriginal {
    val interface = "eif.INonFungibleOriginal";

    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface
    ];

    val symbol = dip_core.Attribute.I(interface, name = "symbol");
    val uri = dip_core.Attribute.I(interface, name = "uri");

	function register(account: acc.account) {
		dip_core.InterfaceFactory.new(interface,
			[
                symbol: dip_attributes.Type(dip_attributes.Text.T(), [dip_attributes.Optional()]),
                uri: dip_attributes.Type(dip_attributes.Text.T(), [dip_attributes.Optional()])
            ],
            dependencies() @* {} (dip_core.Interface.get($)),
            account = account,
            is_open = true
		);
	}

	function get() = dip_core.Interface.get(interface);
	function has(dip_core.instance) = dip_core.Interface.is_a(instance, get());
}

operation create_admin_account(pubkey) {
    admin.require_admin();

    val flags = set<text>(["T"]);
    flags.add("A");

    val auth_descriptor = acc.single_sig_auth_descriptor(
        pubkey,
        flags = flags
    );

    val id = acc.Unsafe.create_account_with_auth(auth_descriptor);
    log("created admin account: " + id);
}

operation create_project(account_id: byte_array) {
    admin.require_admin();

    val owner = acc.account @ { .id == account_id };
    val props = proj.simple_project_props(
        id = "coa",
        name = "Chromia Originals",
        avatar = "https://avatars.githubusercontent.com/u/37784805?s=200&v=4",
        website = "https://chromia.com",
        background_image = "https://images.unsplash.com/photo-1612835362596-4b0b2b0b0b0b?ixid=MnwxMjA3fDB8MHxzZWFyY2h8Mnx8Y2hvbWlhJTIwb2ZmaWNlfGVufDB8fDB8fA%3D%3D&ixlib=rb-1.2.1&w=1000&q=80",
        description = "Chromia Originals is a platform for creating and trading NFTs on Chromia blockchain."
    );

    proj.create_project(owner, props);
}

operation create_collection(account_id: byte_array) {
    admin.require_admin();
    
    val owner = acc.account @ { .id == account_id };
    collections.create_collection(
        "eif",
        "EIF",
        "Chromia Originals",
        "Chromia Originals is a platform for creating and trading NFTs on Chromia blockchain.",
        owner,
        owner,
        "https://images.unsplash.com/photo-1612835362596-4b0b2b0b0b0b?ixid=MnwxMjA3fDB8MHxzZWFyY2h8Mnx8Y2hvbWlhJTIwb2ZmaWNlfGVufDB8fDB8fA%3D%3D&ixlib=rb-1.2.1&w=1000&q=80",
        "https://avatars.githubusercontent.com/u/37784805?s=200&v=4",
        "coa"
    );
}

operation register_chromia_base_originals(account_id: byte_array) {
    admin.require_admin();

    val admin_account = require(
        acc.account @? { .id == account_id }, 
        "admin account was not defined: " + account_id
    );

    val dclass = dip_core.Interface.dclass @? { originals_core.chromia.INonFungibleOriginal.interface };
    if (empty(dclass)) {
        originals_core.initialize_original_interfaces(admin_account);
    }
}

operation init_eif_original_interface(account_id: byte_array) {
    admin.require_admin();

    val admin_account = require(
        acc.account @? { .id == account_id }, 
        "admin account was not defined: " + account_id
    );

    require(
        empty(dip_core.Interface.dclass @? { eif.INonFungibleOriginal.interface }),
        "eif non fungible original interface was already defined"
    );
    eif.INonFungibleOriginal.register(admin_account);
}

operation mint_non_fungible_original(account_id: byte_array) {
    admin.require_admin();

    val account = acc.account @ { .id == account_id };
    val original_type = originals_core.Minter.I(
        interface_name = "eif.INonFungibleOriginal",
        [
            eif.INonFungibleOriginal.symbol: dip_attributes.Text.T("CHR"),
            originals_core.chromia.IOriginal.name: dip_attributes.Text.T("Chromia"),
            eif.INonFungibleOriginal.uri: dip_attributes.Text.T(""),
            originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(account.id),
            originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("User")
        ]
    );
    originals_core.Minter.mint_non_fungible_original(account, "eif", original_type, dip_attributes.Meta.Engine.access(account));
}

operation add_eif_nft_mapping(network_id: integer, token_address: byte_array) {
    admin.require_admin();

    val dclass = require(
        dip_core.Interface.dclass @? { eif.INonFungibleOriginal.interface },
        "dclass does not exist: " + eif.INonFungibleOriginal.interface
    );

    require(
        empty(nft_mapping @? {}),
        "eif non fungible token was already mapped: " + token_address
    );

    create nft_mapping(network_id, token_address, interface = dclass);
}

query get_erc721_withdrawal(network_id: integer, token_address: byte_array, beneficiary: byte_array) {
    return evm_erc721_withdraw @* { network_id, token_address, beneficiary } (@sort_desc .serial, .network_id, .token_address, .beneficiary, .asset_id);
}

query evm_has_erc721(network_id: integer, token_address: byte_array, token_id: integer, beneficiary: byte_array): boolean {
    val t = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(t)) {
        return false;
    }
    val b = evm_erc721_balance @? { network_id, .token == t, beneficiary };
    return not empty(b);
}

@extend(root.evm_block_fn)
function(
    c.evm_block,
    network_id: integer,
    token_address: byte_array,
    beneficiary: byte_array,
    evm.evm_account?,
    event: c.event_data,
    indexed_values_bytes: byte_array,
    non_indexed_values_bytes: byte_array
) {
    if (event.name != "DepositedERC721") return;

    // ignore event if dip instance does not exist
    val interface = nft_mapping @? { network_id, .address == token_address }.interface;
    if (empty(interface)) {
        log("nft token was not mapping yet: " + token_address);
        return;
    }
    
    val evm_event = create c.evm_event(
        evm_block,
        tnx_hash = event.tnx_hash,
        log_index = event.log_index,
        event_signature = event.signature,
        contract_address = event.contract_address,
        indexed_values = indexed_values_bytes,
        non_indexed_values = non_indexed_values_bytes
    );

    val asset_id = byte_array.from_gtv(event.non_indexed_values[1]);
    val token_id = integer.from_gtv(event.non_indexed_values[2]);
    val name = text.from_gtv(event.non_indexed_values[3]);
    val symbol = text.from_gtv(event.non_indexed_values[4]);
    val uri = text.from_gtv(event.non_indexed_values[5]);

    if (empty(evm_account)) {
        log("deposit nft into EIF: " + token_id);
        deposit_ERC721(network_id, beneficiary, token_address, token_id, name, symbol, uri, asset_id);

        val account_link = c.get_or_create_evm_account_link(network_id, beneficiary);
        val state = c.build_account_state(network_id, beneficiary, null);
        val state_data = c.state_data(
            account_link.state_n,
            account = state
        );
        op_context.emit_event("eif_state", state_data.to_gtv());
    } else {
        // unlock non fungible token for the user
        val ft_locked_account = ft_helper.ensure_locked_account("EIF", evm_account.account);
        val instance = originals_core.Id.get_instance(asset_id);
        originals_core.Ownership.transfer(ft_locked_account, instance, evm_account.account.id, 1);
    }
}

@extend(c.build_account_state_fn)
function(
    network_id: integer,
    beneficiary: byte_array,
    account: acc.account?
): map<integer, list<gtv>> {
    val state = list<gtv>();
    // 1: ERC721
    val erc721_balances = evm_erc721_balance @* { network_id, beneficiary };
    val erc721_byte_offset = erc721_balances.size() * 2 * 32; // 2 values per entry
    state.add(erc721_byte_offset.to_gtv());
    for (balance in erc721_balances) {
        state.add(byte_array.from_hex("000000000000000000000000" + balance.token.address.sub(2)).to_gtv());
        state.add(balance.token.asset_id.to_gtv());
    }

    val states = map<integer, list<gtv>>();
    states.put(1, state);
    return states;
}

function deposit_ERC721(network_id: integer, beneficiary: byte_array, token_address: byte_array, token_id: integer, name: text, symbol: text, uri: text, asset_id: byte_array) {
    var token = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(token)) {
        token = create evm_erc721(
            network_id,
            address = token_address,
            token_id,
            name,
            symbol,
            uri,
            asset_id            
        );
    }

    create evm_erc721_balance(
        network_id,
        token,
        beneficiary
    );
}

operation bridge_non_fungible_original_to_evm(c.auth_id, asset_id: byte_array, network_id: integer, token_address: byte_array, beneficiary: byte_array) {
    val account = acc.account @ { .id == auth_id.account_id };
    val account_auth_descriptor = acc.auth_descriptor_by_id(account, auth_id.auth_descriptor_id);
    acc._auth(account, account_auth_descriptor, ["T"]);

    val ft_locked_account = ft_helper.ensure_locked_account("EIF", account);

    val instance = originals_core.Id.get_instance(asset_id);
    val dclass = dip_core.instance_dclass @ { instance, .direct == true} .dclass;
    require(dclass.name == eif.INonFungibleOriginal.interface, "interface is not support: " + dclass.name);
    originals_core.Ownership.transfer(account, instance, ft_locked_account.id, 1);

    require(
        nft_mapping @? { network_id, .address == token_address }.interface, 
        "nft token was not mapping yet: " + token_address
    );

    var name = dip_core.Text.get_value(instance, originals_core.chromia.IOriginal.name) ?: "";
    var symbol = dip_core.Text.get_value(instance, eif.INonFungibleOriginal.symbol) ?: "";
    var uri = dip_core.Text.get_value(instance, eif.INonFungibleOriginal.uri) ?: "";

    update c.withdraw_stats(withdraw_count += 1);
    val next_serial = c.withdraw_stats.withdraw_count;

    create evm_erc721_withdraw(
        serial = next_serial,
        network_id,
        token_address,
        beneficiary,
        asset_id
    );

    val withdraw_info = list<gtv>();
    withdraw_info.add(next_serial.to_gtv());
    withdraw_info.add(network_id.to_gtv());
    withdraw_info.add(byte_array.from_hex(u.to_zero_padded_hex(token_address)).to_gtv());
    withdraw_info.add(byte_array.from_hex(u.to_zero_padded_hex(beneficiary)).to_gtv());
    withdraw_info.add(asset_id.to_gtv());

    op_context.emit_event("eif_event", withdraw_info.to_gtv());
}


