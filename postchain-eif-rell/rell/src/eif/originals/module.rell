@mount('eif.origials')
module;

import root: ^.*;
import c: ^.common;
import a: lib.access.admin;
import ^.evm;

import admin: lib.ft4.admin;
import acc: lib.ft4.accounts;
import dip_core: lib.dip.core;
import dip_attributes: lib.dip.attributes;
import originals_core: lib.originals.core;
import access: lib.collections.external.access.*;
import hao: lib.originals.originals_collection.external.access.*;
import lib.collections.{collection};

@extend(access.has_create_collection_permission) function(acc.account) = true;

@extend(hao.has_add_original_to_collection_permission) function(acc.account, original: originals_core.Id.asset_instance, collection) = true;

entity evm_erc721 {
    key network_id: integer, address: byte_array, token_id: integer;
    name: text;
    symbol: text;
    uri: text;
}

entity evm_erc721_balance {
    network_id: integer;
    token: evm_erc721;
    beneficiary: byte_array;
    key token, beneficiary;
}

entity evm_erc721_withdraw {
    key serial: integer;
    network_id: integer;
    index token: evm_erc721;
    index beneficiary: byte_array;
}

entity nft_mapping {
    network_id: integer;
    address: byte_array;
    interface: dip_core.Interface.dclass;
    key network_id, address;
}

namespace eif.INonFungibleOriginal {
    val interface = "eif.INonFungibleOriginal";

    function dependencies() = [
        originals_core.chromia.INonFungibleOriginal.interface
    ];

    val id = dip_core.Attribute.I(interface, name = "id");
    val address = dip_core.Attribute.I(interface, name = "address");
    val symbol = dip_core.Attribute.I(interface, name = "symbol");
    val uri = dip_core.Attribute.I(interface, name = "uri");

	function register(account: acc.account) {
		dip_core.InterfaceFactory.new(interface,
			[
                id: dip_attributes.Type(dip_attributes.Integer.T()),
                address: dip_attributes.Type(dip_attributes.Text.T(), [dip_attributes.Optional()]),
                symbol: dip_attributes.Type(dip_attributes.Text.T(), [dip_attributes.Optional()]),
                uri: dip_attributes.Type(dip_attributes.Text.T(), [dip_attributes.Optional()])
            ],
            dependencies() @* {} (dip_core.Interface.get($)),
            account = account,
            is_open = true
		);
	}

	function get() = dip_core.Interface.get(interface);
	function has(dip_core.instance) = dip_core.Interface.is_a(instance, get());
}

operation register_chromia_base_originals(account_id: byte_array) {
    admin.require_admin();

    val admin_account = require(
        acc.account @? { .id == account_id }, 
        "admin account was not defined: " + account_id
    );

    val dclass = dip_core.Interface.dclass @? { originals_core.chromia.INonFungibleOriginal.interface };
    if (empty(dclass)) {
        originals_core.initialize_original_interfaces(admin_account);
    }
}

operation init_eif_original_interface(account_id: byte_array) {
    admin.require_admin();

    val admin_account = require(
        acc.account @? { .id == account_id }, 
        "admin account was not defined: " + account_id
    );

    require(
        empty(dip_core.Interface.dclass @? { eif.INonFungibleOriginal.interface }),
        "eif non fungible original interface was already defined"
    );
    eif.INonFungibleOriginal.register(admin_account);
}

operation add_eif_nft_mapping(network_id: integer, token_address: byte_array) {
    admin.require_admin();

    val dclass = require(
        dip_core.Interface.dclass @? { eif.INonFungibleOriginal.interface },
        "dclass does not exist: " + eif.INonFungibleOriginal.interface
    );

    require(
        empty(nft_mapping @? {}),
        "eif non fungible token was already mapped: " + token_address
    );

    create nft_mapping(network_id, token_address, interface = dclass);
}

query get_erc721_withdrawal(network_id: integer, token_address: byte_array, token_id: integer, beneficiary: byte_array) {
    val token = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(token)) {
        return null;
    }

    return evm_erc721_withdraw @* { network_id, token, beneficiary } (@sort_desc .serial, .network_id, token = .token.address, .beneficiary);
}

query evm_has_erc721(network_id: integer, token_address: byte_array, token_id: integer, beneficiary: byte_array): boolean {
    val t = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(t)) {
        return false;
    }
    val b = evm_erc721_balance @? { network_id, .token == t, beneficiary };
    return not empty(b);
}

@extend(root.evm_block_fn)
function(
    c.evm_block,
    network_id: integer,
    token_address: byte_array,
    beneficiary: byte_array,
    evm.evm_account?,
    event: c.event_data,
    indexed_values_bytes: byte_array,
    non_indexed_values_bytes: byte_array
) {
    if (event.name != "DepositedERC721") return;

    // ignore event if dip instance does not exist
    val interface = nft_mapping @? { network_id, .address == token_address }.interface;
    if (empty(interface)) {
        log("nft token was not mapping yet: " + token_address);
        return;
    }
    
    val evm_event = create c.evm_event(
        evm_block,
        tnx_hash = event.tnx_hash,
        log_index = event.log_index,
        event_signature = event.signature,
        contract_address = event.contract_address,
        indexed_values = indexed_values_bytes,
        non_indexed_values = non_indexed_values_bytes
    );

    val token_id = integer.from_gtv(event.non_indexed_values[1]);
    val name = text.from_gtv(event.non_indexed_values[2]);
    val symbol = text.from_gtv(event.non_indexed_values[3]);
    val uri = text.from_gtv(event.non_indexed_values[4]);

    if (empty(evm_account)) {
        log("deposit nft into EIF: " + name);
        deposit_ERC721(network_id, beneficiary, token_address, token_id, name, symbol, uri);

        val account_link = c.get_or_create_evm_account_link(network_id, beneficiary);
        val state = c.build_account_state(network_id, beneficiary, null);
        val state_data = c.state_data(
            account_link.state_n,
            account = state
        );
        op_context.emit_event("eif_state", state_data.to_gtv());
    } else {
        val ft_account = evm_account.account;
        log("mint a non fungible original for ft account: " + ft_account.id);
        require(interface.name == eif.INonFungibleOriginal.interface, "interface is not supported: " + interface.name);
        val original_type = originals_core.Minter.I(
            interface_name = interface.name,
            [
                eif.INonFungibleOriginal.symbol: dip_attributes.Text.T(symbol),
                // eif.INonFungibleOriginal.uri: dip.Text.T(uri),
                eif.INonFungibleOriginal.id: dip_attributes.Integer.T(token_id),
                // eif.INonFungibleOriginal.address: dip.Text.T(token_address),
                originals_core.chromia.IOriginal.name: dip_attributes.Text.T(name),
                originals_core.chromia.IOriginal.creator_id: dip_attributes.ByteArray.T(ft_account.id),
                originals_core.chromia.IOriginal.creator_name: dip_attributes.Text.T("User")
            ]
        );
        originals_core.Minter.mint_non_fungible_original(ft_account, "eif", original_type, dip_attributes.Meta.Engine.access(ft_account));
    }
}

@extend(c.build_account_state_fn)
function(
    network_id: integer,
    beneficiary: byte_array,
    account: acc.account?
): map<integer, list<gtv>> {
    val state = list<gtv>();
    // 1: ERC721
    val erc721_balances = evm_erc721_balance @* { network_id, beneficiary };
    val erc721_byte_offset = erc721_balances.size() * 2 * 32; // 2 values per entry
    state.add(erc721_byte_offset.to_gtv());
    for (balance in erc721_balances) {
        state.add(byte_array.from_hex("000000000000000000000000" + balance.token.address.sub(2)).to_gtv());
        state.add(balance.token.token_id.to_gtv());
    }

    val states = map<integer, list<gtv>>();
    states.put(1, state);
    return states;
}

function deposit_ERC721(network_id: integer, beneficiary: byte_array, token_address: byte_array, token_id: integer, name: text, symbol: text, uri: text) {
    var token = evm_erc721 @? { network_id, .address == token_address, token_id };
    if (empty(token)) {
        token = create evm_erc721(
            network_id,
            address = token_address,
            token_id,
            name,
            symbol,
            uri
        );
    }

    create evm_erc721_balance(
        network_id,
        token,
        beneficiary
    );
}

