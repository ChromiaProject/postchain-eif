@mount("eif.hbridge")
module;

import messaging: ^.eif.messaging;
import common: ^.eif.common;
import utils: ^.eif.utils;

namespace ft4 {
    import lib.ft4.accounts;
    import lib.ft4.accounts.strategies;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import lib.ft4.utils;
    import transfer_strategy: lib.ft4.accounts.strategies.transfer;
}

enum bridge_mode {
    native,
    foreign
}

// nothing really stops us from accepting deposits from any EVM address,
// except that it might be icky and easier to exploit via client (front-end) attacks
val need_consent_on_deposit = true;

// withdrawal from EVM to FT4
entity erc20_withdraw {
    key serial: integer;
    network_id: integer;
    token_address: byte_array;
    index network_id, token_address;
    index beneficiary: byte_array;
    amount: big_integer;
}

// link between EVM address and FT4 account, specifically for EOA. (Where user has the private key)
entity evm_eoa_account_link {
    key address: byte_array;
    index ft4.accounts.account;
}

// for smart contracts we need to keep track of network_id
entity evm_sc_account_link {
    key address: byte_array, network_id: integer;
    index ft4.accounts.account;
}

entity proposed_evm_sc_account_link {
    key address: byte_array, network_id: integer;
    index ft4.accounts.account;
}

// potential account_id
entity pending_deposit {
    index sender_address: byte_array;
    network_id: integer;
    from_smart_contract: boolean;
    index recipient_id: byte_array;
    token: erc20_asset;
    index ft4.transfer_strategy.account_creation_transfer;
}

// link between ERC20 token and FT4 asset
entity erc20_asset {
    network_id: integer;
    token_address: byte_array; // contract address
    key network_id, token_address;
    bridge_mode;
    index ft4.assets.asset;
    key virtual_blockchain_rid: byte_array; // virtual blockchain RID derived from network_id and address
}

function register_erc20_asset(
    network_id: integer,
    token_address: byte_array,
    ft4.assets.asset,
    mode: bridge_mode
) {
    require(mode == bridge_mode.foreign, "native mode not supported yet");
    require(empty(erc20_asset @? { network_id, token_address }), "token already exists");
    create erc20_asset (
        network_id,
        token_address = token_address,
        mode,
        asset,
        virtual_blockchain_rid = compute_virtual_blockchain_rid(network_id, token_address)
    );
}

function compute_virtual_blockchain_rid(network_id: integer, token_address: byte_array): byte_array =
    ("EVM", network_id, token_address).hash();

function find_ft4_account_for_address(network_id: integer, address: byte_array): ft4.accounts.account? {
    val candidate = evm_eoa_account_link @? { address } .account;
    if (not empty(candidate)) {
        return candidate;
    } else {
        return evm_sc_account_link @? { address, network_id } .account;
    }
}

@extend(messaging.handle_evm_block)
function (evm_block: messaging.evm_block_message) {
    for (event in evm_block.events) {
        process_event(evm_block.network_id, evm_block.evm_block_height, evm_block.evm_block_hash, event);
    }
}

function process_link_event(network_id: integer, evm_block_height: integer, evm_block_hash: byte_array, event: messaging.event_data) {
    if (event.name != "LinkAccountID") return;

    val address = byte_array.from_gtv(event.indexed_values[0]);
    val account_id = byte_array.from_gtv(event.non_indexed_values[0]);
    val is_contract = boolean.from_gtv(event.non_indexed_values[1]);

    if (not is_contract) return; // we currently don't allow linking EOA using this method

    if (not empty(evm_sc_account_link @? { address, network_id })) {
        // can only link once
        return;
    }
    if (not empty(proposed_evm_sc_account_link @? { address, network_id })) {
        // can only propose once
        return;
    }

    val account = ft4.accounts.account @? { .id == account_id };
    if (empty(account)) {
        // we can't link to non-existent account
        return;
    }

    create proposed_evm_sc_account_link(address, network_id, account);
}

function process_deposit_event(network_id: integer, evm_block_height: integer, evm_block_hash: byte_array, event: messaging.event_data) {
    if (event.name != "DepositedERC20") return;

    val sender = byte_array.from_gtv(event.indexed_values[0]);
    val token_address = byte_array.from_gtv(event.indexed_values[1]);
    val amount = big_integer.from_gtv(event.non_indexed_values[0]);
    var beneficiary = byte_array.from_gtv(event.non_indexed_values[1]); // account_id

    // normally only smart contracts have non-zero beneficiary
    // given that it's just a flag which enable more complex account registration logic
    // it's OK if it's not 100% reliable - it only needs to be true in a specific case
    val deposit_from_smart_contract = beneficiary != (x"00".repeat(32));

    val erc20 = erc20_asset @? { network_id, token_address };
    if (erc20 == null) {
        log("deposit event bounced: ERC20 token not found");
        bounce_deposit_event(network_id, token_address, beneficiary, amount);
        return;
    }

    var ft4_account: ft4.accounts.account? = null;

    if (deposit_from_smart_contract) {
        ft4_account = ft4.accounts.account @? { .id == beneficiary };

        if (not empty(ft4_account)) {
            // we require explicit link to avoid unwanted deposits
            if (need_consent_on_deposit and empty(evm_sc_account_link @? { sender, network_id, ft4_account })) {
                bounce_deposit_event(network_id, token_address, beneficiary, amount);
                return;
            }
        }

    } else {
        // compute beneficiary account automatically
        ft4_account = find_ft4_account_for_address(sender);
        beneficiary = sender.hash();
    }

    if (empty(ft4_account)) {
        // create account_creation_transfer to allow the account to be registered later
        // note: we don't want to call create_on_transfer because it fails when requirements are not met.
        // we want to bounce instead

        val sender_blockchain_rid = erc20.virtual_blockchain_rid;
        val sender_id = beneficiary;
        val recipient_id = beneficiary;

        val rules = ft4.transfer_strategy.find_allowed_rules(
            from_chain = sender_blockchain_rid,
            from_id = sender_id,
            to_id = recipient_id,
            asset = erc20.asset,
            amount = amount
        );

        if (empty(rules)) {
            log("deposit event bounced: no rules found for transfer");
            bounce_deposit_event(network_id, token_address, beneficiary, amount);
            return;
        }

        if (not empty(pending_deposit @* { .sender_address == beneficiary })) {
            log("deposit event bounced: tokens has already been transferred to this recipient, and has not been claimed yet");
            bounce_deposit_event(network_id, token_address, beneficiary, amount);
            return;
        }

        bridge_increase_balance(ft4.transfer_strategy.ensure_pool_account(chain_context.blockchain_rid),
            erc20.asset, amount);

        val creation = create ft4.transfer_strategy.account_creation_transfer(
            op_context.transaction, op_index = op_context.op_index,
            sender_blockchain_rid, sender_id, recipient_id, erc20.asset, amount,
            rules = rules.to_gtv().to_bytes(),
            timestamp = ft4.utils.latest_time()
        );

        create pending_deposit(sender_address = sender, recipient_id, creation, erc20, network_id, deposit_from_smart_contract);
    } else {
        bridge_increase_balance(ft4_account, erc20.asset, amount);
    }
}

@extend(ft4.strategies.after_register_account)
function (ft4.accounts.account) {
    val pending = pending_deposit @* { .recipient_id == account.id };
    for (deposit in pending) {
        if (deposit.from_smart_contract) {
            create evm_sc_account_link(deposit.sender_address, deposit.network_id, account);
        } else {
            create evm_account_link(pending.sender_address, account);
        }

        // note: we don't need to call collect_pooled_assets here, because it's already done in the transfer strategy implementation
        delete deposit;
    }
}

// accounts might be linked explicitly (e.g. when account_id is not derived from EVM address)
function _link_evm_eoa_account(address: byte_array, account: ft4.accounts.account) {
    create evm_eoa_account_link(address, account);

    val pending = pending_deposit @* { .sender_address == address, .from_smart_contract == false };
    for (deposit in pending) {
        // there's a possibility that the account_id is different from address hash
        // collect funds from the pool account here
        collect_pooled_assets(account, recipient_id = deposit.recipient_id);
        delete deposit;
    }
}

function _link_evm_sc_account(address: byte_array, network_id: integer, account: ft4.accounts.account) {
    create evm_sc_account_link(address, network_id, account);

    val pending = pending_deposit @* { .sender_address == address, .from_smart_contract == true };
    for (deposit in pending) {
        // there's a possibility that the account_id is different from address hash
        // collect funds from the pool account here
        collect_pooled_assets(account, recipient_id = deposit.recipient_id);
        delete deposit;
    }
}

function collect_pooled_assets(ft4.accounts.account, recipient_id: byte_array) {
    for (account_creation_transfer in ft4.transfer_strategy.account_creation_transfer @* {
        recipient_id, .state == ft4.transfer_strategy.account_creation_state.pending
    }) {
        val pool_account = ft4.transfer_strategy.ensure_pool_account(chain_context.blockchain_rid);
        ft4.assets.Unsafe.transfer(
            pool_account,
            account,
            account_creation_transfer.asset,
            account_creation_transfer.amount);

        account_creation_transfer.state = ft4.transfer_strategy.account_creation_state.done;
        account_creation_transfer.final_tx_rid = op_context.transaction.tx_rid;
        account_creation_transfer.final_op_index = op_context.op_index;
    }
}

// return deposit if we cannot credit it to the account
function bounce_deposit_event(network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer) {
    emit_withdraw_event(network_id, token_address, beneficiary, amount);
}

function emit_withdraw_event(network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer) {
    val next_serial = common.event_counter.counter + 1;
    common.event_counter.counter = next_serial;

    create erc20_withdraw(
        serial = next_serial,
        network_id,
        token_address,
        beneficiary,
        amount
    );

    val withdraw_info = [
        next_serial.to_gtv(),
        network_id.to_gtv(),
        utils.to_32_byte_array(token_address).to_gtv(),
        utils.to_32_byte_array(beneficiary).to_gtv(),
        amount.to_gtv()
    ];

    op_context.emit_event("eif_event", withdraw_info.to_gtv());
}

// function which deducts balance from the account in a smart way:
//  * burn when bridge is in foreign mode
//  * transfer to pool account when bridge is in native mode
function bridge_deduct_balance(ft4.accounts.account, ft4.assets.asset, amount: big_integer) {
    ft4.assets.Unsafe.burn(account, asset, amount);
}

// function which increase balance of the account in a smart way:
//  * mint when bridge is in foreign mode
//  * transfer from pool account when bridge is in native mode
function bridge_increase_balance(ft4.accounts.account, ft4.assets.asset, amount: big_integer) {
    ft4.assets.Unsafe.mint(account, asset, amount);
}
