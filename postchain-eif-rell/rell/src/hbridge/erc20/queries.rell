query get_erc20_for_asset(asset_id: byte_array): list<erc20_info> {
    val asset = ft4.assets.Asset(asset_id);
    return erc20_asset @* { asset } (erc20_info(
        .network_id,
        .token_address,
        .bridge_mode,
        .virtual_blockchain_rid
    ));
}

/**
 * Returns the list of registered ERC20 assets by EVM network ID.
 *
 * @param network_id The ID of the EVM network.
 * @return A list of `erc20_info` objects.
 */
query get_registered_erc20_assets(network_id: integer): list<erc20_asset_info> {
    return erc20_asset @* { network_id } (map_erc20_asset_to_erc20_asset_info($));
}

/**
 * Returns the list of registered ERC20 assets by EVM network ID and bridge contract address.
 *
 * @param network_id The ID of the EVM network.
 * @param bridge_contract_address The bridge EVM contract address.
 * @return A list of `erc20_info` objects.
 */
query get_registered_bridge_erc20_assets(network_id: integer, bridge_contract_address: byte_array): list<erc20_asset_info> {
    return bridge_erc20_asset @* {
        .erc20_asset.network_id == network_id,
        .bridge_contract.contract_address == bridge_contract_address
    } (map_erc20_asset_to_erc20_asset_info(.erc20_asset));
}

// Snapshot queries

query are_snapshots_enabled_for_asset(asset_id: byte_array): boolean {
    val asset = ft4.assets.Asset(asset_id);
    return exists(erc20_asset_snapshots_enabled @? { asset });
}

query get_state_slot_ids_for_account(account_id: byte_array, network_id: integer): list<integer> {
    val account = ft4.accounts.Account(account_id);
    return local_erc20_state_slot_binding @* { account, .state_slot.network_id == network_id } (.state_slot.id);
}

query get_withdrawal_state_slot_ids_for_address(beneficiary: byte_array, network_id: integer): list<integer> {
    return core.state_slot @* {
        .recipient_address == beneficiary,
        .network_id == network_id,
        .type == state_slot_type.erc20_withdrawal,
        .local == true
    } (.id);
}

/**
 * Retrieves a list of bridge contracts associated with the specified EVM network ID,
 * including ERC20 assets associated with each bridge contract.
 *
 * @param network_id The ID of the EVM network.
 *
 * @return A list of `bridge_contract_info` objects containing the bridge `contract_address`, `evm_read_offset`,
 * and the list of ERC20 assets associated with each bridge contract.
 */
query get_bridge_contracts(network_id: integer): list<bridge_contract_info> {
    val read_offset = core.get_evm_read_offset(network_id);

    val res = list<bridge_contract_info>();
    for (bridge_contract_address in core.bridge_contract @* { network_id } ( .contract_address )) {
        val erc20_assets = get_registered_bridge_erc20_assets(network_id, bridge_contract_address);

        res.add(bridge_contract_info(
            contract_address = bridge_contract_address,
            evm_read_offset = read_offset,
            erc20_assets = erc20_assets,
        ));
    }

    return res;
}

/**
 * Retrieves information about a bridge contract based on its contract address.
 *
 * @param network_id The ID of the EVM network.
 * @param contract_address The contract address of the bridge contract.
 *
 * @return A `bridge_contract_info` object containing the bridge `contract_address`, `evm_read_offset`,
 * and the list of ERC20 assets associated with the bridge contract.
 */
query get_bridge_contract_info(network_id: integer, contract_address: byte_array): bridge_contract_info? {
    val bridge_contract = core.bridge_contract @? { network_id, contract_address } ($.to_struct());
    if (bridge_contract == null) return null;

    return bridge_contract_info(
        contract_address = bridge_contract.contract_address,
        evm_read_offset = core.get_evm_read_offset(bridge_contract.network_id),
        erc20_assets = get_registered_bridge_erc20_assets(bridge_contract.network_id, bridge_contract.contract_address)
    );
}
