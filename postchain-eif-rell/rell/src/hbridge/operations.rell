@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(link_evm_account).mount_name,
    flags = ["A"]
);

operation link_evm_account(address: byte_array) {
    val account = ft4.auth.authenticate();
    ft4.auth.verify_signers([address]);
    _link_evm_account(address, account);
}

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(bridge_ft4_token_to_evm).mount_name,
    flags = ["T"]
);

operation bridge_ft4_token_to_evm(network_id: integer, asset_id: byte_array, amount: big_integer, beneficiary: byte_array) {
    val ft4_asset = ft4.assets.Asset(asset_id);
    val erc20 = erc20_asset @? { .network_id == network_id, .asset == ft4_asset };
    require(erc20, "ERC20 token not found");

    val from_account = ft4.auth.authenticate();

    require(evm_account_link @? { .account == from_account, .address == beneficiary },
        "Can only withdraw to your own account");

    bridge_deduct_balance(from_account, erc20.asset, amount);

    emit_withdraw_event(erc20.network_id, erc20.token_address, beneficiary, amount);
}

// if account was not created, we can recall the deposit back to EVM
// note: we do not check authorization. after a time-out the deposit can be recalled by anyone,
// and it goes back to where it came from. this simplifies the flow
operation recall_pending_deposit(sender_address: byte_array) {
    val pending = pending_deposit @ { sender_address };

    val creation = pending.account_creation_transfer;

    val (asset, amount) = ft4.transfer_strategy.recall_transfer(
        creation.sender_blockchain_rid,
        creation.sender_id,
        creation.transaction.tx_rid, creation.op_index);

    bridge_deduct_balance(ft4.transfer_strategy.ensure_pool_account(chain_context.blockchain_rid), asset, amount);

    emit_withdraw_event(pending.token.network_id, pending.token.token_address, sender_address, amount);

    delete pending;
}
