@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(link_evm_eoa_account).mount_name,
    flags = ["A"]
);

operation link_evm_eoa_account(address: byte_array) {
    val account = ft4.auth.authenticate();
    ft4.auth.verify_signers([address]);
    _link_evm_eoa_account(address, account);
}

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(link_evm_sc_account).mount_name,
    flags = ["A"]
);

operation link_evm_sc_account(address: byte_array, network_id: integer) {
    val account = ft4.auth.authenticate();
    require(
        proposed_evm_sc_account_link @? { account, address, network_id },
        "Proposed EVM SC account link not found for EVM address %s on chain ID %d".format(address, network_id)
    );
    _link_evm_sc_account(address, network_id, account);
}

@extend(ft4.auth.auth_handler)
function () = ft4.auth.add_auth_handler(
    scope = rell.meta(bridge_ft4_token_to_evm).mount_name,
    flags = ["T"]
);

operation bridge_ft4_token_to_evm(network_id: integer, asset_id: byte_array, amount: big_integer, beneficiary: byte_array) {
    val ft4_asset = ft4.assets.Asset(asset_id);
    val erc20 = erc20_asset @? { .network_id == network_id, .asset == ft4_asset };
    require(erc20, "ERC20 token not found");

    val from_account = ft4.auth.authenticate();

    require(
        evm_eoa_account_link @? { from_account, beneficiary } ??
            or evm_sc_account_link @? { from_account, beneficiary, network_id } ??,
        "Can only withdraw to your own account"
    );

    bridge_deduct_balance(from_account, erc20.asset, amount);
    emit_withdrawal_event(erc20.network_id, erc20.token_address, beneficiary, amount);
}

// if account was not created, we can recall the deposit back to EVM
// note: we do not check authorization. after a time-out the deposit can be recalled by anyone,
// and it goes back to where it came from. this simplifies the flow
operation recall_pending_deposit(sender_address: byte_array) {
    val pending_deposits = erc20_deposit @* { sender_address, deposit_state.pending };
    for (deposit in pending_deposits) {
        val transfer = pending_erc20_deposit @ { deposit } ( .account_creation_transfer );
        val (asset, amount) = ft4.transfer_strategy.recall_transfer(
            transfer.sender_blockchain_rid, transfer.sender_id, transfer.transaction.tx_rid, transfer.op_index
        );

        bridge_deduct_balance(ft4.transfer_strategy.ensure_pool_account(chain_context.blockchain_rid), asset, amount);
        emit_withdrawal_event(deposit.token.network_id, deposit.token.token_address, sender_address, amount);

        update_deposit_state(deposit, deposit_state.recalled);
    }
}
