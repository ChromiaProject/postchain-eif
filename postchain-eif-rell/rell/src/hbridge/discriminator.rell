
function network_discriminator(network_id: integer): big_integer {
    return big_integer(network_id) * (2L).pow(160);
}

function network_contract_discriminator(network_id: integer, contract_address: byte_array): big_integer {
    val network_discriminator = big_integer(network_id) * (2L).pow(160);
    val contract_discriminator = big_integer.from_bytes_unsigned(contract_address);
    return network_discriminator + contract_discriminator;
}

@extend(snapshot.compute_erc20_asset_discriminator) function (snapshot.erc20_asset): big_integer? {
    if (chain_context.args.version == 1) {
        return network_discriminator(erc20_asset.network_id);
    }

    // Get primary bridge
    val primary_bridge = require(
        snapshot.bridge_erc20_asset @? { erc20_asset } ( @omit @sort .rowid, .bridge_contract.contract_address ) limit 1,
        "Bridge address for ERC-20 token %s not found on network ID %d".format(erc20_asset.token_address, erc20_asset.network_id)
    );
    return network_contract_discriminator(erc20_asset.network_id, primary_bridge);
}