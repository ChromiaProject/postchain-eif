
// hbridge:erc20_withdrawal:v1 followed by 7x 01 bytes, 32 bytes in total
val ERC20_WITHDRAWAL_STATE_TAG = x"686272696467653a65726332305f77697468647261773a763101010101010101";

function add_erc20_withdrawal_to_snapshot(ew: erc20_withdrawal) {
    val withdrawal_info = ew.to_struct();
    val asset = erc20_asset @? { .token_address == withdrawal_info.token_address, 
        .network_id == withdrawal_info.network_id };

    if (not exists(asset)) return;
    if (not exists(erc20_asset_snapshots_enabled @? { .erc20_asset == asset })) return;

    val network_id = withdrawal_info.network_id;
    val beneficiary = withdrawal_info.beneficiary;
    
    // Create state_slot as needed
    val discriminator = build_discriminator(asset);
    var state_slot = state_slot @? {
        .recipient_address == beneficiary,
        .type == state_slot_type.erc20_withdrawal,
        .network_id == network_id,
        .discriminator == discriminator,
        .local == true
    };
    
    if (empty(state_slot)) {
        state_slot = create state_slot (
            id = get_next_state_slot_id(),
            network_id,
            recipient_address = beneficiary,
            type = state_slot_type.erc20_withdrawal,
            discriminator = discriminator,
            local = true
        );
    }

    // Collect all withdrawals for a given address with status other than withdrawn
    val event_hashes = (
        w: erc20_withdrawal,
        s: erc20_withdrawal_status
    ) @* {
        w.beneficiary == beneficiary,
        w.network_id == network_id,
        s.erc20_withdrawal == w,
        s.withdrawal_status != withdrawal_status.withdrawn,
        s.withdrawal_status != withdrawal_status.withdrawn_to_chromia
    } ( w.event_hash );

    // Emit state
    emit_erc20_withdrawal_state_eif_event(state_slot, event_hashes);
}

function emit_erc20_withdrawal_state_eif_event(state_slot: state_slot, event_hashes: list<byte_array>) {
    val state_slot_data = state_slot.to_struct();
    val state_parts = list<gtv>();
    state_parts.add(ERC20_WITHDRAWAL_STATE_TAG.to_gtv());
    state_parts.add(utils.evm_address_to_32_byte_array(state_slot_data.recipient_address).to_gtv());
    state_parts.add(state_slot_data.discriminator.to_gtv()); // discriminator includes (v1) network_id, or (v2) network_id and bridge_address
    for (event_hash in event_hashes) {
        state_parts.add(event_hash.to_gtv());
    }
    op_context.emit_event(
        "eif_state",
        state_data(state_slot_data.id, state_parts).to_gtv()
    );
}
