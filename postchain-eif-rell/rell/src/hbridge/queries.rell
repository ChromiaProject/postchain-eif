
query get_erc20_for_asset(asset_id: byte_array): list<erc20_info> {
    val asset = ft4.assets.Asset(asset_id);
    return erc20_asset @* { asset } (erc20_info(
        .network_id,
        .token_address,
        .bridge_mode,
        .virtual_blockchain_rid
    ));
}

/**
 * @deprecated Use get_erc20_withdrawals()
 */
query get_erc20_withdrawal(network_id: integer, token_address: byte_array, beneficiary: byte_array): list<struct<erc20_withdraw>> =
    erc20_withdraw @* {
        network_id,
        token_address,
        beneficiary
    } (@sort_desc @omit .serial, $.to_struct());

/**
 * Retrieves ERC20 token withdrawals based on a given filter, with pagination options.
 *
 * @param filter The filter applied to the withdrawal search. See [withdrawal_filter] structure.
 * @param page_size The number of withdrawal records to return per page. Limited by the maximum page size defined in the chain configuration. If not specified, a maximum page size defined in the chain configuration is used.
 * @param page_cursor A cursor for pagination, typically pointing to the start of the next page of results. If not specified, the first page will be returned.
 * @return A `ft4.utils.paged_result` containing the filtered results and pagination data. This result includes data such as the list of withdrawals (see [erc20_withdrawal_info]), and the next page cursor (`next_cursor`). If `next_cursor` is null, there are no more pages to fetch.
 */
query get_erc20_withdrawals(filter: withdrawal_filter, page_size: integer?, page_cursor: text?): ft4.utils.paged_result {
    val before_rowid = ft4.utils.before_rowid(page_cursor);

    val paginated_result = erc20_withdraw @* {
        filter.network_id == null or .network_id == filter.network_id,
        filter.token_address == null or .token_address == filter.token_address,
        filter.beneficiary == null or .beneficiary == filter.beneficiary,
        filter.from == null or .timestamp >= filter.from!!,
        filter.to == null or .timestamp < filter.to!!,
        .rowid > (before_rowid ?: rowid(0))
    } (
        ft4.utils.pagination_result(
            data = map_withdrawal($).to_gtv_pretty(),
            rowid = .rowid
        )
    ) limit ft4.utils.fetch_data_size(page_size);

    return ft4.utils.make_page(paginated_result, page_size);
}

query get_account_for_eoa_address(evm_address: byte_array): byte_array? =
    evm_eoa_account_link @? { .address == evm_address } (.account.id);

query get_account_for_sc_address (evm_address: byte_array, network_id: integer): byte_array? =
    evm_sc_account_link @? { .address == evm_address, network_id } (.account.id);

query get_eoa_addresses_for_account(account_id: byte_array): list<byte_array> {
    val account = ft4.accounts.Account(account_id);
    return evm_eoa_account_link @* { account } (.address);
}

query get_sc_addresses_for_account(account_id: byte_array): list<(address: byte_array, network_id: integer)> {
    val account = ft4.accounts.Account(account_id);
    return evm_sc_account_link @* { account } (.address, .network_id);
}

/**
 * Returns paginated ERC-20 deposits
 *
 * @param network_id EVM network ID. If null, all networks are considered.
 * @param token_address EVM token address. If null, all token addresses are considered.
 * @param recipient_id EVM beneficiary address. If null, all recipient_id values are considered.
 */
query get_erc20_deposits(
    network_id: integer?,
    token_address: byte_array?,
    recipient_id: byte_array?,
    page_size: integer?,
    page_cursor: text?
): ft4.utils.paged_result {

    val before_rowid = ft4.utils.before_rowid(page_cursor);

    val paginated_result = erc20_deposit @* {
        network_id == null or .network_id == network_id,
        token_address == null or .token.token_address == token_address,
        recipient_id == null or .recipient_id == recipient_id,
        .rowid > (before_rowid ?: rowid(0))
    } (
        ft4.utils.pagination_result(
            data = map_deposit($).to_gtv_pretty(),
            rowid = .rowid
        )
    ) limit ft4.utils.fetch_data_size(page_size);

    return ft4.utils.make_page(paginated_result, page_size);
}

/**
 * Returns deposit's history
 *
 * @param deposit_id Deposit id
 */
query get_erc20_deposit_history(deposit_id: rowid): list<erc20_deposit_history_entry> {
    val deposit = require(erc20_deposit @? { .rowid == deposit_id }, "Deposit not found: " + deposit_id);

    val history = erc20_deposit_history @* { deposit } (
        @sort @omit .timestamp,
        erc20_deposit_history_entry(
            deposit_id = deposit.rowid.to_integer(),
            state = .state,
            timestamp = .timestamp
    ));

    history.add(erc20_deposit_history_entry(
        deposit_id = deposit.rowid.to_integer(),
        state = deposit.state,
        timestamp = deposit.last_updated
    ));

    return history;
}
