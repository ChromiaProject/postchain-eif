
query get_erc20_for_asset(asset_id: byte_array): list<erc20_info> {
    val asset = ft4.assets.Asset(asset_id);
    return erc20_asset @* { asset } (erc20_info(
        .network_id,
        .token_address,
        .bridge_mode,
        .virtual_blockchain_rid
    ));
}

/**
 * @deprecated Use get_erc20_withdrawals()
 */
query get_erc20_withdrawal(network_id: integer, token_address: byte_array, beneficiary: byte_array): list<struct<erc20_withdrawal>> =
    erc20_withdrawal @* {
        network_id,
        token_address,
        beneficiary
    } (@sort_desc @omit .serial, $.to_struct());

/**
 * Retrieves ERC20 token withdrawals based on a given filter, with pagination options.
 *
 * @param filter The filter applied to the withdrawal search. See [withdrawal_filter] structure.
 * @param page_size The number of withdrawal records to return per page. Limited by the maximum page size defined in the chain configuration. If not specified, a maximum page size defined in the chain configuration is used.
 * @param page_cursor A cursor for pagination, typically pointing to the start of the next page of results. If not specified, the first page will be returned.
 * @return A `ft4.utils.paged_result` containing the filtered results and pagination data. This result includes data such as the list of withdrawals (see [erc20_withdrawal_info]), and the next page cursor (`next_cursor`). If `next_cursor` is null, there are no more pages to fetch.
 */
query get_erc20_withdrawals(filter: withdrawal_filter, page_size: integer?, page_cursor: text?): ft4.utils.paged_result {
    val before_rowid = ft4.utils.before_rowid(page_cursor);

    val paginated_result = (
        w: erc20_withdrawal,
        s: erc20_withdrawal_status @* { .erc20_withdrawal == w }
    ) @* {
        filter.network_id == null or w.network_id == filter.network_id,
        filter.token_address == null or w.token_address == filter.token_address,
        filter.beneficiary == null or w.beneficiary == filter.beneficiary,
        filter.from == null or w.transaction.block.timestamp >= filter.from!!,
        filter.to == null or w.transaction.block.timestamp < filter.to!!,
        filter.tx_rid == null or w.transaction.tx_rid == filter.tx_rid!!,
        empty(filter.statuses) or s.withdrawal_status in filter.statuses!!,
        w.rowid > (before_rowid ?: rowid(0))
    } (
        ft4.utils.pagination_result(
            data = map_withdrawal(w, s.withdrawal_status).to_gtv_pretty(),
            rowid = w.rowid
        )
    ) limit ft4.utils.fetch_data_size(page_size);

    return ft4.utils.make_page(paginated_result, page_size);
}

/**
 * Retrieves ERC20 token withdrawal based on a transaction RID and operation index.
 *
 * @param tx_rid transaction RID in which the withdrawal was initiated
 * @param op_index index of the operation within the transaction in which the withdrawal was initiated
 */
query get_erc20_withdrawal_by_tx(tx_rid: byte_array, op_index: integer): erc20_withdrawal_info? =
        erc20_withdrawal @? { .transaction.tx_rid == tx_rid, op_index } ( map_withdrawal($) );

query get_erc20_withdrawal_by_event_hash(event_hash: byte_array): erc20_withdrawal_info? =
        erc20_withdrawal @? { .event_hash == event_hash } ( map_withdrawal($) );

query get_erc20_withdrawal_by_id(withdrawal_id: rowid): erc20_withdrawal_info? =
        erc20_withdrawal @? { .rowid == withdrawal_id } ( map_withdrawal($) );

query get_account_for_eoa_address(evm_address: byte_array): byte_array? =
        evm_eoa_account_link @? { .address == evm_address } (.account.id);

query get_account_for_sc_address(evm_address: byte_array, network_id: integer): byte_array? =
        evm_sc_account_link @? { .address == evm_address, network_id } (.account.id);

query get_eoa_addresses_for_account(account_id: byte_array): list<byte_array> {
    val account = ft4.accounts.Account(account_id);
    return evm_eoa_account_link @* { account } (.address);
}

query get_sc_addresses_for_account(account_id: byte_array): list<(address: byte_array, network_id: integer)> {
    val account = ft4.accounts.Account(account_id);
    return evm_sc_account_link @* { account } (.address, .network_id);
}


/**
 * Retrieves ERC20 token deposits based on a given filter, with pagination options.
 *
 * @param filter The filter applied to the deposit search. See [deposit_filter] structure.
 * @param page_size The number of deposit records to return per page. Limited by the maximum page size defined in the chain configuration. If not specified, a maximum page size defined in the chain configuration is used.
 * @param page_cursor A cursor for pagination, typically pointing to the start of the next page of results. If not specified, the first page will be returned.
 * @return A `ft4.utils.paged_result` containing the filtered results and pagination data. This result includes data such as the list of deposits (see [erc20_deposit_info]), and the next page cursor (`next_cursor`). If `next_cursor` is null, there are no more pages to fetch.
 */
query get_erc20_deposits(filter: deposit_filter, page_size: integer?, page_cursor: text?): ft4.utils.paged_result {
    val before_rowid = ft4.utils.before_rowid(page_cursor);

    val paginated_result = erc20_deposit @* {
        filter.network_id == null or .network_id == filter.network_id,
        filter.token_address == null or .token.token_address == filter.token_address,
        filter.recipient_id == null or .recipient_id == filter.recipient_id,
        filter.state == null or .state == filter.state,
        filter.evm_tx_hash == null or .evm_tx_hash == filter.evm_tx_hash,
        .rowid > (before_rowid ?: rowid(0))
    } (
        ft4.utils.pagination_result(
            data = map_deposit($).to_gtv_pretty(),
            rowid = .rowid
        )
    ) limit ft4.utils.fetch_data_size(page_size);

    return ft4.utils.make_page(paginated_result, page_size);
}

/**
 * Retrieves the history of an ERC20 deposit based on the specified deposit ID.
 *
 * @param deposit_id A `rowid` type identifier for the deposit.
 *
 * @return A list of `erc20_deposit_history_entry` objects, each representing a record in the
 * history of the specified deposit.
 */
query get_erc20_deposit_history(deposit_id: rowid): list<erc20_deposit_history_entry> {
    val deposit = require(erc20_deposit @? { .rowid == deposit_id }, "Deposit not found: " + deposit_id);

    val history = erc20_deposit_history @* { deposit } (
        @sort @omit .rowid,
        erc20_deposit_history_entry(
            deposit_id = deposit.rowid.to_integer(),
            state = .state,
            timestamp = .timestamp
    ));

    history.add(erc20_deposit_history_entry(
        deposit_id = deposit.rowid.to_integer(),
        state = deposit.state,
        timestamp = deposit.last_updated
    ));

    return history;
}

/**
 * Retrieves the history of an ERC20 withdrawal based on the specified withdrawal ID.
 *
 * @param withdrawal_id A `rowid` type identifier for the withdrawal.
 *
 * @return A list of `erc20_withdrawal_history_entry` objects, each representing a record in the
 * history of the specified withdrawal.
 */
query get_erc20_withdrawal_history(withdrawal_id: rowid): list<erc20_withdrawal_history_entry> {
    val withdrawal = require(erc20_withdrawal @? { .rowid == withdrawal_id }, "Withdrawal not found: " + withdrawal_id);

    val history = erc20_withdrawal_history @* { withdrawal } (
        @sort @omit .rowid,
        erc20_withdrawal_history_entry(
            withdrawal_id = withdrawal.rowid.to_integer(),
            status = .withdrawal_status,
            timestamp = .transaction.block.timestamp
        )
    );

    return history;
}

/**
 * Returns the list of registered ERC20 assets by EVM network ID.
 *
 * @param network_id The ID of the EVM network.
 * @return A list of `erc20_info` objects.
 */
query get_registered_erc20_assets(network_id: integer): list<erc20_asset_info> {
    return erc20_asset @* { network_id } (map_erc20_asset_to_erc20_asset_info($));
}

/**
 * Returns the list of registered ERC20 assets by EVM network ID and bridge contract address.
 *
 * @param network_id The ID of the EVM network.
 * @param bridge_contract_address The bridge EVM contract address.
 * @return A list of `erc20_info` objects.
 */
query get_registered_bridge_erc20_assets(network_id: integer, bridge_contract_address: byte_array): list<erc20_asset_info> {
    return bridge_erc20_asset @* {
        .erc20_asset.network_id == network_id,
        .bridge_contract.contract_address == bridge_contract_address
    } (map_erc20_asset_to_erc20_asset_info(.erc20_asset));
}

// Snapshot queries

query are_snapshots_enabled_for_asset(asset_id: byte_array): boolean {
    val asset = ft4.assets.Asset(asset_id);
    return exists(erc20_asset_snapshots_enabled @? { asset });
}

query get_state_slot_ids_for_account(account_id: byte_array, network_id: integer): list<integer> {
    val account = ft4.accounts.Account(account_id);
    return local_erc20_state_slot_binding @* { account, .state_slot.network_id == network_id } (.state_slot.id);
}

query get_withdrawal_state_slot_ids_for_address(beneficiary: byte_array, network_id: integer): list<integer> {
    return state_slot @* {
        .recipient_address == beneficiary,
        .network_id == network_id,
        .type == state_slot_type.erc20_withdrawal,
        .local == true
    } (.id);
}

query get_state_slot_ids_for_address(beneficiary: byte_array, network_id: integer): list<integer> {
    return state_slot @* { beneficiary, network_id } (.id);
}

query get_recovery_contract(blockchain_rid: byte_array, network_id: integer): byte_array? {
    return recovery_contract @? { blockchain_rid, network_id } .contract_address;
}

/**
 * Retrieves a list of bridge contracts associated with the specified EVM network ID,
 * including ERC20 assets associated with each bridge contract.
 *
 * @param network_id The ID of the EVM network.
 *
 * @return A list of `bridge_contract_info` objects containing the bridge `contract_address`, `evm_read_offset`,
 * and the list of ERC20 assets associated with each bridge contract.
 */
query get_bridge_contracts(network_id: integer): list<bridge_contract_info> {
    val read_offset = map<text, integer>.from_gtv_pretty(chain_context.args.evm_read_offsets).get_or_null("%d".format(network_id));

    val res = list<bridge_contract_info>();
    for (bridge_contract_address in bridge_contract @* { network_id } ( .contract_address )) {
        val erc20_assets = get_registered_bridge_erc20_assets(network_id, bridge_contract_address);

        res.add(bridge_contract_info(
            contract_address = bridge_contract_address,
            evm_read_offset = read_offset ?: 0,
            erc20_assets = erc20_assets,
        ));
    }

    return res;
}
