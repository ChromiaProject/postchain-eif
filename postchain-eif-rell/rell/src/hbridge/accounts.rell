@extend(ft4.strategies.after_register_account) function (ft4.accounts.account) {
    val pending_deposits = erc20_deposit @* { .recipient_id == account.id, deposit_state.pending };
    for (deposit in pending_deposits) {
        snapshot.core._link_evm_account_if_not_linked(deposit.network_id, deposit.sender_address, deposit.from_smart_contract, account);

        // Note: we don't need to call collect_pooled_assets here, because it's already done in the transfer strategy implementation
        update_deposit_state(deposit, deposit_state.completed);
    }
}

@extend(snapshot.core.after_evm_account_linked) function (address: byte_array, ft4.accounts.account, network_id: integer, is_contract: boolean) {
    val pending_deposits = erc20_deposit @* { .sender_address == address, deposit_state.pending, .from_smart_contract == is_contract };
    for (deposit in pending_deposits) {
        update_deposit_state(deposit, deposit_state.completed);
    }
}

