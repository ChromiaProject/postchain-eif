
// withdrawal from EVM to FT4
entity erc20_withdraw {
    key serial: integer;
    network_id: integer;
    token_address: byte_array;
    index network_id, token_address;
    index beneficiary: byte_array;
    amount: big_integer;
    timestamp;
}

struct erc20_withdrawal_info {
    serial: integer;
    network_id: integer;
    token_address: byte_array;
    beneficiary: byte_array;
    amount: big_integer;
    timestamp;
}

/**
 * Withdrawal filter for get_erc20_withdrawals()
 *
 * @param network_id EVM network ID. If null, all networks are considered.
 * @param token_address EVM token address. If null, all token addresses are considered.
 * @param beneficiary EVM beneficiary address. If null, all beneficiaries are considered.
 * @param from marks the beginning of a time interval. If not null, withdrawals occurring before `from` are excluded.
 * @param to marks the end of a time interval. If not null, withdrawals occurring after `to` are excluded.
 */
struct withdrawal_filter {
    network_id: integer? = null;
    token_address: byte_array? = null;
    beneficiary: byte_array? = null;
    from: timestamp? = null;
    to: timestamp? = null;
}

function map_withdrawal(withdrawal: erc20_withdraw) = erc20_withdrawal_info(
    serial = withdrawal.serial,
    network_id = withdrawal.network_id,
    token_address = withdrawal.token_address,
    beneficiary = withdrawal.beneficiary,
    amount = withdrawal.amount,
    timestamp = withdrawal.timestamp,
);
