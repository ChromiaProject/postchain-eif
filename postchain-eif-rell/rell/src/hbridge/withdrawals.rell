
@log entity erc20_withdrawal {
    op_index: integer = op_context.op_index;
    index transaction, op_index;

    key serial: integer;
    network_id: integer;
    token_address: byte_array;
    index network_id, token_address;
    index beneficiary: byte_array;
    amount: big_integer;
    index event_hash: byte_array;
}

@log entity erc20_withdrawal_history {
    op_index: integer = op_context.op_index;
    index transaction, op_index;

    key erc20_withdrawal;
    withdrawal_status;
}

/**
    +-----------------------------------+---------------------------------+
    |             Chromia               |               EVM               |
    +-----------------------------------+---------------------------------+
    | created                           |                                 |
    | requested                         |  Withdrawable                   |
    | pending <-> requested             |  Pending <-> Withdrawable       |
    | withdrawn | withdrawn_to_chromia  |  Withdrawn | PostchainWithdrawn |
    +-----------------------------------+---------------------------------+
 */
enum withdrawal_status {
    created,
    requested,
    pending,
    withdrawn,
    withdrawn_to_chromia,
}

struct erc20_withdrawal_info {
    serial: integer;
    network_id: integer;
    token_address: byte_array;
    beneficiary: byte_array;
    amount: big_integer;
    timestamp;
    event_hash: byte_array;
    status: withdrawal_status;
}

/**
 * Withdrawal filter for get_erc20_withdrawals()
 *
 * @property network_id EVM network ID. If null, all networks are considered.
 * @property token_address EVM token address. If null, all token addresses are considered.
 * @property beneficiary EVM beneficiary address. If null, all beneficiaries are considered.
 * @property from marks the beginning of a time interval. If not null, withdrawals occurring before `from` are excluded.
 * @property to marks the end of a time interval. If not null, withdrawals occurring at `to` and after `to` are excluded.
 * @property tx_rid transaction RID in which the withdrawals were initiated
 * @property statuses withdrawal status list. If null or empty, all status are considered.
 */
struct withdrawal_filter {
    network_id: integer? = null;
    token_address: byte_array? = null;
    beneficiary: byte_array? = null;
    from: timestamp? = null;
    to: timestamp? = null;
    tx_rid: byte_array? = null;
    statuses: list<withdrawal_status>? = null;
}

function map_withdrawal(withdrawal: erc20_withdrawal) = erc20_withdrawal_info(
    serial = withdrawal.serial,
    network_id = withdrawal.network_id,
    token_address = withdrawal.token_address,
    beneficiary = withdrawal.beneficiary,
    amount = withdrawal.amount,
    timestamp = withdrawal.transaction.block.timestamp,
    event_hash = withdrawal.event_hash,
    status = erc20_withdrawal_history @ { withdrawal } (@omit @sort_desc .rowid, .withdrawal_status) limit 1,
);

function update_withdrawal_status(withdrawal_event_hash: byte_array, status: withdrawal_status) {
    val withdrawal = erc20_withdrawal @? { .event_hash == withdrawal_event_hash };
    if (empty(withdrawal)) {
        log("Withdrawal event with hash %s not found".format(withdrawal_event_hash));
        return;
    }

    create erc20_withdrawal_history(
        erc20_withdrawal = withdrawal,
        withdrawal_status = status
    );
}
