struct link_account_id_event {
    sender: byte_array;
    account_id: byte_array;
    is_contract: boolean;
}

function create_link_account_id_event(event: messaging.event_data) = link_account_id_event(
    sender = byte_array.from_gtv(event.indexed_values[0]),
    account_id = byte_array.from_gtv(event.non_indexed_values[0]),
    is_contract = boolean.from_gtv(event.non_indexed_values[1])
);

struct deposited_erc20_event {
    sender: byte_array;
    token_address: byte_array;
    amount: big_integer;
    beneficiary: byte_array; // account_id
    evm_tx_hash: byte_array;
}

function create_deposited_erc20_event(event: messaging.event_data) = deposited_erc20_event(
    sender = byte_array.from_gtv(event.indexed_values[0]),
    token_address = byte_array.from_gtv(event.indexed_values[1]),
    amount = big_integer.from_gtv(event.non_indexed_values[0]),
    beneficiary = byte_array.from_gtv(event.non_indexed_values[1]),
    evm_tx_hash = event.tnx_hash,
);

function create_withdrawal_event(event: messaging.event_data) = withdrawal_event(
    hash = byte_array.from_gtv(event.indexed_values[0]),
);

struct withdrawal_event {
    hash: byte_array;
}

@extend(messaging.handle_evm_block)
function (evm_block: messaging.evm_block_message) {
    for (event in evm_block.events) {
        when (event.name) {
            // deposit
            "LinkAccountID" -> process_link_account_event(evm_block.network_id, create_link_account_id_event(event));
            "DepositedERC20" -> process_deposit_erc20_event(evm_block.network_id, create_deposited_erc20_event(event));
            // withdrawal
            "PendingWithdraw" -> process_pending_withdraw_event(evm_block.network_id, create_withdrawal_event(event));
            "UnpendingWithdraw" -> process_unpending_withdraw_event(evm_block.network_id, create_withdrawal_event(event));
            "WithdrawRequestHash" -> process_withdraw_request_event(evm_block.network_id, create_withdrawal_event(event));
            "WithdrawalHash" -> process_withdrawal_event(evm_block.network_id, create_withdrawal_event(event));
            "WithdrawalToPostchain" -> process_withdrawal_to_postchain_event(evm_block.network_id, create_withdrawal_event(event));
        }
    }
}

function process_link_account_event(network_id: integer, event: link_account_id_event) {
    if (not event.is_contract) return; // we currently don't allow linking EOA using this method

    if (not empty(evm_sc_account_link @? { event.sender, network_id })) {
        // can only link once
        return;
    }
    if (not empty(proposed_evm_sc_account_link @? { event.sender, network_id })) {
        // can only propose once
        return;
    }

    val account = ft4.accounts.account @? { .id == event.account_id };
    if (empty(account)) {
        // we can't link to non-existent account
        return;
    }

    create proposed_evm_sc_account_link(event.sender, network_id, account);
}

function process_deposit_erc20_event(network_id: integer, event: deposited_erc20_event) {
    // normally only smart contracts have non-zero beneficiary
    // given that it's just a flag which enable more complex account registration logic
    // it's OK if it's not 100% reliable -- it only needs to be true in a specific case
    var beneficiary = event.beneficiary;
    val deposit_from_smart_contract = beneficiary != zero_beneficiary;

    val erc20 = erc20_asset @? { network_id, .token_address == event.token_address };
    if (erc20 == null) {
        log("Deposit event bounced: ERC20 token %s not found".format(event.token_address));
        bounce_deposit_event(network_id, event.token_address, event.sender, event.amount);
        return;
    }

    if (event.amount <= 0) {
        log("Deposit event ignored: amount must be greater than 0: ERC20 token %s, sender %s".format(event.token_address, event.sender));
        return;
    }

    var ft4_account: ft4.accounts.account? = null;
    if (deposit_from_smart_contract) {
        ft4_account = ft4.accounts.account @? { .id == beneficiary };

        if (not empty(ft4_account)) {
            // we require explicit link to avoid unwanted deposits
            if (need_consent_on_deposit and empty(evm_sc_account_link @? { event.sender, network_id, ft4_account })) {
                bounce_deposit_event(network_id, event.token_address, event.sender, event.amount);
                return;
            }
        }

    } else {
        // compute beneficiary account automatically
        ft4_account = find_ft4_account_for_address(event.sender, network_id);
        beneficiary = event.sender.hash();
    }

    val sender_id = beneficiary;
    val recipient_id = beneficiary;

    if (empty(ft4_account)) {
        // create account_creation_transfer to allow the account to be registered later
        // note: we don't want to call create_on_transfer because it fails when requirements are not met.
        // we want to bounce instead

        val sender_blockchain_rid = erc20.virtual_blockchain_rid;
        val rules = ft4.transfer_strategy.find_allowed_rules(
            from_chain = sender_blockchain_rid,
            from_id = sender_id,
            to_id = recipient_id,
            asset = erc20.asset,
            amount = event.amount
        );

        if (empty(rules)) {
            log("Deposit event bounced: no rules found for transfer");
            bounce_deposit_event(network_id, event.token_address, event.sender, event.amount);
            return;
        }

        if (not deposit_from_smart_contract and exists(erc20_deposit @* { .recipient_id == recipient_id, erc20 })) {
            log("Deposit event bounced: tokens has already been transferred from EOA account to this recipient, and has not been claimed yet");
            bounce_deposit_event(network_id, event.token_address, event.sender, event.amount);
            return;
        }

        bridge_increase_balance(
            ft4.transfer_strategy.ensure_pool_account(chain_context.blockchain_rid), erc20.asset, event.amount);

        val deposit = create erc20_deposit(
            sender_address = event.sender,
            network_id,
            deposit_from_smart_contract,
            recipient_id,
            erc20,
            event.amount,
            deposit_state.pending,
            last_updated = op_context.last_block_time,
            evm_tx_hash = event.evm_tx_hash,
        );

        val creation = ft4.transfer_strategy.pool_assets_with_rules(
            sender_blockchain_rid = sender_blockchain_rid,
            sender_id = sender_id,
            recipient_id = recipient_id,
            asset = erc20.asset,
            amount = event.amount,
            rules = rules
        );

        create pending_erc20_deposit(deposit, creation);

    } else {

        create erc20_deposit(
            sender_address = event.sender,
            network_id,
            deposit_from_smart_contract,
            recipient_id,
            erc20,
            event.amount,
            deposit_state.completed,
            last_updated = op_context.last_block_time,
            evm_tx_hash = event.evm_tx_hash,
        );

        bridge_increase_balance(ft4_account, erc20.asset, event.amount);
    }
}

function process_pending_withdraw_event(network_id: integer, event: withdrawal_event) {
    update_withdrawal_status(event.hash, withdrawal_status.pending);
}

function process_unpending_withdraw_event(network_id: integer, event: withdrawal_event) {
    update_withdrawal_status(event.hash, withdrawal_status.requested);
}

function process_withdraw_request_event(network_id: integer, event: withdrawal_event) {
    update_withdrawal_status(event.hash, withdrawal_status.requested);
}

function process_withdrawal_event(network_id: integer, event: withdrawal_event) {
    update_withdrawal_status(event.hash, withdrawal_status.withdrawn);
}

function process_withdrawal_to_postchain_event(network_id: integer, event: withdrawal_event) {
    update_withdrawal_status(event.hash, withdrawal_status.withdrawn_to_chromia);
}

// return deposit if we cannot credit it to the account
function bounce_deposit_event(network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer) {
    emit_withdrawal_event(network_id, token_address, beneficiary, amount);
}

function emit_withdrawal_event(network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer) {
    val next_serial = common.event_counter.counter + 1;
    common.event_counter.counter = next_serial;

    val event_hash = calculate_withdrawal_event_evm_hash(
        next_serial,
        network_id,
        token_address,
        beneficiary,
        amount
    );

    val withdrawal = create erc20_withdrawal(
        serial = next_serial,
        network_id,
        token_address,
        beneficiary,
        amount,
        timestamp = op_context.last_block_time,
        event_hash
    );

    update_withdrawal_status(event_hash, withdrawal_status.created);

    add_erc20_withdrawal_to_snapshot(withdrawal);

    val withdraw_info = [
        next_serial.to_gtv(),
        network_id.to_gtv(),
        utils.evm_address_to_32_byte_array(token_address).to_gtv(),
        utils.evm_address_to_32_byte_array(beneficiary).to_gtv(),
        amount.to_gtv()
    ];

    op_context.emit_event("eif_event", withdraw_info.to_gtv());
}

function calculate_withdrawal_event_evm_hash(
    serial: integer,
    network_id: integer,
    token_address: byte_array,
    beneficiary: byte_array,
    amount: big_integer
): byte_array {

    val data = utils.integer_to_32_byte_array(serial)
        + utils.integer_to_32_byte_array(network_id)
        + utils.evm_address_to_32_byte_array(token_address)
        + utils.evm_address_to_32_byte_array(beneficiary)
        + utils.big_integer_to_32_byte_array(amount);

    return crypto.keccak256(data);
}
