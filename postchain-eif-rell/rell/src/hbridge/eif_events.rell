
function emit_withdrawal_event(network_id: integer, token_address: byte_array, beneficiary: byte_array, amount: big_integer, bridge_address: byte_array = x"") {
    val next_serial = common.event_counter.counter + 1;
    common.event_counter.counter = next_serial;

    val (event_gtv, event_hash) = if (chain_context.args.version == 2)
        pack_withdrawal_event_v2(next_serial, network_id, token_address, beneficiary, bridge_address, amount)
    else
        pack_withdrawal_event_v1(next_serial, network_id, token_address, beneficiary, amount);

    val withdrawal = create erc20_withdrawal(
        serial = next_serial,
        network_id,
        token_address,
        beneficiary,
        bridge_address,
        amount,
        timestamp = op_context.last_block_time,
        event_hash
    );

    update_withdrawal_status(event_hash, withdrawal_status.created);
    add_erc20_withdrawal_to_snapshot(withdrawal);

    op_context.emit_event("eif_event", event_gtv);
}

function pack_withdrawal_event_v1(
    serial: integer,
    network_id: integer,
    token_address: byte_array,
    beneficiary: byte_array,
    amount: big_integer
): (gtv, byte_array) {

    val event = [
        serial.to_gtv(),
        network_id.to_gtv(),
        utils.evm_address_to_32_byte_array(token_address).to_gtv(),
        utils.evm_address_to_32_byte_array(beneficiary).to_gtv(),
        amount.to_gtv()
    ].to_gtv();

    val data = utils.integer_to_32_byte_array(serial)
        + utils.integer_to_32_byte_array(network_id)
        + utils.evm_address_to_32_byte_array(token_address)
        + utils.evm_address_to_32_byte_array(beneficiary)
        + utils.big_integer_to_32_byte_array(amount);
    val hash = crypto.keccak256(data);

    return (event, hash);
}

function pack_withdrawal_event_v2(
    serial: integer,
    network_id: integer,
    token_address: byte_array,
    beneficiary: byte_array,
    bridge_address: byte_array,
    amount: big_integer
): (gtv, byte_array) {

    val discriminator = network_contract_discriminator(network_id, bridge_address);

    val event = [
        serial.to_gtv(),
        discriminator.to_gtv(),
        utils.evm_address_to_32_byte_array(token_address).to_gtv(),
        utils.evm_address_to_32_byte_array(beneficiary).to_gtv(),
        amount.to_gtv()
    ].to_gtv();

    val data = utils.integer_to_32_byte_array(serial)
        + utils.big_integer_to_32_byte_array(discriminator)
        + utils.evm_address_to_32_byte_array(token_address)
        + utils.evm_address_to_32_byte_array(beneficiary)
        + utils.big_integer_to_32_byte_array(amount);
    val hash = crypto.keccak256(data);

    return (event, hash);
}
