module;

import ^^.lib.icmf.constants. { ICMF_TOPIC_GLOBAL_PREFIX };

val evm_block_events_topic = ICMF_TOPIC_GLOBAL_PREFIX + "evm_block_events";

struct evm_block_message {
    network_id: integer;
    evm_block_height: integer;
    evm_block_hash: byte_array;
    events: list<event_data>;
}

struct event_data {
    tnx_hash: byte_array;
    log_index: integer;
    signature: byte_array;
    contract_address: byte_array;
    name: text;
    indexed_values: list<gtv>;
    non_indexed_values: list<gtv>;
}
