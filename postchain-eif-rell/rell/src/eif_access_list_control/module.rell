module;

import hbridge: ^.hbridge;

@extend(hbridge.deposit_check_access_list)
function deposit_check_access_list(account_id: byte_array): boolean {
    return check_access_list(account_id);
}

@extend(hbridge.withdraw_check_access_list)
function withdraw_check_access_list(account_id: byte_array): boolean {
    return check_access_list(account_id);
}

function check_access_list(account_id: byte_array): boolean {
    if (state.access_mode == access_mode.blacklist) {
        return blacklist @ { account_id } ( @sum 1 ) == 0;
    }
    if (state.access_mode == access_mode.whitelist) {
        return whitelist @ { account_id } ( @sum 1 ) > 0;
    }
    return true;
}

enum access_mode {
    blacklist,
    whitelist
}

entity blacklist {
    key account_id: byte_array;
}

entity whitelist {
    key account_id: byte_array;
}

object state {
    mutable access_mode: access_mode = access_mode.blacklist;
}

operation add_blacklist_account_id(account_id: byte_array) {
    require_auth();
    require(blacklist @? { account_id } == null, "The account id %s is already blacklisted.".format(account_id));
    create blacklist ( account_id );
    create blacklist_history ( account_id, action.add, op_context.block_height );
}

operation remove_blacklist_account_id(account_id: byte_array) {
    require_auth();
    require(blacklist @? { account_id } != null, "The account id %s is not blacklisted.".format(account_id));
    delete blacklist @? { account_id };
    create blacklist_history ( account_id, action.remove, op_context.block_height );
}

operation add_whitelist_account_id(account_id: byte_array) {
    require_auth();
    require(whitelist @? { account_id } == null, "The account id %s is already whitelisted.".format(account_id));
    create whitelist ( account_id );
    create whitelist_history ( account_id, action.add, op_context.block_height );
}

operation remove_whitelist_account_id(account_id: byte_array) {
    require_auth();
    require(whitelist @? { account_id } != null, "The account id %s is not whitelisted.".format(account_id));
    delete whitelist @? { account_id };
    create whitelist_history ( account_id, action.remove, op_context.block_height );
}

operation set_access_mode(access_mode: access_mode) {
    require_auth();
    state.access_mode = access_mode;
}

query is_account_allowed_to_deposit(account_id: byte_array): boolean {
    return deposit_check_access_list(account_id);
}

query is_account_allowed_to_withdraw(account_id: byte_array): boolean {
    return withdraw_check_access_list(account_id);
}

@extendable
function require_auth();

@log entity blacklist_history {
    op_index: integer = op_context.op_index;
    index transaction, op_index;

    index account_id: byte_array;
    action;
}

entity whitelist_history {
    account_id: byte_array;
    action;
    block_height: integer;
}

enum action {
    add,
    remove
}
