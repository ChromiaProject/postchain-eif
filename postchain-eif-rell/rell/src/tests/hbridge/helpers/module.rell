module;

import lib.ft4.assets;
import lib.hbridge.*;

operation register_erc20_asset_op(
    network_id: integer,
    token_address: byte_array,
    assets.asset,
    bridge_mode,
    enable_snapshots: boolean
) {
    erc20.register_erc20_asset(network_id, token_address, asset, bridge_mode, enable_snapshots);
}

operation register_bridge_and_erc20_asset_op(
    network_id: integer,
    token_address: byte_array,
    assets.asset,
    mode: bridge_mode,
    use_snapshots: boolean = false,
    bridge_contract_address: byte_array
) {
    erc20.register_bridge_and_erc20_asset(network_id, token_address, asset, mode, use_snapshots, bridge_contract_address, 0);
}

operation register_bridge_with_erc20_assets_op(network_id: integer, bridge_contract_address: byte_array, skip_to_height: integer, erc20_assets: list<erc20.erc20_asset>) {
    erc20.register_bridge_with_erc20_assets(network_id, bridge_contract_address, skip_to_height, erc20_assets);
}

operation unregister_bridge_op(network_id: integer, bridge_contract_address: byte_array) {
    core.unregister_bridge(network_id, bridge_contract_address);
}

operation get_or_create_bridge_op(
    network_id: integer, bridge_contract_address: byte_array
) {
    core.get_or_create_bridge(network_id, bridge_contract_address, 0);
}

operation create_bridge_account_op(blockchain_rid: byte_array) {
    core.ensure_bridge_account(blockchain_rid);
}

// ICCF proof mock operation to use in cross-chain tests
operation iccf_proof(
    blockchain_rid: byte_array,
    tx_hash: byte_array,
    tx_proof: byte_array,
    tx_data: byte_array,
    tx_index: integer,
    anchoring_proof: byte_array
) {}

// NOTE: Non-camel case is necessary to decode properly
struct confirmation_proof {
    hash: byte_array;
    blockHeader: byte_array;
    witness: byte_array;
    merkleProofTree: list<gtv>;
    txIndex: integer;
}

struct block_header {
    blockchain_rid: byte_array;
    previous_block_rid: byte_array;
    merkle_root_hash: byte_array;
    timestamp: integer;
    height: integer;
    dependencies: gtv; // Can be either GtvNull or GtvArray
    extra: map<text,gtv>;
}

function mock_blockheader_bytes(blockchain_rid: byte_array, height: integer = 0) = block_header(
    blockchain_rid = blockchain_rid,
    previous_block_rid = x"",
    merkle_root_hash = x"",
    timestamp = 0,
    height = height,
    dependencies = null.to_gtv(),
    extra = ["merkle_hash_version" : (2).to_gtv()] // TODO: why it only works with 2?
).to_gtv().to_bytes();

function mock_confirmation_proof_bytes(blockchain_rid: byte_array = x"", height: integer = 0, tx_index: integer = 0) = confirmation_proof(
    hash = x"",
    blockHeader = mock_blockheader_bytes(blockchain_rid, height),
    witness = x"",
    merkleProofTree = list<gtv>(),
    txIndex = tx_index
).to_gtv_pretty().to_bytes();


@mount("register_recovery_contract")
operation register_recovery_contract_op(network_id: integer, contract_address: byte_array) {}
