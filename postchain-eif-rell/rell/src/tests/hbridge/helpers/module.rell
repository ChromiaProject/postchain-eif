module;

import lib.ft4.assets;
import hbridge;

operation register_erc20_asset_op(
    network_id: integer,
    token_address: byte_array,
    assets.asset,
    hbridge.bridge_mode,
    enable_snapshots: boolean
) {
    hbridge.register_erc20_asset(network_id, token_address, asset, bridge_mode, enable_snapshots);
}

operation register_bridge_and_erc20_asset_op(
    network_id: integer,
    token_address: byte_array,
    assets.asset,
    mode: hbridge.bridge_mode,
    use_snapshots: boolean = false,
    bridge_contract_address: byte_array
) {
    hbridge.register_bridge_and_erc20_asset(network_id, token_address, asset, mode, use_snapshots, bridge_contract_address);
}

operation register_bridge_with_erc20_assets_op(network_id: integer, bridge_contract_address: byte_array, erc20_assets: list<hbridge.erc20_asset>) {
    hbridge.register_bridge_with_erc20_assets(network_id, bridge_contract_address, erc20_assets);
}

operation get_or_create_bridge_op(
    network_id: integer, bridge_contract_address: byte_array
) {
    hbridge.get_or_create_bridge(network_id, bridge_contract_address);
}

operation create_bridge_account_op(blockchain_rid: byte_array) {
    hbridge.ensure_bridge_account(blockchain_rid);
}

// ICCF proof mock operation to use in cross-chain tests
operation iccf_proof(
    blockchain_rid: byte_array,
    tx_hash: byte_array,
    tx_proof: byte_array,
    tx_data: byte_array,
    tx_index: integer,
    anchoring_proof: byte_array
) {}

// NOTE: Non-camel case is necessary to decode properly
struct confirmation_proof {
    hash: byte_array;
    blockHeader: byte_array;
    witness: byte_array;
    merkleProofTree: list<gtv>;
    txIndex: integer;
}

function mock_confirmation_proof_bytes() = confirmation_proof(
    hash = x"",
    blockHeader = x"",
    witness = x"",
    merkleProofTree = list<gtv>(),
    txIndex = 0
).to_gtv_pretty().to_bytes();

