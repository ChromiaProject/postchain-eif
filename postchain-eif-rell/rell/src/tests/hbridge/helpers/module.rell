module;

import lib.ft4.assets;
import hbridge;

operation register_erc20_asset_op(
    network_id: integer,
    token_address: byte_array,
    assets.asset,
    hbridge.bridge_mode,
    enable_snapshots: boolean
) {
    hbridge.register_erc20_asset(network_id, token_address, asset, bridge_mode, enable_snapshots);
}
