import hbridge.*;

function test_get_erc20_withdrawals() {
    // FT4 assets
    val chr_asset = register_foreign_asset(CHR);
    val foo_asset = register_foreign_asset(FOO);
    val bar_asset = register_foreign_asset(BAR, network_id2);

    // FT4 / Alice
    val (alice_account, alice_auth_descriptor) = create_ft4_account(rell.test.pubkeys.alice);
    // EVM / Alice
    val alice_evm_keypair = rell.test.keypairs.eve;
    val alice_evm_address = crypto.eth_pubkey_to_address(alice_evm_keypair.pub);
    val alice_evm_deposit_receipient_id = alice_evm_address.hash();

    // FT4 / Bob
    val (bob_account, bob_auth_descriptor) = create_ft4_account(rell.test.pubkeys.bob);
    // EVM / Bob
    val bob_evm_keypair = rell.test.keypairs.dave;
    val bob_evm_address = crypto.eth_pubkey_to_address(bob_evm_keypair.pub);
    val bob_evm_deposit_receipient_id = bob_evm_address.hash();

    // Linking EVM and FT4 accounts for Alice and Bob
    link_eoa_account(alice_evm_keypair, rell.test.keypairs.alice, alice_account.id, alice_auth_descriptor.hash());
    link_eoa_account(bob_evm_keypair, rell.test.keypairs.bob, bob_account.id, bob_auth_descriptor.hash());

    // Minting some for Alice and Bob
    val minted = 10000L;
    rell.test.tx().op(
        admin.external.mint(alice_account.id, chr_asset.id, minted),
        admin.external.mint(alice_account.id, foo_asset.id, minted),
        admin.external.mint(bob_account.id, foo_asset.id, minted),
        admin.external.mint(bob_account.id, bar_asset.id, minted),
    ).sign(admin_privkey).run();

    // Asserting that there are no withdrawals
    val res0 = get_erc20_withdrawals(withdrawal_filter(), null, null);
    assert_equals(res0, ft4_utils.null_page());

    // Withdrawing some to EVM
    withdraw(rell.test.keypairs.alice, alice_account, alice_auth_descriptor, network_id1, chr_asset.id, 100, alice_evm_address);
    withdraw(rell.test.keypairs.alice, alice_account, alice_auth_descriptor, network_id1, foo_asset.id, 200, alice_evm_address);
    val t0 = (block @ {} (@omit @sort_desc .rowid, .timestamp) limit 1) + 1;
    // Alice
    for (wdr in range(5)) {
        withdraw(rell.test.keypairs.alice, alice_account, alice_auth_descriptor, network_id1, chr_asset.id, 300, alice_evm_address);
        withdraw(rell.test.keypairs.alice, alice_account, alice_auth_descriptor, network_id1, foo_asset.id, 400, alice_evm_address);
    }
    val t1 = (block @ {} (@omit @sort_desc .rowid, .timestamp) limit 1) + 1;
    // Bob
    for (wdr in range(5)) {
        withdraw(rell.test.keypairs.bob, bob_account, bob_auth_descriptor, network_id1, foo_asset.id, 500, bob_evm_address);
        withdraw(rell.test.keypairs.bob, bob_account, bob_auth_descriptor, network_id2, bar_asset.id, 600, bob_evm_address);
    }
    val t2 = (block @ {} (@omit @sort_desc .rowid, .timestamp) limit 1) + 1;
    withdraw(rell.test.keypairs.bob, bob_account, bob_auth_descriptor, network_id2, bar_asset.id, 700, bob_evm_address);
    withdraw(rell.test.keypairs.bob, bob_account, bob_auth_descriptor, network_id2, bar_asset.id, 800, bob_evm_address);

    // Getting all withdrawals
    val res1 = get_erc20_withdrawals(withdrawal_filter(), null, null);
    assert_null(res1.next_cursor);
    val wdr1 = parse_paged_withdrawals(res1);
    assert_equals(wdr1.size(), 24);
    assert_equals(wdr1 @ {} (@set .network_id), set([network_id1, network_id2]));
    assert_equals(wdr1 @ {} (@set .token_address), set([CHR.token_address, FOO.token_address, BAR.token_address]));
    assert_equals(wdr1 @ {} (@set .beneficiary), set([alice_evm_address, bob_evm_address]));

    // Getting all withdrawals to network_id1
    val res2 = get_erc20_withdrawals(withdrawal_filter(network_id = network_id1), null, null);
    val wdr2 = parse_paged_withdrawals(res2);
    assert_equals(wdr2.size(), 17);
    assert_equals(wdr2 @ {} (@set .network_id), set([network_id1]));
    assert_equals(wdr2 @ {} (@set .token_address), set([CHR.token_address, FOO.token_address]));
    assert_equals(wdr2 @ {} (@set .beneficiary), set([alice_evm_address, bob_evm_address]));

    // Getting all withdrawals for FOO
    val res3 = get_erc20_withdrawals(withdrawal_filter(token_address = FOO.token_address), null, null);
    val wdr3 = parse_paged_withdrawals(res3);
    assert_equals(wdr3.size(), 11);
    assert_equals(wdr3 @ {} (@set .network_id), set([network_id1]));
    assert_equals(wdr3 @ {} (@set .token_address), set([FOO.token_address]));
    assert_equals(wdr3 @ {} (@set .beneficiary), set([alice_evm_address, bob_evm_address]));

    // Getting all withdrawals for Bob
    val res4 = get_erc20_withdrawals(withdrawal_filter(beneficiary = bob_evm_address), null, null);
    val wdr4 = parse_paged_withdrawals(res4);
    assert_equals(wdr4.size(), 12);
    assert_equals(wdr4 @ {} (@set .network_id), set([network_id1, network_id2]));
    assert_equals(wdr4 @ {} (@set .token_address), set([FOO.token_address, BAR.token_address]));
    assert_equals(wdr4 @ {} (@set .beneficiary), set([bob_evm_address]));

    // Getting all withdrawals in [t0, t2) time interval
    val res5 = get_erc20_withdrawals(withdrawal_filter(from = t0, to = t2), null, null);
    val wdr5 = parse_paged_withdrawals(res5);
    assert_equals(wdr5.size(), 20);
    assert_equals(wdr5 @ {} (@set .network_id), set([network_id1, network_id2]));
    assert_equals(wdr5 @ {} (@set .token_address), set([CHR.token_address, FOO.token_address, BAR.token_address]));
    assert_equals(wdr5 @ {} (@set .beneficiary), set([alice_evm_address, bob_evm_address]));

    // Getting all withdrawals in [t1, ) time interval
    val res6 = get_erc20_withdrawals(withdrawal_filter(from = t1), null, null);
    val wdr6 = parse_paged_withdrawals(res6);
    assert_equals(wdr6.size(), 12);
    assert_equals(wdr6 @ {} (@set .network_id), set([network_id1, network_id2]));
    assert_equals(wdr6 @ {} (@set .token_address), set([FOO.token_address, BAR.token_address]));
    assert_equals(wdr6 @ {} (@set .beneficiary), set([bob_evm_address]));

    // Getting all withdrawals in [, t1) time interval
    val res7 = get_erc20_withdrawals(withdrawal_filter(to = t1), null, null);
    val wdr7 = parse_paged_withdrawals(res7);
    assert_equals(wdr7.size(), 12);
    assert_equals(wdr7 @ {} (@set .network_id), set([network_id1]));
    assert_equals(wdr7 @ {} (@set .token_address), set([CHR.token_address, FOO.token_address]));
    assert_equals(wdr7 @ {} (@set .beneficiary), set([alice_evm_address]));

    // Asserting pagination
    //  - page_size 4, page 0
    val res8 = get_erc20_withdrawals(withdrawal_filter(network_id = network_id1, token_address = FOO.token_address, from = t0), 4, null);
    assert_not_null(res8.next_cursor);
    val wdr8 = parse_paged_withdrawals(res8);
    assert_equals(wdr8.size(), 4);
    assert_equals(wdr8 @ {} (@set .network_id), set([network_id1]));
    assert_equals(wdr8 @ {} (@set .token_address), set([FOO.token_address]));
    assert_equals(wdr8 @ {} (@set .beneficiary), set([alice_evm_address]));
    //  - page_size 4, page 1
    val res9 = get_erc20_withdrawals(withdrawal_filter(network_id = network_id1, token_address = FOO.token_address, from = t0), 4, res8.next_cursor);
    assert_not_null(res9.next_cursor);
    val wdr9 = parse_paged_withdrawals(res9);
    assert_equals(wdr9.size(), 4);
    assert_equals(wdr9 @ {} (@set .network_id), set([network_id1]));
    assert_equals(wdr9 @ {} (@set .token_address), set([FOO.token_address]));
    assert_equals(wdr9 @ {} (@set .beneficiary), set([alice_evm_address, bob_evm_address]));
    //  - page_size 4, page 2
    val res10 = get_erc20_withdrawals(withdrawal_filter(network_id = network_id1, token_address = FOO.token_address, from = t0), 4, res9.next_cursor);
    assert_null(res10.next_cursor);
    val wdr10 = parse_paged_withdrawals(res10);
    assert_equals(wdr10.size(), 2);
    assert_equals(wdr10 @ {} (@set .network_id), set([network_id1]));
    assert_equals(wdr10 @ {} (@set .token_address), set([FOO.token_address]));
    assert_equals(wdr10 @ {} (@set .beneficiary), set([bob_evm_address]));

    // Getting withdrawal by tx1.tx_rid
    val wdr1_tx_rid = erc20_withdrawal @ {} (@omit @sort .rowid, .transaction.tx_rid) limit 1;
    val res11 = get_erc20_withdrawals(withdrawal_filter(tx_rid = wdr1_tx_rid), null, null);
    val wdr11_actual = parse_paged_withdrawals(res11);
    assert_equals(wdr11_actual.size(), 1);
    assert_equals(wdr11_actual @ {} (_ = .network_id, _ = .token_address, _ = .beneficiary, _ = .amount),
        (network_id1, CHR.token_address, alice_evm_address, 100L)
    );
    // Getting withdrawal by exact location
    assert_null(get_erc20_withdrawal_by_tx(wdr1_tx_rid, 1234));
    val wdr11_actual2 = get_erc20_withdrawal_by_tx(wdr1_tx_rid, 2); // 2 <- nop, auth, withdrawal
    assert_not_null(wdr11_actual2);
    assert_equals(
        (wdr11_actual2.network_id, wdr11_actual2.token_address, wdr11_actual2.beneficiary, wdr11_actual2.amount),
        (network_id1, CHR.token_address, alice_evm_address, 100L)
    );

    // Withdrawal history
    //  - unknown withdrawal
    try_call(get_erc20_withdrawal_history(rowid(integer.MAX_VALUE), *));
    //  - withdrawal wdr1[0] -> requested
    trigger_withdrawal_status_on_evm(wdr1[0].event_hash, evm_events.withdraw_request_event);
    assert_equals(
        get_erc20_withdrawal_history(wdr1[0].id),
        [
            erc20_withdrawal_history_entry(
                withdrawal_id = wdr1[0].id.to_integer(),
                status = withdrawal_status.created,
                timestamp = wdr1[0].timestamp
            ),
            erc20_withdrawal_history_entry(
                withdrawal_id = wdr1[0].id.to_integer(),
                status = withdrawal_status.requested,
                timestamp = block @ {} (@omit @sort_desc .rowid, .timestamp) limit 1
            ),
        ]
    );
    //  - withdrawal wdr1[0] -> pending
    trigger_withdrawal_status_on_evm(wdr1[0].event_hash, evm_events.pending_withdraw_event, block_height = 2);
    assert_equals(
        get_erc20_withdrawal_history(wdr1[0].id),
        [
            erc20_withdrawal_history_entry(
                withdrawal_id = wdr1[0].id.to_integer(),
                status = withdrawal_status.created,
                timestamp = wdr1[0].timestamp
            ),
            erc20_withdrawal_history_entry(
                withdrawal_id = wdr1[0].id.to_integer(),
                status = withdrawal_status.requested,
                timestamp = block @ {} (@omit @sort_desc .rowid, .timestamp) offset 1 limit 1
            ),
            erc20_withdrawal_history_entry(
                withdrawal_id = wdr1[0].id.to_integer(),
                status = withdrawal_status.pending,
                timestamp = block @ {} (@omit @sort_desc .rowid, .timestamp) limit 1
            ),
        ]
    );
    //  - withdrawal wdr1[1] -> requested -> pending
    trigger_withdrawal_status_on_evm(wdr1[1].event_hash, evm_events.withdraw_request_event, block_height = 3);
    trigger_withdrawal_status_on_evm(wdr1[1].event_hash, evm_events.pending_withdraw_event, block_height = 4);

    // - filter by null or empty statuses
    assert_equals(parse_paged_withdrawals(get_erc20_withdrawals(withdrawal_filter(), null, null)).size(), 24);
    assert_equals(parse_paged_withdrawals(get_erc20_withdrawals(withdrawal_filter(statuses = []), null, null)).size(), 24);

    // - filter by status = pending
    val res12 = get_erc20_withdrawals(withdrawal_filter(statuses = [withdrawal_status.pending]), null, null);
    val wdr12 = parse_paged_withdrawals(res12);
    assert_equals(wdr12.size(), 2);
    assert_equals(wdr12 @ {} (@set .token_address), set([CHR.token_address, FOO.token_address]));
    assert_equals(wdr12 @ {} (@set .amount), set([100L, 200L]));

    // - filter by status = pending | requested
    trigger_withdrawal_status_on_evm(wdr1[1].event_hash, evm_events.unpending_withdraw_event, block_height = 5);
    val res13 = get_erc20_withdrawals(withdrawal_filter(statuses = [withdrawal_status.pending, withdrawal_status.requested]), null, null);
    val wdr13 = parse_paged_withdrawals(res13);
    assert_equals(wdr13.size(), 2);
    assert_equals(wdr13 @ {} (@set .token_address), set([CHR.token_address, FOO.token_address]));
    assert_equals(wdr13 @ {} (@set .amount), set([100L, 200L]));

    // - filter by status = pending | requested | withdrawn (there are no withdrawn entries)
    assert_true(empty(erc20_withdrawal_status @* { withdrawal_status.withdrawn }));
    val res14 = get_erc20_withdrawals(withdrawal_filter(statuses = [withdrawal_status.pending, withdrawal_status.requested, withdrawal_status.withdrawn]), null, null);
    val wdr14 = parse_paged_withdrawals(res14);
    assert_equals(wdr14.size(), 2);
    assert_equals(wdr14 @ {} (@set .token_address), set([CHR.token_address, FOO.token_address]));
    assert_equals(wdr14 @ {} (@set .amount), set([100L, 200L]));
}

function withdraw(
    keypair: rell.test.keypair, account: ft4.accounts.account, auth_descriptor: accounts.auth_descriptor,
    network_id: integer, asset_id: byte_array, amount: integer, beneficiary: byte_array
) {
    rell.test.tx().nop().op(
        auth.external.ft_auth(account.id, auth_descriptor.hash()),
        bridge_ft4_token_to_evm(network_id, asset_id, amount, beneficiary)
    ).sign(keypair).run();
}

function parse_paged_withdrawals(paged_result: ft4.utils.paged_result) {
    return paged_result.data @* {} ( erc20_withdrawal_info.from_gtv_pretty($) );
}
