import hbridge.*;

function test_get_registered_erc20_assets() {
    // Empty list
    assert_true(snapshot.get_registered_erc20_assets(network_id1).empty());

    // Register FT4 and ERC20 assets
    val chr_asset = register_foreign_asset(CHR, network_id1);
    // bind ERC20 asset FOO on network_id2 to the FT4 CHR asset on Chromia
    register_erc20_asset(chr_asset, FOO, network_id2);

    val bar_asset = register_foreign_asset(BAR, network_id2);

    // Asserts / network_id1
    assert_equals(
        snapshot.get_registered_erc20_assets(network_id1) @* {} (_ = .token_address, _ = .ft_asset_id),
        [(CHR.token_address, chr_asset.id)]
    );
    // Asserts / network_id2
    assert_equals(
        snapshot.get_registered_erc20_assets(network_id2) @* {} (_ = .token_address, _ = .ft_asset_id),
        [
            (FOO.token_address, chr_asset.id), // ERC20 FOO <-> FT4 CHR
            (BAR.token_address, bar_asset.id)
        ]
    );
}
