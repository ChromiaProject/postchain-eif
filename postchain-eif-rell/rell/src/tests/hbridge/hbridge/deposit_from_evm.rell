function test_deposit_foreign_token_from_ethereum_with_already_linked_account() {
    val ft_asset = register_foreign_asset();

    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    link_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    val amount = 10000000000000000000L;

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), 0L);

    deposit_from_ethereum(evm_address, amount);

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    run_block_after_timeout();
    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run_must_fail("No records found");
}

function test_deposit_foreign_token_from_ethereum_will_get_pending_assets_when_linking_once_but_not_twice() {
    val ft_asset = register_foreign_asset();

    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    val amount = 10000000000000000000L;

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), 0L);

    deposit_from_ethereum(evm_address, amount);

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), 0L);

    link_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    assert_fails("duplicate key value violates unique constraint",
        link_account(
            rell.test.keypairs.eve,
            rell.test.keypairs.alice,
            account_id,
            auth_descriptor.hash(),
            *
        )
    );

    val auth_descriptor2 = test_utils.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"]);
    val account_id2 = rell.test.pubkeys.bob.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor2)
    ).sign(admin_privkey).run();
    assert_fails("duplicate key value violates unique constraint",
        link_account(
            rell.test.keypairs.eve,
            rell.test.keypairs.bob,
            account_id2,
            auth_descriptor2.hash(),
            *
        )
    );

    run_block_after_timeout();
    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run_must_fail("No records found");
}

function test_deposit_foreign_token_from_ethereum_will_get_pending_assets_when_registering_account_and_duplicate_deposit_will_bounce() {
    val ft_asset = register_foreign_asset();

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    val amount = 10000000000000000000L;
    val amount2 = 5000000000000000000L;

    deposit_from_ethereum(evm_address, amount, block_height = 1);

    val recipient_id = evm_address.hash();

    assert_true("open" in create_on_transfer.get_pending_transfer_strategies(recipient_id));

    deposit_from_ethereum(evm_address, amount2, block_height = 2);
    assert_withdraw(1, evm_address, amount2);

    val auth_descriptor = test_utils.create_auth_descriptor(evm_address, ["A", "T"]);

    val op1 = open.ras_transfer_open(auth_descriptor);
    val op2 = strategies.external.register_account();
    val message = strategies.external.get_register_account_message(
        op1.to_gtx_operation(),
        op2.to_gtx_operation()
    );
    val signature = test_utils.evm_sign(message, rell.test.privkeys.eve);
    rell.test.tx()
        .op(auth.evm_signatures([evm_address], [signature]))
        .op(op1)
        .op(op2)
        .nop()
        .run();

    assert_true(empty(create_on_transfer.get_pending_transfer_strategies(recipient_id)));

    val ft_account = accounts.Account(recipient_id);

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    assert_equals(hbridge.get_account_for_eoa_address(evm_address), ft_account.id);
    assert_equals(hbridge.get_eoa_addresses_for_account(ft_account.id), [evm_address]);

    val op = hbridge.link_evm_eoa_account(evm_address);
    val message2 = test_utils.create_evm_auth_message(op);
    val signature2 = test_utils.evm_sign(message2, rell.test.privkeys.eve);
    rell.test.tx()
        .op(auth.evm_signatures([evm_address], [signature2]))
        .op(auth.external.evm_auth(recipient_id, auth_descriptor.hash(), [signature2]))
        .op(op)
        .nop()
        .run_must_fail("duplicate key value violates unique constraint");

    run_block_after_timeout();
    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run_must_fail("No records found");
}

function test_can_recall_unclaimed_deposit_from_ethereum_after_timeout_once_but_not_twice() {
    val ft_asset = register_foreign_asset();

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    val amount = 10000000000000000000L;

    deposit_from_ethereum(evm_address, amount);

    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run_must_fail("This transfer has not timed out yet");

    run_block_after_timeout();
    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run();

    assert_withdraw(1, evm_address, amount);

    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run_must_fail("No records found");
}
