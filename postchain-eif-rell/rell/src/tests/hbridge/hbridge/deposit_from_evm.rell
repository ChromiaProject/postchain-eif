function _deposit_token_from_evm_sc_with_already_created_and_linked_account(ft_asset: ft4.assets.asset): big_integer {
    // Account
    val auth_descriptor = ft4_test.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    // Register account
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    // Try to deposit before linking accounts
    deposit_from_evm(evm_address, 11000000, block_height = 2, account_id = account_id);
    assert_true(empty(erc20_deposit @* {}));
    val bounced = get_bounced_erc20_deposits(bounced_deposit_filter());
    assert_equals(bounced.data.size(), 1);
    assert_bounced_at(bounced, 0, 11000000L, "Sender EVM account not linked to recipient FT4 account");

    // Link accounts
    link_sc_account_id_event(evm_address, account_id);
    link_sc_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), 0L);
    val deposited_amount = 10000000L;
    deposit_from_evm(evm_address, deposited_amount, block_height = 3, account_id = account_id);
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), deposited_amount);

    return deposited_amount;
}

