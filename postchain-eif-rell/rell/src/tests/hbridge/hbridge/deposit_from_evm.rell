function test_deposit_foreign_token_from_evm_will_collect_pending_deposits_when_registering_account_with_evm_address() {
    // FT4 CHR <-> CHR on network_id1
    val chr_asset = register_foreign_asset(CHR);

    // FT4 FOO <-> FOO on network_id1 & BAR on network_id2
    val foo_asset = register_ft4_asset(FOO);
    register_erc20_asset(foo_asset, FOO, network_id1);
    register_erc20_asset(foo_asset, BAR, network_id2);

    // Account
    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    val recipient_id = evm_address.hash();
    val auth_descriptor = ft4_test.create_auth_descriptor(evm_address, ["A", "T"]);

    val amount1 = 10000000L;
    val amount2 = 20000000L;
    val amount3 = 30000000L;
    val amount4 = 40000000L;

    // The first CHR deposit will be created as pending
    deposit_from_evm(evm_address, amount1, block_height = 1, asset = CHR);
    assert_equals(create_on_transfer.get_pending_transfer_strategies(recipient_id), set(["open"]));

    // The 2nd CHR deposit will be bounced
    deposit_from_evm(evm_address, amount2, block_height = 2, asset = CHR);
    assert_withdraw(1, evm_address, amount2);

    // The first FOO deposit from the network_id1 will be created as pending
    deposit_from_evm(evm_address, amount3, block_height = 3, asset = FOO, network_id = network_id1);
    assert_equals(create_on_transfer.get_pending_transfer_strategies(recipient_id), set(["open"]));

    // The first BAR deposit from the network_id2 will be created as pending
    deposit_from_evm(evm_address, amount4, block_height = 4, asset = BAR, network_id = network_id2);
    assert_equals(create_on_transfer.get_pending_transfer_strategies(recipient_id), set(["open"]));

    // Verify pending deposits
    val pending_deposits = get_erc20_deposits(deposit_filter(recipient_id = recipient_id), null, null, null, null);
    assert_equals(
        pending_deposits.data @* {} (erc20_deposit_info.from_gtv_pretty($)) @* {} (_ = .asset_id, _ = .amount, _ = .state),
        [
            (chr_asset.id, amount1, deposit_state.pending), // CHR
            (foo_asset.id, amount3, deposit_state.pending), // FOO
            (foo_asset.id, amount4, deposit_state.pending)  // BAR
        ],
    );

    // Register account using strategies
    val op1 = open.ras_transfer_open(auth_descriptor);
    val op2 = strategies.external.register_account();
    val message = strategies.external.get_register_account_message(
        op1.to_gtx_operation(),
        op2.to_gtx_operation()
    );
    val signature = ft4_test.evm_sign(message, rell.test.privkeys.eve);
    rell.test.tx()
        .op(auth.evm_signatures([evm_address], [signature]))
        .op(op1)
        .op(op2)
        .nop()
        .run();

    assert_true(empty(create_on_transfer.get_pending_transfer_strategies(recipient_id)));

    val ft_account = accounts.Account(recipient_id);
    // CHR token deposit has been credited to the FT4 CHR token balance.
    assert_equals(assets.get_asset_balance(ft_account, chr_asset), amount1);
    // Both FOO and BAR token deposits have been credited to the FT4 FOO token balance.
    assert_equals(assets.get_asset_balance(ft_account, foo_asset), amount3 + amount4);

    // Making sure ft4 and evm accounts are linked
    assert_equals(core.get_account_for_eoa_address(evm_address), ft_account.id);
    assert_equals(core.get_eoa_addresses_for_account(ft_account.id), [evm_address]);

    // Explicit account linking will fail
    val op = core.link_evm_eoa_account(evm_address);
    val message2 = ft4_test.create_evm_auth_message(op)
        .replace(auth.ACCOUNT_ID_PLACEHOLDER, recipient_id.to_hex().upper_case())
        .replace(auth.AUTH_DESCRIPTOR_ID_PLACEHOLDER, auth_descriptor.hash().to_hex().upper_case());
    val signature2 = ft4_test.evm_sign(message2, rell.test.privkeys.eve);
    rell.test.tx()
        .op(auth.evm_signatures([evm_address], [signature2]))
        .op(auth.external.evm_auth(recipient_id, auth_descriptor.hash(), [signature2]))
        .op(op)
        .nop()
        .run_must_fail("EVM address %s is already linked to FT4 account".format(evm_address));
}

function test_can_recall_unclaimed_deposit_from_evm_after_timeout_once_but_not_twice() {
    val ft_asset = register_foreign_asset();

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    val amount = 10000000L;

    deposit_from_evm(evm_address, amount);

    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run_must_fail("This transfer has not timed out yet");

    run_block_after_timeout();
    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run();

    assert_withdraw(1, evm_address, amount);

    // Try to recall again: no new withdrawal should be created
    rell.test.tx()
        .op(hbridge.recall_pending_deposit(evm_address))
        .nop()
        .run();

    // Still only 1 withdrawal
    assert_equals(erc20_withdrawal @ {} (@sum 1), 1);
}

function test_get_bounced_erc20_deposits_from_to_filter() {
    val ft_asset = register_foreign_asset();
    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    // Create first bounced deposit
    deposit_from_evm(evm_address, 10, block_height = 1);
    val t0 = rell.test.last_block_time;

    // Create second bounced deposit
    deposit_from_evm(evm_address, 11, block_height = 2);
    val t1 = rell.test.last_block_time;

    // Create third bounced deposit
    deposit_from_evm(evm_address, 12, block_height = 3);
    val t2 = rell.test.last_block_time;

    // Verify all 3 bounced deposits exist
    val all_bounced = get_bounced_erc20_deposits(bounced_deposit_filter());
    assert_equals(all_bounced.data.size(), 3);

    // Test from/to range: [t0, t1) should return 1 deposit
    val res1 = get_bounced_erc20_deposits(bounced_deposit_filter(from = t0, to = t1));
    assert_equals(res1.data.size(), 1);
    assert_bounced_at(res1, 0, 10L);

    // Test from only: [t1, ) should return 2 deposits
    val res2 = get_bounced_erc20_deposits(bounced_deposit_filter(from = t1));
    assert_equals(res2.data.size(), 2);
    assert_bounced_at(res2, 0, 11L);
    assert_bounced_at(res2, 1, 12L);

    // Test to only: [, t1) should return 1 deposit
    val res3 = get_bounced_erc20_deposits(bounced_deposit_filter(to = t1));
    assert_equals(res3.data.size(), 1);
    assert_bounced_at(res3, 0, 10L);

    // Test from/to range: [t0, t2) should return 2 deposits
    val res4 = get_bounced_erc20_deposits(bounced_deposit_filter(from = t0, to = t2));
    assert_equals(res4.data.size(), 2);
    assert_bounced_at(res4, 0, 10L);
    assert_bounced_at(res4, 1, 11L);

    // Test from/to range: [t1, t2) should return 1 deposit
    val res5 = get_bounced_erc20_deposits(bounced_deposit_filter(from = t1, to = t2));
    assert_equals(res5.data.size(), 1);
    assert_bounced_at(res5, 0, 11L);

    // Test from/to range in descending order: [t0, t2) should return 2 deposits
    val res6 = get_bounced_erc20_deposits(bounced_deposit_filter(from = t0, to = t2), sort_desc = true);
    assert_equals(res6.data.size(), 2);
    assert_bounced_at(res6, 0, 11L);
    assert_bounced_at(res6, 1, 10L);
}
