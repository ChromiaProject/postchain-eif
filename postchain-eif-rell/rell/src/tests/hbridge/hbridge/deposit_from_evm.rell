function test_deposit_foreign_token_from_evm_when_account_is_registered_and_erc20_token_is_not_registered() {
    val auth_descriptor = ft4_test.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();

    // Register ft4 account
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();

    // Deposit ERC20 tokens
    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    val amount = 10000000L;
    val (tnx_hash, log_index) = deposit_from_evm(evm_address, amount);

    // There is no deposit for evm_address
    assert_true(empty(erc20_deposit @* {}));

    // The deposit will be bounced
    assert_withdraw(1, evm_address, amount);

    // Verify bounced deposit
    assert_bounced_queries(evm_address, tnx_hash, log_index, "Token not registered");
}

