function test_deposit_native_token_from_evm_eoa_with_already_created_and_linked_account_deducts_from_bridge_account() {
    val erc20 = register_native_asset();

    rell.test.tx().op(
        helpers.create_bridge_account_op(erc20.virtual_blockchain_rid)
    ).run();
    val bridge_account = core.ensure_bridge_account(erc20.virtual_blockchain_rid);
    val bridge_amount = _mint(bridge_account, erc20.asset);

    val deposited_amount = _deposit_token_from_evm_eoa_with_already_created_and_linked_account(erc20.asset);

    assert_equals(assets.get_asset_balance(bridge_account, erc20.asset), bridge_amount - deposited_amount);
}

function _deposit_token_from_evm_eoa_with_already_created_and_linked_account(ft_asset: ft4.assets.asset): big_integer {
    // Account
    val auth_descriptor = ft4_test.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    // Register account
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    // Link account
    link_eoa_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    // Deposit 1 tCHR, 8.000 tCHR, 10.000.000 tCHR
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), 0L);
    deposit_from_evm(evm_address, 1, block_height = 1);
    deposit_from_evm(evm_address, 8000, block_height = 2);
    deposit_from_evm(evm_address, 10000000, block_height = 3);
    val deposited_amount = 10008001L;
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), deposited_amount);

    // Deposits with zero or negative amount are not allowed
    val nr_of_deposits = erc20_deposit @ {} (@sum 1);
    deposit_from_evm(evm_address, 0, block_height = 4);
    deposit_from_evm(evm_address, -1, block_height = 5);
    assert_equals(erc20_deposit @ {} (@sum 1), nr_of_deposits);

    return deposited_amount;
}

function test_deposit_native_token_from_evm_eoa_is_not_allowed_when_there_is_insufficient_balance_in_bridge_account() {
    val ft_asset = register_native_asset().asset;

    // Account
    val auth_descriptor = ft4_test.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    // Register account
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    // Link account
    link_eoa_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    // Deposit from EVM is not allowed when there is no previous balance in bridge account
    deposit_from_evm(evm_address, 1, block_height = 1);
    deposit_from_evm(evm_address, 8000, block_height = 2);
    deposit_from_evm(evm_address, 10000000, block_height = 3);

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), 0L);
    assert_equals(erc20_deposit @ {} (@sum 1), 0);

    // Verify all three deposits were bounced with correct reason
    val result = get_bounced_erc20_deposits(
        bounced_deposit_filter(network_id = network_id1, token_address = CHR.token_address),
        page_size = 10,
        page_cursor = null,
        sort_desc = true
    );
    assert_equals(result.data.size(), 3);

    // Descending order: newest first (10000000, 8000, 1)
    assert_bounced_at(result, 0, 10000000L, "Insufficient bridge balance");
    assert_bounced_at(result, 1, 8000L, "Insufficient bridge balance");
    assert_bounced_at(result, 2, 1L, "Insufficient bridge balance");
}

