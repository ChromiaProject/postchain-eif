function test_deposit_native_token_from_evm_before_account_creation_deducs_from_brige_account() {
    val erc20 = register_native_asset();

    rell.test.tx().op(
        helpers.create_bridge_account_op(erc20.virtual_blockchain_rid)
    ).run();
    val bridge_account = snapshot.core.ensure_bridge_account(erc20.virtual_blockchain_rid);
    val bridge_amount = _mint(bridge_account, erc20.asset);

    val deposited_amount = _deposit_token_from_evm_before_account_creation(erc20.asset);

    assert_equals(assets.get_asset_balance(bridge_account, erc20.asset), bridge_amount - deposited_amount);
}

function _deposit_token_from_evm_before_account_creation(ft_asset: ft4.assets.asset): big_integer {
    // Account
    val auth_descriptor = ft4_test.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    // A user can't deposit less than 10 tCHR before account is created,
    deposit_from_evm(evm_address, 7000000, block_height = 1);
    assert_true(empty(erc20_deposit @* {}));
    assert_withdraw(1, evm_address, 7000000);

    // but can deposit 10+ tCHR before account is created,
    deposit_from_evm(evm_address, 10000000, block_height = 2);
    val deposit = erc20_deposit @ {} ($.to_struct());
    assert_equals(deposit.amount, 10000000);
    assert_equals(deposit.state, deposit_state.pending);
    assert_equals(erc20_withdrawal @ {} (@sum 1), 1);

    // but only once.
    deposit_from_evm(evm_address, 11000000, block_height = 3);
    assert_equals(erc20_deposit @ {} (@sum 1), 1);
    assert_withdraw(2, evm_address, 11000000, expected_nr_withdrawals = 2);

    // Register account
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    // Accounts are not linked, so balance is 0
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), 0L);

    // FT4 account is created but EVM account is not linked, so a user can't deposit
    deposit_from_evm(evm_address, 8000, block_height = 5);
    deposit_from_evm(evm_address, 12000000, block_height = 6);
    // We still have 1 pending deposit
    val deposit2 = erc20_deposit @ {} ($.to_struct());
    assert_equals(deposit2.amount, 10000000);
    assert_equals(deposit2.state, deposit_state.pending);
    // and 4 bounced deposits
    assert_equals(erc20_withdrawal @* {} (.amount), [7000000L, 11000000L, 8000L, 12000000L]);

    // Link accounts
    link_eoa_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    // Once accounts are linked, the balance is equal to the amount of the single pending deposit
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), 10000000L);

    // Once accounts are linked, the user can deposit any amount
    deposit_from_evm(evm_address, 9000, block_height = 8);
    deposit_from_evm(evm_address, 13000000, block_height = 9);
    val deposited_amount = 10000000 + 9000 + 13000000;
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), deposited_amount);

    // Trying to link accounts again
    assert_fails("EVM address %s is already linked to FT4 account".format(evm_address),
        link_eoa_account(
            rell.test.keypairs.eve,
            rell.test.keypairs.alice,
            account_id,
            auth_descriptor.hash(),
            *
        )
    );

    // Trying to link Alice's EVM account to Bob's FT4 account
    val auth_descriptor2 = ft4_test.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"]);
    val account_id2 = rell.test.pubkeys.bob.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor2)
    ).sign(admin_privkey).run();
    assert_fails("EVM address %s is already linked to FT4 account".format(evm_address),
        link_eoa_account(
            rell.test.keypairs.eve,
            rell.test.keypairs.bob,
            account_id2,
            auth_descriptor2.hash(),
            *
        )
    );

    return deposited_amount;
}

