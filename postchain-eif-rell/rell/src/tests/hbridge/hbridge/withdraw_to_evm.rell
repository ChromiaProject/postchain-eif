function test_withdraw_foreign_ERC20_token_to_ethereum_with_already_linked_account() {
    val ft_asset = register_foreign_asset();

    val auth_descriptor = create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = auth_descriptor.hash();
    rell.test.tx().op(
        admin.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    link_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    val amount = 10000000000000000000L;

    rell.test.tx().op(
        admin.mint(account_id, ft_asset.id, amount)
    ).sign(admin_privkey).run();

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth_ext.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice).run();

    val withdraw_info = [
        (1).to_gtv(),
        network_id.to_gtv(),
        to_32_byte_array(token_address).to_gtv(),
        to_32_byte_array(evm_address).to_gtv(),
        (amount / 2).to_gtv()
    ];
    assert_events(("eif_event", withdraw_info.to_gtv_pretty()));

    assert_equals(hbridge.get_erc20_withdrawal(network_id, token_address, evm_address), [
        struct<hbridge.erc20_withdraw>(
            serial = 1,
            network_id,
            token_address,
            beneficiary = evm_address,
            amount / 2
        )
    ]);

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount / 2);
}

function test_can_not_withdraw_to_ethereum_without_linked_token() {
    val asset_id = (token_name, chain_context.blockchain_rid).hash();
    rell.test.tx().op(
        admin.register_asset(token_name, token_symbol, token_decimal, token_icon_url)
    ).sign(admin_privkey).run();
    val ft_asset = assets.Asset(asset_id);

    val auth_descriptor = create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = auth_descriptor.hash();
    rell.test.tx().op(
        admin.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    link_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    val amount = 10000000000000000000L;

    rell.test.tx().op(
        admin.mint(account_id, ft_asset.id, amount)
    ).sign(admin_privkey).run();

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth_ext.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("ERC20 token not found");
}

function test_can_not_withdraw_to_ethereum_without_linked_account() {
    val ft_asset = register_foreign_asset();

    val auth_descriptor = create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = auth_descriptor.hash();
    rell.test.tx().op(
        admin.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    val amount = 10000000000000000000L;

    rell.test.tx().op(
        admin.mint(account_id, ft_asset.id, amount)
    ).sign(admin_privkey).run();

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth_ext.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Can only withdraw to your own account");
}

function test_can_not_withdraw_to_ethereum_with_insufficient_balance() {
    val ft_asset = register_foreign_asset();

    val auth_descriptor = create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = auth_descriptor.hash();
    rell.test.tx().op(
        admin.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    link_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    rell.test.tx()
        .op(auth_ext.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id, ft_asset.id, 100000000000000000L, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Insufficient balance");
}
