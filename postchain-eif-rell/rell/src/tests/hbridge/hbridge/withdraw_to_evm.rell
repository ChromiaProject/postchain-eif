function test_withdraw_foreign_ERC20_token_to_ethereum_with_already_linked_account() {
    val ft_asset = register_foreign_asset();

    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    link_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    val amount = 10000000000000000000L;

    rell.test.tx().op(
        admin.external.mint(account_id, ft_asset.id, amount)
    ).sign(admin_privkey).run();

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice).run();

    assert_withdraw(1, evm_address, amount / 2);

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount / 2);
}

function test_can_not_withdraw_to_ethereum_without_linked_token() {
    val asset_id = (CHR.token_name, chain_context.blockchain_rid).hash();
    rell.test.tx().op(
        admin.external.register_asset(CHR.token_name, CHR.token_symbol, CHR.token_decimal, CHR.token_icon_url)
    ).sign(admin_privkey).run();
    val ft_asset = assets.Asset(asset_id);

    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    link_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    val amount = 10000000000000000000L;

    rell.test.tx().op(
        admin.external.mint(account_id, ft_asset.id, amount)
    ).sign(admin_privkey).run();

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("ERC20 token not found");
}

function test_can_not_withdraw_to_ethereum_without_linked_account() {
    val ft_asset = register_foreign_asset();

    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    val amount = 10000000000000000000L;

    rell.test.tx().op(
        admin.external.mint(account_id, ft_asset.id, amount)
    ).sign(admin_privkey).run();

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Can only withdraw to your own account");
}

function test_can_not_withdraw_to_ethereum_with_insufficient_balance() {
    val ft_asset = register_foreign_asset();

    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);
    link_account(
        rell.test.keypairs.eve,
        rell.test.keypairs.alice,
        account_id,
        auth_descriptor.hash()
    );

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, 100000000000000000L, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Insufficient balance");
}
