function test_can_not_withdraw_foreign_asset_negative_or_zero_amount_to_ethereum() {
    val ft_asset = register_foreign_asset();
    _can_not_withdraw_negative_or_zero_amount_to_ethereum(ft_asset);
}

function test_can_not_withdraw_native_asset_negative_or_zero_amount_to_ethereum() {
    val ft_asset = register_native_asset().asset;
    _can_not_withdraw_negative_or_zero_amount_to_ethereum(ft_asset);
}

function _can_not_withdraw_negative_or_zero_amount_to_ethereum(ft_asset: ft4.assets.asset) {
    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    // 0
    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, 0L, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Parameter amount: value must be non-zero positive, actual: 0");

    // -1
    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, -1L, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Parameter amount: value must be non-zero positive, actual: -1");
}

function _register_ft_account_and_link_evm_address(link_evm_account: boolean = true) {
    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);
    val account_id = rell.test.pubkeys.alice.hash();
    rell.test.tx().op(
        admin.external.register_account(auth_descriptor)
    ).sign(admin_privkey).run();
    val ft_account = accounts.Account(account_id);

    val evm_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.eve);

    if (link_evm_account) {
        link_eoa_account(
            rell.test.keypairs.eve,
            rell.test.keypairs.alice,
            account_id,
            auth_descriptor.hash()
        );
    }

    return (
        auth_descriptor = auth_descriptor,
        ft_account = ft_account,
        evm_address = evm_address,
    );
}
