/**
 * Once HBridge v2 becomes the default version, perform the following:
 *  - Add `@test module;`
 *  - Add `blockchains.withdraw_to_evm_test` profile to the chromia.yml file to run this test suite
 *    (cf. `blockchains.withdraw_to_multiple_bridges_test`).
 */

function test_withdraw_foreign_asset_to_ethereum_with_already_linked_account() {
    val ft_asset = register_foreign_asset();
    _withdraw_to_ethereum_with_already_linked_account(ft_asset);
}

function test_withdraw_native_asset_to_ethereum_with_already_linked_account_ends_up_in_bridge_account() {
    val erc20 = register_native_asset();
    val withdraw_amount = _withdraw_to_ethereum_with_already_linked_account(erc20.asset);

    val bridge_account = ensure_bridge_account(erc20.virtual_blockchain_rid);
    assert_equals(assets.get_asset_balance(bridge_account, erc20.asset), withdraw_amount);
}

function _withdraw_to_ethereum_with_already_linked_account(ft_asset: ft4.assets.asset): big_integer {
    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    val amount = _mint(ft_account, ft_asset);
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    val withdraw_amount = amount / 2;

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, withdraw_amount, evm_address))
        .sign(rell.test.keypairs.alice).run();

    assert_withdraw(1, evm_address, withdraw_amount);

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), withdraw_amount);

    return withdraw_amount;
}

function test_withdraw_to_ethereum_using_most_recent_erc20_token_address_by_default() {
    val ft_asset = register_ft4_asset(CHR);
    register_erc20_asset(ft_asset, CHR, network_id1);
    register_erc20_asset(ft_asset, FOO, network_id1);

    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    val amount = _mint(ft_account, ft_asset);
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice).run();

    // withdrawal to FOO token contract, by default
    assert_withdraw(1, evm_address, amount / 2, asset = FOO);
    // no withdrawals to the CHR token contract
    assert_true(empty(
        hbridge.get_erc20_withdrawal(network_id1, CHR.token_address, evm_address)
    ));

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount / 2);
}

function test_withdraw_to_ethereum_using_specific_erc20_token_address() {
    val ft_asset = register_ft4_asset(CHR);
    register_erc20_asset(ft_asset, CHR, network_id1);
    register_erc20_asset(ft_asset, FOO, network_id1);

    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    val amount = _mint(ft_account, ft_asset);
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm_contract(network_id1, ft_asset.id, amount / 2, evm_address, CHR.token_address))
        .sign(rell.test.keypairs.alice).run();

    // withdrawal to CHR token contract
    assert_withdraw(1, evm_address, amount / 2, asset = CHR);
    // no withdrawals to the FOO token contract
    assert_true(empty(
        hbridge.get_erc20_withdrawal(network_id1, FOO.token_address, evm_address)
    ));

    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount / 2);
}

function test_can_not_withdraw_if_no_bridges_are_configured_for_this_network_but_exist_for_other_neworks() {
    // CHR
    val ft_chr_asset = register_ft4_asset(CHR);
    val erc20_chr_asset = register_erc20_asset(ft_chr_asset, CHR, network_id1);
    // FOO
    val ft_foo_asset = register_ft4_asset(FOO);
    val erc20_foo_asset = register_erc20_asset(ft_foo_asset, FOO, network_id2);

    // Register bridge for network 2
    rell.test.tx().op(
        helpers.register_bridge_with_erc20_assets_op(
            network_id = network_id2,
            bridge_contract_address = bridge_address2,
            erc20_assets = [erc20_foo_asset]
        )
    ).run();

    // Register FT account
    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    // Verify that withdrawal is not possible
    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_chr_asset.id, 1, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("No bridges are configured for network ID 1");
}

function test_can_not_withdraw_if_more_than_one_bridge_is_configured_for_this_network() {
    // CHR
    val ft_chr_asset = register_ft4_asset(CHR);
    val erc20_chr_asset = register_erc20_asset(ft_chr_asset, CHR, network_id1);
    // FOO
    val ft_foo_asset = register_ft4_asset(FOO);
    val erc20_foo_asset = register_erc20_asset(ft_foo_asset, FOO, network_id1);

    // Register 2 bridges for network 1
    rell.test.tx().op(
        helpers.register_bridge_with_erc20_assets_op(
            network_id = network_id1,
            bridge_contract_address = bridge_address1,
            erc20_assets = [erc20_chr_asset]
        ),
        helpers.register_bridge_with_erc20_assets_op(
            network_id = network_id1,
            bridge_contract_address = bridge_address2,
            erc20_assets = [erc20_foo_asset]
        )
    ).run();

    // Register FT account
    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    // Verify that withdrawal is not possible
    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_chr_asset.id, 1, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("More than one bridge is configured for network ID 1");
}

function test_can_not_call_operation__bridge_ft_asset_to_evm__if_hbridge_uses_v1() {
    rell.test.tx().op(
        hbridge.bridge_ft_asset_to_evm(x"", 1, network_id1, evm_address, bridge_address1)
    ).run_must_fail("Unsupported HBridge version 1 for the `bridge_ft_asset_to_evm` operation. Version 2 is required.");
}

function test_withdraw_if_only_one_bridge_is_configured_for_the_network() {
    // CHR
    val ft_chr_asset = register_ft4_asset(CHR);
    val erc20_chr_asset = register_erc20_asset(ft_chr_asset, CHR, network_id1);

    // Register only one bridges for network 1
    rell.test.tx().op(
        helpers.register_bridge_with_erc20_assets_op(
            network_id = network_id1,
            bridge_contract_address = bridge_address1,
            erc20_assets = [erc20_chr_asset]
        )
    ).run();

    _withdraw_to_ethereum_with_already_linked_account(ft_chr_asset);
}

function test_can_not_withdraw_to_ethereum_without_linked_token() {
    val asset_id = (CHR.token_name, chain_context.blockchain_rid).hash();
    rell.test.tx().op(
        admin.external.register_asset(CHR.token_name, CHR.token_symbol, CHR.token_decimal, CHR.token_icon_url)
    ).sign(admin_privkey).run();
    val ft_asset = assets.Asset(asset_id);

    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    val amount = _mint(ft_account, ft_asset);
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("ERC20 token not found");
}

function test_can_not_withdraw_foreign_asset_to_ethereum_without_linked_account() {
    val ft_asset = register_foreign_asset();
    _can_not_withdraw_to_ethereum_without_linked_account(ft_asset);
}

function test_can_not_withdraw_native_asset_to_ethereum_without_linked_account() {
    val ft_asset = register_native_asset().asset;
    _can_not_withdraw_to_ethereum_without_linked_account(ft_asset);
}

function _can_not_withdraw_to_ethereum_without_linked_account(ft_asset: ft4.assets.asset) {
    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address(false);

    val amount = _mint(ft_account, ft_asset);
    assert_equals(assets.get_asset_balance(ft_account, ft_asset), amount);

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, amount / 2, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Can only withdraw to your own account");
}

function test_can_not_withdraw_foreign_asset_to_ethereum_with_no_balance() {
    val ft_asset = register_foreign_asset();
    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, 100000000000000000L, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Insufficient balance");
}

function test_can_not_withdraw_foreign_asset_to_ethereum_with_insufficient_balance() {
    val ft_asset = register_foreign_asset();
    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    val amount = _mint(ft_account, ft_asset);

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, amount + 1, evm_address))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Insufficient balance");
}

function test_can_not_withdraw_native_asset_to_ethereum_with_no_balance() {
    val ft_asset = register_native_asset().asset;
    val (auth_descriptor, ft_account, evm_address) = _register_ft_account_and_link_evm_address();

    rell.test.tx()
        .op(auth.external.ft_auth(ft_account.id, auth_descriptor.hash()))
        .op(hbridge.bridge_ft4_token_to_evm(network_id1, ft_asset.id, 100000000000000000L, evm_address))
        .sign(rell.test.keypairs.alice)
