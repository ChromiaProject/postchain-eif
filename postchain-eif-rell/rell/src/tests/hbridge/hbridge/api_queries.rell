
function test_get_bridge_contracts_for_unknown_network() {
    assert_equals(
        get_bridge_contracts(network_id = -1),
        list<bridge_contract_info>()
    );

    assert_equals(
        get_bridge_contract_info(97, x"0000000000000000000000000000000000000000"),
        null
    );
}

function test_get_bridge_contracts_when_no_registered_erc20_assets() {
    val sepolia = 11155111;
    val bsc_testnet = 97;

    rell.test.tx().op(
        helpers.get_or_create_bridge_op(bsc_testnet, x"2Cf48D2891CC286d18596Df1261D011d1B78E03E"),
        helpers.get_or_create_bridge_op(bsc_testnet, x"2Cf48D2891CC286d18596Df1261D011d1B78E03F"),
        helpers.get_or_create_bridge_op(sepolia, x"2Cf48D2891CC286d18596Df1261D011d1B78E03E"), // same as bsc_testnet
    ).run();

    assert_equals(
        get_bridge_contracts(bsc_testnet),
        [
            bridge_contract_info(
                contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E03E",
                evm_read_offset = 10,
                erc20_assets = []
            ),
            bridge_contract_info(
                contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E03F",
                evm_read_offset = 10,
                erc20_assets = []
            ),
        ]
    );

    assert_equals(
        get_bridge_contracts(sepolia),
        [
            bridge_contract_info(
                contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E03E",
                evm_read_offset = 20,
                erc20_assets = []
            ),
        ]
    );

    assert_equals(
        get_bridge_contract_info(bsc_testnet, x"2Cf48D2891CC286d18596Df1261D011d1B78E03E"),
        bridge_contract_info(
            contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E03E",
            evm_read_offset = 10,
            erc20_assets = []
        )
    );

    assert_equals(
        get_bridge_contract_info(sepolia, x"2Cf48D2891CC286d18596Df1261D011d1B78E03E"),
        bridge_contract_info(
            contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E03E",
            evm_read_offset = 20,
            erc20_assets = []
        )
    );
}

function test_get_bridge_contracts_when_registered_erc20_assets_exist() {
    val sepolia = 11155111;
    val bsc_testnet = 97;

    // Register FT4 CHR and ERC20 CHR assets
    val chr_asset = register_foreign_asset(CHR, sepolia);
    // bind ERC20 asset FOO on sepolia to the FT4 CHR asset on Chromia
    register_erc20_asset(chr_asset, FOO, sepolia);
    // Register FT4 BAR and ERC20 BAR assets on sepolia
    register_foreign_asset(BAR, sepolia);
    // Register FT4 ABC and ERC20 ABC on bsc_testnet:97 assets
    register_foreign_asset(ABC, bsc_testnet);

    val erc20_chr = erc20_asset @ { .token_address == CHR.token_address };
    val erc20_foo = erc20_asset @ { .token_address == FOO.token_address };
    val erc20_bar = erc20_asset @ { .token_address == BAR.token_address };
    val erc20_abc = erc20_asset @ { .token_address == ABC.token_address };
    val erc20_chr_info = map_erc20_asset_to_erc20_asset_info(erc20_chr);
    val erc20_foo_info = map_erc20_asset_to_erc20_asset_info(erc20_foo);
    val erc20_bar_info = map_erc20_asset_to_erc20_asset_info(erc20_bar);
    val erc20_abc_info = map_erc20_asset_to_erc20_asset_info(erc20_abc);

    rell.test.tx().op(
        helpers.register_bridge_with_erc20_assets_op(
            sepolia,
            x"2Cf48D2891CC286d18596Df1261D011d1B78E04E",
            [erc20_chr, erc20_foo]
        ),
        helpers.register_bridge_with_erc20_assets_op(
            sepolia,
            x"2Cf48D2891CC286d18596Df1261D011d1B78E04F",
            [erc20_foo, erc20_bar]
        ),
        helpers.register_bridge_with_erc20_assets_op(
            bsc_testnet,
            x"2Cf48D2891CC286d18596Df1261D011d1B78E04E", // same as sepolia
            [erc20_abc]
        ),
    ).run();

    assert_equals(
        get_bridge_contracts(network_id = sepolia),
        [
            bridge_contract_info(
                contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E04E",
                evm_read_offset = 20,
                erc20_assets = [erc20_chr_info, erc20_foo_info]
            ),
            bridge_contract_info(
                contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E04F",
                evm_read_offset = 20,
                erc20_assets = [erc20_foo_info, erc20_bar_info]
            ),
        ]
    );

    assert_equals(
        get_bridge_contracts(network_id = bsc_testnet),
        [
            bridge_contract_info(
                contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E04E",
                evm_read_offset = 10,
                erc20_assets = [erc20_abc_info]
            ),
        ]
    );

    assert_equals(
        get_bridge_contract_info(sepolia, x"2Cf48D2891CC286d18596Df1261D011d1B78E04E"),
        bridge_contract_info(
            contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E04E",
            evm_read_offset = 20,
            erc20_assets = [erc20_chr_info, erc20_foo_info]
        )
    );

    assert_equals(
        get_bridge_contract_info(sepolia, x"2Cf48D2891CC286d18596Df1261D011d1B78E04F"),
        bridge_contract_info(
            contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E04F",
            evm_read_offset = 20,
            erc20_assets = [erc20_foo_info, erc20_bar_info]
        )
    );

    assert_equals(
        get_bridge_contract_info(bsc_testnet, x"2Cf48D2891CC286d18596Df1261D011d1B78E04E"),
        bridge_contract_info(
            contract_address = x"2Cf48D2891CC286d18596Df1261D011d1B78E04E",
            evm_read_offset = 10,
            erc20_assets = [erc20_abc_info]
        )
    );
}
