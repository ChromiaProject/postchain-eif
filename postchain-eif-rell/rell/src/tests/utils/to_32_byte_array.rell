function test_evm_address_to_32_byte_array() {
    val address =                          x"b7eB5d60Dd5610A82A4844Beb3F7d750316d3D32";
    val expected = x"000000000000000000000000b7eB5d60Dd5610A82A4844Beb3F7d750316d3D32";

    val actual = utils.evm_address_to_32_byte_array(address);
    assert_equals(actual, expected);

    assert_fails("Invalid address length 21, must be 20", utils.evm_address_to_32_byte_array(address + x"f0", *));

    assert_fails("Invalid address length 10, must be 20", utils.evm_address_to_32_byte_array(address.sub(0, 10), *));
}
