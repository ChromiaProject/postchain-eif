
function test_evm_block() {
    val contract_address = x"b7eB5d60Dd5610A82A4844Beb3F7d750316d3D32";
    val token_address = x"39615b16b74589919c9ce1ea73f1fc5d53141a78";
    val token_name = "Chromia";
    val token_symbol = "CHR";
    val token_decimal = 6;
    val token_icon_url = "https://chromaway.com/chr";
    val admin_privkey = x"3132333435363738393031323334353637383930313233343536373839303131";
    val user_pubkey = "038f888dec563b5bc253e87abc90afd26c3287021d10236ea19d248043dc39e0b8";
    val user_privkey = x"71b5b7f8de0661af934a5e4612f3d0ba183e639bdf4e7452fb6457ed3cfbc825";
    val other_pubkey = "03229b4671a77dbf70bd8cfb375a034a2c331cf638607d883ee4a11dd4194f7af2";
    val other_privkey = x"89496a99e123e26ce7a65c0d810f3b49fbea1661522948f29f696ead84426c75";
    val user_evm_address = x"e105ba42b66d08ac7ca7fc48c583599044a6dab3";
    val other_evm_address = x"661683e5d36e83b38b1a20247ba6f5c410dc165d";
    val event_name = "DepositedERC20";
    val amount = 10000000000000000000L;
    val network_id = 1;
    val asset_id = (token_name, chain_context.blockchain_rid).hash();
    
    rell.test.tx().op(
        admin.register_asset(token_name, token_symbol, token_decimal, token_icon_url)
    ).sign(admin_privkey).run();

    rell.test.tx().op(
        ft.add_new_evm_erc20(network_id, token_address, token_name, token_symbol, token_decimal)
    ).sign(admin_privkey).run();
    
    rell.test.tx().op(
        ft.add_new_token_mapping(network_id, token_address, asset_id)
    ).sign(admin_privkey).run();

    val auth = auth_descriptor(
        auth_type.S,
        [
            ["T"].to_gtv(),
            user_pubkey.to_gtv()
        ],
        null.to_gtv()
    );
    val account_id = auth.hash();
    val sig = ft_auth.signature(
        r = x"39b0c8c44a10d0fd70c0ed0e833cf6d93818ae1b10777857eb868516932796dc",
        s = x"44de8f297cce55c3da8401dd77269d0baf978f60e97ebc5717d4c8eeaed3bea9",
        v = 28
    );

    rell.test.tx().op(
        evm.register_account(user_evm_address, auth, sig)
    ).sign(user_privkey).run();

    val ft_asset = assets.asset @ { .id == asset_id };
    val evm_account = evm.evm_account @ { .address == user_evm_address };
    val ft_account = evm_account.account;

    val event_data_list = list<c.event_data>();
    val indexed_values = list<gtv>();
    val non_indexed_values = list<gtv>();
    indexed_values.add(user_evm_address.to_gtv());
    indexed_values.add(token_address.to_gtv());
    indexed_values.add(account_id.to_gtv());
    non_indexed_values.add((network_id).to_gtv());
    non_indexed_values.add((amount).to_gtv());
    non_indexed_values.add((token_name).to_gtv());
    non_indexed_values.add((token_symbol).to_gtv());
    non_indexed_values.add((token_decimal).to_gtv());
    val e = c.event_data(
        tnx_hash = x"26b1a0d2c8ed8e32efff45232a106b459aeb23c98d83478eb5f29ca4109be13c",
        log_index = 1,
        signature = x"4090023c909f5c377c211a8e8aedd778ec5de71852d4d66b4bb2fe6fc033211f",
        contract_address = contract_address,
        name = event_name,
        indexed_values = indexed_values,
        non_indexed_values = non_indexed_values
    );
    val account_number_1 = 1;
    val block_height = 100;
    val block_hash = x"508ccf97bb5fac1546ac0040793e32d0336e764d62b60810fd460d445adfde64";
    event_data_list.add(e);
    rell.test.tx().op(
        th_eif.evm_block_op(network_id, block_height, block_hash, event_data_list)
    ).run();
    val state = list<gtv>();
    state.add(to_32_byte_array(user_evm_address).to_gtv());
    state.add((64).to_gtv());
    state.add(to_32_byte_array(token_address).to_gtv());
    state.add((amount).to_gtv());
    assert_events(("eif_state", (account_number_1, state).to_gtv_pretty()));

    val ft_balance = assets.get_asset_balance( ft_account, ft_asset );
    assert_equals(ft_balance, amount);

    val last_block = main.get_last_evm_block(network_id)!!;
    assert_equals(last_block.evm_block_height, block_height);
    assert_equals(last_block.evm_block_hash, block_hash);

    // bridge some ft3 token to evm
    val auth_id = c.auth_id(account_id = ft_account.id, auth_descriptor_id = auth.hash());
    rell.test.tx().op(
        ft.bridge_ft_token_to_evm(auth_id, network_id, token_address, user_evm_address, amount/2)
    ).sign(user_privkey).run();

    val withdraw_info = list<gtv>();
    withdraw_info.add((1).to_gtv());
    withdraw_info.add(network_id.to_gtv());
    withdraw_info.add(to_32_byte_array(token_address).to_gtv());
    withdraw_info.add(to_32_byte_array(user_evm_address).to_gtv());
    withdraw_info.add((amount/2).to_gtv());
    val state_2 = list<gtv>();
    state_2.add(to_32_byte_array(user_evm_address).to_gtv());
    state_2.add((64).to_gtv());
    state_2.add(to_32_byte_array(token_address).to_gtv());
    state_2.add((amount/2).to_gtv());
    assert_events(("eif_state", (account_number_1, state_2).to_gtv_pretty()), ("eif_event", withdraw_info.to_gtv_pretty()));

    val ft_balance_2 = assets.get_asset_balance( ft_account, ft_asset );
    assert_equals(ft_balance_2, amount/2);

    // user can also deposit from ft3 account to EIF
    rell.test.tx().op(
        ft.deposit_ft_token(auth_id, network_id, token_address, user_evm_address, amount/4)
    ).sign(user_privkey).run();

    val state_3 = list<gtv>();
    state_3.add(to_32_byte_array(user_evm_address).to_gtv());
    state_3.add((128).to_gtv());
    state_3.add(to_32_byte_array(token_address).to_gtv());
    state_3.add((amount/4).to_gtv());
    state_3.add(to_32_byte_array(token_address).to_gtv());
    state_3.add((amount/4).to_gtv());
    assert_events(("eif_state", (account_number_1, state_3).to_gtv_pretty()));

    val ft_balance_3 = assets.get_asset_balance( ft_account, ft_asset );
    assert_equals(ft_balance_3, amount/4);

    // and claim token back to ft3 account from EIF
    val r_1 = x"8b7ea2bdf37c7f18555547cac6a84f4ced79f6b3b9de556ff52b75170f2ada75";
    val s_1 = x"136c7364dd5549001b7eba351c448dd8c2483f078f8e102d4f48084b7e04212e";
    val v_1 = 0;
    val tx = rell.test.tx().op(
        ft.claim_ERC20(network_id, token_address, user_evm_address, amount/4, r_1, s_1, v_1, user_pubkey, account_id)
    );
    tx.run_must_fail("participants is empty");
    tx.sign(user_privkey).run();
    val withdraw_info_1 = list<gtv>();
    withdraw_info_1.add((2).to_gtv());
    withdraw_info_1.add((0).to_gtv());
    withdraw_info_1.add(to_32_byte_array(token_address).to_gtv());
    withdraw_info_1.add(to_32_byte_array(user_evm_address).to_gtv());
    withdraw_info_1.add((amount/4).to_gtv());
    val state_4 = list<gtv>();
    state_4.add(to_32_byte_array(user_evm_address).to_gtv());
    state_4.add((128).to_gtv());
    state_4.add(to_32_byte_array(token_address).to_gtv());
    state_4.add(big_integer(0).to_gtv());
    state_4.add(to_32_byte_array(token_address).to_gtv());
    state_4.add((amount/2).to_gtv());
    assert_events(("eif_state", (account_number_1, state_4).to_gtv_pretty()), ("eif_event", withdraw_info_1.to_gtv_pretty()));

    val ft_balance_4 = assets.get_asset_balance( ft_account, ft_asset );
    assert_equals(ft_balance_4, amount/2);

    // deposit into non-existing evm account
    val account_number_2 = 2;
    val other_indexed_values = list<gtv>();
    other_indexed_values.add(other_evm_address.to_gtv());
    other_indexed_values.add(token_address.to_gtv());
    other_indexed_values.add(account_id.to_gtv());

    val e1 = c.event_data(
        tnx_hash = x"26b1a0d2c8ed8e32efff45232a106b459aeb23c98d83478eb5f29ca4109be13d",
        log_index = 2,
        signature = x"4090023c909f5c377c211a8e8aedd778ec5de71852d4d66b4bb2fe6fc033211f",
        contract_address = contract_address,
        name = event_name,
        indexed_values = other_indexed_values,
        non_indexed_values = non_indexed_values
    );
    val other_event_data_list = list<c.event_data>();
    other_event_data_list.add(e1);
    rell.test.tx().op(
        th_eif.evm_block_op(network_id, 101, x"508ccf97bb5fac1546ac0040793e32d0336e764d62b60810fd460d445adfde65", other_event_data_list)
    ).run();

    val other_state = list<gtv>();
    other_state.add(to_32_byte_array(other_evm_address).to_gtv());
    other_state.add((64).to_gtv());
    other_state.add(to_32_byte_array(token_address).to_gtv());
    other_state.add((amount).to_gtv());
    assert_events(("eif_state", (account_number_2, other_state).to_gtv_pretty()));

    val balance = ft.evm_balance_of_erc20(network_id, token_address, other_evm_address);
    assert_equals(balance, amount);

    // withdraw erc20 token from EIF to evm chain
    val r = x"51a57dc379195ee8ebefb17a6d187c6133ad19f32a322b0bf1cb606af6cedd59";
    val s = x"4382248996dae4277e9804c7972f545e8552a983d918491a05e26d963f47ebfe";
    val v = 1;

    val withdraw_amount = amount - 1000000;
    rell.test.tx().op(
        ft.withdraw_ERC20(network_id, token_address, other_evm_address, withdraw_amount, r, s, v, other_pubkey)
    ).sign(other_privkey).run();

    val other_withdraw_info = list<gtv>();
    other_withdraw_info.add((3).to_gtv());
    other_withdraw_info.add(network_id.to_gtv());
    other_withdraw_info.add(to_32_byte_array(token_address).to_gtv());
    other_withdraw_info.add(to_32_byte_array(other_evm_address).to_gtv());
    other_withdraw_info.add((withdraw_amount).to_gtv());

    val other_state_2 = list<gtv>();
    other_state_2.add(to_32_byte_array(other_evm_address).to_gtv());
    other_state_2.add((64).to_gtv());
    other_state_2.add(to_32_byte_array(token_address).to_gtv());
    other_state_2.add((amount-withdraw_amount).to_gtv());

    assert_events(("eif_state", (account_number_2, other_state_2).to_gtv_pretty()), ("eif_event", other_withdraw_info.to_gtv_pretty()));
}

function to_32_byte_array(evm_address: byte_array): byte_array {
    return byte_array.from_hex("000000000000000000000000" + evm_address.to_hex());
}