import u: eif.utils;

function test_to_zero_padded_hex() {
    val input = "b7eB5d60Dd5610A82A4844Beb3F7d750316d3D32";
    val expected = x"000000000000000000000000b7eB5d60Dd5610A82A4844Beb3F7d750316d3D32";
    val actual = u.to_zero_padded_hex(byte_array.from_hex(input));
    assert_equals(expected, byte_array.from_hex(actual));
}