module;

import transaction_submitter.signer_update.*;

operation enqueue_signer_update_op(update_id: integer, new_signers: list<byte_array>) {
    enqueue_signer_update_transaction_impl(update_id, x"", x"", [x""], new_signers, x"", x"");
}

operation signer_update_message_op(signer_list_update_message) {
    handle_signer_update_message(x"", signer_list_update_topic, signer_list_update_message.to_gtv());

}
operation bridge_mapping_message_update_op(bridge_mapping_message) {
    handle_bridge_mapping_updates(x"", bridge_mapping_topic, bridge_mapping_message.to_gtv());
}

operation mock_system_validator_contract_update(blockchain_rid: byte_array, network_id: integer, validator_contract: text) {
    handle_new_validator_contract(blockchain_rid, network_id, validator_contract);
}
