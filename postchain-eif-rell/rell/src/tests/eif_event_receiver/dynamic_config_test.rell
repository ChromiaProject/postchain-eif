@test module;

import ^.helpers.*;
import lib.eif.dynamic_config_common.*;

function test_contracts_config() {
    rell.test.tx()
        .op(add_contract_config(1, x"753218363422002DF74F3D0D8d67f6CB38bE32D0", 1))
        .op(add_contract_config(1, x"2Cf48D2891CC286d18596Df1261D011d1B78E03E", 2))
        .op(add_contract_config(2, x"0000000000000000000000000000000000000000", 0))
    .run();

    assert_equals(get_contracts_to_fetch(1),
        [contract_to_fetch(x"753218363422002DF74F3D0D8d67f6CB38bE32D0", 1), contract_to_fetch(x"2Cf48D2891CC286d18596Df1261D011d1B78E03E", 2)]);
}

function test_events_config() {
    val event1 = event_def(name = "foo", inputs = [event_input(type = "address", indexed = true), event_input(type = "uint256", indexed = false)]);
    val event2 = event_def(name = "bar", inputs = [event_input(type = "bytes32", indexed = false)]);

    rell.test.tx()
        .op(add_event_config(1, event1.name, encode_inputs(event1.inputs)))
        .op(add_event_config(1, event2.name, encode_inputs(event2.inputs)))
        .op(add_event_config(2, "baz", encode_inputs([])))
    .run();

    assert_equals(get_events(1), [event1, event2]);
}
