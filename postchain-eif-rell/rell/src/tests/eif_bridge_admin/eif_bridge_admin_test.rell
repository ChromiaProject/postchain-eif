@test module;

import eif_bridge_admin.*;
import ^.helper_operations.*;

val bridge_admin_account_privkey = rell.test.privkeys.charlie;
val bridge_admin_account_signer = rell.test.pubkeys.charlie;

function test_register_bridge_admin_account_twice() {
    rell.test.tx().op(register_bridge_admin_account()).nop().run();
    rell.test.tx().op(register_bridge_admin_account()).nop().run_must_fail("Bridge admin account already created.");
}

function test_seize_funds() {
    //register bridge admin account
    rell.test.tx().op(register_bridge_admin_account()).run();

    //register test accounts and asset
    rell.test.tx().op(
            register_test_account(rell.test.pubkeys.alice),
            register_test_account(rell.test.pubkeys.bob),
            register_asset()
        ).run();

    //mint alice account
    val alice_account = ft4.accounts.account_by_id(rell.test.pubkeys.alice.hash());
    rell.test.tx()
        .op(mint_to(alice_account, 1000)).run();

    //Only frozen accounts can be seized
    rell.test.tx()
        .op(
            ft_auth_operation_for(bridge_admin_account_signer),
            seize_funds(alice_account.id, 1000, get_asset().id)
        )
        .sign(bridge_admin_account_privkey)
        .run_must_fail("Block transfer exceptions can only be applied to blocked accounts.");

    //blacklist alice account
    rell.test.tx()
        .op(
            ft_auth_operation_for(bridge_admin_account_signer),
            eif_access_list_control.add_account_id_to_blacklist(alice_account.id)
        ).sign(bridge_admin_account_privkey).run();
    assert_false(eif_access_list_control.check_access_list(alice_account.id));

    //ft4 transfer not allowed for blacklisted account
    val bob_account = ft4.accounts.account_by_id(rell.test.pubkeys.bob.hash());
    rell.test.tx()
        .op(
            ft_auth_operation_for(rell.test.pubkeys.alice),
            ft4.assets.external.transfer(bob_account.id, get_asset().id, 100)
        )
        .sign(rell.test.privkeys.alice)
        .run_must_fail(
            "Transfers from account 0x7b1dda0d03d062460c745b459779e1dee9845a5eec6341a81f91c081c5cc89c5 are blocked."
        );

    //bob cannot seize funds
    rell.test.tx()
        .op(
            ft_auth_operation_for(rell.test.pubkeys.bob),
            seize_funds(alice_account.id, 1000, get_asset().id)
        )
        .sign(rell.test.privkeys.bob)
        .run_must_fail(
            "Authorization failed: The account 0xe7240d97ba8a49f146f3464f8193491f68bb48f55d85307fd1c5ea24e233bbd8 is not authorized. Bridge admin account authorization is required."
        );


    //bridge_account can seize funds
    rell.test.tx()
        .op(
            ft_auth_operation_for(bridge_admin_account_signer),
            seize_funds(alice_account.id, 1000, get_asset().id)
        )
        .sign(bridge_admin_account_privkey)
        .run();
    assert_equals(ft4.assets.get_asset_balance(alice_account, get_asset()), 0L);

    val seize_history = get_seize_history(alice_account.id);
    assert_equals(seize_history.size(), 1);
    assert_equals(seize_history[0], seize_history_entry(account_id=alice_account.id, amount=1000, asset_id= get_asset().id, timestamp=1577836840000));
}

function ft_auth_operation_for(signer: byte_array) {
    val descriptor = require(
        ft4.accounts.auth_descriptor_signer @? { signer }.account_auth_descriptor limit 1,
        "No auth descriptor found for signer %s".format(signer)
    );

    return ft4.auth.external.ft_auth(descriptor.account.id, descriptor.id);
}
