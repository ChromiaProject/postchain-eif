@test module;

import lib.hbridge_admin.*;

val bridge_admin_account_signer = rell.test.pubkeys.charlie;
val bridge_admin_account_privkey = rell.test.privkeys.charlie;

function test_check_access_list_blacklist_pass() {
    assert_true(access_list_control.is_account_on_access_list(x""));
}

function test_check_access_list_blacklist_block() {
    rell.test.tx().op(register_bridge_admin_account()).run();
    rell.test.tx().op(
            ft_auth_operation_for(bridge_admin_account_signer),
            access_list_control.add_account_id_to_blacklist(x"")
        ).sign(bridge_admin_account_privkey).run();

    assert_false(access_list_control.is_account_on_access_list(x""));
}

function test_check_access_list_blacklist_same_account_id() {
    rell.test.tx().op(register_bridge_admin_account()).run();
    rell.test.tx().op(
            ft_auth_operation_for(bridge_admin_account_signer),
            access_list_control.add_account_id_to_blacklist(x""),
            ft_auth_operation_for(bridge_admin_account_signer),
            access_list_control.add_account_id_to_blacklist(x"")
        ).sign(bridge_admin_account_privkey).run_must_fail("The account id 0x is already blacklisted.");
}

function test_blacklist_history() {
    rell.test.tx().op(register_bridge_admin_account()).run();
    rell.test.tx().op(
            ft_auth_operation_for(bridge_admin_account_signer),
            access_list_control.add_account_id_to_blacklist(x""),
            ft_auth_operation_for(bridge_admin_account_signer),
            access_list_control.remove_account_id_from_blacklist(x"")
        ).sign(bridge_admin_account_privkey).run();

    assert_true(access_list_control.is_account_on_access_list(x""));

    val history = access_list_control.get_blacklist_history(x"");
    assert_true(history.size() == 2);
    assert_equals(history[0], access_list_control.blacklist_history_entry(x"", access_list_control.action.add, 1577836810000));
    assert_equals(history[1], access_list_control.blacklist_history_entry(x"", access_list_control.action.remove, 1577836810000));
}

function ft_auth_operation_for(signer: byte_array) {
    val descriptor = require(
        ft4.accounts.auth_descriptor_signer @? { signer }.account_auth_descriptor limit 1,
        "No auth descriptor found for signer %s".format(signer)
    );

    return ft4.auth.external.ft_auth(descriptor.account.id, descriptor.id);
}
