function test_deposit_bounce_on_no_consent_link() {
    val evm_collection = register_collection();
    val evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);

    // Create FT4 account but don't link
    val (ft_account, _) = create_ft4_account(rell.test.keypairs.alice.pub);
    val account_id = ft_account.id;

    // Deposit from smart contract (non-zero recipient_id) without linking
    val (tnx_hash, log_index) = deposit_from_evm(
        evm_address,
        FOO.token_address,
        [123L],
        [1L],
        721L,
        account_id = account_id
    );
    assert_withdraw(
        1,
        evm_address,
        FOO.token_address,
        [hbridge_crc2.token_amount(token_id = 123L, amount = 1L)],
        721,
        1,
        network_id1,
        contract_address
    );

    // Verify bounced deposit
    val bounced = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter());
    assert_equals(bounced.data.size(), 1);
    assert_bounced_at(bounced, 0, [hbridge_crc2.token_amount(token_id = 123L, amount = 1L)], "Sender EVM account not linked to recipient FT4 account");
}

function test_deposit_bounce_erc1155_invalid_amount() {
    val evm_collection = register_collection(BAR);
    val (account, evm_address) = register_evm_account(rell.test.keypairs.alice);

    // Deposit with amount = 0 (invalid)
    val (tnx_hash, log_index) = deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [123L],
        [0L],
        1155L
    );

    // All tokens bounced, deposit should be recalled
    assert_equals(hbridge_crc2.token_deposit @ { .state == hbridge_crc2.deposit_state.recalled } (@sum 1), 1);

    // Verify bounced deposit reason
    val bounced = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter());
    assert_equals(bounced.data.size(), 1);
    assert_bounced_at(bounced, 0, [hbridge_crc2.token_amount(token_id = 123L, amount = 0L)], "Invalid tokens: amount <= 0 or insufficient bridge balance");
}

function test_deposit_partial_bounce_erc1155_mixed_amounts() {
    val evm_collection = register_collection(BAR);
    val (account, evm_address) = register_evm_account(rell.test.keypairs.alice);

    // Deposit with mixed valid/invalid amounts
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [100L, 200L, 300L],
        [5L, 0L, 3L],
        1155L
    );

    // Valid tokens deposited
    val token100 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 100L);
    assert_not_null(token100);
    assert_equals(crc2._get_account_balance(account, token100), 5L);

    val token300 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 300L);
    assert_not_null(token300);
    assert_equals(crc2._get_account_balance(account, token300), 3L);

    // Invalid token bounced
    val bounced = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter());
    assert_equals(bounced.data.size(), 1);
    assert_bounced_at(bounced, 0, [hbridge_crc2.token_amount(token_id = 200L, amount = 0L)], "Invalid tokens: amount <= 0 or insufficient bridge balance");

    // Completed deposit also created
    assert_equals(hbridge_crc2.token_deposit @ { .state == hbridge_crc2.deposit_state.completed } (@sum 1), 1);
}

