function test_deposit_erc721_many() {
    val evm_collection = register_collection();
    val (account, evm_address) = register_evm_account(rell.test.keypairs.alice);
    val token_ids = [100L, 200L, 300L, 400L, 500L];
    val token_amounts = [1L, 1L, 1L, 1L, 1L];
    deposit_from_evm(
        evm_address,
