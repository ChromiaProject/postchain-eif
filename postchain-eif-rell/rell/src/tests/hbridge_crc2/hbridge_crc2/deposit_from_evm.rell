function test_deposit_with_invalid_protocol_id() {
    val evm_collection = register_collection(FOO);
    val (account, evm_address) = register_evm_account(rell.test.keypairs.alice);
    val token_ids = [100L, 200L, 300L, 400L, 500L];
    val token_amounts: list<big_integer> = [1L, 2L, 3L, 4L, 5L];
    deposit_from_evm(evm_address, evm_collection.contract_address, token_ids, token_amounts, 123L);
    for (token_id in token_ids) {
        val token = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, token_id);
        assert_null(token);
    }
}

function test_duplicate_deposit_with_same_tx_hash_and_log_index_is_ignored() {
    val evm_collection = register_collection(FOO);
    val (account, evm_address) = register_evm_account(rell.test.keypairs.alice);

    // First deposit with log_index = 5
    deposit_from_evm(evm_address, evm_collection.contract_address, [100L], [1L], 721L, block_height = 1, log_index = 5);
    val token1 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 100L);
    assert_not_null(token1);
    assert_equals(crc2._get_account_balance(account, token1), 1L);
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 1);
    // Verify log_index is stored
    assert_equals(hbridge_crc2.token_deposit @ {} .evm_log_index, 5L);

    // Duplicate deposit with same tx_hash and log_index should be ignored (not bounced)
    deposit_from_evm(evm_address, evm_collection.contract_address, [200L], [1L], 721L, block_height = 1, log_index = 5);
    val token2 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 200L);
    assert_null(token2); // Token should not be created
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 1); // Still only 1 deposit

    // Deposit with same tx_hash but different log_index should succeed
    deposit_from_evm(evm_address, evm_collection.contract_address, [300L], [1L], 721L, block_height = 1, log_index = 0);
    val token3 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 300L);
    assert_not_null(token3);
    assert_equals(crc2._get_account_balance(account, token3), 1L);
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 2);

    // Deposit with different tx_hash should succeed
    deposit_from_evm(evm_address, evm_collection.contract_address, [400L], [1L], 721L, block_height = 2, log_index = 0);
    val token4 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 400L);
    assert_not_null(token4);
    assert_equals(crc2._get_account_balance(account, token4), 1L);
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 3);
}

function test_bounced_deposit_blocks_subsequent_deposits_from_same_evm_tx_and_log_index() {
    val evm_collection = register_collection(FOO);
    // Don't register account - deposit will be bounced
    val evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);

    // First deposit - will be bounced because no account exists
    deposit_from_evm(evm_address, evm_collection.contract_address, [100L], [1L], 721L, block_height = 1);
    // Verify it was bounced (state = recalled)
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 1);
    assert_equals(hbridge_crc2.token_deposit @ { .state == hbridge_crc2.deposit_state.recalled } (@sum 1), 1);
    assert_equals(hbridge_crc2.token_withdrawal @ {} (@sum 1), 1);

    // Second deposit from same EVM tx and log_index should be ignored
    deposit_from_evm(evm_address, evm_collection.contract_address, [200L], [1L], 721L, block_height = 1);
    // Still only 1 deposit (second one was ignored)
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 1);
    assert_equals(hbridge_crc2.token_withdrawal @ {} (@sum 1), 1);

    // Deposit from different EVM tx should be bounced (creates new entry)
    deposit_from_evm(evm_address, evm_collection.contract_address, [300L], [1L], 721L, block_height = 2);
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 2);
    assert_equals(hbridge_crc2.token_deposit @ { .state == hbridge_crc2.deposit_state.recalled } (@sum 1), 2);
    assert_equals(hbridge_crc2.token_withdrawal @ {} (@sum 1), 2);
}
