    for (token_id in token_ids) {
        val token = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, token_id);
        assert_not_null(token);
        assert_equals(crc2._get_account_balance(account, token), 1L);
