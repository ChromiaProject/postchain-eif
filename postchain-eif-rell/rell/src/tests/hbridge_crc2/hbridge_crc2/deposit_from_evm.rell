function test_duplicate_deposit_with_same_tx_hash_and_log_index_is_ignored() {
    val evm_collection = register_collection(FOO);
    val (account, evm_address) = register_evm_account(rell.test.keypairs.alice);

    // First deposit with log_index = 5
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [100L],
        [1L],
        721L,
        block_height = 1,
        log_index = 5
    );
    val token1 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 100L);
    assert_not_null(token1);
    assert_equals(crc2._get_account_balance(account, token1), 1L);
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 1);
    // Verify log_index is stored
    assert_equals(hbridge_crc2.token_deposit @ {} .evm_log_index, 5L);

    // Duplicate deposit with same tx_hash and log_index should be ignored (not bounced)
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [200L],
        [1L],
        721L,
        block_height = 1,
        log_index = 5
    );
    val token2 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 200L);
    assert_null(token2); // Token should not be created
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 1); // Still only 1 deposit
    assert_equals(hbridge_crc2.bounced_token_deposit @ {} (@sum 1), 0); // No bounced

    // Deposit with same tx_hash but different log_index should succeed
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [300L],
        [1L],
        721L,
        block_height = 1,
        log_index = 0
    );
    val token3 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 300L);
    assert_not_null(token3);
    assert_equals(crc2._get_account_balance(account, token3), 1L);
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 2);

    // Deposit with different tx_hash should succeed
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [400L],
        [1L],
        721L,
        block_height = 2,
        log_index = 0
    );
    val token4 = crc2.evm._get_token_by_evm_token(evm_collection.network_id, evm_collection.contract_address, 400L);
    assert_not_null(token4);
    assert_equals(crc2._get_account_balance(account, token4), 1L);
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 3);
}

function test_bounced_deposit_blocks_subsequent_deposits_from_same_evm_tx_and_log_index() {
    val evm_collection = register_collection(FOO);
    // Don't register account - deposit will be bounced
    val evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);

    // First deposit - will be bounced because no account exists
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [100L],
        [1L],
        721L,
        block_height = 1
    );
    // Verify it was bounced (state = recalled)
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 1);
    assert_equals(hbridge_crc2.token_deposit @ { .state == hbridge_crc2.deposit_state.recalled } (@sum 1), 1);
    assert_equals(hbridge_crc2.token_withdrawal @ {} (@sum 1), 1);
    assert_equals(hbridge_crc2.bounced_token_deposit @ {} (@sum 1), 1);

    // Second deposit from same EVM tx and log_index should be ignored
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [200L],
        [1L],
        721L,
        block_height = 1
    );
    // Still only 1 deposit (second one was ignored)
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 1);
    assert_equals(hbridge_crc2.token_withdrawal @ {} (@sum 1), 1);
    assert_equals(hbridge_crc2.bounced_token_deposit @ {} (@sum 1), 1);

    // Deposit from different EVM tx should be bounced (creates new entry)
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [300L],
        [1L],
        721L,
        block_height = 2
    );
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 2);
    assert_equals(hbridge_crc2.token_deposit @ { .state == hbridge_crc2.deposit_state.recalled } (@sum 1), 2);
    assert_equals(hbridge_crc2.token_withdrawal @ {} (@sum 1), 2);
    assert_equals(hbridge_crc2.bounced_token_deposit @ {} (@sum 1), 2);
}

function test_bounced_deposit_no_collection_blocks_duplicate() {
    // No collection registered, no account - bounce happens before token_deposit is created
    val evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);

    // First deposit bounced (collection not registered)
    deposit_from_evm(
        evm_address,
        FOO.token_address,
        [100L],
        [1L],
        721L,
        block_height = 1,
        log_index = 0L
    );
    assert_equals(hbridge_crc2.token_deposit @ {} (@sum 1), 0); // No token_deposit created
    assert_equals(hbridge_crc2.bounced_token_deposit @ {} (@sum 1), 1);

    // Second attempt with same tx/log_index ignored via bounced_token_deposit check
    deposit_from_evm(
        evm_address,
        FOO.token_address,
        [100L],
        [1L],
        721L,
        block_height = 1,
        log_index = 0L
    );
    assert_equals(hbridge_crc2.bounced_token_deposit @ {} (@sum 1), 1); // Still only 1
}

function test_get_bounced_token_deposits_multiple() {
    val evm_collection = register_collection(FOO);
    val evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);

    // Multiple bounced deposits (no account)
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [10L],
        [1L],
        721L,
        block_height = 1
    );
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [20L],
        [1L],
        721L,
        block_height = 2
    );
    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [30L],
        [1L],
        721L,
        block_height = 3
    );

    val result = hbridge_crc2.get_bounced_token_deposits(
        hbridge_crc2.bounced_deposit_filter(network_id = network_id1, contract_address = evm_collection.contract_address),
        page_size = 10,
        sort_desc = true
    );
    assert_equals(result.data.size(), 3);

    // Descending order: newest first (30, 20, 10)
    assert_bounced_at(result, 0, [hbridge_crc2.token_amount(token_id = 30L, amount = 1L)], "No FT4 account found");
    assert_bounced_at(result, 1, [hbridge_crc2.token_amount(token_id = 20L, amount = 1L)], "No FT4 account found");
    assert_bounced_at(result, 2, [hbridge_crc2.token_amount(token_id = 10L, amount = 1L)], "No FT4 account found");
}

function test_get_bounced_token_deposits_from_to_filter() {
    val evm_collection = register_collection(FOO);
    val evm_address = crypto.eth_pubkey_to_address(rell.test.keypairs.alice.pub);

    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [10L],
        [1L],
        721L,
        block_height = 1
    );
    val t0 = rell.test.last_block_time;

    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [11L],
        [1L],
        721L,
        block_height = 2
    );
    val t1 = rell.test.last_block_time;

    deposit_from_evm(
        evm_address,
        evm_collection.contract_address,
        [12L],
        [1L],
        721L,
        block_height = 3
    );
    val t2 = rell.test.last_block_time;

    // Test from/to range: [t0, t1) should return 1 deposit
    val res1 = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter(from = t0, to = t1));
    assert_equals(res1.data.size(), 1);
    assert_bounced_at(res1, 0, [hbridge_crc2.token_amount(token_id = 10L, amount = 1L)]);

    // Test from only: [t1, ) should return 2 deposits
    val res2 = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter(from = t1));
    assert_equals(res2.data.size(), 2);
    assert_bounced_at(res2, 0, [hbridge_crc2.token_amount(token_id = 11L, amount = 1L)]);
    assert_bounced_at(res2, 1, [hbridge_crc2.token_amount(token_id = 12L, amount = 1L)]);

    // Test to only: [, t1) should return 1 deposit
    val res3 = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter(to = t1));
    assert_equals(res3.data.size(), 1);
    assert_bounced_at(res3, 0, [hbridge_crc2.token_amount(token_id = 10L, amount = 1L)]);

    // Test from/to range: [t0, t2) should return 2 deposits
    val res4 = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter(from = t0, to = t2));
    assert_equals(res4.data.size(), 2);
    assert_bounced_at(res4, 0, [hbridge_crc2.token_amount(token_id = 10L, amount = 1L)]);
    assert_bounced_at(res4, 1, [hbridge_crc2.token_amount(token_id = 11L, amount = 1L)]);

    // Test from/to range: [t1, t2) should return 1 deposit
    val res5 = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter(from = t1, to = t2));
    assert_equals(res5.data.size(), 1);
    assert_bounced_at(res5, 0, [hbridge_crc2.token_amount(token_id = 11L, amount = 1L)]);

    // Test from/to range in descending order: [t0, t2) should return 2 deposits
    val res6 = hbridge_crc2.get_bounced_token_deposits(hbridge_crc2.bounced_deposit_filter(from = t0, to = t2), sort_desc = true);
    assert_equals(res6.data.size(), 2);
    assert_bounced_at(res6, 0, [hbridge_crc2.token_amount(token_id = 11L, amount = 1L)]);
    assert_bounced_at(res6, 1, [hbridge_crc2.token_amount(token_id = 10L, amount = 1L)]);
}
