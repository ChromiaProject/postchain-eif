function test_deposit_bounce_on_no_collection() {
    val (account, evm_address) = register_evm_account(rell.test.keypairs.alice);
    val (tnx_hash, log_index) = deposit_from_evm(
        evm_address,
        FOO.token_address,
        [123L],
        [1L],
        721L
    );
    assert_withdraw(
        1,
        evm_address,
        FOO.token_address,
        [hbridge_crc2.token_amount(token_id = 123L, amount = 1L)],
        721,
        1,
        network_id1,
        contract_address
    );

    // Verify bounced deposit
    assert_bounced_queries(evm_address, tnx_hash, log_index, "Collection not registered");
}

