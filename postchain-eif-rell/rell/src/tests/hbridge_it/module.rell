@mount("eif.hbridge")
module;

import eif_event_receiver_with_dynamic_config.*;
import hbridge.*;

import lib.ft4.admin;
import lib.ft4.assets;

operation register_erc20_asset(
    network_id: integer,
    token_address: byte_array,
    asset_id: byte_array,
    bridge_mode,
    enable_snapshots: boolean
) {
    admin.require_admin();

    val asset = assets.Asset(asset_id);

    erc20.register_erc20_asset(
        network_id,
        token_address,
        asset,
        bridge_mode,
        enable_snapshots
    );
}

operation add_contract_config(network_id: integer, contract: byte_array, skip_to_height: integer) {
    admin.require_admin();

    create contract_config(network_id, contract, skip_to_height);
}

operation register_bridge_with_erc20_assets(network_id: integer, bridge_address: byte_array) {
    admin.require_admin();

    val erc20_assets = erc20.erc20_asset @* { network_id };
    erc20.register_bridge_with_erc20_assets(network_id, bridge_address, 0, erc20_assets);
}
