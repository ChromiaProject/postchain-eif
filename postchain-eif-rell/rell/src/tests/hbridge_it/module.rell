@mount("eif.hbridge")
module;

import eif_event_receiver_with_dynamic_config.*;
import hbridge;

import lib.ft4.admin;
import lib.ft4.assets;

operation register_erc20_asset(
    network_id: integer,
    token_address: byte_array,
    asset_id: byte_array,
    enable_snapshots: boolean
) {
    admin.require_admin();

    val asset = assets.Asset(asset_id);

    hbridge.register_erc20_asset(
        network_id,
        token_address,
        asset,
        hbridge.bridge_mode.foreign,
        enable_snapshots
    );
}

operation add_contract_config(network_id: integer, contract: byte_array) {
    admin.require_admin();

    create contract_config(network_id, contract);
}
