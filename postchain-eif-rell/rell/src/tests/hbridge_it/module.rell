@mount("eif.hbridge")
module;

import eif_event_receiver_with_dynamic_config.*;
import lib.hbridge;

namespace ft4 {
    import lib.ft4.admin;
    import lib.ft4.accounts;
    import lib.ft4.assets;
    import lib.ft4.auth;
    import lib.ft4.utils;
    import lib.ft4.accounts.strategies.transfer.open. { ras_transfer_open };
    import lib.ft4.external.accounts.strategies.{ register_account };
}

operation register_erc20_asset(
    network_id: integer,
    token_address: byte_array,
    asset_id: byte_array,
    hbridge.bridge_mode,
    enable_snapshots: boolean
) {
    ft4.admin.require_admin();

    val asset = ft4.assets.Asset(asset_id);
    hbridge.erc20.register_erc20_asset(
        network_id,
        token_address,
        asset,
        bridge_mode,
        enable_snapshots
    );
}

operation add_contract_config(network_id: integer, contract: byte_array, skip_to_height: integer) {
    ft4.admin.require_admin();

    create contract_config ( network_id, contract, skip_to_height );
}

operation register_bridge_with_erc20_assets(network_id: integer, bridge_address: byte_array) {
    ft4.admin.require_admin();

    val erc20_assets = hbridge.erc20.erc20_asset @* { network_id };
    hbridge.erc20.register_bridge_with_erc20_assets(network_id, bridge_address, 0, erc20_assets);
}

operation enable_account_creation_on_deposit(network_id: integer, token_address: byte_array) {
    ft4.admin.require_admin();

    hbridge.enable_account_creation_on_deposit(network_id, token_address);
}

operation disable_account_creation_on_deposit(network_id: integer, token_address: byte_array) {
    ft4.admin.require_admin();

    hbridge.disable_account_creation_on_deposit(network_id, token_address);
}
